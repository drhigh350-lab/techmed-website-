# Sanity project connection for the Knowledge Base / Blog.
# Not yet provisioned — the site builds and runs fine with these unset;
# /blog/ simply shows its empty state until a real project is connected.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01
# Only needed if the dataset is private (draft/preview content).
SANITY_API_TOKEN=
