---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { sanityFetch, isSanityConfigured } from '../../lib/sanity';
import { ARTICLE_LIST_QUERY } from '../../lib/queries';
import type { ArticleSummary } from '../../lib/types';

const articles = await sanityFetch<ArticleSummary[]>(ARTICLE_LIST_QUERY, {}, []);
const [featured, ...rest] = articles;
---

<BaseLayout
  title="Knowledge Base — TECHMED"
  description="Straight answers on UTME/JAMB preparation, the syllabus, subject strategy, and admission — from the team building TECHMED."
>
  <main class="blog-index">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }]} />

      <header class="intro">
        <p class="eyebrow">TECHMED Knowledge Base</p>
        <h1>Answers before you need the product.</h1>
        <p class="lede">
          Practical guidance on UTME/JAMB preparation — the syllabus, subject strategy, exam
          technique, past questions, study planning, and admission — written to actually help,
          whether or not you ever use TECHMED.
        </p>
      </header>

      {
        articles.length === 0 ? (
          <div class="empty-state">
            <p class="empty-title">The Knowledge Base is just getting started.</p>
            <p class="empty-body">
              We're publishing our first guides here soon. In the meantime, explore the{' '}
              <a href="/resources.html">Resources</a> already available.
            </p>
          </div>
        ) : (
          <>
            {featured && (
              <section class="featured" aria-label="Featured article">
                <ArticleCard article={featured} priority />
              </section>
            )}
            {rest.length > 0 && (
              <section class="grid">
                {rest.map((article) => (
                  <ArticleCard article={article} />
                ))}
              </section>
            )}
          </>
        )
      }

      {
        !isSanityConfigured() && import.meta.env.DEV && (
          <p class="dev-note">
            Dev note: no Sanity project is configured (PUBLIC_SANITY_PROJECT_ID is unset), so
            this page is showing its empty state.
          </p>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .blog-index {
    padding-block: var(--space-16) var(--space-24);
  }

  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: var(--space-6);
  }

  .intro {
    max-width: 640px;
    margin-block: var(--space-8) var(--space-12);
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .lede {
    color: var(--text-light);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .featured {
    margin-bottom: var(--space-12);
    max-width: 640px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .empty-state {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    max-width: 640px;
  }

  .empty-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: var(--space-3);
  }

  .empty-body {
    color: var(--text-light);
    line-height: 1.7;
  }

  .empty-body a {
    color: var(--accent);
    text-decoration: underline;
  }

  .dev-note {
    margin-top: var(--space-12);
    padding: var(--space-4);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.8rem;
  }
</style>
