---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudentHubNav from '../../components/StudentHubNav.astro';

const title = 'Account Settings | TECHMED';
const description = 'Manage your TECHMED account security, email, password recovery, and profile preferences.';
---

<BaseLayout title={title} description={description} noindex>
  <main class="settings-page">
    <div class="settings-container">
      <!-- Loading State -->
      <div id="loadingState" class="settings-card state-card">
        <div class="spinner"></div>
        <p>Loading your account settings...</p>
      </div>

      <!-- Unauthorized State -->
      <div id="unauthCard" class="settings-card state-card" style="display: none;">
        <h2>Authentication Required</h2>
        <p>Please log in to manage your student account settings.</p>
        <a href="/login?redirect=/account/settings" class="btn-primary auth-btn">Log In</a>
      </div>

      <!-- Main Settings Content -->
      <div id="settingsContent" class="settings-content" style="display: none;">
        <!-- Header & Nav Tabs -->
        <header class="settings-header">
          <div class="header-titles">
            <span class="eyebrow">Student Hub</span>
            <h1 class="page-title">Account Settings</h1>
            <p class="page-sub">Review your credentials, security settings, and communication preferences.</p>
          </div>

          <StudentHubNav activeTab="settings" />
        </header>

        <!-- Alert Banner -->
        <div id="settingsAlert" class="settings-alert" style="display: none;" role="alert"></div>

        <div class="settings-grid">
          <!-- Card 1: Account Credentials -->
          <section class="settings-card credentials-card">
            <h2 class="card-heading">Account Credentials</h2>

            <div class="field-item">
              <span class="field-label">Email Address</span>
              <div class="field-val-row">
                <span class="field-value" id="displayEmail">--</span>
                <span class="verified-indicator">Active</span>
              </div>
            </div>

            <div class="field-item">
              <span class="field-label">Student ID Reference</span>
              <span class="field-value code-font" id="displayUserId">--</span>
            </div>

            <div class="field-item">
              <span class="field-label">Account Verification Status</span>
              <div class="status-wrap">
                <span class="status-badge" id="accountStatusBadge">Checking...</span>
              </div>
            </div>

            <div class="field-item">
              <span class="field-label">Account Created</span>
              <span class="field-value" id="displayCreatedAt">--</span>
            </div>
          </section>

          <!-- Card 2: Security & Password -->
          <section class="settings-card security-card">
            <h2 class="card-heading">Security &amp; Password</h2>
            <p class="card-desc">
              Update your account password directly or request a secure email reset link.
            </p>

            <!-- Direct Password Change Form -->
            <form id="changePasswordForm" class="password-change-form" novalidate>
              <div class="settings-form-group">
                <label for="settingsNewPassword">New Password</label>
                <div class="password-input-wrap">
                  <input
                    type="password"
                    id="settingsNewPassword"
                    required
                    autocomplete="new-password"
                    placeholder="Enter your new password"
                    class="form-input password-input"
                  />
                  <button
                    type="button"
                    class="password-toggle-btn"
                    id="toggleSettingsNewPassBtn"
                    aria-label="Show password"
                    title="Show password"
                  >
                    <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                  </button>
                </div>

                <!-- Password Checklist -->
                <div class="password-checklist-card" id="settingsChecklistCard">
                  <div class="checklist-header">
                    <span class="checklist-title">Password Requirements:</span>
                    <span class="checklist-count-badge" id="settingsChecklistBadge">0 of 5 satisfied</span>
                  </div>
                  <ul class="checklist-list" role="list">
                    <li class="checklist-item" id="set-req-length">
                      <span class="item-status-icon" aria-hidden="true">
                        <span class="dot-indicator"></span>
                        <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="item-label">At least 8 characters</span>
                    </li>
                    <li class="checklist-item" id="set-req-upper">
                      <span class="item-status-icon" aria-hidden="true">
                        <span class="dot-indicator"></span>
                        <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="item-label">At least one uppercase letter (A–Z)</span>
                    </li>
                    <li class="checklist-item" id="set-req-lower">
                      <span class="item-status-icon" aria-hidden="true">
                        <span class="dot-indicator"></span>
                        <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="item-label">At least one lowercase letter (a–z)</span>
                    </li>
                    <li class="checklist-item" id="set-req-number">
                      <span class="item-status-icon" aria-hidden="true">
                        <span class="dot-indicator"></span>
                        <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="item-label">At least one number (0–9)</span>
                    </li>
                    <li class="checklist-item" id="set-req-special">
                      <span class="item-status-icon" aria-hidden="true">
                        <span class="dot-indicator"></span>
                        <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="item-label">At least one special character (e.g. @, #, $, !)</span>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Password Confirmation -->
              <div class="settings-form-group">
                <label for="settingsNewPasswordConfirm">Confirm New Password</label>
                <div class="password-input-wrap">
                  <input
                    type="password"
                    id="settingsNewPasswordConfirm"
                    required
                    autocomplete="new-password"
                    placeholder="Re-enter your new password"
                    class="form-input password-input"
                  />
                  <button
                    type="button"
                    class="password-toggle-btn"
                    id="toggleSettingsConfirmBtn"
                    aria-label="Show confirm password"
                    title="Show password"
                  >
                    <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                  </button>
                </div>
                <div class="match-indicator" id="settingsMatchStatus" style="display: none;">
                  <span class="match-icon-badge" id="settingsMatchIcon"></span>
                  <span class="match-label" id="settingsMatchLabel"></span>
                </div>
              </div>

              <button type="submit" class="btn-primary update-pass-btn" id="savePasswordBtn">
                <span>Update Password</span>
              </button>
            </form>

            <div class="reset-email-divider">
              <span>OR</span>
            </div>

            <div class="action-box">
              <button type="button" class="btn-secondary reset-pass-btn" id="requestResetBtn">
                <span>Send Password Reset Email Link</span>
              </button>
              <span class="action-hint">A reset link valid for 1 hour will be sent to your registered email address.</span>
            </div>
          </section>

          <!-- Card 3: Profile & Communication Summary -->
          <section class="settings-card comms-card">
            <div class="card-header-with-action">
              <h2 class="card-heading">Personal & Contact Info</h2>
              <a href="/account/onboarding" class="btn-secondary small-btn">Update Profile</a>
            </div>

            <div class="summary-list">
              <div class="summary-row">
                <span class="summary-key">Full Name</span>
                <span class="summary-val" id="displayFullName">Not set</span>
              </div>
              <div class="summary-row">
                <span class="summary-key">Primary Phone</span>
                <span class="summary-val" id="displayPhone">Not set</span>
              </div>
              <div class="summary-row">
                <span class="summary-key">WhatsApp Number</span>
                <span class="summary-val" id="displayWhatsapp">Not set</span>
              </div>
              <div class="summary-row">
                <span class="summary-key">Telegram Handle</span>
                <span class="summary-val" id="displayTelegram">Not set</span>
              </div>
              <div class="summary-row">
                <span class="summary-key">Parent / Guardian</span>
                <span class="summary-val" id="displayParent">Not provided</span>
              </div>
            </div>
          </section>

          <!-- Card 4: Session & Sign Out -->
          <section class="settings-card session-card">
            <h2 class="card-heading">Session Management</h2>
            <p class="card-desc">
              Signing out will end your current browser session. You will need your email and password to log in again.
            </p>

            <button type="button" class="btn-danger signout-btn" id="settingsSignOutBtn">
              Sign Out of TECHMED
            </button>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { getSupabase, fetchUserProfile, checkIsVerifiedStudent } from '../../lib/supabase';
  import { pushLogout } from '../../lib/push';
  import {
    initPasswordChecklist,
    validatePassword,
    validatePasswordMatch,
    getFriendlyAuthErrorMessage,
  } from '../../lib/password-validator';

  const supabase = getSupabase();

  const loadingState = document.getElementById('loadingState');
  const unauthCard = document.getElementById('unauthCard');
  const settingsContent = document.getElementById('settingsContent');
  const settingsAlert = document.getElementById('settingsAlert');

  const displayEmail = document.getElementById('displayEmail');
  const displayUserId = document.getElementById('displayUserId');
  const accountStatusBadge = document.getElementById('accountStatusBadge');
  const displayCreatedAt = document.getElementById('displayCreatedAt');

  const displayFullName = document.getElementById('displayFullName');
  const displayPhone = document.getElementById('displayPhone');
  const displayWhatsapp = document.getElementById('displayWhatsapp');
  const displayTelegram = document.getElementById('displayTelegram');
  const displayParent = document.getElementById('displayParent');

  const changePasswordForm = document.getElementById('changePasswordForm') as HTMLFormElement | null;
  const settingsNewPassword = document.getElementById('settingsNewPassword') as HTMLInputElement | null;
  const settingsNewPasswordConfirm = document.getElementById('settingsNewPasswordConfirm') as HTMLInputElement | null;
  const settingsChecklistBadge = document.getElementById('settingsChecklistBadge');
  const settingsMatchStatus = document.getElementById('settingsMatchStatus');
  const settingsMatchIcon = document.getElementById('settingsMatchIcon');
  const settingsMatchLabel = document.getElementById('settingsMatchLabel');
  const toggleSettingsNewPassBtn = document.getElementById('toggleSettingsNewPassBtn');
  const toggleSettingsConfirmBtn = document.getElementById('toggleSettingsConfirmBtn');
  const savePasswordBtn = document.getElementById('savePasswordBtn') as HTMLButtonElement | null;

  const requestResetBtn = document.getElementById('requestResetBtn');
  const settingsSignOutBtn = document.getElementById('settingsSignOutBtn');

  let currentUserEmail = '';

  function showAlert(msg: string, type: 'error' | 'success' = 'error') {
    if (!settingsAlert) return;
    settingsAlert.textContent = msg;
    settingsAlert.className = `settings-alert ${type}`;
    settingsAlert.style.display = 'block';
    settingsAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideAlert() {
    if (!settingsAlert) return;
    settingsAlert.style.display = 'none';
  }

  // Initialize Real-Time Password Checklist & Confirmation
  initPasswordChecklist({
    passwordInput: settingsNewPassword,
    prefix: 'set-req-',
    badgeEl: settingsChecklistBadge,
    confirmInput: settingsNewPasswordConfirm,
    matchStatusEl: settingsMatchStatus,
    matchIconEl: settingsMatchIcon,
    matchLabelEl: settingsMatchLabel,
    togglePasswordBtn: toggleSettingsNewPassBtn,
    toggleConfirmBtn: toggleSettingsConfirmBtn,
  });

  // Handle Direct Password Update
  changePasswordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const newPass = settingsNewPassword?.value || '';
    const confirmPass = settingsNewPasswordConfirm?.value || '';

    const validation = validatePassword(newPass);
    if (!validation.isValid) {
      showAlert(`Please satisfy all 5 password requirements in the checklist below. Missing: ${validation.missingLabels.join('; ')}.`);
      settingsNewPassword?.focus();
      return;
    }

    const matchCheck = validatePasswordMatch(newPass, confirmPass);
    if (!matchCheck.isMatch) {
      showAlert('Passwords do not match. Please ensure both fields match exactly.');
      settingsNewPasswordConfirm?.focus();
      return;
    }

    if (savePasswordBtn) {
      savePasswordBtn.disabled = true;
      savePasswordBtn.textContent = 'Updating password...';
    }

    try {
      const { error } = await supabase.auth.updateUser({ password: newPass });

      if (error) {
        showAlert(getFriendlyAuthErrorMessage(error.message));
      } else {
        showAlert('Your password has been updated successfully!', 'success');
        if (settingsNewPassword) settingsNewPassword.value = '';
        if (settingsNewPasswordConfirm) settingsNewPasswordConfirm.value = '';
        if (settingsMatchStatus) settingsMatchStatus.style.display = 'none';
        const res = validatePassword('');
        const badge = document.getElementById('settingsChecklistBadge');
        if (badge) badge.textContent = `0 of ${res.totalCount} satisfied`;
        res.rules.forEach(r => {
          document.getElementById(`set-req-${r.id}`)?.classList.remove('satisfied');
        });
      }
    } catch (err: any) {
      showAlert(getFriendlyAuthErrorMessage(err.message));
    } finally {
      if (savePasswordBtn) {
        savePasswordBtn.disabled = false;
        savePasswordBtn.textContent = 'Update Password';
      }
    }
  });

  // Request password reset email
  requestResetBtn?.addEventListener('click', async () => {
    if (!currentUserEmail) return;
    hideAlert();

    const originalText = requestResetBtn.innerHTML;
    requestResetBtn.innerHTML = '<span>Sending...</span>';
    (requestResetBtn as HTMLButtonElement).disabled = true;

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(currentUserEmail, {
        redirectTo: `${window.location.origin}/login?tab=new-password`,
      });

      if (error) {
        showAlert(getFriendlyAuthErrorMessage(error.message));
      } else {
        showAlert(`Password reset link dispatched to ${currentUserEmail}. Please check your inbox.`, 'success');
      }
    } catch (err: any) {
      showAlert(getFriendlyAuthErrorMessage(err.message));
    } finally {
      requestResetBtn.innerHTML = originalText;
      (requestResetBtn as HTMLButtonElement).disabled = false;
    }
  });

  async function loadSettings() {
    const { data } = await supabase.auth.getSession();
    const user = data.session?.user;

    if (!user) {
      if (loadingState) loadingState.style.display = 'none';
      if (unauthCard) unauthCard.style.display = 'block';
      setTimeout(() => {
        window.location.href = '/login?redirect=/account/settings';
      }, 1000);
      return;
    }

    currentUserEmail = user.email || '';
    if (displayEmail) displayEmail.textContent = currentUserEmail;
    if (displayUserId) displayUserId.textContent = user.id;

    if (user.created_at && displayCreatedAt) {
      const d = new Date(user.created_at);
      displayCreatedAt.textContent = d.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    }

    // Check Verified Status
    try {
      const { isVerified, verifiedPlanOrProduct } = await checkIsVerifiedStudent(user.id, user.email);
      if (accountStatusBadge) {
        if (isVerified) {
          accountStatusBadge.textContent = 'Verified Student';
          accountStatusBadge.className = 'status-badge verified';
        } else {
          accountStatusBadge.textContent = 'Free Registered Candidate';
          accountStatusBadge.className = 'status-badge unverified';
        }
      }
    } catch {
      if (accountStatusBadge) {
        accountStatusBadge.textContent = 'Registered Candidate';
        accountStatusBadge.className = 'status-badge';
      }
    }

    // Load Profile
    try {
      const { profile } = await fetchUserProfile(user.id);
      if (profile) {
        if (displayFullName) displayFullName.textContent = profile.fullName || user.user_metadata?.full_name || 'Not set';
        if (displayPhone) displayPhone.textContent = profile.phone || 'Not set';
        if (displayWhatsapp) displayWhatsapp.textContent = profile.whatsappPhone || 'Not set';
        if (displayTelegram) displayTelegram.textContent = profile.telegramPhone || 'Not set';
        if (displayParent) displayParent.textContent = profile.parentPhone || 'Not provided';
      }
    } catch {
      // Non-fatal fallback
    }

    if (loadingState) loadingState.style.display = 'none';
    if (settingsContent) settingsContent.style.display = 'block';
  }

  // Request password reset email
  requestResetBtn?.addEventListener('click', async () => {
    if (!currentUserEmail) return;
    hideAlert();

    const originalText = requestResetBtn.innerHTML;
    requestResetBtn.innerHTML = '<span>Sending...</span>';
    (requestResetBtn as HTMLButtonElement).disabled = true;

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(currentUserEmail, {
        redirectTo: `${window.location.origin}/login?tab=login`,
      });

      if (error) {
        showAlert(`Error: ${error.message}`);
      } else {
        showAlert(`Password reset link dispatched to ${currentUserEmail}. Please check your inbox.`, 'success');
      }
    } catch (err: any) {
      showAlert(`Network error: ${err.message}`);
    } finally {
      requestResetBtn.innerHTML = originalText;
      (requestResetBtn as HTMLButtonElement).disabled = false;
    }
  });

  // Sign out handler
  settingsSignOutBtn?.addEventListener('click', async () => {
    try {
      await pushLogout();
      await supabase.auth.signOut();
    } finally {
      window.location.href = '/';
    }
  });

  loadSettings();
</script>

<style>
  .settings-page {
    min-height: calc(100vh - 180px);
    padding: var(--space-8) var(--space-6) var(--space-16);
    background: radial-gradient(circle at 50% 10%, rgba(9, 71, 110, 0.2), transparent 70%), var(--bg);
  }

  .settings-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .settings-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .state-card {
    text-align: center;
    padding: var(--space-16) var(--space-6);
  }

  .spinner {
    width: 38px;
    height: 38px;
    border: 3px solid rgba(201, 162, 39, 0.2);
    border-top-color: var(--accent);
    border-radius: 50%;
    margin: 0 auto var(--space-4);
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .auth-btn {
    display: inline-block;
    margin-top: var(--space-4);
    padding: 10px 20px;
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    border-radius: var(--radius-sm);
  }

  /* Header & Tabs */
  .settings-header {
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .page-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 4px 0 var(--space-2);
    color: var(--text);
  }

  .page-sub {
    font-size: 0.92rem;
    color: var(--text-light);
    margin-bottom: var(--space-6);
  }

  .hub-nav-tabs {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .tab-link {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid transparent;
    transition: all 150ms ease;
    white-space: nowrap;
  }

  .tab-link:hover {
    color: var(--text);
  }

  .tab-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }

  /* Alert */
  .settings-alert {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .settings-alert.error {
    background: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.35);
    color: #fca5a5;
  }

  .settings-alert.success {
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #86efac;
  }

  /* Grid */
  .settings-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .card-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .card-header-with-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .card-header-with-action .card-heading {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.55;
    margin-bottom: var(--space-4);
  }

  .field-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .field-label {
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .field-val-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .field-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .code-font {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .verified-indicator {
    font-size: 0.72rem;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.12);
