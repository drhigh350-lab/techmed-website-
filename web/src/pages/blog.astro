---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
---

<BaseLayout
  title="Blog — TECHMED"
  description="Writing on strategy, preparation and the Builder journey."
>
  <ComingSoon
    title="The TECHMED Blog"
    description="Writing on strategy, preparation and the Builder journey is coming to this page soon."
  />
  <p class="hub-link">
    Preparing for JAMB 2027 right now? Start at the <a href="/utme-2027">UTME 2027 Hub</a>.
  </p>
</BaseLayout>

<style>
  .hub-link {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-24);
    text-align: center;
    font-size: 0.95rem;
    color: var(--text-light);
  }

  .hub-link a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .hub-link a:hover {
    text-decoration: underline;
  }
</style>
