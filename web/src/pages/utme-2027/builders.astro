---
// The UTME 2027 Builder page — the single, consolidated home for the
// Builder identity, the permanent Builders Channel, and (when active) the
// current free tutorial cohort. Previously split across this page and
// /utme-2027/builders/join; merged into one page (with a redirect from
// the old URL, see astro.config.mjs) so a student isn't routed through
// multiple pages to do one thing. Every other "Join the Builders" CTA
// sitewide points straight at the permanent Channel — this is the only
// page that also surfaces the actual current-cohort join link, since
// that's the one destination TECHMED needs to be able to change (a full
// vs. new cohort) without touching any other page on the site. See
// web/src/lib/builders.ts and studio/schemaTypes/utmeBuilderSettings.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NoteBox from '../../components/NoteBox.astro';
import BuilderManifesto from '../../components/BuilderManifesto.astro';
import { getBuilderSettings, formatDateRange } from '../../lib/builders';

const settings = await getBuilderSettings();
const tutorialDates = formatDateRange(settings.tutorialStartDate, settings.tutorialEndDate);
const showTutorial = settings.tutorialActive && settings.tutorialTitle;

const PILLARS = [
  { name: 'Understanding', copy: "Know what you're actually studying." },
  { name: 'Consistency', copy: 'Build a preparation routine you can sustain.' },
  { name: 'Practice', copy: "Turn what you learn into performance." },
  { name: 'Confidence', copy: 'See your improvement through deliberate work.' },
];

const FOUR_H = [
  {
    name: 'Honesty',
    copy: 'Be real about where you are. Ask the question you actually have — not the one you think will make you sound smart.',
  },
  {
    name: 'Humility',
    copy: 'Every Builder is still building, including the ones ahead of you. No condescension. No ego.',
  },
  {
    name: 'Hard Work',
    copy: 'Show up. Do the work. This experience rewards consistency, not talk.',
  },
  {
    name: 'Helpfulness',
    copy: "If you can help another Builder, help them. You're not competing with each other. You're competing with who you were yesterday.",
  },
];

const BUILDER_RULES = [
  'Stay on topic — UTME 2027 preparation and the tutorial.',
  'No spam or unrelated promotion.',
  'No exam malpractice or cheating content.',
  'Respect other Builders.',
  'Ask questions freely.',
  'Help when you can.',
  "Don't discourage another student because they're behind.",
];

const pageUrl = new URL('/utme-2027/builders', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'UTME 2027 Builders — TECHMED',
    url: pageUrl,
    description:
      "The UTME 2027 Builder identity, the permanent Builders Channel, and TECHMED's free UTME 2027 tutorial experience.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'UTME 2027', item: new URL('/utme-2027', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: 'Builders', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="UTME 2027 Builders — Free Preparation & Tutorials | TECHMED"
  description="Join the UTME 2027 Builders: TECHMED's free preparation identity and community for UTME 2027 candidates, including the free UTME 2027 tutorial experience."
  jsonLd={jsonLd}
  smoothScroll
>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">UTME 2027</p>
      <h1>BUILT TO LAST.</h1>
      <p class="lede">
        Preparing for UTME isn't about being perfect from day one. It's about building a
        preparation you can keep showing up for.
      </p>
      <div class="hero-ctas">
        <a class="btn-primary" href={settings.channelUrl} target="_blank" rel="noopener">Join the Builders</a>
      </div>
    </div>
  </section>

  <!-- 2. WHAT IS A BUILDER? -->
  <section class="what-is">
    <SectionHeading eyebrow="The Identity" title="Who Is a Builder?" align="center" />
    <p class="what-is-lede">
      A Builder is a student who has decided to start preparing deliberately. You don't need to
      have everything figured out. You need to be willing to build.
    </p>
    <div class="pillar-grid">
      {PILLARS.map((pillar) => (
        <div class="pillar reveal">
          <h3>{pillar.name}</h3>
          <p>{pillar.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. FOLLOW THE BUILDERS -->
  <section class="channel reveal">
    <div class="channel-inner">
      <SectionHeading eyebrow="Stay Connected" title="Follow the Builders" align="center" />
      <p class="channel-copy">
        The official {settings.channelLabel} is where TECHMED shares updates, useful preparation
        content, resources, announcements and important information throughout the journey — open
        to every student, independent of any tutorial cohort.
      </p>
      <a class="text-link-dark" href={settings.channelUrl} target="_blank" rel="noopener">Open the Builders Channel <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- 4. FREE UTME 2027 TUTORIAL + JOIN THE COHORT -->
  {showTutorial && (
    <section class="tutorial reveal">
      <div class="tutorial-header">
        <p class="eyebrow">Current Builder Experience</p>
        <h2>{settings.tutorialTitle}</h2>
        {tutorialDates && <p class="tutorial-dates">{tutorialDates}</p>}
        <p class="tutorial-copy">{settings.tutorialDescription}</p>
      </div>

      <div class="tutorial-modules">
        <div class="module">
          <h3>What the Cohort Is For</h3>
          <p class="module-copy">
            The Builder Cohort exists behind the free tutorial experience. Before and after
            tutorial sessions, TECHMED shares relevant challenges, updates and tips from the Blog
            directly in the group — kept focused, not a flood of information.
          </p>
        </div>

        <div class="module">
          <h3>The 4H Builder Standard</h3>
          <div class="four-h-grid">
            {FOUR_H.map((item) => (
              <div class="four-h-item">
                <h4>{item.name}</h4>
                <p>{item.copy}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="module">
          <h3>Builder Rules</h3>
          <p class="rules-intro">To keep the classroom useful for everyone:</p>
          <ul class="rules-list">
            {BUILDER_RULES.map((rule) => <li>{rule}</li>)}
          </ul>
        </div>
      </div>

      <div class="tutorial-join">
        {settings.joinUrl ? (
          <a class="btn-primary" href={settings.joinUrl} target="_blank" rel="noopener">Join Builder Cohort</a>
        ) : (
          <div class="join-pending">
            <NoteBox>
              <strong>The current cohort link is being prepared.</strong> Follow the Builders
              Channel above and we'll let you know the moment it's ready.
            </NoteBox>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 5. BUILDER MANIFESTO -->
  <BuilderManifesto />
</BaseLayout>

<style>
  section {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  .btn-primary {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 15px 30px;
    border-radius: var(--radius);
    text-decoration: none;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.35);
  }

  /* 1. Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
    padding: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black 30%, transparent 75%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-6) var(--space-16);
    text-align: center;
  }

  h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 2. What Is a Builder */
  .what-is-lede {
    max-width: 620px;
    margin: 0 auto var(--space-10);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-light);
    text-align: center;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .pillar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .pillar:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .pillar h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .pillar p {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.6;
  }

  /* 3. Follow the Builders */
  .channel {
    max-width: 100%;
    background: var(--surface-dark);
  }

  .channel-inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .channel-copy {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-light-on-dark-surface);
    margin-bottom: var(--space-6);
  }

  .channel :global(.section-heading h2),
  .channel :global(.section-heading .subtitle) {
    color: var(--text-on-dark-surface);
  }

  .text-link-dark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
  }

  .text-link-dark:hover {
    text-decoration: underline;
  }

  /* 4. Tutorial */
  .tutorial {
    max-width: 900px;
  }

  .tutorial-header {
    max-width: 620px;
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .tutorial-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .tutorial-dates {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.03em;
    color: var(--accent-text);
    margin-bottom: var(--space-5);
  }

  .tutorial-copy {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-light);
  }

  /* Each part of the cohort experience (what it's for, the standard, the
     rules) gets its own bounded card — previously all three ran straight
     into each other as one continuous block of text with only heading
     size to tell them apart, which read as cramped and hard to scan. */
  .tutorial-modules {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
    margin: 0 auto;
  }

  .module {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: left;
  }

  .module h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .module-copy {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-light);
    text-align: center;
    max-width: 56ch;
    margin: 0 auto;
  }

  .four-h-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .four-h-item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .four-h-item h4 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .four-h-item p {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-light);
  }

  .rules-intro {
    text-align: center;
    font-size: 0.92rem;
    color: var(--text-light);
    margin-bottom: var(--space-5);
  }

  .rules-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 480px;
    margin: 0 auto;
  }

  .rules-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-light);
  }

  .rules-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tutorial-join {
    margin-top: var(--space-10);
    text-align: center;
  }

  .join-pending {
    max-width: 480px;
    margin: 0 auto;
    text-align: left;
  }

  @media (max-width: 700px) {
    .pillar-grid {
      grid-template-columns: 1fr 1fr;
    }

    .four-h-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }

    .module {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
