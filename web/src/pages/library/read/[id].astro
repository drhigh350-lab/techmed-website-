---
// TECHMED protected PDF reader.
//
// Renders the ORIGINAL PDF page by page (pdf.js → canvas). Nothing is ever
// converted to text, so diagrams, layout and typography stay exactly as
// designed. Paid books are delivered by the reader-file Edge Function only
// to signed-in, entitled students, then saved (encrypted) on the device so
// they open again with no data — see src/lib/offlineBooks.ts.
import { getResources, FALLBACK_RESOURCES, type Resource } from '../../../lib/resources';

export async function getStaticPaths() {
  const live = await getResources();
  const all = new Map<string, Resource>();
  for (const r of [...FALLBACK_RESOURCES, ...live]) {
    all.set(r.id, r);
  }
  const paths: { params: { id: string }; props: { resource: Resource } }[] = [];
  const seen = new Set<string>();
  for (const r of all.values()) {
    for (const key of [r.id, r.slug]) {
      if (key && !seen.has(key)) {
        seen.add(key);
        paths.push({ params: { id: key }, props: { resource: r } });
      }
    }
  }
  // Legacy short links that were shared before.
  const aliases: Record<string, string> = {
    'chem-boost-2026': 'chemistry-booster',
    'bio-boost-2026': 'biology-booster',
    'phys-boost-2026': 'physics-booster',
    'admission-guide': 'admission-intelligence-guide-2026',
  };
  for (const [alias, target] of Object.entries(aliases)) {
    const r = all.get(target);
    if (r && !seen.has(alias)) {
      seen.add(alias);
      paths.push({ params: { id: alias }, props: { resource: r } });
    }
  }
  return paths;
}

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;

// The original booster systems carry a faint TECHMED mark. New Think Smart
// e-books are watermarked by the author inside the PDF itself.
const WATERMARKED = ['chemistry-booster', 'biology-booster', 'physics-booster'];

const isPublicPdf = resource.status === 'free' && !!resource.accessUrl && resource.accessUrl.endsWith('.pdf');
const config = {
  id: resource.id,
  slug: resource.slug,
  title: resource.title,
  isFree: resource.status === 'free',
  publicPdfUrl: isPublicPdf ? resource.accessUrl : null,
  isReadable: isPublicPdf || resource.deliveryFormat === 'PDF eBook',
  watermark: WATERMARKED.includes(resource.id),
  detailUrl: `/resources/${resource.slug}`,
  cover: resource.primaryImage ?? null,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#012748" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>{resource.title} — TECHMED Reader</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body data-theme="light">
    <div id="app" class="reader" data-config={JSON.stringify(config)}>
      <header class="topbar">
        <a class="icon-btn" href="/resources#my-library" aria-label="Back to my library">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </a>
        <div class="title-wrap">
          <h1 class="book-title">{resource.title}</h1>
          <span id="statusChip" class="status-chip" hidden></span>
        </div>
        <button id="menuBtn" class="icon-btn" type="button" aria-label="Reader options" aria-haspopup="dialog" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg>
        </button>
      </header>

      <div id="partsBar" class="parts-bar" hidden>
        <label for="partSelect">Section</label>
        <select id="partSelect"></select>
      </div>

      <main id="stage" class="stage" aria-live="polite">
        <div id="message" class="message">
          <div class="spinner" aria-hidden="true"></div>
          <p id="messageText">Opening your book…</p>
          <div id="progressWrap" class="progress" hidden><div id="progressBar"></div></div>
          <p id="messageSub" class="sub"></p>
          <div id="messageActions" class="actions"></div>
        </div>
        <div id="pages" class="pages" hidden></div>
      </main>

      <footer id="bottombar" class="bottombar" hidden>
        <button id="zoomOut" class="pill-btn" type="button" aria-label="Smaller (A minus)">A−</button>
        <button id="pageBtn" class="page-indicator" type="button" aria-label="Go to page">
          <span id="pageNow">1</span> / <span id="pageTotal">1</span>
        </button>
        <button id="zoomIn" class="pill-btn" type="button" aria-label="Bigger (A plus)">A+</button>
      </footer>

      <div id="sheet" class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" hidden>
        <div class="sheet-panel">
          <div class="sheet-head">
            <h2 id="sheetTitle">Reader options</h2>
            <button id="sheetClose" class="icon-btn" type="button" aria-label="Close">✕</button>
          </div>

          <section class="sheet-section" id="offlineSection">
            <h3>Read without data</h3>
            <p id="offlineText" class="muted">Save this book on this phone once. After that it opens even with data off.</p>
            <button id="offlineBtn" class="primary-btn" type="button">Save for offline reading</button>
          </section>

          <section class="sheet-section">
            <h3>Page colour</h3>
            <div class="seg" role="radiogroup" aria-label="Page colour">
              <button type="button" data-theme-btn="light" role="radio">Light</button>
              <button type="button" data-theme-btn="sepia" role="radio">Sepia</button>
              <button type="button" data-theme-btn="dark" role="radio">Dark</button>
            </div>
            <p class="muted small">Dark mode reverses page colours, so coloured diagrams may look different. Switch back to Light for diagrams.</p>
          </section>

          <section class="sheet-section">
            <h3>Go to page</h3>
            <form id="gotoForm" class="goto">
              <input id="gotoInput" type="number" inputmode="numeric" min="1" placeholder="Page" aria-label="Page number" />
              <button class="primary-btn" type="submit">Go</button>
            </form>
          </section>
        </div>
      </div>
    </div>

    <script>
      import * as pdfjsLib from 'pdfjs-dist';
      import { getSupabase, getReadingProgress, saveReadingProgress } from '../../../lib/supabase';
      import {
        saveBook,
        loadBook,
        getBookMeta,
        removeBook,
        rememberReader,
        lastReader,
        isOfflineStorageSupported,
        formatSize,
        keepPagesOffline,
        type OfflineBookMeta,
      } from '../../../lib/offlineBooks';
      import { downloadBook, checkBook, ReaderError } from '../../../lib/readerApi';
      import { parseZipArchive } from '../../../lib/zipReader';

      pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdfjs/pdf.worker.min.mjs';

      type Config = {
        id: string;
        slug: string;
        title: string;
        isFree: boolean;
        publicPdfUrl: string | null;
        isReadable: boolean;
        watermark: boolean;
        detailUrl: string;
        cover: string | null;
      };

      const app = document.getElementById('app') as HTMLElement;
      const cfg: Config = JSON.parse(app.dataset.config || '{}');
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

      const stage = $('stage');
      const pagesEl = $('pages');
      const message = $('message');
      const messageText = $('messageText');
      const messageSub = $('messageSub');
      const messageActions = $('messageActions');
      const progressWrap = $('progressWrap');
      const progressBar = $('progressBar');
      const bottombar = $('bottombar');
      const statusChip = $('statusChip');
      const partsBar = $('partsBar');
      const partSelect = $<HTMLSelectElement>('partSelect');
      const sheet = $('sheet');
      const offlineBtn = $<HTMLButtonElement>('offlineBtn');
      const offlineText = $('offlineText');

      // ---------- preferences (per device) ----------
      const PREF_KEY = 'techmed_reader_prefs';
      const ZOOMS = [0.8, 1, 1.15, 1.3, 1.5, 1.75, 2, 2.5, 3];
      let prefs = { theme: 'light', zoomIndex: 1 };
      try {
        prefs = { ...prefs, ...JSON.parse(localStorage.getItem(PREF_KEY) || '{}') };
      } catch {}
      const savePrefs = () => {
        try {
          localStorage.setItem(PREF_KEY, JSON.stringify(prefs));
        } catch {}
      };

      function applyTheme(theme: string) {
        prefs.theme = ['light', 'sepia', 'dark'].includes(theme) ? theme : 'light';
        document.body.dataset.theme = prefs.theme;
        document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]').forEach((b) => {
          b.setAttribute('aria-checked', String(b.dataset.themeBtn === prefs.theme));
        });
        savePrefs();
      }
      applyTheme(prefs.theme);

      // ---------- UI helpers ----------
      function showMessage(text: string, sub = '', actions: { label: string; href?: string; onClick?: () => void; primary?: boolean }[] = [], spinning = false) {
        message.hidden = false;
        pagesEl.hidden = true;
        bottombar.hidden = true;
        messageText.textContent = text;
        messageSub.textContent = sub;
        (message.querySelector('.spinner') as HTMLElement).hidden = !spinning;
        progressWrap.hidden = true;
        messageActions.innerHTML = '';
        for (const a of actions) {
          const el = document.createElement(a.href ? 'a' : 'button');
          el.className = a.primary ? 'primary-btn' : 'ghost-btn';
          el.textContent = a.label;
          if (a.href) (el as HTMLAnchorElement).href = a.href;
          if (a.onClick) el.addEventListener('click', a.onClick);
          messageActions.appendChild(el);
        }
      }

      function showProgress(fraction: number | null, received: number) {
        progressWrap.hidden = false;
        progressBar.style.width = fraction == null ? '35%' : `${Math.round(fraction * 100)}%`;
        progressBar.classList.toggle('indeterminate', fraction == null);
        messageSub.textContent =
          fraction == null ? `${formatSize(received)} downloaded` : `${Math.round(fraction * 100)}% · ${formatSize(received)}`;
      }

      function setChip(text: string, kind: 'ok' | 'info' | 'warn') {
        statusChip.hidden = false;
        statusChip.textContent = text;
        statusChip.className = `status-chip ${kind}`;
      }

      // ---------- identity ----------
      let userId: string | null = null;
      let userEmail: string | null = null;
      let savedMeta: OfflineBookMeta | null = null;

      async function resolveUser() {
        try {
          const { data } = await getSupabase().auth.getSession();
          const u = data.session?.user;
          if (u) {
            userId = u.id;
            userEmail = u.email ?? null;
            rememberReader({ id: u.id, email: u.email });
            return;
          }
        } catch {}
        // Offline with an expired session: fall back to the last signed-in reader
        // on this device. Saved books are encrypted with that reader's key.
        if (!navigator.onLine) {
          const last = lastReader();
          if (last) {
            userId = last.id;
            userEmail = last.email;
          }
        }
      }

      // ---------- PDF rendering ----------
      let pdfDoc: any = null;
      let pageSizes: { w: number; h: number }[] = [];
      let currentPage = 1;
      let documentKey = '';
      const rendered = new Map<number, { canvas: HTMLCanvasElement; task: any; scale: number }>();
      let observer: IntersectionObserver | null = null;
      let logo: HTMLImageElement | null = null;

      if (cfg.watermark) {
        logo = new Image();
        logo.src = '/images/logo.png';
      }

      function fitWidth(): number {
        return Math.min(stage.clientWidth - 16, 980);
      }

      function cssScaleFor(pageNum: number): number {
        const size = pageSizes[pageNum - 1];
        return (fitWidth() / size.w) * ZOOMS[prefs.zoomIndex];
      }

      function layoutPages() {
        pagesEl.innerHTML = '';
        rendered.clear();
        observer?.disconnect();
        observer = new IntersectionObserver(onIntersect, { root: stage, rootMargin: '150% 0px' });
        for (let i = 1; i <= pageSizes.length; i++) {
          const s = cssScaleFor(i);
          const holder = document.createElement('div');
          holder.className = 'page';
          holder.dataset.page = String(i);
          holder.style.width = `${Math.floor(pageSizes[i - 1].w * s)}px`;
          holder.style.height = `${Math.floor(pageSizes[i - 1].h * s)}px`;
          holder.setAttribute('aria-label', `Page ${i}`);
          pagesEl.appendChild(holder);
          observer.observe(holder);
        }
        pagesEl.classList.toggle('zoomed', ZOOMS[prefs.zoomIndex] > 1);
      }

      function onIntersect(entries: IntersectionObserverEntry[]) {
        for (const e of entries) {
          const n = Number((e.target as HTMLElement).dataset.page);
          if (e.isIntersecting) renderPage(n, e.target as HTMLElement);
          else unrenderPage(n, e.target as HTMLElement);
        }
      }

      async function renderPage(n: number, holder: HTMLElement) {
        const scale = cssScaleFor(n);
        const existing = rendered.get(n);
        if (existing && existing.scale === scale) return;
        if (existing) unrenderPage(n, holder);
        const page = await pdfDoc.getPage(n);
        const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
        const viewport = page.getViewport({ scale: scale * dpr });
        const canvas = document.createElement('canvas');
        canvas.width = Math.floor(viewport.width);
        canvas.height = Math.floor(viewport.height);
        canvas.setAttribute('role', 'img');
        canvas.setAttribute('aria-label', `Page ${n} of ${pageSizes.length}`);
        const ctx = canvas.getContext('2d', { alpha: false })!;
        const task = page.render({ canvasContext: ctx, viewport });
        rendered.set(n, { canvas, task, scale });
        try {
          await task.promise;
        } catch {
          return; // cancelled (scrolled away or zoom changed)
        }
        if (rendered.get(n)?.canvas !== canvas) return;
        if (cfg.watermark && logo?.complete && logo.naturalWidth) {
          const w = canvas.width * 0.28;
          const h = (logo.naturalHeight / logo.naturalWidth) * w;
          ctx.globalAlpha = 0.05;
          ctx.drawImage(logo, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h);
          ctx.globalAlpha = 1;
        }
        holder.replaceChildren(canvas);
      }

      function unrenderPage(n: number, holder: HTMLElement) {
        const r = rendered.get(n);
        if (!r) return;
        try {
          r.task.cancel();
        } catch {}
        r.canvas.width = 0;
        r.canvas.height = 0;
        rendered.delete(n);
        holder.replaceChildren();
      }

      function scrollToPage(n: number, smooth = false) {
        const el = pagesEl.querySelector<HTMLElement>(`[data-page="${n}"]`);
        if (el) stage.scrollTo({ top: el.offsetTop - 8, behavior: smooth ? 'smooth' : 'auto' });
      }

      let progressTimer: number | undefined;
      function trackCurrentPage() {
        const mid = stage.scrollTop + stage.clientHeight * 0.35;
        const holders = pagesEl.children;
        let lo = 0;
        let hi = holders.length - 1;
        while (lo < hi) {
          const m = (lo + hi + 1) >> 1;
          if ((holders[m] as HTMLElement).offsetTop <= mid) lo = m;
          else hi = m - 1;
        }
        const n = lo + 1;
        if (n !== currentPage) {
          currentPage = n;
          $('pageNow').textContent = String(n);
          window.clearTimeout(progressTimer);
          progressTimer = window.setTimeout(persistProgress, 1500);
        }
      }

      function persistProgress() {
        if (!pdfDoc) return;
        saveReadingProgress(
          {
            resourceId: cfg.id,
            documentKey,
            currentPage,
            totalPages: pageSizes.length,
            isFinished: currentPage >= pageSizes.length,
          },
          userId ? { id: userId, email: userEmail ?? undefined } : null,
        ).catch(() => {});
      }

      async function openPdf(data: ArrayBuffer, key: string) {
        documentKey = key;
        if (pdfDoc) {
          try {
            await pdfDoc.destroy();
          } catch {}
        }
        // pdf.js may transfer the buffer to its worker: give it a copy so the
        // original stays usable for saving/switching sections.
        pdfDoc = await pdfjsLib.getDocument({ data: new Uint8Array(data.slice(0)), isEvalSupported: false }).promise;
        pageSizes = [];
        for (let i = 1; i <= pdfDoc.numPages; i++) {
          const p = await pdfDoc.getPage(i);
          const v = p.getViewport({ scale: 1 });
          pageSizes.push({ w: v.width, h: v.height });
        }
        $('pageTotal').textContent = String(pageSizes.length);
        message.hidden = true;
        pagesEl.hidden = false;
        bottombar.hidden = false;
        layoutPages();

        const saved = await getReadingProgress(cfg.id, documentKey, userId ? { id: userId, email: userEmail ?? undefined } : null).catch(() => null);
        currentPage = 1;
        $('pageNow').textContent = '1';
        if (saved && saved.currentPage > 1 && saved.currentPage <= pageSizes.length) {
          requestAnimationFrame(() => scrollToPage(saved.currentPage));
        }
      }

      // ---------- ZIP (legacy booster systems: several PDFs in one file) ----------
      async function openFile(bytes: ArrayBuffer, fileType: 'pdf' | 'zip') {
        if (fileType === 'pdf') {
          partsBar.hidden = true;
          await openPdf(bytes, '');
          return;
        }
        const archive = await parseZipArchive(bytes);
        const pdfs = archive.pdfEntries;
        if (!pdfs.length) throw new Error('No PDF found in this book file.');
        partsBar.hidden = pdfs.length < 2;
        partSelect.innerHTML = '';
        pdfs.forEach((entry, i) => {
          const opt = document.createElement('option');
          opt.value = String(i);
          opt.textContent = entry.cleanName.replace(/^.*\//, '').replace(/\.pdf$/i, '').replace(/[_-]+/g, ' ');
          partSelect.appendChild(opt);
        });
        const openPart = async (i: number) => {
          const data = await archive.extractEntry(pdfs[i]);
          await openPdf(data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength) as ArrayBuffer, pdfs[i].cleanName);
          stage.scrollTop = 0;
        };
        partSelect.onchange = () => openPart(Number(partSelect.value));
        await openPart(0);
      }

      // ---------- offline save state ----------
      function renderOfflineState() {
        if (!isOfflineStorageSupported()) {
          offlineText.textContent = 'This browser cannot save books for offline reading. Try Chrome.';
          offlineBtn.hidden = true;
          return;
        }
        if (savedMeta) {
          setChip('Saved offline', 'ok');
          offlineText.textContent = `Saved on this phone (${formatSize(savedMeta.size)}). It opens without data.`;
          offlineBtn.textContent = 'Remove from this phone';
          offlineBtn.className = 'ghost-btn';
        } else {
          setChip(navigator.onLine ? 'Online' : 'Offline', navigator.onLine ? 'info' : 'warn');
          offlineText.textContent = 'Save this book on this phone once. After that it opens even with data off.';
          offlineBtn.textContent = 'Save for offline reading';
          offlineBtn.className = 'primary-btn';
        }
      }

      let lastFile: { bytes: ArrayBuffer; fileType: 'pdf' | 'zip'; version: string } | null = null;

      async function saveCurrentOffline() {
        if (!userId || !lastFile) return;
        offlineBtn.disabled = true;
        offlineBtn.textContent = 'Saving…';
        try {
          savedMeta = await saveBook(
            { userId, resourceId: cfg.id, title: cfg.title, fileType: lastFile.fileType, version: lastFile.version },
            lastFile.bytes,
          );
          void keepPagesOffline([location.pathname, '/resources/']);
        } catch (err) {
          console.warn('Offline save failed', err);
          offlineText.textContent = 'Could not save. Your phone may be low on storage.';
        } finally {
          offlineBtn.disabled = false;
          renderOfflineState();
        }
      }

      offlineBtn.addEventListener('click', async () => {
        if (savedMeta && userId) {
          if (!confirm('Remove this book from this phone? You can save it again any time (uses data).')) return;
          await removeBook(userId, cfg.id);
          savedMeta = null;
          renderOfflineState();
        } else {
          await saveCurrentOffline();
        }
      });

      // ---------- main flow ----------
      async function start() {
        if (!cfg.isReadable) {
          showMessage('This resource opens outside the reader.', '', [{ label: 'View details', href: cfg.detailUrl, primary: true }]);
          return;
        }

        // Free public guides: no account needed.
        if (cfg.publicPdfUrl) {
          showMessage('Opening your book…', '', [], true);
          try {
            const res = await fetch(cfg.publicPdfUrl);
            const bytes = await res.arrayBuffer();
            await openFile(bytes, 'pdf');
            $('offlineSection').hidden = true;
            setChip('Free guide', 'info');
          } catch {
            showMessage('Could not open this guide.', 'Check your connection and try again.', [
              { label: 'Try again', onClick: () => location.reload(), primary: true },
            ]);
          }
          return;
        }

        await resolveUser();
        if (!userId) {
          showMessage('Sign in to read your book', 'Use the same email you paid with or enrolled with.', [
            { label: 'Sign in', href: `/login?redirect=${encodeURIComponent(location.pathname)}`, primary: true },
            { label: 'About this book', href: cfg.detailUrl },
          ]);
          return;
        }

        // 1. Saved on this phone? Open instantly, no data used.
        savedMeta = await getBookMeta(userId, cfg.id);
        if (savedMeta) {
          showMessage('Opening your saved book…', 'No data needed', [], true);
          try {
            const local = await loadBook(userId, cfg.id);
            if (local) {
              lastFile = { bytes: local.bytes, fileType: local.meta.fileType, version: local.meta.version };
              await openFile(local.bytes, local.meta.fileType);
              renderOfflineState();
              if (navigator.onLine) {
                revalidateSaved();
                void keepPagesOffline([location.pathname, '/resources/']);
              }
              return;
            }
          } catch (err) {
            console.warn('Saved copy unreadable; downloading again', err);
            savedMeta = null;
          }
        }

        // 2. Not saved: download once (needs data), then keep it.
        if (!navigator.onLine) {
          showMessage('You are offline', "This book isn't saved on this phone yet. Connect once to download it. After that it opens without data.", [
            { label: 'Try again', onClick: () => location.reload(), primary: true },
          ]);
          return;
        }

        showMessage('Downloading your book…', 'This happens once. It will then be saved on this phone.', [], false);
        try {
          const file = await downloadBook(cfg.id, showProgress);
          lastFile = file;
          await openFile(file.bytes, file.fileType);
          // Reading once = saved: students never pay data twice for a book they own.
          if (isOfflineStorageSupported()) await saveCurrentOffline();
          renderOfflineState();
        } catch (err) {
          handleError(err);
        }
      }

      // When online, make sure a saved copy is still allowed and up to date.
      async function revalidateSaved() {
        if (!userId || !savedMeta) return;
        try {
          const info = await checkBook(cfg.id);
          if (info.version && savedMeta.version && info.version !== savedMeta.version) {
            setChip('Update available', 'info');
            offlineText.textContent = 'A newer edition of this book is available.';
            offlineBtn.textContent = 'Download update';
            offlineBtn.className = 'primary-btn';
            offlineBtn.onclick = async (e) => {
              e.stopImmediatePropagation();
              offlineBtn.disabled = true;
              const file = await downloadBook(cfg.id);
              lastFile = file;
              await saveCurrentOffline();
              location.reload();
            };
          }
        } catch (err) {
          if (err instanceof ReaderError && err.code === 'not_entitled') {
            await removeBook(userId, cfg.id);
            savedMeta = null;
            showMessage('Your access to this book has ended.', 'The saved copy was removed from this phone.', [
              { label: 'View book', href: cfg.detailUrl, primary: true },
            ]);
          }
        }
      }

      function handleError(err: unknown) {
        const code = err instanceof ReaderError ? err.code : 'failed';
        if (code === 'not_entitled') {
          showMessage("You don't have this book yet", 'Buy it once and it stays in your library for life.', [
            { label: 'Get this book', href: cfg.detailUrl, primary: true },
            { label: 'My library', href: '/resources#my-library' },
          ]);
        } else if (code === 'sign_in_required') {
          showMessage('Please sign in again', '', [
            { label: 'Sign in', href: `/login?redirect=${encodeURIComponent(location.pathname)}`, primary: true },
          ]);
        } else if (code === 'file_not_uploaded') {
          showMessage('Your book is on its way', "It's in your library and will open here as soon as TECHMED uploads it. You don't need to buy it again.", [
            { label: 'My library', href: '/resources#my-library', primary: true },
          ]);
        } else if (code === 'offline') {
          showMessage('Connection lost', 'Reconnect once to download this book.', [
            { label: 'Try again', onClick: () => location.reload(), primary: true },
          ]);
        } else {
          showMessage('Something went wrong opening this book.', 'Please try again. If it keeps happening, contact TECHMED on WhatsApp.', [
            { label: 'Try again', onClick: () => location.reload(), primary: true },
          ]);
        }
      }

      // ---------- controls ----------
      function setZoom(index: number) {
        const next = Math.max(0, Math.min(ZOOMS.length - 1, index));
        if (next === prefs.zoomIndex || !pdfDoc) return;
        const keep = currentPage;
        prefs.zoomIndex = next;
        savePrefs();
        layoutPages();
        scrollToPage(keep);
        ($('zoomOut') as HTMLButtonElement).disabled = next === 0;
        ($('zoomIn') as HTMLButtonElement).disabled = next === ZOOMS.length - 1;
      }
      $('zoomIn').addEventListener('click', () => setZoom(prefs.zoomIndex + 1));
      $('zoomOut').addEventListener('click', () => setZoom(prefs.zoomIndex - 1));

      stage.addEventListener('scroll', () => requestAnimationFrame(trackCurrentPage), { passive: true });

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          if (!pdfDoc) return;
          const keep = currentPage;
          layoutPages();
          scrollToPage(keep);
        }, 250);
      });

      const openSheet = () => {
        sheet.hidden = false;
        $('menuBtn').setAttribute('aria-expanded', 'true');
        ($('gotoInput') as HTMLInputElement).max = String(pageSizes.length || 1);
      };
      const closeSheet = () => {
        sheet.hidden = true;
        $('menuBtn').setAttribute('aria-expanded', 'false');
      };
      $('menuBtn').addEventListener('click', openSheet);
      $('pageBtn').addEventListener('click', () => {
        openSheet();
        ($('gotoInput') as HTMLInputElement).focus();
      });
      $('sheetClose').addEventListener('click', closeSheet);
      sheet.addEventListener('click', (e) => {
        if (e.target === sheet) closeSheet();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSheet();
      });
      document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]').forEach((b) =>
        b.addEventListener('click', () => applyTheme(b.dataset.themeBtn || 'light')),
      );
      $('gotoForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const n = Number(($('gotoInput') as HTMLInputElement).value);
        if (n >= 1 && n <= pageSizes.length) {
          closeSheet();
          scrollToPage(n);
        }
      });

      // Light deterrents only (no web page can fully block copying).
      pagesEl.addEventListener('contextmenu', (e) => e.preventDefault());
      pagesEl.addEventListener('dragstart', (e) => e.preventDefault());

      window.addEventListener('online', renderOfflineState);
      window.addEventListener('offline', renderOfflineState);
      window.addEventListener('pagehide', persistProgress);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') persistProgress();
      });

      start();
    </script>

    <style is:global>
      :root {
        --navy: #012748;
        --blue: #09476e;
        --soft: #98b0c4;
        --white: #f8f9fa;
        --gold: #c9a227;
        --page-bg: #e9eef3;
        --bar-bg: #012748;
        --bar-text: #f8f9fa;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--page-bg);
        font-family: 'Source Sans 3', system-ui, sans-serif;
        color: var(--navy);
        -webkit-tap-highlight-color: transparent;
      }
      body[data-theme='sepia'] {
        --page-bg: #e8dcc4;
      }
      body[data-theme='dark'] {
        --page-bg: #0b1520;
        color: var(--white);
      }
      [hidden] {
        display: none !important;
      }
      .reader {
        display: flex;
        flex-direction: column;
        height: 100dvh;
      }
      .topbar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 8px;
        padding-top: max(8px, env(safe-area-inset-top));
        background: var(--bar-bg);
        color: var(--bar-text);
      }
      .title-wrap {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .book-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .status-chip {
        flex-shrink: 0;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(152, 176, 196, 0.2);
      }
      .status-chip.ok {
        background: rgba(201, 162, 39, 0.22);
        color: #f1d77e;
      }
      .status-chip.warn {
        background: rgba(239, 68, 68, 0.22);
        color: #fecaca;
      }
      .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        text-decoration: none;
        font-size: 1.1rem;
      }
      .icon-btn:hover,
      .icon-btn:focus-visible {
        background: rgba(255, 255, 255, 0.1);
      }
      .parts-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: var(--blue);
        color: var(--white);
        font-size: 0.85rem;
        font-weight: 600;
      }
      .parts-bar select {
        flex: 1;
        min-width: 0;
        padding: 8px;
        border-radius: 8px;
        border: 0;
        font: inherit;
        color: var(--navy);
      }
      .stage {
        flex: 1;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
      }
      .pages {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 8px 8px 24px;
        width: max-content;
        min-width: 100%;
      }
      .page {
        background: #fff;
        box-shadow: 0 2px 10px rgba(1, 39, 72, 0.15);
        flex-shrink: 0;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
      }
      .page canvas {
        display: block;
        width: 100%;
        height: 100%;
      }
      body[data-theme='sepia'] .page canvas {
        filter: sepia(0.35) saturate(1.1) brightness(0.97);
      }
      body[data-theme='dark'] .page {
        background: #111;
      }
      body[data-theme='dark'] .page canvas {
        filter: invert(0.9) hue-rotate(180deg);
      }
      .message {
        max-width: 420px;
        margin: 12vh auto 0;
        padding: 24px;
        text-align: center;
      }
      .message p {
        margin: 8px 0;
      }
      #messageText {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 1.15rem;
      }
      .sub,
      .muted {
        color: #4b647a;
        font-size: 0.95rem;
      }
      body[data-theme='dark'] .sub,
      body[data-theme='dark'] .muted {
        color: var(--soft);
      }
      .small {
        font-size: 0.82rem;
      }
      .spinner {
        width: 36px;
        height: 36px;
        margin: 0 auto 12px;
        border-radius: 50%;
        border: 3px solid rgba(9, 71, 110, 0.2);
        border-top-color: var(--blue);
        animation: spin 0.9s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .progress {
        height: 8px;
        border-radius: 999px;
        background: rgba(9, 71, 110, 0.15);
        overflow: hidden;
        margin: 16px 0 4px;
      }
      #progressBar {
        height: 100%;
        width: 0;
        background: var(--gold);
        transition: width 0.2s;
      }
      #progressBar.indeterminate {
        animation: slide 1.2s ease-in-out infinite;
      }
      @keyframes slide {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(300%);
        }
      }
      .actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 18px;
      }
      .primary-btn,
      .ghost-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 10px 18px;
        border-radius: 12px;
        font: 700 0.95rem 'Montserrat', sans-serif;
        text-decoration: none;
        cursor: pointer;
        border: 2px solid transparent;
      }
      .primary-btn {
        background: var(--gold);
        color: #1a1400;
      }
      .ghost-btn {
        background: transparent;
        color: inherit;
        border-color: rgba(9, 71, 110, 0.35);
      }
      .primary-btn:disabled {
        opacity: 0.6;
      }
      .bottombar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 12px;
        padding-bottom: max(8px, env(safe-area-inset-bottom));
        background: var(--bar-bg);
        color: var(--bar-text);
      }
      .pill-btn {
        min-width: 64px;
        height: 44px;
        border-radius: 12px;
        border: 1px solid rgba(152, 176, 196, 0.4);
        background: rgba(255, 255, 255, 0.06);
        color: inherit;
        font: 800 1.05rem 'Montserrat', sans-serif;
        cursor: pointer;
      }
      .pill-btn:disabled {
        opacity: 0.35;
      }
      .page-indicator {
        flex: 1;
        height: 44px;
        border: 0;
        background: transparent;
        color: inherit;
        font: 700 1rem 'Montserrat', sans-serif;
        cursor: pointer;
      }
      .sheet {
        position: fixed;
        inset: 0;
        background: rgba(1, 20, 37, 0.55);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        z-index: 10;
      }
      .sheet-panel {
        width: 100%;
        max-width: 520px;
        max-height: 85dvh;
        overflow: auto;
        background: var(--white);
        color: var(--navy);
        border-radius: 18px 18px 0 0;
        padding: 8px 18px max(18px, env(safe-area-inset-bottom));
      }
      .sheet-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .sheet-head h2 {
        font: 800 1.05rem 'Montserrat', sans-serif;
        margin: 0;
      }
      .sheet-section {
        padding: 12px 0;
        border-top: 1px solid rgba(9, 71, 110, 0.12);
      }
      .sheet-section h3 {
        font: 700 0.9rem 'Montserrat', sans-serif;
        margin: 0 0 6px;
      }
      .sheet-section .primary-btn,
      .sheet-section .ghost-btn {
        width: 100%;
        margin-top: 6px;
      }
      .seg {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
      }
      .seg button {
        min-height: 44px;
        border-radius: 10px;
        border: 2px solid rgba(9, 71, 110, 0.2);
        background: #fff;
        font: 700 0.9rem 'Source Sans 3', sans-serif;
        cursor: pointer;
        color: var(--navy);
      }
      .seg button[data-theme-btn='sepia'] {
        background: #f1e6cf;
      }
      .seg button[data-theme-btn='dark'] {
        background: #1b2733;
        color: #f8f9fa;
      }
      .seg button[aria-checked='true'] {
        border-color: var(--gold);
        box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.35);
      }
      .goto {
        display: flex;
        gap: 8px;
      }
      .goto input {
        flex: 1;
        min-height: 46px;
        border-radius: 10px;
        border: 1px solid rgba(9, 71, 110, 0.3);
        padding: 0 12px;
        font: inherit;
        font-size: 1rem;
      }
      .goto .primary-btn {
        width: auto;
        margin: 0;
      }
      @media print {
        body * {
          display: none !important;
        }
      }
    </style>
  </body>
</html>
