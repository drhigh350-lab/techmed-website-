  // 3. In-Memory ZIP Archive Reader for Bundles
  async function loadAndRenderZipBundle(zipUrl: string) {
    try {
      if (pdfViewerStage) pdfViewerStage.style.display = 'block';
      if (pdfLoadingBox) pdfLoadingBox.style.display = 'flex';
      if (pdfLoadingStatus) pdfLoadingStatus.textContent = 'Extracting bundle archive in memory...';

      const res = await fetch(zipUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}: Failed to download ZIP bundle.`);
      const arrayBuffer = await res.arrayBuffer();

      const archive = await parseZipArchive(arrayBuffer);

      if (bundleExplorerSection) {
        bundleExplorerSection.style.display = 'block';
        if (bundleExplorerTitle) bundleExplorerTitle.textContent = `${RESOURCE.title} (ZIP Archive)`;
        if (bundleExplorerDesc) {
          bundleExplorerDesc.textContent = `Contains ${archive.entries.length} extracted files. Read any PDF document below directly in the embedded reader:`;
        }
        if (bundleItemsList) {
          bundleItemsList.innerHTML = '';
          archive.entries.forEach((entry) => {
            const card = document.createElement('div');
            card.className = 'bundle-item-card unlocked';
            card.innerHTML = `
              <div class="bundle-item-header">
                <span class="bundle-type-pill">${entry.isPdf ? 'PDF Document' : entry.mimeType}</span>
                <span class="bundle-subject-tag">${entry.formattedSize}</span>
              </div>
              <h3 class="bundle-item-title">${entry.cleanName}</h3>
              <div class="bundle-item-footer">
                ${entry.isPdf ? `
                  <button type="button" class="btn-primary bundle-read-action zip-pdf-extract-btn" data-file-name="${entry.fileName}">
                    Open PDF in Reader &rarr;
                  </button>
                ` : `
                  <span class="text-muted" style="font-size: 13px;">Supplementary Document</span>
                `}
              </div>
            `;
            bundleItemsList.appendChild(card);
          });

          // Bind click to in-memory extraction
          const extractBtns = bundleItemsList.querySelectorAll('.zip-pdf-extract-btn');
          extractBtns.forEach((btn) => {
            btn.addEventListener('click', async () => {
              const fname = btn.getAttribute('data-file-name');
              const entry = archive.entries.find((e) => e.fileName === fname);
              if (entry) {
                btn.textContent = 'Opening in Reader...';
                currentDocumentKey = entry.fileName;
                const blobUrl = await archive.extractPdfUrl(entry);
                isPdfMode = true;
                pdfUrl = blobUrl;
                await loadAndRenderPdf(blobUrl);
              }
            });
          });
        }
      }

      if (pdfLoadingBox) pdfLoadingBox.style.display = 'none';

      // If the archive has PDFs, automatically render the first PDF into the reader view
      if (archive.hasPdfs && archive.pdfEntries.length > 0) {
        const firstPdf = archive.pdfEntries[0];
        currentDocumentKey = firstPdf.fileName;
        const blobUrl = await archive.extractPdfUrl(firstPdf);
        isPdfMode = true;
        pdfUrl = blobUrl;
        await loadAndRenderPdf(blobUrl);
      }
    } catch (zipErr: any) {
      console.error('ZIP bundle extraction error:', zipErr);
      if (pdfLoadingBox) pdfLoadingBox.style.display = 'none';
      if (pdfErrorBox) pdfErrorBox.style.display = 'flex';
      if (pdfErrorMessage) {
        pdfErrorMessage.textContent = `Unable to extract bundle archive: ${zipErr?.message || 'Archive error'}`;
      }
    }
  }

