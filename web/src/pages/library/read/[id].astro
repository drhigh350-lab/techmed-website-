  async function loadAndRenderPdf(url: string) {
    try {
      if (readingStage) readingStage.style.display = 'none';
      if (chapterFooterNav) (chapterFooterNav as HTMLElement).style.display = 'none';
      if (fontSwitchGroup) fontSwitchGroup.style.display = 'none';
      if (toggleOutlineBtn) toggleOutlineBtn.style.display = 'none';
      if (gatekeeperCard) gatekeeperCard.style.display = 'none';

      if (pdfViewerStage) pdfViewerStage.style.display = 'block';
      if (pdfControlsGroup) pdfControlsGroup.style.display = 'flex';
      if (pdfLoadingBox) pdfLoadingBox.style.display = 'flex';
      if (pdfErrorBox) pdfErrorBox.style.display = 'none';
      if (pdfLoadingStatus) pdfLoadingStatus.textContent = 'Loading official document...';

      pdfDoc = await pdfjsLib.getDocument({ url }).promise;
      totalPdfPages = pdfDoc.numPages;

      if (pdfTotalPages) pdfTotalPages.textContent = totalPdfPages.toString();
      if (pdfPageInput) {
        pdfPageInput.max = totalPdfPages.toString();
        pdfPageInput.value = '1';
      }
      currentPdfPageNum = 1;
      if (pdfPrevPageBtn) pdfPrevPageBtn.disabled = true;
      if (pdfNextPageBtn) pdfNextPageBtn.disabled = totalPdfPages <= 1;

      // Determine dimensions from Page 1
      const p1 = await pdfDoc.getPage(1);
      const unscaledVp = p1.getViewport({ scale: 1.0 });
      basePageWidth = unscaledVp.width || 595.28;
      basePageHeight = unscaledVp.height || 841.89;

      // Initial fit to width
      fitToWidth();

      // Build placeholders with highlight layers
      if (pdfPagesContainer) {
        pdfPagesContainer.innerHTML = '';
        for (let i = 1; i <= totalPdfPages; i++) {
          const wrapper = document.createElement('div');
          wrapper.className = 'pdf-page-wrapper';
          wrapper.id = `pdfPageWrapper-${i}`;
          wrapper.setAttribute('data-page-number', i.toString());
          wrapper.style.width = `${Math.floor(basePageWidth * currentPdfScale)}px`;
          wrapper.style.minHeight = `${Math.floor(basePageHeight * currentPdfScale)}px`;

          wrapper.innerHTML = `
            <div class="pdf-page-skeleton" id="pdfSkeleton-${i}">
              <div class="skeleton-shimmer"></div>
              <span class="skeleton-label">Loading Page ${i}...</span>
            </div>
            <canvas class="pdf-page-canvas" id="pdfCanvas-${i}"></canvas>
            <div class="pdf-highlight-layer" id="pdfHighlightLayer-${i}"></div>
          `;
          pdfPagesContainer.appendChild(wrapper);
        }

        // Setup IntersectionObserver for lazy page rendering
        if (pageObserver) pageObserver.disconnect();
        pageObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const p = parseInt(entry.target.getAttribute('data-page-number') || '1', 10);
              renderSinglePdfPage(p);
            }
          });
        }, { rootMargin: '350px 0px 350px 0px', threshold: 0.01 });

        const wrappers = pdfPagesContainer.querySelectorAll('.pdf-page-wrapper');
        wrappers.forEach((w) => pageObserver.observe(w));

        // Setup scroll observer for page counter and editable input synchronization
        if (scrollSpyObserver) scrollSpyObserver.disconnect();
        scrollSpyObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.25) {
              const p = parseInt(entry.target.getAttribute('data-page-number') || '1', 10);
              if (currentPdfPageNum !== p) {
                currentPdfPageNum = p;
                if (pdfPageInput && document.activeElement !== pdfPageInput) {
                  pdfPageInput.value = p.toString();
                }
                if (pdfPrevPageBtn) pdfPrevPageBtn.disabled = p <= 1;
                if (pdfNextPageBtn) pdfNextPageBtn.disabled = p >= totalPdfPages;

                // Dismiss resume prompt banner if student scrolls on their own
                if (p > 1) {
                  hideResumePrompt();
                }

                // Debounced persistence of actual reading position (anti-race & safe)
                scheduleProgressSave(false);
              }
            }
          });
        }, { threshold: [0.25, 0.6] });

        wrappers.forEach((w) => scrollSpyObserver.observe(w));
      }

      if (pdfLoadingBox) pdfLoadingBox.style.display = 'none';

      // Immediately render Page 1
      renderSinglePdfPage(1);

      // Phase 4: Query saved progress and display resume prompt if previous position exists
      try {
        activeSavedProgress = await getReadingProgress(RESOURCE.id, currentDocumentKey, currentUser);
        if (
          activeSavedProgress &&
          activeSavedProgress.currentPage > 1 &&
          activeSavedProgress.currentPage <= totalPdfPages
        ) {
          showResumePrompt(activeSavedProgress);
        } else {
          hideResumePrompt();
        }
      } catch (resumeErr) {
        console.warn('Notice loading resume progress:', resumeErr);
        hideResumePrompt();
      }
    } catch (loadErr: any) {
      console.error('Failed to load PDF document:', loadErr);
      if (pdfLoadingBox) pdfLoadingBox.style.display = 'none';
      if (pdfErrorBox) pdfErrorBox.style.display = 'flex';
      if (pdfErrorMessage) {
        pdfErrorMessage.textContent = loadErr?.message || 'Could not load the original document.';
      }
    }
  }

  async function renderSinglePdfPage(pageNum: number) {
    if (!pdfDoc || pageNum < 1 || pageNum > totalPdfPages) return;
    if (renderedPages.get(pageNum) || renderingPages.has(pageNum)) return;

    renderingPages.add(pageNum);

    try {
      const page = await pdfDoc.getPage(pageNum);
      const viewport = page.getViewport({ scale: currentPdfScale });
      const wrapper = document.getElementById(`pdfPageWrapper-${pageNum}`);
      const canvas = document.getElementById(`pdfCanvas-${pageNum}`) as HTMLCanvasElement | null;
      const skeleton = document.getElementById(`pdfSkeleton-${pageNum}`);

      if (!canvas || !wrapper) {
        renderingPages.delete(pageNum);
        return;
      }

      const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      const displayWidth = Math.floor(viewport.width);
      const displayHeight = Math.floor(viewport.height);

      canvas.width = Math.floor(viewport.width * dpr);
      canvas.height = Math.floor(viewport.height * dpr);
      canvas.style.width = `${displayWidth}px`;
      canvas.style.height = `${displayHeight}px`;

      wrapper.style.width = `${displayWidth}px`;
      wrapper.style.minHeight = `${displayHeight}px`;

      const ctx = canvas.getContext('2d');
      if (!ctx) {
        renderingPages.delete(pageNum);
        return;
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (renderTasks.has(pageNum)) {
        try {
          renderTasks.get(pageNum).cancel();
        } catch (e) {}
      }

      const renderTask = page.render({
        canvasContext: ctx,
        viewport: viewport,
      });
      renderTasks.set(pageNum, renderTask);

      await renderTask.promise;
      renderTasks.delete(pageNum);

      // Draw subtle TECHMED brand logo watermark directly on canvas overlay (Branding only — zero student PII)
      if (brandLogo.complete && brandLogo.naturalWidth > 0) {
        ctx.save();
        ctx.globalAlpha = currentTheme === 'light' ? 0.048 : 0.058;
        ctx.rotate((-20 * Math.PI) / 180);

        const logoSize = 120;
        const stepX = 280;
        const stepY = 240;

        for (let y = -200; y < viewport.height + 400; y += stepY) {
          for (let x = -300; x < viewport.width + 400; x += stepX) {
            ctx.drawImage(brandLogo, x, y, logoSize, logoSize);
          }
        }
        ctx.restore();
      }

      if (skeleton) skeleton.style.display = 'none';
      renderedPages.set(pageNum, true);

      // Render search highlights for this page if an active query exists
      renderPageHighlights(pageNum);
    } catch (renderErr: any) {
      if (renderErr?.name !== 'RenderingCancelledException') {
        console.warn(`Error rendering page ${pageNum}:`, renderErr);
      }
    } finally {
      renderingPages.delete(pageNum);
    }
  }

  function cleanupPdfResources() {
    renderTasks.forEach((task) => {
      try { task.cancel(); } catch (e) {}
    });
    renderTasks.clear();
    renderingPages.clear();
    renderedPages.clear();
    pageTextCache.clear();
    clearSearch();

    if (pageObserver) {
      pageObserver.disconnect();
      pageObserver = null;
    }
    if (scrollSpyObserver) {
      scrollSpyObserver.disconnect();
      scrollSpyObserver = null;
    }
    if (pdfDoc && typeof pdfDoc.destroy === 'function') {
      try { pdfDoc.destroy(); } catch (e) {}
    }
    pdfDoc = null;
  }

