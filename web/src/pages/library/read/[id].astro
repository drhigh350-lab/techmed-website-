    gatekeeperClaimMsg.style.display = 'block';
    gatekeeperClaimMsg.textContent = res.message;
    gatekeeperClaimMsg.className = `claim-message ${res.success ? 'success' : 'error'}`;

    gatekeeperClaimSubmit.disabled = false;
    gatekeeperClaimSubmit.textContent = 'Verify Access';

    if (res.success) {
      isEntitled = true;
      initAuthAndAccess();
    }
  });

  // 14. PWA Offline Caching & Connection Monitor
  const saveOfflineBtn = document.getElementById('saveOfflineBtn');
  const saveOfflineText = document.getElementById('saveOfflineText');
  const offlineNotice = document.getElementById('offlineNotice');

  function updateNetworkStatus() {
    if (!navigator.onLine) {
      if (offlineNotice) offlineNotice.style.display = 'flex';
      renderWatermark();
    } else {
      if (offlineNotice) offlineNotice.style.display = 'none';
    }
  }

  window.addEventListener('online', updateNetworkStatus);
  window.addEventListener('offline', updateNetworkStatus);
  updateNetworkStatus();

  saveOfflineBtn?.addEventListener('click', async () => {
    if (!isEntitled) {
      alert('Access Required: Full study access is required to download this manual for offline reading.');
      return;
    }

    // Session Security: Require authenticated session for paid materials before caching
    if (RESOURCE.status === 'paid' && !currentUser?.id) {
      alert('Authentication Required: Please sign in to your student account before saving licensed manuals offline.');
      return;
    }

    saveOfflineBtn.disabled = true;
    saveOfflineText.textContent = 'Saving offline...';

    try {
      if ('caches' in window) {
        // Partition cache per authenticated student to prevent cross-account data leakage
        const cacheName = currentUser?.id ? `techmed-reader-user-${currentUser.id}` : 'techmed-reader-public';
        const cache = await caches.open(cacheName);
        const res = await fetch(window.location.href);
        if (!res.ok) {
          throw new Error(`Failed to fetch manual: HTTP ${res.status}`);
        }
        await cache.put(window.location.href, res);
        saveOfflineBtn.classList.add('saved');
        saveOfflineText.textContent = '✓ Saved Offline';
      } else {
        saveOfflineText.textContent = 'Offline Not Supported';
      }
    } catch (err: any) {
      console.warn('Manual offline caching error:', err);
      saveOfflineBtn.classList.remove('saved');
      saveOfflineText.textContent = 'Save Failed';
      alert('Unable to complete offline save. Please check your storage quota and internet connection.');
    } finally {
      setTimeout(() => {
        saveOfflineBtn.disabled = false;
      }, 3000);
    }
  });

  // 15. PDF Viewer Controls Listeners (Phase 2 Zoom, Page Navigation, Search & Shortcuts)
  pdfSearchToggleBtn?.addEventListener('click', () => {
    toggleSearchBar();
  });

  pdfSearchCloseBtn?.addEventListener('click', () => {
    toggleSearchBar(false);
  });

  pdfSearchClearBtn?.addEventListener('click', () => {
    clearSearch();
    pdfSearchInput?.focus();
  });

  let searchDebounceTimer: any = null;
  pdfSearchInput?.addEventListener('input', () => {
    const val = pdfSearchInput?.value || '';
    if (pdfSearchClearBtn) {
      pdfSearchClearBtn.style.display = val.length > 0 ? 'inline-flex' : 'none';
    }
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(() => {
      executePdfSearch(val);
    }, 320);
  });

  pdfSearchInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      if (e.shiftKey) {
        goToSearchMatch(currentMatchIndex - 1);
      } else if (currentSearchQuery === (pdfSearchInput?.value.trim() || '') && searchMatches.length > 0) {
        goToSearchMatch(currentMatchIndex + 1);
      } else {
        executePdfSearch(pdfSearchInput?.value || '');
      }
    } else if (e.key === 'Escape') {
      toggleSearchBar(false);
    }
  });

  pdfSearchPrevBtn?.addEventListener('click', () => {
    goToSearchMatch(currentMatchIndex - 1);
  });

  pdfSearchNextBtn?.addEventListener('click', () => {
    goToSearchMatch(currentMatchIndex + 1);
  });

  // Page input direct navigation
  pdfPageInput?.addEventListener('change', () => {
    navigateToInputPage();
  });

  pdfPageInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      navigateToInputPage();
      pdfPageInput?.blur();
    }
  });

  // Zoom Controls Listeners
  pdfZoomInBtn?.addEventListener('click', () => {
    zoomIn();
  });

  pdfZoomOutBtn?.addEventListener('click', () => {
    zoomOut();
  });

  pdfFitWidthBtn?.addEventListener('click', () => {
    fitToWidth();
  });

  pdfFitPageBtn?.addEventListener('click', () => {
    fitToPage();
  });

  pdfPrevPageBtn?.addEventListener('click', () => {
    scrollToPage(currentPdfPageNum - 1);
  });

  pdfNextPageBtn?.addEventListener('click', () => {
    scrollToPage(currentPdfPageNum + 1);
  });

  pdfRetryBtn?.addEventListener('click', () => {
    if (pdfUrl) loadAndRenderPdf(pdfUrl);
  });

  pdfFallbackBtn?.addEventListener('click', () => {
    switchToHtmlReader();
  });

  // Global Keyboard Shortcuts for PDF Reading Mode
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!isPdfMode) return;

    // Ctrl+F or Cmd+F -> Open PDF search
    if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F')) {
      e.preventDefault();
      toggleSearchBar(true);
      return;
    }

    // Escape -> Close search if open
    if (e.key === 'Escape' && isSearchOpen) {
      e.preventDefault();
      toggleSearchBar(false);
      return;
    }

    // Avoid single-key hotkeys when typing in input/textarea
    const activeEl = document.activeElement;
    const tagName = (activeEl?.tagName || '').toLowerCase();
    if (tagName === 'input' || tagName === 'textarea') return;

    if (e.key === '+' || e.key === '=') {
      e.preventDefault();
      zoomIn();
    } else if (e.key === '-' || e.key === '_') {
      e.preventDefault();
      zoomOut();
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      scrollToPage(currentPdfPageNum - 1);
    } else if (e.key === 'ArrowRight' || e.key === 'PageDown') {
      e.preventDefault();
      scrollToPage(currentPdfPageNum + 1);
    }
  });

  // Window resize: re-render watermark and adjust fit width if in PDF mode
  window.addEventListener('resize', () => {
    renderWatermark();
    if (isPdfMode && fitMode === 'width') {
      fitToWidth();
    }
  });

  // Phase 4 Resume Prompt Buttons
  resumeContinueBtn?.addEventListener('click', () => {
    hideResumePrompt();
    if (activeSavedProgress && activeSavedProgress.currentPage > 1) {
      scrollToPage(activeSavedProgress.currentPage);
    }
  });

  resumeRestartBtn?.addEventListener('click', () => {
    hideResumePrompt();
    scrollToPage(1);
    scheduleProgressSave(true);
  });

  resumeDismissBtn?.addEventListener('click', () => {
    hideResumePrompt();
  });

  // Save progress immediately on visibility change or page exit
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      scheduleProgressSave(true);
    }
  });

  window.addEventListener('beforeunload', () => {
    scheduleProgressSave(true);
  });

  // Run on startup
  initAuthAndAccess();
</script>

