    setupBundleExperience();

    // Retrieve Secure Original PDF or ZIP Bundle
    try {
      const securePdf = await getSecureResourcePdf(RESOURCE.id, currentUser);

      // Handle ZIP bundle archive
      if (securePdf.isZip && securePdf.zipUrl && securePdf.hasAccess) {
        await loadAndRenderZipBundle(securePdf.zipUrl);
        return;
      }

      // Handle direct PDF document
      if (securePdf.isPdf && securePdf.pdfUrl && securePdf.hasAccess) {
        isPdfMode = true;
        pdfUrl = securePdf.pdfUrl;
        await loadAndRenderPdf(pdfUrl);
        return;
      }
    } catch (pdfInitErr) {
      console.warn('PDF reader initialization warning:', pdfInitErr);
    }

    // If this is a bundle product without direct single PDF, bundle explorer is already rendered
    if (RESOURCE.isBundle || RESOURCE.id === 'booster-bundle' || RESOURCE.id === 'all-science-boosters-bundle') {
      return;
    }

    // Default to HTML Reader fallback
    switchToHtmlReader();
