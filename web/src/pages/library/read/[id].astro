  // 1. Dynamic TECHMED Brand Watermark Generator (Official Logo Asset Only - Zero Student PII)
  function renderWatermark() {
    if (!watermarkCanvas) return;
    const ctx = watermarkCanvas.getContext('2d');
    if (!ctx) return;

    const dpr = window.devicePixelRatio || 1;
    const width = window.innerWidth;
    const height = Math.max(window.innerHeight * 2, 2000);

    watermarkCanvas.width = width * dpr;
    watermarkCanvas.height = height * dpr;
    ctx.scale(dpr, dpr);

    ctx.clearRect(0, 0, width, height);

    if (!brandLogo.complete || brandLogo.naturalWidth === 0) return;

    ctx.save();
    // Subtle branding watermark: opacity 0.048 (light) to 0.058 (dark)
    ctx.globalAlpha = currentTheme === 'light' ? 0.048 : 0.058;
    ctx.rotate((-20 * Math.PI) / 180);

    const logoSize = 130;
    const stepX = 320;
    const stepY = 260;

    for (let y = -300; y < height + 600; y += stepY) {
      for (let x = -400; x < width + 600; x += stepX) {
        ctx.drawImage(brandLogo, x, y, logoSize, logoSize);
      }
    }
    ctx.restore();
  }

