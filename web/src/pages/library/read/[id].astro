  // PDF Viewer Logic — Phase 2 Navigation, Zoom, and Search
  const ZOOM_LEVELS = [0.50, 0.75, 1.00, 1.25, 1.50, 1.75, 2.00, 2.50, 3.00];

  function updateZoomDisplay() {
    if (pdfZoomLevel) {
      pdfZoomLevel.textContent = `${Math.round(currentPdfScale * 100)}%`;
    }
    if (pdfZoomOutBtn) {
      pdfZoomOutBtn.disabled = currentPdfScale <= 0.50;
    }
    if (pdfZoomInBtn) {
      pdfZoomInBtn.disabled = currentPdfScale >= 3.00;
    }
  }

  function zoomIn() {
    fitMode = 'custom';
    if (currentPdfScale >= 3.00) return;
    const next = ZOOM_LEVELS.find((z) => z > currentPdfScale + 0.02) || 3.00;
    setZoom(Math.min(next, 3.00), 'custom');
  }

  function zoomOut() {
    fitMode = 'custom';
    if (currentPdfScale <= 0.50) return;
    const prev = [...ZOOM_LEVELS].reverse().find((z) => z < currentPdfScale - 0.02) || 0.50;
    setZoom(Math.max(prev, 0.50), 'custom');
  }

  function fitToWidth() {
    fitMode = 'width';
    const containerW = Math.max((pdfPagesContainer ? pdfPagesContainer.clientWidth : window.innerWidth) - 32, 280);
    const target = containerW / basePageWidth;
    setZoom(Math.min(Math.max(target, 0.50), 3.00), 'width');
  }

  function fitToPage() {
    fitMode = 'page';
    const availableH = Math.max(window.innerHeight - 150, 400);
    const containerW = Math.max((pdfPagesContainer ? pdfPagesContainer.clientWidth : window.innerWidth) - 32, 280);
    const target = Math.min(containerW / basePageWidth, availableH / basePageHeight);
    setZoom(Math.min(Math.max(target, 0.50), 3.00), 'page');
  }

  function setZoom(newScale: number, mode = 'custom') {
    if (!pdfDoc) return;
    fitMode = mode;
    currentPdfScale = Math.min(Math.max(newScale, 0.50), 3.00);

    // Record reading anchor (current page and its offset from viewport top)
    const anchorPage = currentPdfPageNum;
    const anchorEl = document.getElementById(`pdfPageWrapper-${anchorPage}`);
    const anchorRectBefore = anchorEl ? anchorEl.getBoundingClientRect() : null;

    updateZoomDisplay();

    // Cancel running render tasks
    renderTasks.forEach((task) => {
      try { task.cancel(); } catch (e) {}
    });
    renderTasks.clear();
    renderingPages.clear();
    renderedPages.clear();

    // Resize placeholder frames
    const wrappers = pdfPagesContainer ? pdfPagesContainer.querySelectorAll('.pdf-page-wrapper') : [];
    wrappers.forEach((wrap) => {
      const p = parseInt(wrap.getAttribute('data-page-number') || '1', 10);
      const skel = document.getElementById(`pdfSkeleton-${p}`);
      if (skel) skel.style.display = 'flex';
      (wrap as HTMLElement).style.width = `${Math.floor(basePageWidth * currentPdfScale)}px`;
      (wrap as HTMLElement).style.minHeight = `${Math.floor(basePageHeight * currentPdfScale)}px`;
    });

    // Re-render visible pages and highlight layers
    reRenderVisiblePages();
    renderAllVisibleHighlights();

    // Maintain sensible reading position
    if (anchorEl && anchorRectBefore) {
      const newRect = anchorEl.getBoundingClientRect();
      const diffY = newRect.top - anchorRectBefore.top;
      if (Math.abs(diffY) > 5) {
        window.scrollBy({ top: diffY, behavior: 'instant' });
      }
    }
  }

  function navigateToInputPage() {
    if (!pdfPageInput) return;
    const rawVal = pdfPageInput.value.trim();
    const val = parseInt(rawVal, 10);
    if (isNaN(val) || val < 1 || val > totalPdfPages) {
      pdfPageInput.value = currentPdfPageNum.toString();
      pdfPageInput.classList.add('input-error');
      setTimeout(() => pdfPageInput.classList.remove('input-error'), 800);
      return;
    }
    scrollToPage(val);
  }

  function scrollToPage(pageNum: number) {
    if (pageNum < 1 || pageNum > totalPdfPages) return;
    currentPdfPageNum = pageNum;
    if (pdfPageInput && document.activeElement !== pdfPageInput) {
      pdfPageInput.value = pageNum.toString();
    }
    if (pdfPrevPageBtn) pdfPrevPageBtn.disabled = pageNum <= 1;
    if (pdfNextPageBtn) pdfNextPageBtn.disabled = pageNum >= totalPdfPages;

    const target = document.getElementById(`pdfPageWrapper-${pageNum}`);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    scheduleProgressSave(true);
  }

  function reRenderVisiblePages() {
    if (!pdfPagesContainer) return;
    const wrappers = pdfPagesContainer.querySelectorAll('.pdf-page-wrapper');
    const windowH = window.innerHeight;
    wrappers.forEach((wrap) => {
      const rect = wrap.getBoundingClientRect();
      if (rect.bottom >= -200 && rect.top <= windowH + 200) {
        const p = parseInt(wrap.getAttribute('data-page-number') || '1', 10);
        renderSinglePdfPage(p);
      }
    });
  }

  // --- In-Document PDF Text Search State & Methods ---
  const pageTextCache = new Map(); // pageNum -> Array<items>
  let isSearchOpen = false;
  let currentSearchQuery = '';
  let searchMatches = []; // Array<{ pageNum: number, rect: number[], charIndex: number, length: number, totalChars: number }>
  let currentMatchIndex = -1;
  let isSearching = false;

  async function getPageTextItems(pageNum: number) {
    if (pageTextCache.has(pageNum)) {
      return pageTextCache.get(pageNum);
    }
    if (!pdfDoc || pageNum < 1 || pageNum > totalPdfPages) return [];
    try {
      const page = await pdfDoc.getPage(pageNum);
      const tc = await page.getTextContent();
      pageTextCache.set(pageNum, tc.items);
      return tc.items;
    } catch (err) {
      console.warn(`Error extracting text for page ${pageNum}:`, err);
      return [];
    }
  }

  async function executePdfSearch(query: string) {
    query = query.trim();
    currentSearchQuery = query;

    if (!query) {
      clearSearch();
      return;
    }

    if (pdfSearchClearBtn) pdfSearchClearBtn.style.display = 'inline-flex';
    if (pdfSearchCount) pdfSearchCount.textContent = 'Searching...';
    if (pdfSearchMessage) {
      pdfSearchMessage.style.display = 'block';
      pdfSearchMessage.className = 'pdf-search-status-banner searching';
      pdfSearchMessage.textContent = 'Searching entire document...';
    }

    isSearching = true;
    searchMatches = [];
    currentMatchIndex = -1;

    try {
      for (let p = 1; p <= totalPdfPages; p++) {
        const items = await getPageTextItems(p);
        for (let i = 0; i < items.length; i++) {
          const it = items[i];
          if (!it || !it.str) continue;
          const lowerStr = it.str.toLowerCase();
          const lowerQuery = query.toLowerCase();
          let start = 0;
          let idx = -1;
          while ((idx = lowerStr.indexOf(lowerQuery, start)) !== -1) {
            const rect = [
              it.transform[4],
              it.transform[5],
              it.transform[4] + it.width,
              it.transform[5] + it.height,
            ];
            searchMatches.push({
              pageNum: p,
              rect: rect,
              charIndex: idx,
              length: query.length,
              totalChars: it.str.length,
            });
            start = idx + query.length;
          }
        }
      }

      isSearching = false;

      if (searchMatches.length === 0) {
        if (pdfSearchCount) pdfSearchCount.textContent = '0 of 0';
        if (pdfSearchPrevBtn) pdfSearchPrevBtn.disabled = true;
        if (pdfSearchNextBtn) pdfSearchNextBtn.disabled = true;
        if (pdfSearchMessage) {
          pdfSearchMessage.style.display = 'block';
          pdfSearchMessage.className = 'pdf-search-status-banner empty';
          pdfSearchMessage.textContent = `No matches found for "${query}"`;
        }
        clearAllHighlightLayers();
      } else {
        if (pdfSearchMessage) pdfSearchMessage.style.display = 'none';
        if (pdfSearchPrevBtn) pdfSearchPrevBtn.disabled = false;
        if (pdfSearchNextBtn) pdfSearchNextBtn.disabled = false;
        goToSearchMatch(0);
      }
    } catch (searchErr) {
      console.warn('Search execution error:', searchErr);
      isSearching = false;
      if (pdfSearchMessage) {
        pdfSearchMessage.style.display = 'block';
        pdfSearchMessage.className = 'pdf-search-status-banner error';
        pdfSearchMessage.textContent = 'Unable to complete text search.';
      }
    }
  }

  function goToSearchMatch(index: number) {
    if (searchMatches.length === 0) return;
    currentMatchIndex = (index + searchMatches.length) % searchMatches.length;

    if (pdfSearchCount) {
      pdfSearchCount.textContent = `${currentMatchIndex + 1} of ${searchMatches.length}`;
    }

    const match = searchMatches[currentMatchIndex];
    scrollToPage(match.pageNum);
    renderAllVisibleHighlights();
  }

  async function renderPageHighlights(pageNum: number) {
    const layer = document.getElementById(`pdfHighlightLayer-${pageNum}`);
    if (!layer) return;
    layer.innerHTML = '';

    if (!currentSearchQuery || searchMatches.length === 0 || !pdfDoc) return;

    const pageMatches = searchMatches
      .map((m, idx) => ({ ...m, globalIndex: idx }))
      .filter((m) => m.pageNum === pageNum);

    if (pageMatches.length === 0) return;

    try {
      const page = await pdfDoc.getPage(pageNum);
      const viewport = page.getViewport({ scale: currentPdfScale });

      pageMatches.forEach((m) => {
        const cvt = viewport.convertToViewportRectangle(m.rect);
        let left = Math.min(cvt[0], cvt[2]);
        let top = Math.min(cvt[1], cvt[3]);
        let width = Math.abs(cvt[2] - cvt[0]);
        let height = Math.abs(cvt[3] - cvt[1]);

        if (m.totalChars > 0) {
          const charRatio = m.charIndex / m.totalChars;
          const widthRatio = m.length / m.totalChars;
          left += width * charRatio;
          width = Math.max(width * widthRatio, 4);
        }

        const isCurrent = m.globalIndex === currentMatchIndex;
        const el = document.createElement('div');
        el.className = `pdf-highlight-item ${isCurrent ? 'active' : ''}`;
        el.style.left = `${Math.floor(left)}px`;
        el.style.top = `${Math.floor(top)}px`;
        el.style.width = `${Math.ceil(width)}px`;
        el.style.height = `${Math.ceil(height)}px`;
        layer.appendChild(el);
      });
    } catch (err) {
      console.warn(`Error rendering highlights on page ${pageNum}:`, err);
    }
  }

  function renderAllVisibleHighlights() {
    if (!pdfPagesContainer) return;
    const wrappers = pdfPagesContainer.querySelectorAll('.pdf-page-wrapper');
    const windowH = window.innerHeight;
    wrappers.forEach((wrap) => {
      const rect = wrap.getBoundingClientRect();
      if (rect.bottom >= -350 && rect.top <= windowH + 350) {
        const p = parseInt(wrap.getAttribute('data-page-number') || '1', 10);
        renderPageHighlights(p);
      }
    });
  }

  function clearAllHighlightLayers() {
    if (!pdfPagesContainer) return;
    const layers = pdfPagesContainer.querySelectorAll('.pdf-highlight-layer');
    layers.forEach((l) => { l.innerHTML = ''; });
  }

  function clearSearch() {
