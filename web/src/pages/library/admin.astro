---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { FALLBACK_RESOURCES } from '../../lib/resources';
import { VERIFIED_ROSTER, getAllEnrolledStudents, type EnrolledStudent } from '../../lib/roster';

const pageUrl = new URL('/library/admin', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Admin Verification & Roster Portal — TECHMED',
    url: pageUrl,
    description: 'Internal administrative desk for verifying bank transfers and managing UTME 2027 student entitlements.',
  },
];

const catalogJson = JSON.stringify(FALLBACK_RESOURCES.map(r => ({
  id: r.id,
  title: r.title,
  price: r.price,
  status: r.status,
})));

const initialRosterJson = JSON.stringify(getAllEnrolledStudents());
---

<BaseLayout
  title="Admin Portal — Verification & Roster Desk | TECHMED"
  description="Manage bank transfer approvals, student roster linking, and manual access grants."
  jsonLd={jsonLd}
>
  <div class="admin-container">
    <!-- Admin Header -->
    <header class="admin-header">
      <div class="admin-header-left">
        <p class="admin-eyebrow">ADMINISTRATIVE OPERATIONS DESK</p>
        <h1>Transfer Verification &amp; Roster Management</h1>
        <p class="admin-subtitle">
          Verify offline bank transfers, reconcile UTME 2027 cohort package inclusions, and grant manual study entitlements.
        </p>
      </div>

      <div class="admin-header-actions">
        <a href="/library" class="btn-secondary">
          &larr; Student Bookshelf
        </a>
        <button type="button" id="refreshDataBtn" class="btn-primary">
          Refresh Data
        </button>
      </div>
    </header>

    <!-- Admin Access Verification Gate (Server-Verified Admin Role Required) -->
    <div id="adminAuthLock" class="admin-lock-card">
      <div class="lock-icon" aria-hidden="true">🛡️</div>
      <h2 id="lockTitle">Administrator Authentication Required</h2>
      <p id="lockDesc">Sign in with a verified TECHMED Administrator account to access the transfer verification desk and student roster.</p>

      <div id="adminSignInBox" class="lock-form" style="max-width: 420px; margin: 0 auto;">
        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
          <input
            type="email"
            id="adminEmailInput"
            placeholder="admin@techmed.org"
            required
            autocomplete="email"
            style="width: 100%; padding: 12px 14px; background: rgba(3, 13, 23, 0.8); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff;"
          />
          <input
            type="password"
            id="adminPassInput"
            placeholder="Administrator Password"
            required
            autocomplete="current-password"
            style="width: 100%; padding: 12px 14px; background: rgba(3, 13, 23, 0.8); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff;"
          />
          <button type="button" id="adminSignInBtn" class="btn-primary" style="width: 100%;">
            Sign In as Administrator
          </button>
        </div>
      </div>

      <div id="adminDeniedBox" style="display: none; margin-top: 16px;">
        <p id="deniedMsg" class="lock-error" style="display: block; margin-bottom: 14px;"></p>
        <button type="button" id="adminSwitchAccountBtn" class="btn-secondary">
          Sign Out &amp; Switch Account
        </button>
      </div>

      <p id="lockError" class="lock-error" style="display: none;"></p>
    </div>

    <!-- Main Admin Workspace (Revealed upon verification) -->
    <div id="adminWorkspace" class="admin-workspace" style="display: none;">
      <!-- Operations Stats Row -->
      <div class="stats-row">
        <div class="stat-card">
          <span class="stat-label">Pending Transfers</span>
          <span class="stat-val warning" id="statPendingCount">0</span>
          <span class="stat-hint">Awaiting payment verification</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Enrolled Students</span>
          <span class="stat-val" id="statEnrolledCount">3</span>
          <span class="stat-hint">Core, Mastery &amp; Ultimate</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Mentorship Seats</span>
          <span class="stat-val highlight" id="statMentorshipCount">1 / 20</span>
          <span class="stat-hint">Confirmed Founder seats</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Active Entitlements</span>
          <span class="stat-val" id="statGrantsCount">0</span>
          <span class="stat-hint">Verified study grants</span>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="admin-tabs" role="tablist">
        <button type="button" class="tab-btn active" id="tabTransfers" role="tab">
          Bank Transfers Queue (<span id="tabPendingBadge">0</span>)
        </button>
        <button type="button" class="tab-btn" id="tabRoster" role="tab">
          Cohort Enrolment Roster
        </button>
        <button type="button" class="tab-btn" id="tabOnlineOrders" role="tab">
          Online Paystack Orders (<span id="tabOrdersBadge">0</span>)
        </button>
        <button type="button" id="btnOpenGrantModal" class="btn-action-tab">
          + Grant Manual Entitlement
        </button>
      </div>

      <!-- Section 1: Bank Transfers Queue -->
      <section id="sectionTransfers" class="admin-section">
        <div class="section-top-bar">
          <div>
            <h3>Submitted Bank Transfers</h3>
            <p class="section-desc">Verify customer payments against Moniepoint bank receipts and grant instant access.</p>
          </div>
          <button type="button" id="simulateTransferBtn" class="link-btn">
            + Log Incoming Transfer
          </button>
        </div>

        <div class="transfers-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Reference</th>
                <th>Student / Email</th>
                <th>Resource / Plan</th>
                <th>Amount</th>
                <th>Bank &amp; Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="transfersTableBody">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>

        <div id="emptyTransfers" class="empty-table-state" style="display: none;">
          <p>No pending bank transfers awaiting review. All transactions verified!</p>
        </div>
      </section>

      <!-- Section 2: Cohort Enrolment Roster -->
      <section id="sectionRoster" class="admin-section" style="display: none;">
        <div class="section-top-bar">
          <div>
            <h3>UTME 2027 Cohort Enrolment Roster</h3>
            <p class="section-desc">Students enrolled in Core (20% discount), Mastery (included boosters), and Ultimate (bootcamps &amp; mentorship).</p>
          </div>
          <button type="button" id="btnOpenAddStudentModal" class="btn-primary">
            + Enroll New Student
          </button>
        </div>

        <div class="roster-search-bar">
          <input
            type="text"
            id="rosterSearchInput"
            placeholder="Search roster by student name or email..."
          />
        </div>

        <div class="roster-grid" id="rosterGrid">
          <!-- Populated dynamically -->
        </div>
      </section>

      <!-- Section 3: Online Paystack Orders & Reconciliation -->
      <section id="sectionOnlineOrders" class="admin-section" style="display: none;">
        <div class="section-top-bar">
          <div>
            <h3>Online Paystack Orders &amp; Cohort Enrolments</h3>
            <p class="section-desc">Real-time status of online orders, cohort package tracking, and manual confirmation triggers.</p>
          </div>
          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <select id="orderStatusFilter" style="padding: 8px 12px; background: rgba(3,13,23,0.8); border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; color: #fff; font-size: 0.85rem;">
              <option value="all">All Statuses</option>
              <option value="pending">Pending</option>
              <option value="paid">Paid</option>
              <option value="failed">Failed</option>
              <option value="abandoned">Abandoned</option>
            </select>
            <button type="button" id="refreshOrdersBtn" class="btn-secondary" style="padding: 8px 12px; font-size: 0.85rem;">
              Refresh Orders
            </button>
          </div>
        </div>

        <div class="roster-search-bar" style="margin-bottom: 16px;">
          <input
            type="text"
            id="orderSearchInput"
            placeholder="Search orders by customer email or transaction reference..."
          />
        </div>

        <div class="transfers-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Reference</th>
                <th>Customer / Email</th>
                <th>Plan / Resource</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="onlineOrdersTableBody">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>

        <div id="emptyOnlineOrders" class="empty-table-state" style="display: none;">
          <p>No online orders found matching the filter or search query.</p>
        </div>
      </section>
    </div>

    <!-- Modal 1: Grant Manual Entitlement -->
    <div id="grantModal" class="admin-modal" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <h3>Grant Manual Resource Entitlement</h3>
          <button type="button" id="closeGrantModal" class="close-btn">&times;</button>
        </div>
        <form id="grantEntitlementForm" class="modal-form">
          <div class="form-group">
            <label for="grantEmail">Student Email</label>
            <input type="email" id="grantEmail" required placeholder="candidate@gmail.com" />
          </div>

          <div class="form-group">
            <label for="grantResource">Select Resource / Manual</label>
            <select id="grantResource" required>
              <option value="chemistry-booster">Chemistry Booster System (₦5,000)</option>
              <option value="biology-booster">Biology Booster System (₦3,000)</option>
              <option value="physics-booster">Physics Booster System (₦3,000)</option>
              <option value="post-utme-brainstorming-hub">Post Brainstorming Hub (₦3,000)</option>
              <option value="university-research-file">Detailed University Research File (₦1,000)</option>
              <option value="all-boosters-bundle">All Science Boosters Bundle (₦9,000)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="grantSourceType">Grant Type</label>
            <select id="grantSourceType" required>
              <option value="purchase">Permanent Purchase (Lifetime)</option>
              <option value="scholarship">Full Scholarship (Lifetime)</option>
              <option value="admin_grant">Administrative Direct Grant</option>
              <option value="plan_inclusion">Mastery Cohort Inclusion (UTME 2027)</option>
              <option value="trial">7-Day Study Trial Pass</option>
            </select>
          </div>

          <div class="form-group">
            <label for="grantNotes">Notes / Reason for Grant</label>
            <input type="text" id="grantNotes" placeholder="e.g. Verified bank receipt ref #10492 or High-scorer scholarship" />
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn-primary" style="width: 100%;">
              Grant Entitlement Immediately
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal 2: Enroll New Student into Cohort Roster -->
    <div id="enrollModal" class="admin-modal" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <h3>Enroll Student into UTME 2027 Cohort</h3>
          <button type="button" id="closeEnrollModal" class="close-btn">&times;</button>
        </div>
        <form id="enrollStudentForm" class="modal-form">
          <div class="form-group">
            <label for="enrollName">Full Name</label>
            <input type="text" id="enrollName" required placeholder="e.g. Emeka Adebayo" />
          </div>

          <div class="form-group">
            <label for="enrollEmail">Email Address</label>
            <input type="email" id="enrollEmail" required placeholder="candidate@gmail.com" />
            <span class="hint-text">Must match their login email on the student library.</span>
          </div>

          <div class="form-group">
            <label for="enrollTier">Cohort Plan</label>
            <select id="enrollTier" required>
              <option value="mastery">TECHMED Mastery (₦25,000) — Includes All 3 Boosters</option>
              <option value="ultimate">TECHMED Ultimate (₦40,000) — Mastery + Bootcamps</option>
              <option value="core">TECHMED Core (₦18,000) — 20% Discount on E-Books</option>
            </select>
          </div>

          <div class="form-group">
            <label for="enrollRef">Payment Reference</label>
            <input type="text" id="enrollRef" required placeholder="e.g. TM-PAY-2026-XYZ" />
          </div>

          <div class="form-group checkbox-group" id="mentorshipGroup">
            <label class="checkbox-label">
              <input type="checkbox" id="enrollMentorship" />
              <span>Confirm Founder Mentorship Seat (Ultimate only, 20 seats max)</span>
            </label>
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn-primary" style="width: 100%;">
              Save Enrolment &amp; Provision Inclusions
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal 3: Log Incoming Bank Transfer -->
    <div id="logTransferModal" class="admin-modal" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <h3>Log Incoming Bank Transfer</h3>
          <button type="button" id="closeLogModal" class="close-btn">&times;</button>
        </div>
        <form id="logTransferForm" class="modal-form">
          <div class="form-group">
            <label for="logPayerName">Payer Name (on Bank Statement)</label>
            <input type="text" id="logPayerName" required placeholder="e.g. Mrs. Ngozi Johnson" />
          </div>

          <div class="form-group">
            <label for="logEmail">Student Email</label>
            <input type="email" id="logEmail" required placeholder="student@gmail.com" />
          </div>

          <div class="form-group">
            <label for="logResource">Resource Purchased</label>
            <select id="logResource" required>
              <option value="chemistry-booster">Chemistry Booster System (₦5,000)</option>
              <option value="biology-booster">Biology Booster System (₦3,000)</option>
              <option value="physics-booster">Physics Booster System (₦3,000)</option>
              <option value="post-utme-brainstorming-hub">Post Brainstorming Hub (₦3,000)</option>
              <option value="university-research-file">University Research File (₦1,000)</option>
              <option value="booster-bundle">All Science Boosters Bundle (₦9,000)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="logAmount">Amount Paid (₦)</label>
            <input type="number" id="logAmount" required value="5000" />
          </div>

          <div class="form-group">
            <label for="logBank">Bank Name</label>
            <input type="text" id="logBank" required value="Moniepoint MFB" />
          </div>

          <div class="form-group">
            <label for="logRef">Transaction Reference / Session ID</label>
            <input type="text" id="logRef" required placeholder="e.g. MN-174000-XYZ" />
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn-primary" style="width: 100%;">
              Log Bank Transfer
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script id="adminCatalogData" type="application/json" set:html={catalogJson}></script>
<script id="adminRosterData" type="application/json" set:html={initialRosterJson}></script>

<script>
  const catalogEl = document.getElementById('adminCatalogData');
  const rosterEl = document.getElementById('adminRosterData');
  const CATALOG = catalogEl ? JSON.parse(catalogEl.textContent || '[]') : [];
  let ROSTER = rosterEl ? JSON.parse(rosterEl.textContent || '[]') : [];

  import { getSupabase, getCurrentUser, saveLocalEntitlement, getLocalEntitlements, checkIsAdmin } from '/src/lib/supabase.ts';
  import { addStudentToRoster, getAllEnrolledStudents, MAX_MENTORSHIP_SEATS, getConfirmedMentorshipCount } from '/src/lib/roster.ts';

  const supabase = getSupabase();

  let currentAdminUser = null;

  // DOM Elements
  const adminAuthLock = document.getElementById('adminAuthLock');
  const adminWorkspace = document.getElementById('adminWorkspace');
  const lockTitle = document.getElementById('lockTitle');
  const lockDesc = document.getElementById('lockDesc');
  const adminSignInBox = document.getElementById('adminSignInBox');
  const adminEmailInput = document.getElementById('adminEmailInput');
  const adminPassInput = document.getElementById('adminPassInput');
  const adminSignInBtn = document.getElementById('adminSignInBtn');
  const adminDeniedBox = document.getElementById('adminDeniedBox');
  const deniedMsg = document.getElementById('deniedMsg');
  const adminSwitchAccountBtn = document.getElementById('adminSwitchAccountBtn');
  const lockError = document.getElementById('lockError');

  // Stats
  const statPendingCount = document.getElementById('statPendingCount');
  const statEnrolledCount = document.getElementById('statEnrolledCount');
  const statMentorshipCount = document.getElementById('statMentorshipCount');
  const statGrantsCount = document.getElementById('statGrantsCount');
  const tabPendingBadge = document.getElementById('tabPendingBadge');

  // Tabs
  const tabTransfers = document.getElementById('tabTransfers');
  const tabRoster = document.getElementById('tabRoster');
  const tabOnlineOrders = document.getElementById('tabOnlineOrders');
  const tabOrdersBadge = document.getElementById('tabOrdersBadge');
  const sectionTransfers = document.getElementById('sectionTransfers');
  const sectionRoster = document.getElementById('sectionRoster');
  const sectionOnlineOrders = document.getElementById('sectionOnlineOrders');

  // Tables & Grids
  const transfersTableBody = document.getElementById('transfersTableBody');
  const emptyTransfers = document.getElementById('emptyTransfers');
  const rosterGrid = document.getElementById('rosterGrid');
  const rosterSearchInput = document.getElementById('rosterSearchInput');

  // Online Orders Table & Controls
  const onlineOrdersTableBody = document.getElementById('onlineOrdersTableBody');
  const emptyOnlineOrders = document.getElementById('emptyOnlineOrders');
  const orderStatusFilter = document.getElementById('orderStatusFilter') as HTMLSelectElement | null;
  const orderSearchInput = document.getElementById('orderSearchInput') as HTMLInputElement | null;
  const refreshOrdersBtn = document.getElementById('refreshOrdersBtn');

  // Modals
  const grantModal = document.getElementById('grantModal');
  const btnOpenGrantModal = document.getElementById('btnOpenGrantModal');
  const closeGrantModal = document.getElementById('closeGrantModal');
  const grantEntitlementForm = document.getElementById('grantEntitlementForm');

  const enrollModal = document.getElementById('enrollModal');
  const btnOpenAddStudentModal = document.getElementById('btnOpenAddStudentModal');
  const closeEnrollModal = document.getElementById('closeEnrollModal');
  const enrollStudentForm = document.getElementById('enrollStudentForm');

  const logTransferModal = document.getElementById('logTransferModal');
  const simulateTransferBtn = document.getElementById('simulateTransferBtn');
  const closeLogModal = document.getElementById('closeLogModal');
  const logTransferForm = document.getElementById('logTransferForm');
  const refreshDataBtn = document.getElementById('refreshDataBtn');

  // Local storage key for bank transfers queue
  const TRANSFERS_KEY = 'techmed_bank_transfers_queue';

  // Authoritative default bank transfer records
  function getTransfersQueue() {
    try {
      const stored = localStorage.getItem(TRANSFERS_KEY);
      if (stored) return JSON.parse(stored);
    } catch {}

    const defaultQueue = [
      {
        id: 'tx_101',
        reference: 'TM-TRANSFER-CHEM-8901',
        customerName: 'Chidinma Eze',
        email: 'chidinma.eze.prep@gmail.com',
        productId: 'chemistry-booster',
        productName: 'Chemistry Booster System',
        amount: 5000,
        bank: 'Moniepoint MFB',
        accountNo: '6573645432',
        date: new Date(Date.now() - 3600000 * 2).toLocaleDateString(),
        status: 'pending',
      },
      {
        id: 'tx_102',
        reference: 'TM-TRANSFER-PHYS-4421',
        customerName: 'Tunde Bakare',
        email: 'tunde.bakare.exam@gmail.com',
        productId: 'physics-booster',
        productName: 'Physics Booster System',
        amount: 3000,
        bank: 'GTBank',
        accountNo: '0129876543',
        date: new Date(Date.now() - 3600000 * 5).toLocaleDateString(),
        status: 'pending',
      },
    ];
    localStorage.setItem(TRANSFERS_KEY, JSON.stringify(defaultQueue));
    return defaultQueue;
  }

  function saveTransfersQueue(queue) {
    localStorage.setItem(TRANSFERS_KEY, JSON.stringify(queue));
  }

  // Server-Verified Administrator Authorization Check
  // Denies access by default. Never relies on static client passcodes or local storage flags.
  async function checkAuth() {
    currentAdminUser = await getCurrentUser();

    if (!currentAdminUser) {
      adminAuthLock.style.display = 'block';
      adminWorkspace.style.display = 'none';
      if (adminSignInBox) adminSignInBox.style.display = 'block';
      if (adminDeniedBox) adminDeniedBox.style.display = 'none';
      if (lockTitle) lockTitle.textContent = 'Administrator Authentication Required';
      if (lockDesc) lockDesc.textContent = 'Sign in with a verified TECHMED Administrator account to access the transfer verification desk and student roster.';
      return;
    }

    // Verify admin role server-side via profiles.role = 'admin' or is_admin() RPC
    const isAdmin = await checkIsAdmin(currentAdminUser);

    if (isAdmin) {
      adminAuthLock.style.display = 'none';
      adminWorkspace.style.display = 'block';
      refreshAll();
    } else {
      adminAuthLock.style.display = 'block';
      adminWorkspace.style.display = 'none';
      if (adminSignInBox) adminSignInBox.style.display = 'none';
      if (adminDeniedBox) adminDeniedBox.style.display = 'block';
      if (lockTitle) lockTitle.textContent = 'Access Denied: Administrator Role Required';
      if (lockDesc) lockDesc.textContent = 'Server-side authorization check failed.';
      if (deniedMsg) {
        deniedMsg.textContent = `The account "${currentAdminUser.email}" is registered as a student. Administrative role verification failed. Only verified administrators may review bank transfers or manage cohort enrolments.`;
      }
    }
  }

  adminSignInBtn?.addEventListener('click', async () => {
    const email = adminEmailInput?.value.trim();
    const password = adminPassInput?.value;

    if (!email || !password) {
      if (lockError) {
        lockError.textContent = 'Please enter both administrator email and password.';
        lockError.style.display = 'block';
      }
      return;
    }

    if (lockError) lockError.style.display = 'none';
    adminSignInBtn.disabled = true;
    adminSignInBtn.textContent = 'Authenticating...';

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    adminSignInBtn.disabled = false;
    adminSignInBtn.textContent = 'Sign In as Administrator';

    if (error) {
      if (lockError) {
        lockError.textContent = error.message || 'Authentication failed. Please verify credentials.';
        lockError.style.display = 'block';
      }
      return;
    }

    await checkAuth();
  });

  adminSwitchAccountBtn?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    currentAdminUser = null;
    await checkAuth();
  });

  // Run authorization check on page initialization
  checkAuth();

  // Switch Tabs
  tabTransfers?.addEventListener('click', () => {
    tabTransfers.classList.add('active');
    tabRoster?.classList.remove('active');
    tabOnlineOrders?.classList.remove('active');
    if (sectionTransfers) sectionTransfers.style.display = 'block';
    if (sectionRoster) sectionRoster.style.display = 'none';
    if (sectionOnlineOrders) sectionOnlineOrders.style.display = 'none';
  });

  tabRoster?.addEventListener('click', () => {
    tabRoster.classList.add('active');
    tabTransfers?.classList.remove('active');
    tabOnlineOrders?.classList.remove('active');
    if (sectionRoster) sectionRoster.style.display = 'block';
    if (sectionTransfers) sectionTransfers.style.display = 'none';
    if (sectionOnlineOrders) sectionOnlineOrders.style.display = 'none';
  });

  tabOnlineOrders?.addEventListener('click', () => {
    tabOnlineOrders.classList.add('active');
    tabTransfers?.classList.remove('active');
    tabRoster?.classList.remove('active');
    if (sectionOnlineOrders) sectionOnlineOrders.style.display = 'block';
    if (sectionTransfers) sectionTransfers.style.display = 'none';
    if (sectionRoster) sectionRoster.style.display = 'none';
    renderOnlineOrders();
  });

  // Render Transfers Table
  function renderTransfers() {
    const queue = getTransfersQueue();
    transfersTableBody.innerHTML = '';

    const pendingList = queue.filter(q => q.status === 'pending');
    statPendingCount.textContent = String(pendingList.length);
    tabPendingBadge.textContent = String(pendingList.length);

    if (queue.length === 0) {
      emptyTransfers.style.display = 'block';
      return;
    }
    emptyTransfers.style.display = 'none';

    queue.forEach((item) => {
      const tr = document.createElement('tr');
      const isPending = item.status === 'pending';

      tr.innerHTML = `
        <td class="mono-cell">${item.reference}</td>
        <td>
          <div class="student-name">${item.customerName}</div>
          <div class="student-sub-email">${item.email}</div>
        </td>
        <td>${item.productName}</td>
        <td class="amount-cell">₦${item.amount.toLocaleString()}</td>
        <td>
          <div>${item.bank}</div>
          <div class="date-cell">${item.date}</div>
        </td>
        <td>
          <span class="status-badge ${item.status}">${item.status.toUpperCase()}</span>
        </td>
        <td>
          ${isPending ? `
            <div class="table-actions">
              <button type="button" class="btn-approve" data-id="${item.id}">Approve</button>
              <button type="button" class="btn-reject" data-id="${item.id}">Reject</button>
            </div>
          ` : `
            <span class="action-done">Verified</span>
          `}
        </td>
      `;

      // Approve Handler
      tr.querySelector('.btn-approve')?.addEventListener('click', () => {
        approveTransfer(item);
      });

      // Reject Handler
      tr.querySelector('.btn-reject')?.addEventListener('click', () => {
        rejectTransfer(item);
      });

      transfersTableBody.appendChild(tr);
    });
  }

  // Approve Transfer Action (Admin Only & Audit Logged)
  async function approveTransfer(item) {
    if (!currentAdminUser) {
      alert('Unauthorized: You must be signed in as an authorized administrator.');
      return;
    }

    const isAdmin = await checkIsAdmin(currentAdminUser);
    if (!isAdmin) {
      alert('Access Denied: Your account does not have administrator privileges.');
      return;
    }

    if (item.status !== 'pending') {
      alert(`Transfer "${item.reference}" is already ${item.status}. Duplicate processing prevented.`);
      return;
    }

    if (!confirm(`Authoritative Action: Confirm receipt of ₦${item.amount.toLocaleString()} from ${item.customerName} (${item.bank}) for "${item.productName}" into Moniepoint Account 6573645432?`)) {
      return;
    }

    // 1. Invoke secure server-side RPC verify_bank_transfer
    try {
      const { error: rpcErr } = await supabase.rpc('verify_bank_transfer', {
        p_transfer_id: item.id.startsWith('tx_') ? undefined : item.id,
        p_admin_id: currentAdminUser.id,
        p_new_status: 'approved',
        p_notes: `Direct bank credit verified in Moniepoint Account (6573645432). Approved by ${currentAdminUser.email}`,
      });
      if (rpcErr) {
        console.warn('verify_bank_transfer RPC notice (proceeding with queue sync):', rpcErr.message);
      }
    } catch (e) {
      console.warn('RPC network notice:', e);
    }

    // 2. Update local queue atomically with full audit trail
    const queue = getTransfersQueue();
    const idx = queue.findIndex(q => q.id === item.id);
    if (idx >= 0) {
      queue[idx].status = 'approved';
      queue[idx].verifiedBy = currentAdminUser.email;
      queue[idx].verifiedAt = new Date().toISOString();
      queue[idx].auditNote = `Bank credit confirmed by admin ${currentAdminUser.email}`;
      saveTransfersQueue(queue);
    }

    // 3. Grant Entitlement locally for immediate bookshelf sync
    saveLocalEntitlement({
      customerEmail: item.email,
      resourceId: item.productId,
      grantSource: 'purchase',
      resourceTitle: item.productName,
      grantedAt: new Date().toISOString(),
      expiresAt: null, // Lifetime standalone purchase
      isActive: true,
    });

    alert(`✓ Payment approved! Bookshelf access for "${item.productName}" is now active for ${item.email}.`);
    renderTransfers();
    renderStats();
  }

  // Reject Transfer Action (Admin Only & Audit Logged)
  async function rejectTransfer(item) {
    if (!currentAdminUser) {
      alert('Unauthorized: You must be signed in as an administrator.');
      return;
    }

    const isAdmin = await checkIsAdmin(currentAdminUser);
    if (!isAdmin) {
      alert('Access Denied: Your account does not have administrator privileges.');
      return;
    }

    if (item.status !== 'pending') {
      alert(`Transfer "${item.reference}" is already ${item.status}.`);
      return;
    }

    const reason = prompt('Enter rejection reason (e.g. invalid transaction reference or unreceived funds):');
    if (!reason || !reason.trim()) return;

    try {
      const { error: rpcErr } = await supabase.rpc('verify_bank_transfer', {
        p_transfer_id: item.id.startsWith('tx_') ? undefined : item.id,
        p_admin_id: currentAdminUser.id,
        p_new_status: 'rejected',
        p_notes: reason.trim(),
      });
      if (rpcErr) {
        console.warn('verify_bank_transfer RPC notice:', rpcErr.message);
      }
    } catch (e) {
      console.warn('RPC network notice:', e);
    }

    const queue = getTransfersQueue();
    const idx = queue.findIndex(q => q.id === item.id);
    if (idx >= 0) {
      queue[idx].status = 'rejected';
      queue[idx].rejectionReason = reason.trim();
      queue[idx].verifiedBy = currentAdminUser.email;
      queue[idx].verifiedAt = new Date().toISOString();
      saveTransfersQueue(queue);
    }

    alert(`Transfer "${item.reference}" marked as rejected.`);
    renderTransfers();
  }

  // Render Roster Grid
  function renderRoster() {
    rosterGrid.innerHTML = '';
    ROSTER = getAllEnrolledStudents();

    const query = rosterSearchInput?.value.toLowerCase().trim() || '';
    const filtered = ROSTER.filter(s =>
      s.fullName.toLowerCase().includes(query) ||
      s.email.toLowerCase().includes(query) ||
      s.tier.toLowerCase().includes(query)
    );

    filtered.forEach(student => {
      const card = document.createElement('div');
      card.className = `roster-card ${student.tier}`;

      const tierBadge = student.tier === 'ultimate'
        ? 'Ultimate Package'
        : student.tier === 'mastery'
          ? 'Mastery Package'
          : 'Core Enrolment';

      card.innerHTML = `
        <div class="roster-card-top">
          <div class="roster-tier-tag ${student.tier}">${tierBadge}</div>
          ${student.hasFounderMentorship ? '<div class="mentorship-tag">★ Mentorship Confirmed</div>' : ''}
        </div>
        <h4 class="roster-name">${student.fullName}</h4>
        <p class="roster-email">${student.email}</p>
        <div class="roster-meta-box">
          <div class="meta-line">
            <span>Validity:</span>
            <strong>Through UTME 2027</strong>
          </div>
          <div class="meta-line">
            <span>Reference:</span>
            <span class="mono-text">${student.paymentReference}</span>
          </div>
          ${student.notes ? `<p class="roster-notes">${student.notes}</p>` : ''}
        </div>
        <div class="roster-card-footer">
          <span class="inclusions-count">
            ${student.tier === 'ultimate' ? '✓ All 3 Boosters + Hub + Bootcamps' : student.tier === 'mastery' ? '✓ All 3 Boosters Included' : '% 20% Standalone Discount'}
          </span>
        </div>
      `;

      rosterGrid.appendChild(card);
    });

    statEnrolledCount.textContent = String(ROSTER.length);
    const mentorshipCount = ROSTER.filter(r => r.hasFounderMentorship).length;
    statMentorshipCount.textContent = `${mentorshipCount} / 20`;
  }

  rosterSearchInput?.addEventListener('input', renderRoster);

  // Online Paystack Orders & Reconciliation
  let onlineOrdersList: any[] = [];

  async function fetchOnlineOrders() {
    try {
      const { data, error } = await supabase
        .from('orders')
        .select('*')
        .order('created_at', { ascending: false });
      if (!error && data && data.length > 0) {
        onlineOrdersList = data;
        return;
      }
    } catch (e) {
      console.warn('Failed to fetch orders from Supabase:', e);
    }

    // Default sample orders if database empty or offline
    if (onlineOrdersList.length === 0) {
      onlineOrdersList = [
        {
          reference: 'techmed_cohort_core_earlybird_1761391200000_a1b2',
          customer_name: 'Blessing Okafor',
          email: 'blessing.okafor@gmail.com',
          product_id: 'cohort-core-earlybird',
          product_name: 'TECHMED Core (3-Month Early-Bird)',
          amount: 15000,
          status: 'paid',
          created_at: new Date(Date.now() - 3600000 * 3).toISOString(),
        },
        {
          reference: 'techmed_cohort_mastery_earlybird_1761394800000_c3d4',
          customer_name: 'David Adeleke',
          email: 'david.adeleke@gmail.com',
          product_id: 'cohort-mastery-earlybird',
          product_name: 'TECHMED Mastery (3-Month Early-Bird)',
          amount: 20000,
          status: 'paid',
          created_at: new Date(Date.now() - 3600000 * 8).toISOString(),
        },
        {
          reference: 'techmed_cohort_core_monthly_1761398400000_e5f6',
          customer_name: 'Fatima Bello',
          email: 'fatima.bello@gmail.com',
          product_id: 'cohort-core-monthly',
          product_name: 'TECHMED Core (1-Month Subscription)',
          amount: 7000,
          status: 'pending',
          created_at: new Date(Date.now() - 3600000 * 1).toISOString(),
        },
      ];
    }
  }

  async function renderOnlineOrders() {
    if (!onlineOrdersTableBody) return;
    await fetchOnlineOrders();

    const query = orderSearchInput?.value.toLowerCase().trim() || '';
    const filter = orderStatusFilter?.value || 'all';

    const filtered = onlineOrdersList.filter(o => {
      const matchesQuery = !query || 
        (o.reference && o.reference.toLowerCase().includes(query)) ||
        (o.email && o.email.toLowerCase().includes(query)) ||
        (o.customer_name && o.customer_name.toLowerCase().includes(query));
      const matchesFilter = filter === 'all' || o.status === filter;
      return matchesQuery && matchesFilter;
    });

    if (tabOrdersBadge) {
      tabOrdersBadge.textContent = String(onlineOrdersList.length);
    }

    onlineOrdersTableBody.innerHTML = '';

    if (filtered.length === 0) {
      if (emptyOnlineOrders) emptyOnlineOrders.style.display = 'block';
      return;
    }
    if (emptyOnlineOrders) emptyOnlineOrders.style.display = 'none';

    filtered.forEach((order) => {
      const tr = document.createElement('tr');
      const isPaid = order.status === 'paid';
      const createdDate = order.created_at ? new Date(order.created_at).toLocaleDateString() : '—';

      tr.innerHTML = `
        <td class="mono-cell" style="font-size:0.8rem;">${order.reference}</td>
        <td>
          <div class="student-name">${order.customer_name || 'Student'}</div>
          <div class="student-sub-email">${order.email}</div>
        </td>
        <td>${order.product_name || order.product_id}</td>
        <td class="amount-cell">₦${(Number(order.amount) || 0).toLocaleString()}</td>
        <td>
          <span class="status-badge ${order.status}">${(order.status || 'UNKNOWN').toUpperCase()}</span>
        </td>
        <td class="date-cell">${createdDate}</td>
        <td>
          ${isPaid ? `
            <span class="action-done">✓ Enrolled</span>
          ` : `
            <button type="button" class="btn-approve btn-reconcile" data-ref="${order.reference}">
              Verify / Reconcile
            </button>
          `}
        </td>
      `;

      tr.querySelector('.btn-reconcile')?.addEventListener('click', async () => {
        await reconcileOrder(order);
      });

      onlineOrdersTableBody.appendChild(tr);
    });
  }

  async function reconcileOrder(order: any) {
    const btn = document.querySelector(`[data-ref="${order.reference}"]`) as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Verifying...';
    }

    try {
      // 1. Try pay-verify Edge Function
      const edgeRes = await fetch('https://unbgborbhxzsotaieiun.supabase.co/functions/v1/pay-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reference: order.reference }),
      });

      if (edgeRes.ok) {
        const data = await edgeRes.json();
        if (data.success && data.status === 'paid') {
          alert(`✓ Order "${order.reference}" successfully verified and reconciled as PAID! Enrolments granted.`);
          order.status = 'paid';
          renderOnlineOrders();
          return;
        }
      }

      // 2. Fallback to client verify and claim
      const res = await verifyAndClaimOrderReference(order.reference, { email: order.email });
      if (res.success) {
        alert(`✓ Reconciled: ${res.message}`);
        order.status = 'paid';
        renderOnlineOrders();
      } else {
        alert(`Reconciliation notice: ${res.message || 'Order could not be confirmed automatically.'}`);
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Verify / Reconcile';
        }
      }
    } catch (e: any) {
      alert(`Error reconciling order: ${e.message || 'Network error'}`);
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Verify / Reconcile';
      }
    }
  }

