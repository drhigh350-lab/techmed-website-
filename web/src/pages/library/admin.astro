  btnOpenAddStudentModal?.addEventListener('click', () => { enrollModal.style.display = 'flex'; });
  closeEnrollModal?.addEventListener('click', () => { enrollModal.style.display = 'none'; });

  simulateTransferBtn?.addEventListener('click', () => { logTransferModal.style.display = 'flex'; });
  closeLogModal?.addEventListener('click', () => { logTransferModal.style.display = 'none'; });

  // Grant Entitlement Form Submit
  grantEntitlementForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = document.getElementById('grantEmail').value.trim();
    const resId = document.getElementById('grantResource').value;
    const sourceType = document.getElementById('grantSourceType').value;
    const notes = document.getElementById('grantNotes').value.trim();

    if (!email || !resId) return;

    const matchedRes = CATALOG.find(c => c.id === resId);
    const title = matchedRes ? matchedRes.title : resId;

    saveLocalEntitlement({
      customerEmail: email,
      resourceId: resId,
      grantSource: sourceType,
      resourceTitle: title,
      grantedAt: new Date().toISOString(),
      expiresAt: sourceType === 'trial' ? new Date(Date.now() + 86400000 * 7).toISOString() : null,
      isActive: true,
    });

    alert(`✓ Successfully granted "${title}" to ${email}!`);
    grantEntitlementForm.reset();
    grantModal.style.display = 'none';
    renderStats();
  });

  // Enroll Student Form Submit
  enrollStudentForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('enrollName').value.trim();
    const email = document.getElementById('enrollEmail').value.trim();
    const tier = document.getElementById('enrollTier').value;
    const ref = document.getElementById('enrollRef').value.trim();
    const hasMentorship = document.getElementById('enrollMentorship').checked;

    if (!name || !email) return;

    try {
      addStudentToRoster({
        fullName: name,
        email,
        tier,
        enrolledAt: new Date().toISOString(),
        expiresAt: '2027-05-31T23:59:59Z',
        paymentReference: ref || `TM-ROSTER-${tier.toUpperCase()}-${Date.now().toString(36).toUpperCase()}`,
        hasFounderMentorship: hasMentorship,
        notes: `Enrolled via Admin Operations Desk by ${currentAdminUser?.email || 'Admin'} on ${new Date().toLocaleDateString()}`,
      });

      alert(`✓ Enrolled ${name} into TECHMED ${tier.toUpperCase()}! All package inclusions have been provisioned.`);
      enrollStudentForm.reset();
      enrollModal.style.display = 'none';
      renderRoster();
    } catch (err: any) {
      alert(`Enrolment Notice: ${err.message || 'Could not enroll student.'}`);
    }
  });

  // Log Transfer Form Submit
  logTransferForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('logPayerName').value.trim();
    const email = document.getElementById('logEmail').value.trim();
    const resId = document.getElementById('logResource').value;
    const amount = Number(document.getElementById('logAmount').value);
    const bank = document.getElementById('logBank').value.trim();
    const ref = document.getElementById('logRef').value.trim();

    const matched = CATALOG.find(c => c.id === resId);

    const queue = getTransfersQueue();
    queue.unshift({
      id: `tx_${Date.now()}`,
      reference: ref,
      customerName: name,
      email,
      productId: resId,
      productName: matched ? matched.title : resId,
      amount,
      bank,
      date: new Date().toLocaleDateString(),
      status: 'pending',
    });

    saveTransfersQueue(queue);
    alert('✓ Bank transfer record logged in queue!');
    logTransferForm.reset();
    logTransferModal.style.display = 'none';
    renderTransfers();
  });

  // Check auth on load
  checkAuth();
</script>

