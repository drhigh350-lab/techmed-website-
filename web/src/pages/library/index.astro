---
// The separate /library/ landing page has been retired and consolidated into /resources/.
// This route performs an immediate permanent redirect (301) to the canonical /resources/ destination.
// The dedicated reader route at /library/read/[id] is fully preserved.
return Astro.redirect('/resources', 301);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/resources" />
    <link rel="canonical" href="https://techmedng.com/resources" />
    <title>Redirecting to TECHMED Resources...</title>
  </head>
  <body>
    <script>
      window.location.replace('/resources');
    </script>
    <p>Redirecting to <a href="/resources">TECHMED Resources &amp; Bookshelf</a>...</p>
  </body>
</html>
