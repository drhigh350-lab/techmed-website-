---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Student Account Access | TECHMED';
const description = 'Log in or create your student account to access your UTME 2027 preparation dashboard, materials, and onboarding.';
---

<BaseLayout title={title} description={description} noindex>
  <main class="auth-page">
    <div class="auth-wrapper">
      <header class="auth-header">
        <span class="eyebrow">TECHMED Student Access</span>
        <h1 class="auth-title">Welcome to Your Student Hub</h1>
        <p class="auth-sub">
          Sign in or create your account to manage your UTME 2027 profile, access study resources, and track your progress.
        </p>
      </header>

      <div class="auth-card">
        <!-- Auth Tabs -->
        <div class="auth-tabs" role="tablist">
          <button
            type="button"
            class="tab-btn active"
            id="tabLogin"
            role="tab"
            aria-selected="true"
            aria-controls="loginForm"
          >
            Sign In
          </button>
          <button
            type="button"
            class="tab-btn"
            id="tabRegister"
            role="tab"
            aria-selected="false"
            aria-controls="registerForm"
          >
            Create Account
          </button>
          <button
            type="button"
            class="tab-btn"
            id="tabRecovery"
            role="tab"
            aria-selected="false"
            aria-controls="recoveryForm"
          >
            Reset Password
          </button>
        </div>

        <!-- Feedback Alert -->
        <div id="authAlert" class="auth-alert" style="display: none;" role="alert"></div>

        <!-- Form 1: Sign In -->
        <form id="loginForm" class="auth-form" novalidate>
          <div class="form-group">
            <label for="loginEmail">Email address</label>
            <input
              type="email"
              id="loginEmail"
              required
              autocomplete="email"
              placeholder="candidate@gmail.com"
              class="form-input"
            />
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="loginPassword">Password</label>
              <button type="button" class="text-link forgot-btn" id="forgotPassLink">Forgot password?</button>
            </div>
            <input
              type="password"
              id="loginPassword"
              required
              autocomplete="current-password"
              placeholder="Enter your password"
              class="form-input"
            />
          </div>

          <button type="submit" class="btn-primary auth-submit" id="loginSubmitBtn">
            <span>Sign In to Student Account</span>
          </button>
        </form>

        <!-- Form 2: Create Account -->
        <form id="registerForm" class="auth-form" style="display: none;" novalidate>
          <div class="form-group">
            <label for="registerName">Full Name</label>
            <input
              type="text"
              id="registerName"
              required
              autocomplete="name"
              placeholder="e.g. Wisdom Johnson"
              class="form-input"
            />
          </div>

          <div class="form-group">
            <label for="registerEmail">Email address</label>
            <input
              type="email"
              id="registerEmail"
              required
              autocomplete="email"
              placeholder="candidate@gmail.com"
              class="form-input"
            />
            <span class="form-hint">Use the same email you used (or plan to use) for cohort enrollment or resource purchases.</span>
          </div>

          <div class="form-group">
            <label for="registerPhone">Phone Number</label>
            <input
              type="tel"
              id="registerPhone"
              required
              autocomplete="tel"
              placeholder="08012345678 or +234..."
              class="form-input"
            />
          </div>

          <div class="form-group">
            <label for="registerPassword">Create Password</label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="registerPassword"
                required
                autocomplete="new-password"
                placeholder="Create a strong password"
                class="form-input password-input"
              />
              <button
                type="button"
                class="password-toggle-btn"
                id="toggleRegisterPassBtn"
                aria-label="Show password"
                title="Show password"
              >
                <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
              </button>
            </div>

            <!-- Student-Friendly Password Requirements Checklist -->
            <div class="password-checklist-card" id="registerChecklistCard">
              <div class="checklist-header">
                <span class="checklist-title">Password Requirements:</span>
                <span class="checklist-count-badge" id="registerChecklistBadge">0 of 5 satisfied</span>
              </div>
              <ul class="checklist-list" role="list">
                <li class="checklist-item" id="reg-req-length">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least 8 characters</span>
                </li>
                <li class="checklist-item" id="reg-req-upper">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one uppercase letter (A–Z)</span>
                </li>
                <li class="checklist-item" id="reg-req-lower">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one lowercase letter (a–z)</span>
                </li>
                <li class="checklist-item" id="reg-req-number">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one number (0–9)</span>
                </li>
                <li class="checklist-item" id="reg-req-special">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one special character (e.g. @, #, $, !)</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Password Confirmation Input -->
          <div class="form-group">
            <label for="registerPasswordConfirm">Confirm Password</label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="registerPasswordConfirm"
                required
                autocomplete="new-password"
                placeholder="Re-enter your password to confirm"
                class="form-input password-input"
              />
              <button
                type="button"
                class="password-toggle-btn"
                id="toggleRegisterConfirmBtn"
                aria-label="Show confirm password"
                title="Show password"
              >
                <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
              </button>
            </div>
            <div class="match-indicator" id="registerMatchStatus" style="display: none;">
              <span class="match-icon-badge" id="registerMatchIcon"></span>
              <span class="match-label" id="registerMatchLabel"></span>
            </div>
          </div>

          <div class="account-notice-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="notice-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <p>
              Account registration creates your student profile. Verified TECHMED student status is automatically granted once a qualifying cohort enrollment or resource purchase is confirmed.
            </p>
          </div>

          <button type="submit" class="btn-primary auth-submit" id="registerSubmitBtn">
            <span>Create Student Account</span>
          </button>
        </form>

        <!-- Form 3: Password Recovery Request -->
        <form id="recoveryForm" class="auth-form" style="display: none;" novalidate>
          <p class="recovery-text">
            Enter the email associated with your student account. We'll send you a secure link to reset your password.
          </p>

          <div class="form-group">
            <label for="recoveryEmail">Email address</label>
            <input
              type="email"
              id="recoveryEmail"
              required
              autocomplete="email"
              placeholder="candidate@gmail.com"
              class="form-input"
            />
          </div>

          <button type="submit" class="btn-primary auth-submit" id="recoverySubmitBtn">
            <span>Send Password Reset Link</span>
          </button>

          <button type="button" class="btn-secondary auth-back-btn" id="backToSignInBtn">
            Back to Sign In
          </button>
        </form>

        <!-- Form 4: Set New Password (Used when student clicks email reset link) -->
        <form id="newPasswordForm" class="auth-form" style="display: none;" novalidate>
          <div class="newpass-header">
            <h2 class="newpass-title">Set a New Password</h2>
            <p class="newpass-sub">
              Your recovery session is confirmed. Create your new password below according to the requirements checklist.
            </p>
          </div>

          <div class="form-group">
            <label for="newPasswordInput">New Password</label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="newPasswordInput"
                required
                autocomplete="new-password"
                placeholder="Enter new password"
                class="form-input password-input"
              />
              <button
                type="button"
                class="password-toggle-btn"
                id="toggleNewPassBtn"
                aria-label="Show password"
                title="Show password"
              >
                <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
              </button>
            </div>

            <!-- New Password Requirements Checklist -->
            <div class="password-checklist-card" id="newPassChecklistCard">
              <div class="checklist-header">
                <span class="checklist-title">Password Requirements:</span>
                <span class="checklist-count-badge" id="newPassChecklistBadge">0 of 5 satisfied</span>
              </div>
              <ul class="checklist-list" role="list">
                <li class="checklist-item" id="np-req-length">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least 8 characters</span>
                </li>
                <li class="checklist-item" id="np-req-upper">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one uppercase letter (A–Z)</span>
                </li>
                <li class="checklist-item" id="np-req-lower">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one lowercase letter (a–z)</span>
                </li>
                <li class="checklist-item" id="np-req-number">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one number (0–9)</span>
                </li>
                <li class="checklist-item" id="np-req-special">
                  <span class="item-status-icon" aria-hidden="true">
                    <span class="dot-indicator"></span>
                    <svg class="check-indicator" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span class="item-label">At least one special character (e.g. @, #, $, !)</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="form-group">
            <label for="newPasswordConfirm">Confirm New Password</label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="newPasswordConfirm"
                required
                autocomplete="new-password"
                placeholder="Re-enter your new password"
                class="form-input password-input"
              />
              <button
                type="button"
                class="password-toggle-btn"
                id="toggleNewPassConfirmBtn"
                aria-label="Show confirm password"
                title="Show password"
              >
                <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
              </button>
            </div>
            <div class="match-indicator" id="newPassMatchStatus" style="display: none;">
              <span class="match-icon-badge" id="newPassMatchIcon"></span>
              <span class="match-label" id="newPassMatchLabel"></span>
            </div>
          </div>

          <button type="submit" class="btn-primary auth-submit" id="newPasswordSubmitBtn">
            <span>Update Password &amp; Sign In</span>
          </button>
        </form>

        <footer class="auth-footer">
          <p class="guest-note">
            Free resources like the <a href="/foundation-protocol" class="text-link">Admission Guide</a> and <a href="/tools" class="text-link">Kairo CBT Practice</a> are open to everyone without an account.
          </p>
        </footer>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { getSupabase, sanitizeRedirectUrl } from '../lib/supabase';
  import {
    validatePassword,
    validatePasswordMatch,
    getFriendlyAuthErrorMessage,
    initPasswordChecklist,
  } from '../lib/password-validator';

  const supabase = getSupabase();

  // Elements - Tabs & Forms
  const tabLogin = document.getElementById('tabLogin');
  const tabRegister = document.getElementById('tabRegister');
  const tabRecovery = document.getElementById('tabRecovery');
  const loginForm = document.getElementById('loginForm');
  const registerForm = document.getElementById('registerForm');
  const recoveryForm = document.getElementById('recoveryForm');
  const newPasswordForm = document.getElementById('newPasswordForm');
  const authAlert = document.getElementById('authAlert');
  const forgotPassLink = document.getElementById('forgotPassLink');
  const backToSignInBtn = document.getElementById('backToSignInBtn');

  // Register Form Elements
  const registerNameInput = document.getElementById('registerName') as HTMLInputElement | null;
  const registerEmailInput = document.getElementById('registerEmail') as HTMLInputElement | null;
  const registerPhoneInput = document.getElementById('registerPhone') as HTMLInputElement | null;
  const registerPasswordInput = document.getElementById('registerPassword') as HTMLInputElement | null;
  const registerConfirmInput = document.getElementById('registerPasswordConfirm') as HTMLInputElement | null;
  const registerSubmitBtn = document.getElementById('registerSubmitBtn') as HTMLButtonElement | null;
  const registerChecklistBadge = document.getElementById('registerChecklistBadge');
  const registerMatchStatus = document.getElementById('registerMatchStatus');
  const registerMatchIcon = document.getElementById('registerMatchIcon');
  const registerMatchLabel = document.getElementById('registerMatchLabel');

  // New Password Form Elements (for recovery/reset links)
  const newPasswordInput = document.getElementById('newPasswordInput') as HTMLInputElement | null;
  const newPasswordConfirm = document.getElementById('newPasswordConfirm') as HTMLInputElement | null;
  const newPasswordSubmitBtn = document.getElementById('newPasswordSubmitBtn') as HTMLButtonElement | null;
  const newPassChecklistBadge = document.getElementById('newPassChecklistBadge');
  const newPassMatchStatus = document.getElementById('newPassMatchStatus');
  const newPassMatchIcon = document.getElementById('newPassMatchIcon');
  const newPassMatchLabel = document.getElementById('newPassMatchLabel');

  // URL parameters handling with open-redirect security validation
  const urlParams = new URLSearchParams(window.location.search);
  const redirectTarget = sanitizeRedirectUrl(urlParams.get('redirect'), '/dashboard');
  const initialTab = urlParams.get('tab');
  const isRecoveryHash = window.location.hash.includes('type=recovery') || urlParams.get('type') === 'recovery';

  function showAlert(msg: string, type: 'error' | 'success' = 'error') {
    if (!authAlert) return;
    authAlert.textContent = msg;
    authAlert.className = `auth-alert ${type}`;
    authAlert.style.display = 'block';
    authAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideAlert() {
    if (!authAlert) return;
    authAlert.style.display = 'none';
  }

  function switchTab(tab: 'login' | 'register' | 'recovery' | 'new-password') {
    hideAlert();
    [tabLogin, tabRegister, tabRecovery].forEach(b => {
      b?.classList.remove('active');
      b?.setAttribute('aria-selected', 'false');
    });

    if (loginForm) loginForm.style.display = 'none';
    if (registerForm) registerForm.style.display = 'none';
    if (recoveryForm) recoveryForm.style.display = 'none';
    if (newPasswordForm) newPasswordForm.style.display = 'none';

    if (tab === 'login') {
      tabLogin?.classList.add('active');
      tabLogin?.setAttribute('aria-selected', 'true');
      if (loginForm) loginForm.style.display = 'flex';
    } else if (tab === 'register') {
      tabRegister?.classList.add('active');
      tabRegister?.setAttribute('aria-selected', 'true');
      if (registerForm) registerForm.style.display = 'flex';
    } else if (tab === 'recovery') {
      tabRecovery?.classList.add('active');
      tabRecovery?.setAttribute('aria-selected', 'true');
      if (recoveryForm) recoveryForm.style.display = 'flex';
    } else if (tab === 'new-password') {
      if (newPasswordForm) newPasswordForm.style.display = 'flex';
    }
  }

  tabLogin?.addEventListener('click', () => switchTab('login'));
  tabRegister?.addEventListener('click', () => switchTab('register'));
  tabRecovery?.addEventListener('click', () => switchTab('recovery'));
  forgotPassLink?.addEventListener('click', () => switchTab('recovery'));
  backToSignInBtn?.addEventListener('click', () => switchTab('login'));

  // =========================================================================
  // REAL-TIME PASSWORD CHECKLIST & MATCH ENGINE
  // =========================================================================
  initPasswordChecklist({
    passwordInput: registerPasswordInput,
    confirmInput: registerConfirmInput,
    prefix: 'reg-req-',
    badgeEl: registerChecklistBadge,
    matchStatusEl: registerMatchStatus,
    matchIconEl: registerMatchIcon,
    matchLabelEl: registerMatchLabel,
    togglePasswordBtn: document.getElementById('toggleRegisterPassBtn'),
    toggleConfirmBtn: document.getElementById('toggleRegisterConfirmBtn'),
  });

  initPasswordChecklist({
    passwordInput: newPasswordInput,
    confirmInput: newPasswordConfirm,
    prefix: 'np-req-',
    badgeEl: newPassChecklistBadge,
    matchStatusEl: newPassMatchStatus,
    matchIconEl: newPassMatchIcon,
    matchLabelEl: newPassMatchLabel,
    togglePasswordBtn: document.getElementById('toggleNewPassBtn'),
    toggleConfirmBtn: document.getElementById('toggleNewPassConfirmBtn'),
  });

  // =========================================================================
  // RECOVERY & INITIAL TAB ROUTING
  // =========================================================================
  if (isRecoveryHash || initialTab === 'new-password' || initialTab === 'reset') {
    switchTab('new-password');
    showAlert('Password recovery link verified. Please enter your new password below.', 'success');
  } else if (initialTab === 'signup' || initialTab === 'register' || window.location.pathname.includes('register')) {
    switchTab('register');
  } else if (initialTab === 'recovery' || initialTab === 'forgot') {
    switchTab('recovery');
  }

  // Listen for Supabase PASSWORD_RECOVERY event
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      switchTab('new-password');
      showAlert('Password recovery session active. Please enter your new password below.', 'success');
    }
  });

  // Already logged in check (skip if handling password recovery)
  if (!isRecoveryHash) {
    supabase.auth.getSession().then(({ data }) => {
      if (data?.session) {
        window.location.href = redirectTarget;
      }
    });
  }

  // =========================================================================
  // FORM SUBMISSIONS
  // =========================================================================

  // Handle Login
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const email = (document.getElementById('loginEmail') as HTMLInputElement)?.value.trim();
    const password = (document.getElementById('loginPassword') as HTMLInputElement)?.value;
    const submitBtn = document.getElementById('loginSubmitBtn') as HTMLButtonElement;

    if (!email || !password) {
      showAlert('Please enter both your email address and password.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in...';

    const { data, error } = await supabase.auth.signInWithPassword({ email, password });

    submitBtn.disabled = false;
    submitBtn.textContent = 'Sign In to Student Account';

    if (error) {
      showAlert(getFriendlyAuthErrorMessage(error.message));
    } else if (data?.user) {
      window.location.href = redirectTarget;
    }
  });

  // Handle Register with Strict Real-Time Checklist & Friendly Errors
  registerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const fullName = registerNameInput?.value.trim() || '';
    const email = registerEmailInput?.value.trim().toLowerCase() || '';
    const phone = registerPhoneInput?.value.trim() || '';
    const password = registerPasswordInput?.value || '';
    const confirmPassword = registerConfirmInput?.value || '';

    if (!fullName || !email) {
      showAlert('Please enter your full name and email address to create your account.');
      return;
    }

    if (!email.includes('@') || !email.includes('.')) {
      showAlert('Please enter a valid email address (e.g. candidate@gmail.com).');
      return;
    }

    // 1. Enforce all 5 password requirements before submission
    const validation = validatePassword(password);
    if (!validation.isValid) {
      showAlert(
        `Please satisfy all 5 password requirements below. Missing: ${validation.missingLabels.join('; ')}.`
      );
      registerPasswordInput?.focus();
      return;
    }

    // 2. Enforce matching password confirmation
    const matchCheck = validatePasswordMatch(password, confirmPassword);
    if (!matchCheck.isMatch) {
      showAlert('Passwords do not match. Please ensure both password fields match exactly.');
      registerConfirmInput?.focus();
      return;
    }

    if (registerSubmitBtn) {
      registerSubmitBtn.disabled = true;
      registerSubmitBtn.textContent = 'Creating account...';
    }

    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: {
        data: {
          full_name: fullName,
          name: fullName,
          phone: phone || '',
          whatsapp_phone: phone || '',
          telegram_phone: phone || '',
          role: 'student',
        },
      },
    });

    if (registerSubmitBtn) {
      registerSubmitBtn.disabled = false;
      registerSubmitBtn.textContent = 'Create Student Account';
    }

    if (error) {
      showAlert(getFriendlyAuthErrorMessage(error.message));
    } else if (data?.user) {
      // If auto-logged in, navigate to onboarding to complete profile
      if (data.session) {
        window.location.href = '/account/onboarding';
      } else {
        showAlert(
          'Account created successfully! Please check your email inbox to verify your address, then sign in.',
          'success'
        );
        switchTab('login');
      }
    }
  });

  // Handle Password Recovery Request
  recoveryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const email = (document.getElementById('recoveryEmail') as HTMLInputElement)?.value.trim();
    const submitBtn = document.getElementById('recoverySubmitBtn') as HTMLButtonElement;

    if (!email || !email.includes('@')) {
      showAlert('Please enter the email address linked to your student account.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending reset link...';

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/login?tab=new-password`,
    });

    submitBtn.disabled = false;
    submitBtn.textContent = 'Send Password Reset Link';

    if (error) {
      showAlert(getFriendlyAuthErrorMessage(error.message));
    } else {
      showAlert(
        `If an account exists for ${email}, a password reset link has been dispatched to your inbox. Please check your email.`,
        'success'
      );
    }
  });

  // Handle Set New Password Submission (Recovery Link)
  newPasswordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const newPass = newPasswordInput?.value || '';
    const newPassConfirm = newPasswordConfirm?.value || '';

    const validation = validatePassword(newPass);
    if (!validation.isValid) {
      showAlert(
        `Your new password does not meet all requirements. Missing: ${validation.missingLabels.join('; ')}.`
      );
      newPasswordInput?.focus();
      return;
    }

    const matchCheck = validatePasswordMatch(newPass, newPassConfirm);
    if (!matchCheck.isMatch) {
      showAlert('New passwords do not match. Please ensure both fields match exactly.');
      newPasswordConfirm?.focus();
      return;
    }

    if (newPasswordSubmitBtn) {
      newPasswordSubmitBtn.disabled = true;
      newPasswordSubmitBtn.textContent = 'Updating password...';
    }

    const { error } = await supabase.auth.updateUser({ password: newPass });

    if (newPasswordSubmitBtn) {
      newPasswordSubmitBtn.disabled = false;
      newPasswordSubmitBtn.textContent = 'Update Password & Sign In';
    }

    if (error) {
      showAlert(getFriendlyAuthErrorMessage(error.message));
    } else {
      showAlert('Your password has been updated successfully! You can now sign in with your new password.', 'success');
      switchTab('login');
    }
  });
</script>

