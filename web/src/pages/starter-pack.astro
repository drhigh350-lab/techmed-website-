---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBuilderSettings } from '../lib/builders';

const { channelUrl } = await getBuilderSettings();

const pageUrl = new URL('/starter-pack', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'TECHMED Starter Pack — Final Builder Starting Point',
    url: pageUrl,
    description:
      "Welcome, Builder. Five simple moves to make your TECHMED experience count — know what to prepare for, how to prepare, and what to do next.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Starter Pack', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="TECHMED Starter Pack — Final Builder Starting Point"
  description="Welcome, Builder. Five simple moves to make your TECHMED experience count — know what to prepare for, how to prepare, and what to do next."
  canonicalUrl="/starter-pack"
  jsonLd={jsonLd}
>
  <main class="sp-page" id="starterPackMain">
    <!-- HERO SECTION -->
    <header class="sp-hero" id="hero">
      <div class="sp-container">
        <div class="sp-badge">START HERE &bull; BUILDER ONBOARDING</div>
        <h1 class="sp-hero-title">WELCOME, BUILDER.</h1>
        <p class="sp-hero-lead">
          You're in. Here's how to make your TECHMED experience count.
        </p>
        <p class="sp-hero-sub">
          Start here. Follow the path. Keep building.
        </p>

        <div class="sp-hero-cta-wrap">
          <a
            href={channelUrl}
            class="btn-primary"
            target="_blank"
            rel="noopener"
            id="heroJoinBuilders"
            data-analytics="sp_hero_join_builders"
          >
            <span>JOIN THE BUILDERS</span>
            <span class="arrow-icon" aria-hidden="true">&rarr;</span>
          </a>
          <a href="#journey" class="hero-anchor-link" id="heroJourneyAnchor">
            <span>Explore the 5 Builder Moves</span>
            <span class="arrow-down" aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>
    </header>

    <!-- SECTION 1: YOUR BUILDER JOURNEY -->
    <section class="sp-section" id="journey" aria-labelledby="journeyTitle">
      <div class="sp-container">
        <div class="section-header">
          <span class="section-tag">CORE PROGRESSION</span>
          <h2 id="journeyTitle" class="section-title">YOUR BUILDER JOURNEY</h2>
          <p class="section-subtitle">
            Five simple moves to get the most from your TECHMED experience.
          </p>
        </div>

        <div class="journey-cards">
          <!-- 01: KNOW WHAT YOU'RE PREPARING FOR -->
          <article class="journey-card" id="move01">
            <div class="card-num-badge" aria-hidden="true">01</div>
            <div class="card-body">
              <h3 class="card-title">KNOW WHAT YOU'RE PREPARING FOR</h3>
              <p class="card-pain">
                "Before you start collecting more materials, know what you're actually preparing for."
              </p>
              <p class="card-sol">
                Use the TECHMED JAMB Blueprint to understand what matters and what to study next.
              </p>
              <div class="card-action">
                <a
                  href="/jamb-syllabus-2027"
                  class="btn-secondary"
                  id="ctaBlueprint"
                  data-analytics="sp_blueprint_cta"
                >
                  <span>OPEN THE BLUEPRINT</span>
                  <span class="arrow-icon" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>

          <!-- 02: KNOW HOW TO PREPARE -->
          <article class="journey-card" id="move02">
            <div class="card-num-badge" aria-hidden="true">02</div>
            <div class="card-body">
              <h3 class="card-title">KNOW HOW TO PREPARE</h3>
              <p class="card-sol">
                Preparation works better when you know what to do, why you're doing it, and what to do after.
              </p>

              <!-- Canonical TECHMED Protocol Image -->
              <div class="protocol-showcase">
                <a
                  href="/images/foundation-protocol/techmed-protocol.png"
                  target="_blank"
                  rel="noopener"
                  class="protocol-link"
                  title="View high-resolution TECHMED Protocol diagram"
                  aria-label="View canonical TECHMED Protocol diagram in high resolution"
                >
                  <img
                    src="/images/foundation-protocol/techmed-protocol.png"
                    alt="Canonical TECHMED Protocol: Understand, Plan, Learn, Practise, Diagnose, Revise, Prepare"
                    class="protocol-img"
                    width="1672"
                    height="941"
                    loading="lazy"
                  />
                </a>
                <p class="protocol-legend" aria-hidden="true">
                  UNDERSTAND &rarr; PLAN &rarr; LEARN &rarr; PRACTISE &rarr; DIAGNOSE &rarr; REVISE &rarr; PREPARE
                </p>
              </div>
            </div>
          </article>

          <!-- 03: SEE OCTOBER BEFORE YOU ENTER IT -->
          <article class="journey-card" id="move03">
            <div class="card-num-badge" aria-hidden="true">03</div>
            <div class="card-body">
              <h3 class="card-title">SEE OCTOBER BEFORE YOU ENTER IT</h3>
              <p class="card-sol">
                See exactly how the Foundation Protocol is structured before October begins.
              </p>
              <div class="card-action">
                <a
                  href="/foundation-protocol#program-structure"
                  class="btn-secondary"
                  id="ctaOctoberProgramme"
                  data-analytics="sp_foundation_protocol_cta"
                >
                  <span>SEE THE OCTOBER PROGRAMME</span>
                  <span class="arrow-icon" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>

          <!-- 04: START DOING THE WORK -->
          <article class="journey-card" id="move04">
            <div class="card-num-badge" aria-hidden="true">04</div>
            <div class="card-body">
              <h3 class="card-title">START DOING THE WORK</h3>
              <p class="card-sol">
                Once you know what you're preparing for, practise deliberately.
              </p>
              <div class="card-action">
                <a
                  href="https://kairo.techmedng.com/"
                  class="btn-secondary"
                  target="_blank"
                  rel="noopener"
                  id="ctaKairo"
                  data-analytics="sp_kairo_cta"
                >
                  <span>OPEN KAIRO</span>
                  <span class="arrow-icon" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>

          <!-- 05: WHEN YOU GET STUCK -->
          <article class="journey-card" id="move05">
            <div class="card-num-badge" aria-hidden="true">05</div>
            <div class="card-body">
              <h3 class="card-title">WHEN YOU GET STUCK</h3>
              <p class="card-sol">
                When you hit a problem, don't guess your way through it. Start with the answer that matches the problem.
              </p>

              <div class="blog-articles-grid">
                <a
                  href="/blog/how-to-use-the-jamb-syllabus-not-just-read-it"
                  class="article-tile"
                  id="articleSyllabus"
                  data-analytics="sp_blog_article_click"
                >
                  <span class="tile-tag">Syllabus Strategy</span>
                  <h4 class="tile-title">How to Use the JAMB Syllabus (Not Just Read It)</h4>
                  <p class="tile-summary">
                    Turn the official syllabus from a passive reading list into an active strategy filter.
                  </p>
                  <span class="tile-cta">Read Article &rarr;</span>
                </a>

                <a
                  href="/blog/jamb-score-not-improving"
                  class="article-tile"
                  id="articleScorePlateau"
                  data-analytics="sp_blog_article_click"
                >
                  <span class="tile-tag">Diagnostic</span>
                  <h4 class="tile-title">What to Do When Your JAMB Score Isn't Improving</h4>
                  <p class="tile-summary">
                    Diagnose whether your plateau is caused by knowledge gaps, application errors, or pacing.
                  </p>
                  <span class="tile-cta">Read Article &rarr;</span>
                </a>

                <a
                  href="/blog/how-to-prepare-for-jamb-2027"
                  class="article-tile"
                  id="articlePrepGuide"
                  data-analytics="sp_blog_article_click"
                >
                  <span class="tile-tag">System Guide</span>
                  <h4 class="tile-title">How to Prepare for JAMB 2027</h4>
                  <p class="tile-summary">
                    A deliberate, step-by-step study system built for students who want to build a foundation early.
                  </p>
                  <span class="tile-cta">Read Article &rarr;</span>
                </a>
              </div>

              <p class="reassurance-note">
                You don't have to figure everything out alone.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HOW TO GET THE MOST FROM YOUR EXPERIENCE -->
    <section class="sp-section rules-section" id="builderGuide" aria-labelledby="guideTitle">
      <div class="sp-container">
        <div class="section-header">
          <span class="section-tag">BUILDER'S CODE</span>
          <h2 id="guideTitle" class="section-title">HOW TO GET THE MOST FROM YOUR EXPERIENCE</h2>
          <p class="section-subtitle">
            Five simple principles for building lasting exam readiness.
          </p>
        </div>

        <ol class="rules-list">
          <li class="rule-item">
            <span class="rule-num">01</span>
            <div class="rule-content">
              <strong>START WITH THE BLUEPRINT</strong>
              <p>Don't let random materials decide what you study.</p>
            </div>
          </li>
          <li class="rule-item">
            <span class="rule-num">02</span>
            <div class="rule-content">
              <strong>FOLLOW ONE PLAN</strong>
              <p>Don't restart your preparation every time you discover a new resource.</p>
            </div>
          </li>
          <li class="rule-item">
            <span class="rule-num">03</span>
            <div class="rule-content">
              <strong>PRACTISE WHAT YOU LEARN</strong>
              <p>Understanding feels good. Application proves it.</p>
            </div>
          </li>
          <li class="rule-item">
            <span class="rule-num">04</span>
            <div class="rule-content">
              <strong>USE MISTAKES AS DATA</strong>
              <p>A wrong answer is useful when you understand why it was wrong.</p>
            </div>
          </li>
          <li class="rule-item">
            <span class="rule-num">05</span>
            <div class="rule-content">
              <strong>ALWAYS KNOW YOUR NEXT MOVE</strong>
              <p>Don't finish a study session wondering what to do tomorrow.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- SECTION 3: BUILDER'S BONUS -->
    <section class="sp-section bonus-section" id="bonus" aria-labelledby="bonusTitle">
      <div class="sp-container">
        <div class="bonus-card">
          <div class="bonus-header">
            <span class="bonus-tag">BUILDER'S BONUS</span>
            <h2 id="bonusTitle" class="bonus-title">YOUR FIRST 7 DAYS, MAPPED OUT.</h2>
          </div>

          <div class="bonus-text">
            <p class="bonus-pain">
              One of the hardest parts of starting UTME preparation isn't finding more materials. It's knowing what to do with the ones you already have.
            </p>
            <p class="bonus-sol">
              So we made your first 7 days simple.
            </p>
          </div>

          <div class="bonus-offer-box">
            <h3 class="offer-title">THE BUILDER'S 7-DAY STARTER MAP</h3>
            <p class="offer-desc">
              A simple, practical roadmap for knowing what to do during your first seven days of preparation &mdash; without jumping from one resource to another.
            </p>

            <div class="bonus-takeaways">
              <p>No more wondering what to study.</p>
              <p>No more jumping between resources.</p>
              <p>Just your next seven moves.</p>
            </div>

            <div class="offer-cta-wrap">
              <a
                href="https://wa.link/xz45m3"
                class="btn-bonus"
                target="_blank"
                rel="noopener"
                id="ctaStarterMap"
                data-analytics="sp_bonus_claim_cta"
              >
                <span>GET MY STARTER MAP</span>
                <span class="arrow-icon" aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <p class="bonus-claim-note">
              Tap above to open WhatsApp with your Builder claim message ready.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: FINAL COMMUNITY CLOSER -->
    <section class="sp-section final-cta-section" id="community" aria-labelledby="finalCtaTitle">
      <div class="sp-container">
        <div class="final-cta-box">
          <span class="section-tag">COMMUNITY</span>
          <h2 id="finalCtaTitle" class="final-cta-title">YOU DON'T HAVE TO PREPARE ALONE.</h2>
          <p class="final-cta-sub">
            Surround your preparation with serious students and mentors building with the exact same focus.
          </p>
          <div class="final-btn-wrap">
            <a
              href={channelUrl}
              class="btn-primary"
              target="_blank"
              rel="noopener"
              id="finalJoinBuilders"
              data-analytics="sp_final_join_builders"
            >
              <span>JOIN THE BUILDERS</span>
              <span class="arrow-icon" aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <p class="final-tagline">Brick by brick. Day by day. Because things built well last.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* =========================================================
     PAGE CONTAINER & LAYOUT
     ========================================================= */
  .sp-page {
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding-bottom: var(--space-20);
    overflow-x: hidden;
  }

  .sp-container {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  @media (max-width: 480px) {
    .sp-container {
      padding: 0 var(--space-4);
    }
  }

  .sp-section {
    padding: var(--space-16) 0;
  }

  @media (min-width: 768px) {
    .sp-section {
      padding: var(--space-20) 0;
    }
  }

  /* =========================================================
     TYPOGRAPHY & SECTION HEADERS
     ========================================================= */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .section-tag,
  .sp-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  .sp-badge {
    background: rgba(201, 162, 39, 0.12);
    border: 1px solid rgba(201, 162, 39, 0.35);
    padding: 4px 14px;
    border-radius: var(--radius-full);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.8vw, 2.25rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--text-light);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  /* =========================================================
     HERO SECTION
     ========================================================= */
  .sp-hero {
    text-align: center;
    padding: var(--space-20) 0 var(--space-14);
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .sp-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1.1;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .sp-hero-lead {
    font-size: clamp(1.1rem, 2.6vw, 1.35rem);
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
    max-width: 620px;
    margin: 0 auto var(--space-2);
  }

  .sp-hero-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: var(--space-8);
  }

  .sp-hero-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-anchor-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms ease;
    padding: var(--space-2) var(--space-3);
  }

  .hero-anchor-link:hover {
    color: var(--accent-text);
  }

  .arrow-down {
    transition: transform 160ms ease;
  }

  .hero-anchor-link:hover .arrow-down {
    transform: translateY(2px);
  }

  /* =========================================================
     BUTTONS
     ========================================================= */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.28);
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
    white-space: nowrap;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(201, 162, 39, 0.4);
    filter: brightness(1.05);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    padding: 10px 20px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .btn-secondary:hover {
    background: var(--surface);
    border-color: var(--accent);
    transform: translateX(3px);
  }

  .arrow-icon {
    transition: transform 160ms ease;
  }

  .btn-primary:hover .arrow-icon,
  .btn-secondary:hover .arrow-icon,
  .btn-bonus:hover .arrow-icon {
    transform: translateX(3px);
  }

  /* =========================================================
     YOUR BUILDER JOURNEY (CARDS)
     ========================================================= */
  .journey-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .journey-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--space-5);
    position: relative;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .journey-card:hover {
    border-color: rgba(201, 162, 39, 0.35);
  }

  @media (max-width: 580px) {
    .journey-card {
      grid-template-columns: 1fr;
      padding: var(--space-5);
      gap: var(--space-3);
    }
  }

  .card-num-badge {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--accent-text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
    line-height: 1.3;
    margin: 0;
  }

  .card-pain {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.55;
    margin: 0;
    border-left: 2px solid var(--accent);
    padding-left: var(--space-3);
  }

  .card-sol {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
  }

  .card-action {
    margin-top: var(--space-2);
  }

  /* Protocol artwork showcase */
  .protocol-showcase {
    margin-top: var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .protocol-link {
    display: block;
    cursor: zoom-in;
    border-radius: calc(var(--radius) - 2px);
    overflow: hidden;
  }

  .protocol-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: calc(var(--radius) - 2px);
    transition: transform 200ms ease;
  }

  .protocol-link:hover .protocol-img {
    transform: scale(1.01);
  }

  .protocol-legend {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--accent-text);
    text-align: center;
    margin-top: var(--space-3);
    line-height: 1.4;
  }

  @media (max-width: 580px) {
    .protocol-showcase {
      padding: 6px;
      margin-left: -6px;
      margin-right: -6px;
      border-radius: calc(var(--radius) - 2px);
    }

    .protocol-img {
      width: 100%;
      height: auto;
      transform: scale(1.02);
      transform-origin: center;
    }

    .protocol-legend {
      font-size: 0.68rem;
      letter-spacing: 0.03em;
      margin-top: var(--space-2);
    }
  }

  /* Blog Articles Mini-Grid */
  .blog-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .blog-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .article-tile {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .article-tile:hover {
    background: var(--surface);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .tile-tag {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    margin: 0 0 var(--space-2) 0;
  }

