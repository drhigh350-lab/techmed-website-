    height: 6px;
    border-radius: 50%;
  }

  .subj-header.physics .subj-dot { background: #38bdf8; }
  .subj-header.chemistry .subj-dot { background: #f43f5e; }
  .subj-header.english .subj-dot { background: #a855f7; }
  .subj-header.biology .subj-dot { background: #34d399; }
  .subj-header.mathematics .subj-dot { background: #fbbf24; }

  .topics-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .topic-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .topic-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
  }

  .topic-desc {
    font-size: 0.74rem;
    color: var(--text-light);
    margin: 0;
    line-height: 1.35;
  }

  /* CBT Feature Grid */
  .cbt-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .cbt-feature-box {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  :root[data-theme='light'] .cbt-schedule-card,
  html[data-theme='light'] .cbt-schedule-card {
    background: #ffffff;
    border-color: var(--border);
  }

  :root[data-theme='light'] .cbt-feature-box,
  html[data-theme='light'] .cbt-feature-box {
    background: var(--surface-raised);
    border-color: var(--border);
  }

  .feature-icon {
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  :root[data-theme='light'] .feature-icon,
  html[data-theme='light'] .feature-icon {
    color: var(--color-gold-text);
  }

  .cbt-feature-box h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 4px;
  }

  .cbt-feature-box p {
    font-size: 0.8rem;
    color: var(--text-light);
    margin: 0;
    line-height: 1.45;
  }

  /* Benefits & Resources */
  .benefits-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .benefits-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .section-sub {
    font-size: 0.88rem;
    color: var(--text-light);
    margin: 2px 0 0;
  }

  .resource-filter-bar {
    display: flex;
    gap: 6px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
    overflow-x: auto;
  }

  .filter-tab {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    background: none;
    border: none;
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all 150ms ease;
    white-space: nowrap;
  }

  .filter-tab:hover {
    color: var(--text);
  }

  .filter-tab.active {
    background: rgba(201, 162, 39, 0.15);
    color: var(--accent);
    font-weight: 700;
  }

  :root[data-theme='light'] .filter-tab,
  html[data-theme='light'] .filter-tab {
    color: var(--text-muted);
  }

  :root[data-theme='light'] .filter-tab:hover,
  html[data-theme='light'] .filter-tab:hover {
    color: var(--text);
  }

  :root[data-theme='light'] .filter-tab.active,
  html[data-theme='light'] .filter-tab.active {
    background: #fffdf5;
    color: var(--color-gold-text);
    border: 1px solid rgba(201, 162, 39, 0.4);
  }

  .resources-empty-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: rgba(201, 162, 39, 0.05);
    border: 1px dashed rgba(201, 162, 39, 0.35);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    flex-wrap: wrap;
  }

  :root[data-theme='light'] .resources-empty-banner,
  html[data-theme='light'] .resources-empty-banner {
    background: #fffdf5;
    border-color: rgba(201, 162, 39, 0.4);
  }

  .empty-icon-wrap {
    color: var(--accent);
    flex-shrink: 0;
  }

  :root[data-theme='light'] .empty-icon-wrap,
  html[data-theme='light'] .empty-icon-wrap {
    color: var(--color-gold-text);
  }

  .empty-text-wrap {
    flex-grow: 1;
    min-width: 240px;
  }

  .empty-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .empty-desc {
    font-size: 0.82rem;
    color: var(--text-light);
    margin: 2px 0 0;
    line-height: 1.4;
  }

  .empty-action-btn {
    padding: 6px 14px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: all 150ms ease;
  }

  :root[data-theme='light'] .empty-action-btn,
  html[data-theme='light'] .empty-action-btn {
    background: var(--surface-raised);
    color: var(--text);
    border-color: var(--border);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .resource-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :root[data-theme='light'] .resource-card,
  html[data-theme='light'] .resource-card {
    background: #ffffff;
    border-color: var(--border);
    box-shadow: 0 2px 8px rgba(1, 39, 72, 0.04);
  }

  .resource-card.card-owned {
    border-color: rgba(34, 197, 94, 0.3);
    background: rgba(34, 197, 94, 0.02);
  }

  :root[data-theme='light'] .resource-card.card-owned,
  html[data-theme='light'] .resource-card.card-owned {
    background: #f0fdf4;
    border-color: #86efac;
  }

  .resource-meta-top {
    font-size: 0.74rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .meta-owned {
    color: #4ade80;
    font-weight: 700;
  }

  .meta-unowned {
    color: var(--text-muted);
  }

  .resource-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.35;
  }

  .resource-access-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-light);
  }

  .access-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .access-dot.active { background: #22c55e; }
  .access-dot.locked { background: #facc15; }

  .card-action-wrap {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .resource-action-btn {
    display: inline-block;
    width: 100%;
    text-align: center;
    padding: 7px 12px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .unowned-action-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .resource-price {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text);
  }

  .benefits-list-box {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  :root[data-theme='light'] .benefits-list-box,
  html[data-theme='light'] .benefits-list-box {
    background: var(--surface-raised);
    border-color: var(--border);
  }

  .benefits-list-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 var(--space-3);
  }

  .benefits-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2) var(--space-4);
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .benefit-check {
    color: var(--accent);
    flex-shrink: 0;
  }

  :root[data-theme='light'] .benefit-check,
  html[data-theme='light'] .benefit-check {
    color: var(--color-gold-text);
  }

  /* Next steps panel */
  .next-steps-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  :root[data-theme='light'] .next-steps-panel,
  html[data-theme='light'] .next-steps-panel {
    background: var(--surface-raised);
    border-color: var(--border);
  }

  .panel-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .info-badge-icon {
    color: var(--accent);
    margin-top: 2px;
    flex-shrink: 0;
  }

  :root[data-theme='light'] .info-badge-icon,
  html[data-theme='light'] .info-badge-icon {
    color: var(--color-gold-text);
  }

  .panel-title-text h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 2px;
  }

  .panel-title-text p {
    font-size: 0.82rem;
    color: var(--text-light);
    margin: 0;
    line-height: 1.45;
  }

  .next-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .next-step-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .next-step-card.primary-step {
    border-color: rgba(201, 162, 39, 0.3);
  }

  :root[data-theme='light'] .next-step-card,
  html[data-theme='light'] .next-step-card {
    background: #ffffff;
    border-color: var(--border);
  }

  .step-card-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 2px;
  }

  .step-card-desc {
    font-size: 0.78rem;
    color: var(--text-light);
    margin: 0;
    line-height: 1.35;
  }

  .step-btn {
    display: inline-block;
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border-radius: var(--radius-sm);
    margin-top: auto;
  }

  /* Quick Tools Grid */
  .quick-tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .tool-card {
    display: flex;
    gap: var(--space-3);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-decoration: none;
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .tool-card:hover {
    border-color: rgba(201, 162, 39, 0.3);
    transform: translateY(-2px);
  }

  :root[data-theme='light'] .tool-card,
  html[data-theme='light'] .tool-card {
    background: var(--surface-raised);
    border-color: var(--border);
  }

  :root[data-theme='light'] .tool-card:hover,
  html[data-theme='light'] .tool-card:hover {
    background: #ffffff;
    border-color: var(--color-gold-deep);
  }

  .tool-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  :root[data-theme='light'] .tool-icon,
  html[data-theme='light'] .tool-icon {
    color: var(--color-gold-text);
  }

  .tool-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tool-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
  }

  .tool-desc {
    font-size: 0.78rem;
    color: var(--text-light);
    line-height: 1.35;
  }

  /* Apple-Inspired Segmented Control Switcher */
  .segmented-control-container {
    position: sticky;
    top: 72px;
    z-index: 30;
    margin: var(--space-2) 0 var(--space-4);
    background: rgba(1, 39, 72, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 6px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  }

  :root[data-theme='light'] .segmented-control-container,
  html[data-theme='light'] .segmented-control-container {
    background: rgba(248, 249, 250, 0.94);
    border: 1px solid var(--border);
    box-shadow: 0 4px 16px rgba(1, 39, 72, 0.08);
  }

  .dashboard-segmented-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 2px;
  }

  .segment-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 14px;
    min-height: 42px;
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-soft-blue);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    white-space: nowrap;
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    flex: 1 1 calc(20% - 6px);
  }

  .segment-btn:hover {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.06);
  }

  :root[data-theme='light'] .segment-btn,
  html[data-theme='light'] .segment-btn {
    color: var(--text-light);
  }

  :root[data-theme='light'] .segment-btn:hover,
  html[data-theme='light'] .segment-btn:hover {
    color: var(--text);
    background: rgba(1, 39, 72, 0.05);
  }

  .segment-btn.active {
    color: var(--color-white);
    background: var(--color-professional-blue);
    border-color: rgba(201, 162, 39, 0.5);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
    font-weight: 700;
