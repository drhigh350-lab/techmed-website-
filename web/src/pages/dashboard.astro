  :root[data-theme='light'] .segment-btn.active,
  html[data-theme='light'] .segment-btn.active {
    color: var(--color-deep-navy);
    background: #ffffff;
    border-color: var(--color-gold);
    box-shadow: 0 2px 8px rgba(1, 39, 72, 0.12);
  }

  :root[data-theme='light'] .segment-btn.active svg,
  html[data-theme='light'] .segment-btn.active svg {
    color: var(--color-gold-text);
  }

  /* Today's Live Class Glance Card */
  .today-glance-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
