  .mobile-day-cards {
    display: none;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .day-schedule-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-4);
