    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .today-break-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .break-pill-small {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-gold);
    background: rgba(201, 162, 39, 0.15);
    border: 1px dashed rgba(201, 162, 39, 0.4);
    padding: 3px 8px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  :root[data-theme='light'] .break-pill-small,
  html[data-theme='light'] .break-pill-small {
    color: var(--color-gold-text);
    background: rgba(201, 162, 39, 0.1);
    border-color: rgba(201, 162, 39, 0.35);
