  :root[data-theme='light'] .today-glance-card,
  html[data-theme='light'] .today-glance-card {
    background: #ffffff;
    border-color: var(--border);
    border-left: 4px solid var(--accent-text);
  }

  .today-badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .live-pulse-dot {
    width: 10px;
    height: 10px;
    background-color: #22c55e;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulse-ring 2s infinite cubic-bezier(0.45, 0, 0.55, 1);
  }

  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .today-day-label {
    font-family: var(--font-display);
    font-size: 0.96rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .today-time-badge {
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-gold);
    background: rgba(201, 162, 39, 0.12);
    border: 1px solid rgba(201, 162, 39, 0.3);
    padding: 2px 10px;
    border-radius: var(--radius-full);
  }

  :root[data-theme='light'] .today-time-badge,
  html[data-theme='light'] .today-time-badge {
    color: var(--color-gold-text);
    background: rgba(201, 162, 39, 0.1);
    border-color: rgba(201, 162, 39, 0.35);
  }

  .today-sessions-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3);
    align-items: center;
    background: rgba(1, 39, 72, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }

  :root[data-theme='light'] .today-sessions-grid,
