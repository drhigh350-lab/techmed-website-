    flex-direction: column;
    gap: 4px;
  }

  .session-tag-small {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
  }

  .today-session-subject {
