---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResourceCard from '../components/ResourceCard.astro';
import PlaceholderPreview from '../components/PlaceholderPreview.astro';
---

<BaseLayout
  title="Tools — TECHMED"
  description="KAIRO, the Study Planner, CBT Practice and other tools."
>
  <ComingSoon
    title="Tools"
    description="KAIRO, the Study Planner, CBT Practice and other product tools are coming to this page soon."
  />

  <section class="preview-section">
    <SectionHeading title="What's coming to this page" align="center" />
    <PlaceholderPreview label="KAIRO Preview" />
    <div class="grid">
      <ResourceCard
        title="KAIRO"
        description="The intelligent learning system that understands your journey and helps you know what to do next."
        tag="Learning"
        comingSoon
      />
      <ResourceCard
        title="Study Planner"
        description="Turn a syllabus into a realistic weekly rhythm you can actually stick to."
        tag="Planning"
        comingSoon
      />
      <ResourceCard
        title="CBT Practice"
        description="Timed, exam-format practice that builds real speed and confidence under pressure."
        tag="Practice"
        comingSoon
      />
    </div>
  </section>
</BaseLayout>

<style>
  .preview-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-24);
  }

  .preview-section > :global(.preview) {
    margin-bottom: var(--space-8);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
