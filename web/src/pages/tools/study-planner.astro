---
// The Study Planner -- a client-side tool (no accounts, no backend; see
// src/lib/plannerEngine.ts for why) that turns a student's own exam date,
// available time, subjects and starting point into a realistic sequence of
// what to study next, using the real TECHMED Blueprint data already in
// Sanity (src/lib/syllabus.ts). Plans persist in localStorage on this
// device only.
//
// Design intent (per the product redesign this implements): the planner
// shows the student the DECISION already made for them -- today, this
// week, why -- not the raw output of the scheduling algorithm. The full
// 36-week roadmap exists for reassurance, collapsed behind a disclosure,
// not as the first thing on screen.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSubjects } from '../../lib/syllabus';

const subjects = await getSubjects();
// Only the subjects with real Blueprint stage/topic data can be sequenced
// meaningfully -- matches the "using TECHMED Blueprint where available"
// wording in the brief exactly, rather than silently including subjects
// with no stages to plan against.
const plannableSubjects = subjects.filter((s) => s.stages && s.stages.length > 0);

const pageUrl = new URL('/tools/study-planner', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TECHMED Study Planner',
    url: pageUrl,
    applicationCategory: 'EducationApplication',
    description: 'Turn your UTME subjects, available time and exam date into a realistic sequence of what to study next, sequenced against the TECHMED Blueprint.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: 'Study Planner', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="Study Planner — TECHMED"
  description="Know what to study next. Tell it your subjects, your real available time and your exam date -- it sequences the TECHMED Blueprint into today's tasks, this week's route, and the road to your exam."
  jsonLd={jsonLd}
>
  <div class="planner" id="planner" data-subjects={JSON.stringify(plannableSubjects)}>

    <!-- INTRO -->
    <section class="intro" id="introSection">
      <p class="eyebrow">Tools &middot; Study Planner</p>
      <h1>Know what to study next.</h1>
      <p class="lede">You already have timetables, textbooks, YouTube and group chats. What you don't have is one place that answers the actual question: out of everything you could study right now, what makes sense next? Tell it your subjects, your real available time and your exam date &mdash; it builds the route from the TECHMED Blueprint.</p>
    </section>

    <!-- ONBOARDING WIZARD -->
    <section class="wizard" id="wizardSection">
      <div class="wizard-progress" id="wizardProgress" role="group" aria-label="Setup progress"></div>

      <form id="plannerForm" novalidate>

        <div class="wiz-step" data-step="date">
          <h2>When are you writing UTME?</h2>
          <p class="step-hint">Your best current estimate is fine &mdash; confirm the exact date on jamb.gov.ng closer to the time.</p>
          <input type="date" id="targetDate" name="targetDate" required />
        </div>

        <div class="wiz-step" data-step="subjects" hidden>
          <h2>Which subjects are you taking?</h2>
          <p class="step-hint">Use of English is required for every UTME candidate. Choose exactly 3 more.</p>
          <div class="subject-picker" id="subjectPicker"></div>
        </div>

        <div class="wiz-step" data-step="capacity" hidden>
          <h2>How much time can you realistically protect each week?</h2>
          <p class="step-hint">Not how much you'd <em>like</em> to study &mdash; how much you can actually promise, most weeks.</p>
          <div class="field-group">
            <span class="field-label">Days you can usually study</span>
            <div class="day-toggles" id="dayToggles" role="group" aria-label="Available days">
              {['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map((d, i) => (
                <button type="button" class="day-toggle" data-day={i} aria-pressed="false">{d}</button>
              ))}
            </div>
          </div>
          <div class="field-group">
            <label class="field-label" for="hoursPerDay">Focused hours on a normal study day</label>
            <input type="number" id="hoursPerDay" name="hoursPerDay" min="0.5" max="12" step="0.5" value="2" required />
          </div>
        </div>

        <div class="wiz-step" data-step="starting-point" hidden>
          <h2>Where are you starting from?</h2>
          <p class="step-hint">Rough is fine &mdash; this isn't a test.</p>
          <div id="subjectDetails" class="subject-details"></div>
        </div>

        <div class="wiz-step" data-step="review" hidden>
          <h2>That's enough.</h2>
          <p class="step-hint">We'll build your route from the TECHMED Blueprint.</p>
          <div class="review-summary" id="reviewSummary"></div>
        </div>

        <p class="step-error" id="stepError" hidden></p>

        <div class="wiz-nav">
          <button type="button" class="btn-secondary" id="wizBack" hidden>Back</button>
          <button type="button" class="btn-primary" id="wizNext">Continue</button>
          <button type="submit" class="btn-primary" id="wizBuild" hidden>Build my plan</button>
        </div>
      </form>
    </section>

    <!-- BUILDING TRANSITION -->
    <section class="building no-print" id="buildingSection" hidden>
      <p class="building-title">Building your route</p>
      <ul class="building-steps" id="buildingSteps">
        <li>Checking your available time&hellip;</li>
        <li>Sequencing the Blueprint&hellip;</li>
        <li>Protecting revision time&hellip;</li>
        <li>Balancing your subjects&hellip;</li>
      </ul>
    </section>

    <!-- RESULTS -->
    <section class="results" id="resultsSection" hidden>

      <div class="results-header no-print">
        <div>
          <p class="eyebrow" id="resultsEyebrow"></p>
          <h1 id="resultsHeading">Your Plan</h1>
        </div>
        <div class="toolbar-actions">
          <button type="button" class="btn-secondary" id="printBtn">Print</button>
          <button type="button" class="btn-secondary" id="adjustBtn">Adjust my plan</button>
          <button type="button" class="btn-text" id="startOverBtn">Start over</button>
        </div>
      </div>

      <div class="return-banner no-print" id="returnBanner" hidden></div>

      <div class="phase-banner no-print" id="phaseBanner"></div>

      <div class="constraint-box no-print" id="constraintBox" hidden></div>

      <!-- Deliberately right here, not after the roadmap: this is what
           "Adjust my plan" (in the header above) and the constraint box's
           own action chips both open, so it needs to appear where a
           student is already looking, not several cards further down. -->
      <div class="adjust-panel no-print" id="adjustPanel" hidden>
        <h3>What's changed?</h3>
        <div class="adjust-options" id="adjustOptions">
          <button type="button" data-adjust="missed">I missed some study days</button>
          <button type="button" data-adjust="less-time">I have less time now</button>
          <button type="button" data-adjust="more-time">I have more time now</button>
          <button type="button" data-adjust="date">I want to change my exam date</button>
        </div>
        <div class="adjust-edit" id="adjustEdit" hidden></div>
      </div>

      <div class="today-card no-print" id="todayCard">
        <p class="card-label">Today</p>
        <ul class="task-list" id="todayTasks"></ul>
      </div>

      <div class="week-card no-print" id="weekCard">
        <p class="card-label">This Week</p>
        <p class="week-summary" id="weekSummary"></p>
        <ul class="week-list" id="weekTasks"></ul>
      </div>

      <div class="progress-card no-print" id="progressCard">
        <p class="card-label">Your Progress</p>
        <div class="progress-stats" id="progressStats"></div>
      </div>

      <details class="route-disclosure no-print" id="routeDisclosure">
        <summary>See your full route</summary>
        <div class="roadmap-weeks" id="roadmapWeeks"></div>
      </details>

      <!-- Printable version: always in the DOM, hidden on screen -- built
           fresh, not a raw dump of the on-screen sections (see printBtn's
           handler for why). -->
      <div class="print-sheet" id="printSheet"></div>

    </section>

  </div>
</BaseLayout>

<script>
  import type { Subject, SubjectStage } from '../../lib/syllabus';
  import {
    buildPlan,
    getWeekForDate,
    getTasksForDate,
    getCurrentPhase,
    snapshotPlan,
    diffPlans,
    topicHours,
    addDays,
    type PlannerInput,
    type PlannerSubjectInput,
    type ConfidenceLevel,
    type PlannerPlan,
    type WeekPlan,
    type DayTask,
  } from '../../lib/plannerEngine';
  import {
    saveInput,
    loadInput,
    clearInput,
    loadCompletedKeys,
    markTopicComplete,
    clearProgress,
    todayIso,
    savePlanSnapshot,
    loadPlanSnapshot,
    clearPlanSnapshot,
  } from '../../lib/plannerStorage';

  const root = document.getElementById('planner') as HTMLElement;
  const subjects: Subject[] = JSON.parse(root.dataset.subjects || '[]');
  const subjectBySlug = new Map(subjects.map((s) => [s.slug, s]));

  const ENGLISH_SLUG = 'use-of-english';
  const ELECTIVE_SLUGS = subjects.map((s) => s.slug).filter((slug) => slug !== ENGLISH_SLUG);
  const MAX_ELECTIVES = 3;

  const introSection = document.getElementById('introSection') as HTMLElement;
  const wizardSection = document.getElementById('wizardSection') as HTMLElement;
  const buildingSection = document.getElementById('buildingSection') as HTMLElement;
  const resultsSection = document.getElementById('resultsSection') as HTMLElement;
  const form = document.getElementById('plannerForm') as HTMLFormElement;
  const stepError = document.getElementById('stepError') as HTMLElement;

  function subjectLabel(slug: string): string {
    return subjectBySlug.get(slug)?.name ?? slug;
  }

  function cleanStageName(name: string): string {
    return name.replace(/^\d+\s*—\s*/, '');
  }

  // ============================================================
  // WIZARD -- one focused question per screen, not one long form.
  // ============================================================
  const WIZARD_STEPS = ['date', 'subjects', 'capacity', 'starting-point', 'review'] as const;
  type WizardStep = (typeof WIZARD_STEPS)[number];
  const STEP_TITLES: Record<WizardStep, string> = {
    date: 'Exam date',
    subjects: 'Subjects',
    capacity: 'Weekly time',
    'starting-point': 'Starting point',
    review: 'Review',
  };
  let stepIndex = 0;

  const stepEls = new Map<WizardStep, HTMLElement>(
    WIZARD_STEPS.map((s) => [s, document.querySelector(`.wiz-step[data-step="${s}"]`) as HTMLElement]),
  );
  const wizardProgress = document.getElementById('wizardProgress') as HTMLElement;
  const wizBack = document.getElementById('wizBack') as HTMLButtonElement;
  const wizNext = document.getElementById('wizNext') as HTMLButtonElement;
  const wizBuild = document.getElementById('wizBuild') as HTMLButtonElement;

  function renderWizardProgress() {
    wizardProgress.innerHTML =
      `<span class="wizard-step-label">Step ${stepIndex + 1} of ${WIZARD_STEPS.length} &middot; ${STEP_TITLES[WIZARD_STEPS[stepIndex]]}</span>` +
      '<span class="wizard-dots">' +
      WIZARD_STEPS.map((_, i) => `<span class="wizard-dot${i === stepIndex ? ' active' : ''}${i < stepIndex ? ' done' : ''}"></span>`).join('') +
      '</span>';
  }

  function showStep(index: number) {
    stepIndex = index;
    stepError.hidden = true;
    for (const [step, el] of stepEls) {
      el.hidden = WIZARD_STEPS[index] !== step;
    }
    wizBack.hidden = index === 0;
    const isLast = index === WIZARD_STEPS.length - 1;
    wizNext.hidden = isLast;
    wizBuild.hidden = !isLast;
    renderWizardProgress();
    if (WIZARD_STEPS[index] === 'starting-point') renderSubjectDetails();
    if (WIZARD_STEPS[index] === 'review') renderReviewSummary();
  }

  function showStepError(message: string) {
    stepError.textContent = message;
    stepError.hidden = false;
  }

  function validateCurrentStep(): boolean {
    const step = WIZARD_STEPS[stepIndex];
    if (step === 'date') {
      const value = (document.getElementById('targetDate') as HTMLInputElement).value;
      if (!value) return showStepError('Pick a date to continue.'), false;
      if (value <= todayIso()) return showStepError('Pick a date after today.'), false;
      return true;
    }
    if (step === 'subjects') {
      if (selectedElectives.size !== MAX_ELECTIVES) {
        return showStepError(`Choose exactly ${MAX_ELECTIVES} electives alongside Use of English.`), false;
      }
      return true;
    }
    if (step === 'capacity') {
      const days = dayToggles.filter((b) => b.getAttribute('aria-pressed') === 'true');
      if (days.length === 0) return showStepError('Select at least one day.'), false;
      return true;
    }
    return true;
  }

  wizNext.addEventListener('click', () => {
    if (!validateCurrentStep()) return;
    showStep(stepIndex + 1);
    wizardSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  wizBack.addEventListener('click', () => {
    showStep(stepIndex - 1);
    wizardSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // --- Subject picker (Use of English fixed + up to 3 electives) ---
  const subjectPicker = document.getElementById('subjectPicker') as HTMLElement;
  const subjectDetails = document.getElementById('subjectDetails') as HTMLElement;
  const selectedElectives = new Set<string>();

  function renderSubjectPicker() {
    subjectPicker.innerHTML = '';
    const englishSubject = subjectBySlug.get(ENGLISH_SLUG);
    if (englishSubject) {
      const chip = document.createElement('div');
      chip.className = 'subject-chip fixed';
      chip.textContent = englishSubject.name;
      chip.innerHTML += '<span class="chip-note">Required</span>';
      subjectPicker.appendChild(chip);
    }
    for (const slug of ELECTIVE_SLUGS) {
      const subject = subjectBySlug.get(slug);
      if (!subject) continue;
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'subject-chip';
      chip.textContent = subject.name;
      chip.dataset.slug = slug;
      chip.setAttribute('aria-pressed', 'false');
      chip.addEventListener('click', () => toggleElective(slug, chip));
      subjectPicker.appendChild(chip);
    }
  }

  function toggleElective(slug: string, chip: HTMLButtonElement) {
    if (selectedElectives.has(slug)) {
      selectedElectives.delete(slug);
      chip.classList.remove('selected');
      chip.setAttribute('aria-pressed', 'false');
    } else {
      if (selectedElectives.size >= MAX_ELECTIVES) return;
      selectedElectives.add(slug);
      chip.classList.add('selected');
      chip.setAttribute('aria-pressed', 'true');
    }
  }

  function currentSubjectSlugs(): string[] {
    const slugs = [...selectedElectives];
    if (subjectBySlug.has(ENGLISH_SLUG)) slugs.push(ENGLISH_SLUG);
    return slugs;
  }

  // --- Capacity: day toggles ---
  const dayToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('#dayToggles .day-toggle'));
  dayToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pressed = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!pressed));
      btn.classList.toggle('selected', !pressed);
    });
  });

  // --- Starting point: coarse per-subject picker, precise only on request ---
  // "Starting fresh" / "Mostly covered" need no further input at all --
  // only "Covered some" reveals the stage list, and only for someone who
  // asked for that precision. Matches the brief's "don't ask them to rate
  // 150 topics" instruction.
  type CoarseStart = 'fresh' | 'some' | 'most';

  function renderSubjectDetails() {
    subjectDetails.innerHTML = '';
    for (const slug of currentSubjectSlugs()) {
      const subject = subjectBySlug.get(slug);
      if (!subject) continue;
      const stages = [...subject.stages].sort((a, b) => a.order - b.order);

      const wrap = document.createElement('div');
      wrap.className = 'subject-detail';
      wrap.dataset.slug = slug;

      const heading = document.createElement('p');
      heading.className = 'subject-detail-name';
      heading.textContent = subject.name;
      wrap.appendChild(heading);

      // Confidence
      const confRow = document.createElement('div');
      confRow.className = 'detail-row';
      confRow.innerHTML = `<span class="mini-label">How confident do you feel right now?</span>`;
      const confOptions: { value: ConfidenceLevel; label: string }[] = [
        { value: 'low', label: 'Low' },
        { value: 'medium', label: 'Medium' },
        { value: 'high', label: 'High' },
      ];
      const confSegmented = document.createElement('div');
      confSegmented.className = 'segmented';
      confSegmented.dataset.role = 'confidence';
      confOptions.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = opt.label;
        btn.dataset.value = opt.value;
        btn.className = 'segmented-btn' + (i === 1 ? ' selected' : '');
        btn.addEventListener('click', () => {
          confSegmented.querySelectorAll('.segmented-btn').forEach((b) => b.classList.remove('selected'));
          btn.classList.add('selected');
        });
        confSegmented.appendChild(btn);
      });
      confRow.appendChild(confSegmented);
      wrap.appendChild(confRow);

      // Coarse starting point
      const startRow = document.createElement('div');
      startRow.className = 'detail-row';
      startRow.innerHTML = `<span class="mini-label">Where are you starting from?</span>`;
      const startSegmented = document.createElement('div');
      startSegmented.className = 'segmented';
      startSegmented.dataset.role = 'coarse-start';
      const stageSelect = document.createElement('select');
      stageSelect.className = 'stage-select';
      stageSelect.hidden = true;
      stages.forEach((stage, i) => {
        const option = document.createElement('option');
        option.value = String(i);
        option.textContent = cleanStageName(stage.name);
        stageSelect.appendChild(option);
      });
      stageSelect.dataset.startingIndex = '0';

      const coarseOptions: { value: CoarseStart; label: string }[] = [
        { value: 'fresh', label: 'Starting fresh' },
        { value: 'some', label: "I've covered some" },
        { value: 'most', label: 'Mostly covered' },
      ];
      coarseOptions.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = opt.label;
        btn.dataset.value = opt.value;
        btn.className = 'segmented-btn' + (i === 0 ? ' selected' : '');
        btn.addEventListener('click', () => {
          startSegmented.querySelectorAll('.segmented-btn').forEach((b) => b.classList.remove('selected'));
          btn.classList.add('selected');
          if (opt.value === 'fresh') {
            stageSelect.hidden = true;
            stageSelect.dataset.startingIndex = '0';
          } else if (opt.value === 'most') {
            stageSelect.hidden = true;
            stageSelect.dataset.startingIndex = String(Math.max(0, stages.length - 1));
          } else {
            stageSelect.hidden = false;
          }
        });
        startSegmented.appendChild(btn);
      });
      startRow.appendChild(startSegmented);
      startRow.appendChild(stageSelect);
      wrap.appendChild(startRow);

      subjectDetails.appendChild(wrap);
    }
  }

  function renderReviewSummary() {
    const summary = document.getElementById('reviewSummary') as HTMLElement;
    const targetDate = (document.getElementById('targetDate') as HTMLInputElement).value;
    const hoursPerDay = (document.getElementById('hoursPerDay') as HTMLInputElement).value;
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const chosenDays = dayToggles
      .filter((b) => b.getAttribute('aria-pressed') === 'true')
      .map((b) => dayNames[parseInt(b.dataset.day || '0', 10)]);
    const subjectNames = currentSubjectSlugs().map(subjectLabel);
    const formattedDate = targetDate
      ? new Date(targetDate + 'T00:00:00').toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
      : '—';

    summary.innerHTML = `
      <ul class="review-list">
        <li><span>Exam date</span><strong>${formattedDate}</strong></li>
        <li><span>Subjects</span><strong>${subjectNames.join(', ')}</strong></li>
        <li><span>Study days</span><strong>${chosenDays.join(', ') || '—'}</strong></li>
        <li><span>Hours per study day</span><strong>${hoursPerDay}h</strong></li>
      </ul>`;
  }

  renderSubjectPicker();
  showStep(0);

  // ============================================================
  // BUILD -- submit the wizard, show the brief "building" transition,
  // then reveal the results screen.
  // ============================================================
  function readPlannerInputFromForm(): PlannerInput | null {
    const targetDate = (document.getElementById('targetDate') as HTMLInputElement).value;
    const hoursPerAvailableDay = parseFloat((document.getElementById('hoursPerDay') as HTMLInputElement).value);
    const availableDays = dayToggles
      .filter((b) => b.getAttribute('aria-pressed') === 'true')
      .map((b) => parseInt(b.dataset.day || '0', 10));
    if (!targetDate || availableDays.length === 0 || selectedElectives.size !== MAX_ELECTIVES) return null;

    const plannerSubjects: PlannerSubjectInput[] = currentSubjectSlugs().map((slug) => {
      const detailEl = subjectDetails.querySelector(`.subject-detail[data-slug="${slug}"]`) as HTMLElement;
      const confidence =
        (detailEl?.querySelector('[data-role="confidence"] .segmented-btn.selected') as HTMLElement)?.dataset.value as ConfidenceLevel || 'medium';
      const stageSelect = detailEl?.querySelector('.stage-select') as HTMLSelectElement;
      const startingStageIndex = stageSelect?.hidden
        ? parseInt(stageSelect.dataset.startingIndex || '0', 10)
        : parseInt(stageSelect?.value || '0', 10);
      return { slug, confidence, startingStageIndex };
    });

    return { targetDate, availableDays, hoursPerAvailableDay, subjects: plannerSubjects, createdAt: todayIso() };
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = readPlannerInputFromForm();
    if (!input) {
      showStepError('Something in your setup is incomplete -- go back and check each step.');
      return;
    }
    saveInput(input);
    clearProgress();
    runBuildingTransition(() => {
      introSection.hidden = true;
      wizardSection.hidden = true;
      currentPlan = buildPlan({ input, allSubjects: subjects });
      renderAll(currentPlan);
      resultsSection.hidden = false;
    });
  });

  function runBuildingTransition(onDone: () => void) {
    wizardSection.hidden = true;
    buildingSection.hidden = false;
    const lines = Array.from(document.querySelectorAll('#buildingSteps li'));
    lines.forEach((li) => li.classList.remove('done'));
    lines.forEach((li, i) => {
      setTimeout(() => li.classList.add('done'), 180 * (i + 1));
    });
    setTimeout(() => {
      buildingSection.hidden = true;
      onDone();
    }, 180 * lines.length + 260);
  }

  // ============================================================
  // RESULTS
  // ============================================================
  let currentPlan: PlannerPlan | null = null;

  function renderAll(plan: PlannerPlan) {
    renderHeader(plan);
    renderPhaseBanner(plan);
    renderConstraintBox(plan);
    renderToday(plan);
    renderWeek(plan);
    renderProgressCard(plan);
    renderRoadmap(plan, 'roadmapWeeks');
    renderPrintSheet(plan);
  }

  function renderHeader(plan: PlannerPlan) {
    const eyebrow = document.getElementById('resultsEyebrow') as HTMLElement;
    const heading = document.getElementById('resultsHeading') as HTMLElement;
    eyebrow.textContent = `${plan.totalWeeks} weeks to your exam · about ${plan.weeklyCapacityHours}h a week`;
    heading.textContent = 'Your Plan';
  }

  function renderPhaseBanner(plan: PlannerPlan) {
    const el = document.getElementById('phaseBanner') as HTMLElement;
    const week = getWeekForDate(plan, todayIso()) ?? plan.weeks[0];
    if (!week) { el.innerHTML = ''; return; }
    const phase = getCurrentPhase(plan, week, subjects);

    if (phase.isReviewPhase) {
      el.innerHTML = `
        <p class="phase-label">Revision phase</p>
        <p class="phase-copy">Most new learning is done. Your plan is shifting toward retrieval and practice before the exam.</p>`;
      return;
    }

    // Explicit about what this is -- "Foundations" alone reads as
    // ambiguous (completed? starting point? current?). It's neither: it's
    // the stage each subject is currently working through.
    el.innerHTML = `
      <p class="phase-label">Current Blueprint stage</p>
      <p class="phase-copy">Where each subject is right now in its TECHMED Blueprint sequence.</p>
      <div class="phase-chips">
        ${phase.subjectPhases
          .map((p) => `<span class="phase-chip"><strong>${p.subjectName}</strong> ${cleanStageName(p.stageName)}</span>`)
          .join('')}
      </div>`;
  }

  function renderConstraintBox(plan: PlannerPlan) {
    const box = document.getElementById('constraintBox') as HTMLElement;
    if (plan.warnings.length === 0) {
      box.hidden = true;
      box.innerHTML = '';
      return;
    }
    box.hidden = false;
    box.innerHTML = `
      <p class="constraint-title">One thing to know</p>
      <p class="constraint-copy">Your current plan is realistic, but some coverage will need to be lighter unless you create more study time. It still prioritizes the most important sequence first and protects your revision time.</p>
      <p class="constraint-lead">What you can do</p>
      <div class="constraint-actions">
        <button type="button" class="chip-action" data-action="open-adjust-time">Add study time</button>
        <button type="button" class="chip-action" data-action="open-adjust-date">Move my target date</button>
        <button type="button" class="chip-action ghost" data-action="dismiss-constraint">Continue with this plan</button>
      </div>
      <details class="constraint-details">
        <summary>See the numbers</summary>
        <ul>
          ${plan.warnings.map((w) => `<li><strong>${w.subjectName}</strong>: about ${w.topicsThatFit} of ${w.topicCount} topics realistically fit.</li>`).join('')}
        </ul>
      </details>`;

    box.querySelector('[data-action="dismiss-constraint"]')?.addEventListener('click', () => { box.hidden = true; });
    box.querySelector('[data-action="open-adjust-time"]')?.addEventListener('click', () => openAdjustEdit('less-time'));
    box.querySelector('[data-action="open-adjust-date"]')?.addEventListener('click', () => openAdjustEdit('date'));
  }

  function taskTagHtml(kind: DayTask['kind']): string {
    return kind === 'review' ? '<span class="tag tag-review">Review</span>' : '<span class="tag tag-new">New</span>';
  }

  // Display-only session length -- deliberately NOT the same number as
  // topicHours() in plannerEngine.ts, which is the multi-hour *total*
  // budget the scheduler spends on a topic across however many days it
  // takes to cover it. What a student needs here is "how long is today's
  // sitting," a much smaller, single-session figure. Review sessions are
  // shorter by nature (retrieval practice on something already learned,
  // not first-pass learning).
  const SESSION_MINUTES_NEW: Record<'foundational' | 'low' | 'medium' | 'high', number> = {
    foundational: 45,
    low: 45,
    medium: 60,
    high: 75,
  };
  const SESSION_MINUTES_REVIEW = 30;

  function taskAction(task: DayTask): { verb: string; minutes: number } {
    if (task.kind === 'review') return { verb: 'Revisit + practice', minutes: SESSION_MINUTES_REVIEW };
    const tier = task.examWeight?.tier ?? 'medium';
    return { verb: 'Learn + practice', minutes: SESSION_MINUTES_NEW[tier] };
  }

  function taskActionHtml(task: DayTask): string {
    const { verb, minutes } = taskAction(task);
    return `<span class="task-action">${verb} &middot; ~${minutes} min</span>`;
  }

  function whyThisNext(task: DayTask): string {
    if (task.kind === 'review') {
      return `Coming back to this because it's due another retrieval pass -- that's what makes it stick.`;
    }
    const stage = cleanStageName(task.stageName);
    if (task.prerequisites && task.prerequisites.length > 0) {
      return `It follows ${task.prerequisites.join(' and ')} in your ${task.subjectName} Blueprint (${stage} stage).`;
    }
    return `It's one of the starting points in your ${task.subjectName} Blueprint (${stage} stage).`;
  }

  /** Scans forward day by day (bounded by the plan's own length) for the next day with something scheduled -- the data behind "you're done for today, here's what's next" instead of a bare empty state. */
  function findNextTask(plan: PlannerPlan, fromDateIso: string): { date: string; task: DayTask } | null {
    const horizonDays = plan.totalWeeks * 7 + 7;
    let date = fromDateIso;
    for (let i = 0; i < horizonDays; i++) {
      date = addDays(date, 1);
      if (date > plan.input.targetDate) break;
      const tasks = getTasksForDate(plan, date);
      if (tasks.length > 0) return { date, task: tasks[0] };
    }
    return null;
  }

  function formatDayLabel(iso: string): string {
    const d = new Date(iso + 'T00:00:00');
    const dayName = d.toLocaleDateString(undefined, { weekday: 'long' });
    const isWithinWeek = (d.getTime() - new Date(todayIso() + 'T00:00:00').getTime()) / (1000 * 60 * 60 * 24) < 7;
    return isWithinWeek ? dayName : `${dayName}, ${d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`;
  }

  function renderToday(plan: PlannerPlan) {
    const today = todayIso();
    const tasks = getTasksForDate(plan, today);
    const completed = loadCompletedKeys();
    const list = document.getElementById('todayTasks') as HTMLElement;
    list.innerHTML = '';

    if (tasks.length === 0) {
      const next = findNextTask(plan, today);
      const li = document.createElement('li');
      li.className = 'task-empty';
      if (next) {
        const { verb, minutes } = taskAction(next.task);
        li.innerHTML = `
          <p class="next-up-title">You're done for today.</p>
          <p class="next-up-copy">Your next study session is <strong>${formatDayLabel(next.date)}</strong> &mdash; ${subjectLabel(next.task.subjectSlug)}: ${next.task.topicTitle} (${verb.toLowerCase()} &middot; ~${minutes} min).</p>`;
      } else {
        li.textContent = "Nothing left scheduled between now and your exam date -- take the win.";
      }
      list.appendChild(li);
      return;
    }

    tasks.forEach((task, i) => {
      const li = document.createElement('li');
      li.className = 'task-item';
      const id = `task-${task.key}`.replace(/[^a-zA-Z0-9-]/g, '_');
      const isDone = completed.has(task.key);
      li.innerHTML = `
        <div class="task-row">
          <span class="task-number">${i + 1}</span>
          <label class="task-main" for="${id}">
            <input type="checkbox" id="${id}" ${isDone ? 'checked' : ''} />
            <span class="task-text">
              <span class="task-subject">${subjectLabel(task.subjectSlug)}</span>
              <span class="task-topic">${task.topicTitle}</span>
              ${taskActionHtml(task)}
            </span>
            ${taskTagHtml(task.kind)}
          </label>
        </div>
        <details class="why-next">
          <summary>Why this?</summary>
          <p>${whyThisNext(task)}</p>
        </details>
        ${task.kind === 'first-pass' ? `<p class="practice-nudge" data-practice-nudge hidden>Nice. When you're ready, test yourself with past questions on &ldquo;${task.topicTitle}.&rdquo;</p>` : ''}
      `;
      const checkbox = li.querySelector('input') as HTMLInputElement;
      const nudge = li.querySelector('[data-practice-nudge]') as HTMLElement | null;
      if (nudge) nudge.hidden = !isDone;
      checkbox.addEventListener('change', () => {
        markTopicComplete(task.key, checkbox.checked);
        if (nudge) nudge.hidden = !checkbox.checked;
        if (currentPlan) renderProgressCard(currentPlan);
      });
      list.appendChild(li);
    });
  }

  function renderWeek(plan: PlannerPlan) {
    const week = getWeekForDate(plan, todayIso());
    const summaryEl = document.getElementById('weekSummary') as HTMLElement;
    const listEl = document.getElementById('weekTasks') as HTMLElement;
    if (!week) {
      summaryEl.textContent = '';
      listEl.innerHTML = '<li class="empty-note">No week data.</li>';
      return;
    }
    const newCount = week.topics.length;
    const reviewCount = week.reviewTopics.length;
    const total = newCount + reviewCount;

    if (total === 0) {
      summaryEl.textContent = week.isReviewWeek ? 'Revision week -- no new topics, review only.' : 'Nothing scheduled this week.';
      listEl.innerHTML = '';
      return;
    }

    summaryEl.textContent = `${total} session${total === 1 ? '' : 's'} · ${newCount} new · ${reviewCount} review${week.isReviewWeek ? ' · Revision week' : ''}`;

    const items = [...week.topics.map((t) => ({ ...t, kind: 'first-pass' as const })), ...week.reviewTopics.map((t) => ({ ...t, kind: 'review' as const }))];
    listEl.innerHTML = items
      .map(
        (t) => `<li><span class="task-subject">${subjectLabel(t.subjectSlug)}</span><span class="task-topic">${t.topicTitle}</span>${taskActionHtml(t)}${taskTagHtml(t.kind)}</li>`,
      )
      .join('');
  }

  function renderProgressCard(plan: PlannerPlan) {
    const container = document.getElementById('progressStats') as HTMLElement;
    const completed = loadCompletedKeys();
    const selectedSlugs = new Set(plan.input.subjects.map((s) => s.slug));

    // Coverage: distinct topics ever marked complete, against the total
    // topics each subject is responsible for from its own starting point.
    let coveredCount = 0;
    let totalCount = 0;
    for (const slug of selectedSlugs) totalCount += plan.subjectTopicTotals[slug] ?? 0;
    // completed keys are formatted `${slug}::${stageOrder}::${title}` (see topicKey in plannerEngine.ts)
    for (const key of completed) {
      const slug = key.split('::')[0];
      if (selectedSlugs.has(slug)) coveredCount++;
    }

    // This week's plan completion.
    const week = getWeekForDate(plan, todayIso());
    const weekItems = week ? [...week.topics, ...week.reviewTopics] : [];
    const weekDone = weekItems.filter((t) => completed.has(t.key)).length;

    // Time: planned vs. completed, using the same yield-weighted hour
    // estimate the scheduler itself used -- not a flat guess.
    const plannedHours = week
      ? week.isReviewWeek
        ? plan.weeklyCapacityHours
        : plan.input.subjects.reduce((sum, s) => sum + (plan.subjectWeeklyHours[s.slug] ?? 0), 0)
      : 0;
    const completedHours = weekItems.filter((t) => completed.has(t.key)).reduce((sum, t) => sum + topicHours(t), 0);

    container.innerHTML = `
      <div class="stat">
        <p class="stat-value">${coveredCount} / ${totalCount}</p>
        <p class="stat-label">Topics completed</p>
      </div>
      <div class="stat">
        <p class="stat-value">${weekItems.length ? Math.round((weekDone / weekItems.length) * 100) : 0}%</p>
        <p class="stat-label">of this week's plan completed</p>
      </div>
      <div class="stat">
        <p class="stat-value">${completedHours.toFixed(1)}h / ${plannedHours.toFixed(1)}h</p>
        <p class="stat-label">study time this week</p>
      </div>`;
  }

  function renderRoadmap(plan: PlannerPlan, targetId: string) {
    const container = document.getElementById(targetId) as HTMLElement;
    container.innerHTML = plan.weeks
      .map((week: WeekPlan) => {
        const items = [
          ...week.topics.map((t) => `<li><span class="task-subject">${subjectLabel(t.subjectSlug)}</span> ${t.topicTitle}</li>`),
          ...week.reviewTopics.map((t) => `<li><span class="task-subject">${subjectLabel(t.subjectSlug)}</span> ${t.topicTitle} <span class="review-note">(review)</span></li>`),
        ];
        return `
          <details class="roadmap-week">
            <summary>Week ${week.weekNumber} &middot; ${week.startDate} &rarr; ${week.endDate}${week.isReviewWeek ? ' &middot; Revision' : ''}</summary>
            <ul>${items.length ? items.join('') : '<li class="empty-note">Nothing scheduled.</li>'}</ul>
          </details>`;
      })
      .join('');
  }

  /**
   * A print/PDF is a document a student keeps and shows other people, not
   * a dump of whatever happens to be on screen -- so this builds its own
   * clean, compact, branded summary rather than printing the live results
   * section (which, un-collapsed, is a 35-week accordion never designed
   * to be read on paper). Same underlying browser print-to-PDF mechanism
   * (see printBtn below), just fed deliberately designed content.
   */
  function renderPrintSheet(plan: PlannerPlan) {
    const sheet = document.getElementById('printSheet') as HTMLElement;
    const week = getWeekForDate(plan, todayIso()) ?? plan.weeks[0];
    const phase = week ? getCurrentPhase(plan, week, subjects) : { isReviewPhase: false, subjectPhases: [] };
    const today = getTasksForDate(plan, todayIso());
    const subjectNames = plan.input.subjects.map((s) => subjectLabel(s.slug)).join(', ');
    const generatedOn = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
    const examDate = new Date(plan.input.targetDate + 'T00:00:00').toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });

    const taskLine = (t: { subjectSlug: string; topicTitle: string }, kind: 'first-pass' | 'review') =>
      `<li><span class="ps-subject">${subjectLabel(t.subjectSlug)}</span> ${t.topicTitle}${kind === 'review' ? ' <em>(review)</em>' : ''}</li>`;

    const routeRows = plan.weeks
      .map((w) => {
        const items = [...w.topics.map((t) => taskLine(t, 'first-pass')), ...w.reviewTopics.map((t) => taskLine(t, 'review'))];
        return `
          <tr>
            <td>Week ${w.weekNumber}<br /><span class="ps-dates">${w.startDate} &rarr; ${w.endDate}</span>${w.isReviewWeek ? '<br /><span class="ps-dates">Revision</span>' : ''}</td>
            <td>${items.length ? `<ul>${items.join('')}</ul>` : '&mdash;'}</td>
          </tr>`;
      })
      .join('');

    sheet.innerHTML = `
      <div class="ps-header">
        <div class="ps-wordmark">TECHMED</div>
        <div class="ps-tagline">Think Smart. Perform Elite.</div>
      </div>
      <h1>Your UTME Study Plan</h1>
      <p class="ps-meta">Generated ${generatedOn} &middot; Exam date ${examDate} &middot; ${plan.totalWeeks} weeks to go &middot; about ${plan.weeklyCapacityHours}h a week</p>
      <p class="ps-meta">Subjects: ${subjectNames}</p>

      <h2>Today</h2>
      <ul class="ps-list">${today.length ? today.map((t) => taskLine(t, t.kind)).join('') : '<li>Nothing scheduled today.</li>'}</ul>

      <h2>This Week</h2>
      <ul class="ps-list">${week && (week.topics.length || week.reviewTopics.length) ? [...week.topics.map((t) => taskLine(t, 'first-pass')), ...week.reviewTopics.map((t) => taskLine(t, 'review'))].join('') : '<li>Nothing scheduled this week.</li>'}</ul>

      <h2>Where Things Stand</h2>
      ${
        phase.isReviewPhase
          ? '<p>Revision phase &mdash; most new learning is done; this stretch is retrieval and practice.</p>'
          : `<ul class="ps-list">${phase.subjectPhases.map((p) => `<li><span class="ps-subject">${p.subjectName}</span> ${cleanStageName(p.stageName)}</li>`).join('')}</ul>`
      }

      <h2>Full Route</h2>
      <table class="ps-route"><tbody>${routeRows}</tbody></table>

      <div class="ps-footer">
        <p><strong>TECHMED</strong> &middot; Admission Intelligence &middot; techmedng.com</p>
        <p>Built on the TECHMED Blueprint. Continue with Kairo for a revision plan built around exactly where you stand.</p>
      </div>`;
  }

  // ============================================================
  // ADJUST -- replaces "I've fallen behind, replan": the student's life
  // didn't break the plan, so this never frames it as catching up.
  // ============================================================
  const adjustBtn = document.getElementById('adjustBtn') as HTMLButtonElement;
  const adjustPanel = document.getElementById('adjustPanel') as HTMLElement;
  const adjustEdit = document.getElementById('adjustEdit') as HTMLElement;
  const returnBanner = document.getElementById('returnBanner') as HTMLElement;

  adjustBtn.addEventListener('click', () => {
    adjustPanel.hidden = !adjustPanel.hidden;
    adjustEdit.hidden = true;
    adjustEdit.innerHTML = '';
    if (!adjustPanel.hidden) adjustPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  document.getElementById('adjustOptions')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-adjust]') as HTMLButtonElement | null;
    if (!btn) return;
    const kind = btn.dataset.adjust as 'missed' | 'less-time' | 'more-time' | 'date';
    if (kind === 'missed') {
      performReplan({});
    } else {
      openAdjustEdit(kind === 'less-time' || kind === 'more-time' ? 'less-time' : 'date');
    }
  });

  function openAdjustEdit(kind: 'less-time' | 'date') {
    adjustPanel.hidden = false;
    adjustEdit.hidden = false;
    adjustPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const stored = loadInput();
    if (!stored) return;

    if (kind === 'less-time') {
      const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      adjustEdit.innerHTML = `
        <div class="field-group">
          <span class="field-label">Days you can usually study</span>
          <div class="day-toggles" id="adjustDayToggles" role="group" aria-label="Available days"></div>
        </div>
        <div class="field-group">
          <label class="field-label" for="adjustHoursPerDay">Focused hours on a normal study day</label>
          <input type="number" id="adjustHoursPerDay" min="0.5" max="12" step="0.5" value="${stored.hoursPerAvailableDay}" />
        </div>
        <button type="button" class="btn-primary" id="adjustSave">Save &amp; rebuild</button>`;
      const toggleWrap = document.getElementById('adjustDayToggles') as HTMLElement;
      dayNames.forEach((d, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'day-toggle';
        btn.textContent = d;
        btn.dataset.day = String(i);
        const pressed = stored.availableDays.includes(i);
        btn.setAttribute('aria-pressed', String(pressed));
        if (pressed) btn.classList.add('selected');
        btn.addEventListener('click', () => {
          const isPressed = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', String(!isPressed));
          btn.classList.toggle('selected', !isPressed);
        });
        toggleWrap.appendChild(btn);
      });
      document.getElementById('adjustSave')?.addEventListener('click', () => {
        const hoursPerAvailableDay = parseFloat((document.getElementById('adjustHoursPerDay') as HTMLInputElement).value);
        const availableDays = Array.from(toggleWrap.querySelectorAll<HTMLButtonElement>('.day-toggle'))
          .filter((b) => b.getAttribute('aria-pressed') === 'true')
          .map((b) => parseInt(b.dataset.day || '0', 10));
        if (availableDays.length === 0) return;
        performReplan({ hoursPerAvailableDay, availableDays });
      });
    } else {
      adjustEdit.innerHTML = `
        <div class="field-group">
          <label class="field-label" for="adjustTargetDate">New exam date</label>
          <input type="date" id="adjustTargetDate" value="${stored.targetDate}" />
        </div>
        <button type="button" class="btn-primary" id="adjustSave">Save &amp; rebuild</button>`;
      document.getElementById('adjustSave')?.addEventListener('click', () => {
        const targetDate = (document.getElementById('adjustTargetDate') as HTMLInputElement).value;
        if (!targetDate || targetDate <= todayIso()) return;
        performReplan({ targetDate });
      });
    }
  }

  function performReplan(overrides: Partial<PlannerInput>) {
    const stored = loadInput();
    if (!stored) return;
    if (currentPlan) savePlanSnapshot(snapshotPlan(currentPlan));

    const completed = loadCompletedKeys();
    const newInput: PlannerInput = { ...stored, ...overrides, createdAt: todayIso() };
    const plan = buildPlan({ input: newInput, allSubjects: subjects, alreadyCompletedKeys: completed });
    saveInput(newInput);
    currentPlan = plan;
    renderAll(plan);

    const prevSnapshot = loadPlanSnapshot();
    if (prevSnapshot) {
      const changes = diffPlans(prevSnapshot, plan);
      renderReturnBanner(changes);
      clearPlanSnapshot();
    }

    adjustPanel.hidden = true;
    document.getElementById('todayCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderReturnBanner(changes: import('../../lib/plannerEngine').SubjectPlanChange[]) {
    const moved = changes.filter((c) => c.status !== 'on-track');
    returnBanner.hidden = false;
    returnBanner.innerHTML = `
      <p class="return-title">Welcome back.</p>
      <p class="return-copy">You don't need to catch up on everything at once &mdash; we've adjusted the plan around where things stand now.${
        moved.length
          ? ' ' + moved.map((c) => `${c.subjectName} moved ${c.status === 'moved-later' ? 'a little later' : 'a little earlier'} to keep your revision time protected.`).join(' ')
          : ' Everything else stayed on track.'
      }</p>`;
    setTimeout(() => { returnBanner.hidden = true; }, 12000);
  }

  document.getElementById('printBtn')?.addEventListener('click', () => window.print());

  document.getElementById('startOverBtn')?.addEventListener('click', () => {
    if (!confirm('Clear your current plan and start over?')) return;
    clearInput();
    clearProgress();
    clearPlanSnapshot();
    currentPlan = null;
    resultsSection.hidden = true;
    introSection.hidden = false;
    wizardSection.hidden = false;
    form.reset();
    selectedElectives.clear();
    renderSubjectPicker();
    subjectDetails.innerHTML = '';
    dayToggles.forEach((b) => { b.setAttribute('aria-pressed', 'false'); b.classList.remove('selected'); });
    showStep(0);
  });

  // --- Returning visitor: skip straight to results if a plan exists ---
  const existing = loadInput();
  if (existing) {
    introSection.hidden = true;
    wizardSection.hidden = true;
    currentPlan = buildPlan({ input: existing, allSubjects: subjects, alreadyCompletedKeys: loadCompletedKeys() });
    renderAll(currentPlan);
    resultsSection.hidden = false;
  }
</script>

<style is:global>
  /* Global, deliberately: most of this page's content (tags, chips, task
     rows, phase banner, roadmap weeks, the adjust panel) is built with
     client-side JS (innerHTML/createElement) rather than the static Astro
     template. Astro's default CSS scoping requires an element to carry a
     build-time data-attribute that only server-rendered elements get --
     a scoped rule like `.week-list li { }` silently never matches an
     `<li>` created by client JS, even though the ancestor `.week-list`
     (which IS in the static template) matches fine. Every class name
     here is specific to this page, so going global costs nothing. */
  .planner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-24);
  }

  /* ---------- Intro ---------- */
  .intro {
    padding: var(--space-16) 0 var(--space-10);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .intro .eyebrow { margin-bottom: var(--space-3); }

  .intro h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .intro .lede {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-light);
    max-width: 58ch;
    margin: 0 auto;
  }

  /* ---------- Wizard ---------- */
  .wizard-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .wizard-step-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .wizard-dots { display: flex; gap: var(--space-2); }

  .wizard-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }

  .wizard-dot.done { background: var(--accent-deep); }
  .wizard-dot.active { background: var(--accent); transform: scale(1.3); }

  /* :not([hidden]) matters here -- an author rule that sets `display` on
     an element unconditionally overrides the browser's own `[hidden] {
     display: none }` UA rule (equal specificity, author wins), so without
     this guard every step would render stacked regardless of its hidden
     attribute. Same reasoning applies to every other hidden-toggled
     element below that needs a non-default display value. */
  .wiz-step:not([hidden]) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .wiz-step h2 {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .step-hint { font-size: 0.92rem; line-height: 1.6; color: var(--text-light); margin-top: calc(-1 * var(--space-3)); }

  .step-error {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent-text);
    margin-top: var(--space-4);
  }

  .field-group { display: flex; flex-direction: column; gap: var(--space-3); }

  .field-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
  }

  input[type="date"],
  input[type="number"],
  select {
