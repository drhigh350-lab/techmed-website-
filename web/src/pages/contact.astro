---
// The Contact page — replaces the previous ComingSoon stub. Contact
// identity (WhatsApp/call number, socials) and this page's copy are all
// Sanity-editable (see src/lib/contact.ts); every value has a real,
// non-fabricated fallback so the page is correct even unseeded. Structure
// follows the same conventions as about.astro: BaseLayout + JSON-LD,
// per-section <style> blocks, shared design tokens, .reveal scroll-in.
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getContactChannels,
  getContactPageCopy,
  getProofPoints,
  getFounderCredibility,
  whatsappLink,
  telLink,
} from '../lib/contact';

const channels = await getContactChannels();
const copy = await getContactPageCopy();
const proofPoints = await getProofPoints();
const founder = await getFounderCredibility();

const waMessage = 'Hi TECHMED, I have a question.';
const waHref = whatsappLink(channels.whatsappNumber, waMessage);
const callHref = telLink(channels.whatsappNumber);
const displayNumber = `0${channels.whatsappNumber.slice(3)}`; // 234... -> 0...

const pageUrl = new URL('/contact', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact TECHMED',
    url: pageUrl,
    description: copy.heroSubtitle,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: pageUrl },
    ],
  },
];

const TOPIC_ICONS = [
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20l-7-4V8l7-4 7 4v8l-7 4z"/><path d="M12 12l7-4M12 12v8M12 12L5 8"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
];
---

<BaseLayout
  title="Contact TECHMED — Talk to a Real Person, Not a Form"
  description={copy.heroSubtitle}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-inner reveal">
      <p class="eyebrow">Contact TECHMED</p>
      <h1>{copy.heroTitle}</h1>
      <p class="lede">{copy.heroSubtitle}</p>

      <div class="primary-actions">
        <a class="btn-whatsapp" href={waHref} target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0012.05 0"/></svg>
          Message us on WhatsApp
        </a>
        <a class="btn-call" href={callHref}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {displayNumber}
        </a>
      </div>
      <p class="response-note">Real people read every message — usually within the same day.</p>

      <div class="socials" aria-label="Follow TECHMED on social media">
        <a href={channels.instagramUrl} target="_blank" rel="noopener" aria-label="TECHMED on Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href={channels.facebookUrl} target="_blank" rel="noopener" aria-label="TECHMED on Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href={channels.youtubeUrl} target="_blank" rel="noopener" aria-label="TECHMED on YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a2.994 2.994 0 0 0-2.107-2.117C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.391.524A2.994 2.994 0 0 0 .502 6.186 31.26 31.26 0 0 0 0 12a31.26 31.26 0 0 0 .502 5.814 2.994 2.994 0 0 0 2.107 2.117c1.886.524 9.391.524 9.391.524s7.505 0 9.391-.524a2.994 2.994 0 0 0 2.107-2.117A31.26 31.26 0 0 0 24 12a31.26 31.26 0 0 0-.502-5.814zM9.75 15.568V8.432L15.818 12 9.75 15.568z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="topics">
    <div class="topics-inner">
      <h2 class="reveal">What you can reach us about</h2>
      <ul class="topic-list">
        {copy.supportTopics.map((topic, i) => (
          <li class="reveal">
            <span class="topic-icon" set:html={TOPIC_ICONS[i % TOPIC_ICONS.length]} />
            <span>{topic}</span>
          </li>
        ))}
      </ul>
      <p class="disclaimer reveal">{copy.supportDisclaimer}</p>
    </div>
  </section>

  <section class="proof">
    <div class="proof-inner reveal">
      <p class="eyebrow">Why Trust TECHMED</p>
      <h2>{copy.proofHeading}</h2>
      <p class="proof-lede">{copy.proofIntro}</p>

      <div class="founder-fact">
        <p><strong>{founder.name}</strong>, {founder.role} — {founder.fact}</p>
      </div>

      {proofPoints.length > 0 && (
        <ul class="proof-list">
          {proofPoints.map((point) => (
            <li>
              <span class="proof-category">{point.category}</span>
              <p class="proof-statement">{point.statement}</p>
              {point.attribution && <p class="proof-attribution">— {point.attribution}</p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--surface-raised) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-24) var(--space-6) var(--space-16);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .primary-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .btn-whatsapp,
  .btn-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 15px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }

  .btn-whatsapp {
    color: #ffffff;
    background: #25d366;
  }

  .btn-whatsapp:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
  }

  .btn-call {
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
  }

  .btn-call:hover {
    border-color: var(--accent);
  }

  .response-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: var(--space-8);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
  }

  .socials a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 150ms ease;
  }

  .socials a:hover {
    background: var(--color-professional-blue);
    color: #ffffff;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .topics {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-6);
  }

  .topics h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .topic-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .topic-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
    font-size: 0.95rem;
    transition: border-color 200ms ease;
  }

  .topic-list li:hover {
    border-color: var(--accent);
  }

  .topic-icon {
    flex-shrink: 0;
    display: flex;
    color: var(--accent-text);
  }

  .disclaimer {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text-muted);
    text-align: center;
    max-width: 56ch;
    margin: 0 auto;
  }

  .proof {
    background: var(--surface-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .proof-inner {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-6);
    text-align: center;
  }

  .proof h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-5);
  }

  .proof-lede {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .founder-fact {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 2px 0 0 var(--accent);
    padding: var(--space-6) var(--space-7);
    text-align: left;
  }

  .founder-fact p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-light);
  }

  .founder-fact strong {
    color: var(--text);
  }

  .proof-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
    text-align: left;
  }

  .proof-list li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-6);
  }

  .proof-category {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .proof-statement {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-light);
  }

  .proof-attribution {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  @media (max-width: 560px) {
    .primary-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-whatsapp,
    .btn-call {
      width: 100%;
    }
    .topic-list {
      grid-template-columns: 1fr;
    }
  }
</style>
