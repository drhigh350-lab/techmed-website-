---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBuilderSettings } from '../lib/builders';

const { channelUrl } = await getBuilderSettings();

// SEO Schema for the Foundation Protocol course/programme
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'TECHMED UTME 2027 Foundation Protocol',
  description:
    '30 days of structured UTME foundation preparation at no cost, exclusively optimized for Medical, Engineering and High-Stakes Science students.',
  provider: {
    '@type': 'Organization',
    name: 'TECHMED',
    sameAs: 'https://techmedng.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'NGN',
    availability: 'https://schema.org/InStock',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    startDate: '2026-10-02',
    endDate: '2026-10-31',
  },
};

const OCTOBER_JOURNEY = [
  {
    date: 'OCT 2',
    badge: 'Day 1',
    title: 'GET ORIENTED',
    desc: 'Understand the system, expectations and how to make October count.',
    tag: 'Foundations',
  },
  {
    date: 'OCT 3',
    badge: 'Day 2',
    title: 'LEARN HOW TO PREPARE',
    desc: 'The 300+ Low-Friction System. Study smarter, focus on what matters and eliminate wasted effort.',
    tag: 'Strategy',
  },
  {
    date: 'OCT 4',
    badge: 'Day 3',
    title: 'SEE HOW THE BEST PREPARE',
    desc: '2026 Top Scorer Deconstruction. Live interview + Q&A focused on routines, pitfalls and time management.',
    tag: 'Blueprint',
  },
  {
    date: 'OCT 5–30',
    badge: 'Days 4–29',
    title: 'BUILD THE FOUNDATION',
    desc: '20 days. 40 live sessions. 5 UTME subjects. Learn → Practise → Discover gaps → Correct → Strengthen.',
    tag: 'Core Execution',
    highlight: true,
  },
  {
    date: 'OCT 10 / 17 / 24',
    badge: 'Weekly Milestone',
    title: 'TEST YOURSELF',
    desc: "Weekly Builder's Challenges. Retrieve, apply and discover gaps under timed conditions.",
    tag: 'Assessment',
  },
  {
    date: 'OCT 31',
    badge: 'Culmination',
    title: 'MEASURE',
    desc: 'Final Foundation CBT. 180 questions. Full UTME-format assessment with cash prizes.',
    tag: 'Evaluation',
    milestone: true,
  },
];

const FAQS = [
  {
    q: 'Already in a tutorial or school?',
    a: 'Good. You don’t have to leave it. Foundation Protocol adds structure, high-yield practice, and diagnostic feedback that makes whatever else you are doing work better. Live sessions are scheduled with students attending regular school in mind, with programme materials and access instructions available to Builders.',
  },
  {
    q: 'Just starting?',
    a: 'That’s exactly the point. October is about building a durable foundation before registration rush and exam pressure arrive.',
  },
  {
    q: 'Not naturally brilliant?',
    a: 'You don’t need to be. What UTME demands is not innate genius—it demands willingness to understand concepts, practise deliberately, correct mistakes, and keep building.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes. The Foundation Protocol is completely free of charge. No hidden fees, no credit cards, and no payment barriers.',
  },
];
---

<BaseLayout
  title="TECHMED UTME 2027 Foundation Protocol | Build Your Foundation"
  description="Build your UTME 2027 foundation in 30 focused days with TECHMED's Foundation Protocol, exclusively optimized for Medical, Engineering and High-Stakes Science students."
  canonicalUrl="https://techmedng.com/foundation-protocol"
  ogImage="/images/proof/daniella-372.jpg"
  jsonLd={[courseSchema]}
>
  <div class="fp-page" id="top">
    <!-- SECTION 1: HERO -->
    <header class="fp-hero reveal">
      <div class="fp-hero-bg" aria-hidden="true"></div>
      <div class="fp-container hero-inner">
        <div class="hero-eyebrow-wrap">
          <span class="campaign-tag">CAMPAIGN: BUILT TO LAST</span>
          <span class="hero-brand-dot">•</span>
          <span class="hero-sub-tag">UTME 2027 FOUNDATION PROTOCOL</span>
        </div>

        <h1 class="hero-headline">
          Don’t Wait Until UTME <br class="title-break" />
          <span class="highlight">Pressure Starts.</span>
        </h1>

        <p class="hero-lead">
          Start building before the pressure does.
        </p>

        <div class="protocol-box">
          <p class="protocol-flag">30 DAYS TO BUILD YOUR UTME FOUNDATION — AT NO COST.</p>
          <p class="protocol-target">Exclusively optimized for Medical, Engineering and High-Stakes Science Students.</p>
          <div class="protocol-meta">
            <span class="date-badge">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              October 2–31, 2026
            </span>
            <span class="meta-dot">•</span>
            <span class="live-badge">Online / WhatsApp Community</span>
          </div>
        </div>

        <div class="hero-cta-group">
          <a
            href={channelUrl}
            class="cta-primary"
            target="_blank"
            rel="noopener"
            id="heroCta"
            data-analytics="hero_cta_click"
          >
            JOIN THE BUILDERS
            <span class="arrow-icon" aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="#journey"
            class="hero-anchor-link"
            id="heroJourneyAnchor"
            data-analytics="hero_journey_jump"
          >
            See the 30-day journey &darr;
          </a>
          <p class="cta-microcopy">No payment. No complicated registration. Just enter and start building.</p>
        </div>
      </div>
    </header>

    <!-- SECTION 2: PROBLEM -->
    <section class="fp-section problem-section">
      <div class="fp-container">
        <div class="section-badge">THE PREPARATION REALITY</div>
        <h2 class="section-title">
          You Don’t Need Another <br />
          Pile of Study Materials.
        </h2>

        <div class="problem-content reveal">
          <p class="problem-lead">
            Serious students already have textbooks, past questions, videos, syllabuses and tutorials. Materials are everywhere.
          </p>
          <p class="problem-sub">The harder questions are what actually decide your result:</p>

          <div class="hard-questions-grid">
            <div class="question-pill">
              <span class="q-num">01</span>
              <p>What should I study first?</p>
            </div>
            <div class="question-pill">
              <span class="q-num">02</span>
              <p>Am I actually understanding it?</p>
            </div>
            <div class="question-pill">
              <span class="q-num">03</span>
              <p>What am I getting wrong?</p>
            </div>
            <div class="question-pill">
              <span class="q-num">04</span>
              <p>What do I need to fix?</p>
            </div>
            <div class="question-pill highlight-pill">
              <span class="q-num">05</span>
              <p>What should I do next?</p>
            </div>
          </div>

          <div class="october-answer">
            <span class="answer-badge">THE SOLUTION</span>
            <h3 class="answer-heading">THAT’S WHAT OCTOBER IS FOR.</h3>
            <p class="answer-desc">
              Not another mountain of PDFs to store on your phone. A structured 30-day operating system that turns effort into diagnostic clarity.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: OCTOBER EXPERIENCE -->
    <section class="fp-section experience-section" id="journey">
      <div class="fp-container">
        <div class="section-badge">THE 30-DAY JOURNEY</div>
        <h2 class="section-title">What Happens When You Enter</h2>
        <p class="section-subtitle">
          October is designed as a sequential progression, not a random collection of classes.
        </p>

        <div class="journey-schedule-reassurance reveal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="reassurance-icon" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <p>
            Live sessions are scheduled with students attending regular school in mind, with programme materials and access instructions available to Builders.
          </p>
        </div>

        <div class="journey-timeline">
          {OCTOBER_JOURNEY.map((step, idx) => (
            <div class:list={['timeline-node', 'reveal', { 'is-highlight': step.highlight, 'is-milestone': step.milestone }]}>
              <div class="node-time-col">
                <span class="node-date">{step.date}</span>
                <span class="node-badge">{step.badge}</span>
              </div>
              <div class="node-connector">
                <div class="node-marker">{idx + 1}</div>
                {idx < OCTOBER_JOURNEY.length - 1 && <div class="node-line"></div>}
              </div>
              <div class="node-card">
                <div class="card-tag">{step.tag}</div>
                <h3 class="node-title">{step.title}</h3>
                <p class="node-desc">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="journey-summary-bar reveal">
          <div class="summary-metric">
            <span class="metric-val">30</span>
            <span class="metric-lbl">Total Days</span>
          </div>
          <div class="metric-divider"></div>
          <div class="summary-metric">
            <span class="metric-val">40</span>
            <span class="metric-lbl">Live Sessions</span>
          </div>
          <div class="metric-divider"></div>
          <div class="summary-metric">
            <span class="metric-val">5</span>
            <span class="metric-lbl">UTME Subjects</span>
          </div>
          <div class="metric-divider"></div>
          <div class="summary-metric">
            <span class="metric-val">1</span>
            <span class="metric-lbl">Durable Foundation</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: DIFFERENTIATION -->
    <section class="fp-section diff-section">
      <div class="fp-container">
        <div class="section-badge">CORE POSITIONING</div>
        <h2 class="section-title">This Isn’t Another Tutorial Programme.</h2>
        <p class="section-subtitle">
          The difference is the question that guides the entire system.
        </p>

        <div class="diff-comparison-grid reveal">
          <!-- Typical -->
          <div class="diff-card typical-card">
            <div class="diff-card-head">
              <span class="status-indicator typical-dot"></span>
              <h3>Typical Preparation</h3>
            </div>
            <p class="flow-label">Linear and unexamined:</p>
            <div class="linear-flow">
              <span class="flow-step">Study</span>
              <span class="flow-arrow">&rarr;</span>
              <span class="flow-step">Practise</span>
              <span class="flow-arrow">&rarr;</span>
              <span class="flow-step">Move On</span>
            </div>
            <div class="diff-core-question">
              <p class="question-prefix">Most programmes ask:</p>
              <blockquote class="contrast-quote">
                &ldquo;What topic are we teaching today?&rdquo;
              </blockquote>
            </div>
          </div>

          <!-- TECHMED -->
          <div class="diff-card techmed-card">
            <div class="diff-card-head">
              <span class="status-indicator techmed-dot"></span>
              <h3>The TECHMED Protocol</h3>
            </div>
            <p class="flow-label">Diagnostic and closed-loop:</p>
            <div class="loop-flow">
              <span class="flow-chip">Understand</span>
              <span class="chip-arrow">&rarr;</span>
              <span class="flow-chip">Plan</span>
              <span class="chip-arrow">&rarr;</span>
              <span class="flow-chip">Learn</span>
              <span class="chip-arrow">&rarr;</span>
              <span class="flow-chip">Practise</span>
              <span class="chip-arrow">&rarr;</span>
              <span class="flow-chip highlight-chip">Diagnose</span>
              <span class="chip-arrow">&rarr;</span>
              <span class="flow-chip">Revise</span>
              <span class="chip-arrow">&rarr;</span>
              <span class="flow-chip">Prepare</span>
            </div>
            <div class="diff-core-question">
              <p class="question-prefix">TECHMED asks:</p>
              <blockquote class="techmed-quote">
                &ldquo;What does this student need to understand, practise, fix and do next?&rdquo;
              </blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: OUTCOME -->
    <section class="fp-section outcome-section">
      <div class="fp-container">
        <div class="section-badge">TANGIBLE TRANSFORMATION</div>
        <h2 class="section-title">By the End of October, You Should Have:</h2>
        <p class="section-subtitle">
          Measurable, real-world assets you carry into your entire 2027 journey.
        </p>

        <div class="outcome-pillars-grid reveal">
          <div class="outcome-card">
            <div class="outcome-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </div>
            <h3>Direction</h3>
            <p>A clearer understanding of how to approach UTME 2027 with strategy instead of panic.</p>
          </div>

          <div class="outcome-card">
            <div class="outcome-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
            </div>
            <h3>Foundation</h3>
            <p>A stronger base across the five UTME science subjects built from first principles.</p>
          </div>

          <div class="outcome-card">
            <div class="outcome-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
              </svg>
            </div>
            <h3>Diagnostic Clarity</h3>
            <p>A clearer picture of what you understand, where you need work and what deserves attention next.</p>
          </div>
        </div>

        <div class="transformation-banner reveal">
          <div class="contrast-statement">
            <div class="statement-col bad">
              <span class="state-label">NOT:</span>
              <p class="state-quote">&ldquo;I studied for 30 days.&rdquo;</p>
            </div>
            <div class="statement-divider" aria-hidden="true"></div>
            <div class="statement-col good">
              <span class="state-label">BUT:</span>
              <p class="state-quote">&ldquo;I know where I stand — and what to do next.&rdquo;</p>
            </div>
          </div>
          <p class="honesty-note">
            We don’t promise instant 350s or magic formulas. We build genuine academic capability.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 6: PROGRAMME MATERIALS & SCHEDULE -->
    <section class="fp-section visuals-section" id="curriculum">
      <div class="fp-container">
        <div class="section-badge">PROGRAMME SCHEDULE & CURRICULUM</div>
        <h2 class="section-title">See October Before You Enter It.</h2>
        <p class="section-subtitle">
          Explore the official master calendar, weekly live timetable, and 4-week curriculum exactly as structured for Builders.
        </p>

        <!-- Material Selector Tabs -->
        <div class="material-tabs-wrap reveal">
          <div class="material-tabs" role="tablist" aria-label="Programme Materials">
            <button
              type="button"
              class="material-tab is-active"
              data-material="calendar"
              role="tab"
              aria-selected="true"
              id="tabCalendar"
            >
              <span class="tab-number">01</span>
              <span class="tab-label">October Master Calendar</span>
            </button>
            <button
              type="button"
              class="material-tab"
              data-material="timetable"
              role="tab"
              aria-selected="false"
              id="tabTimetable"
            >
              <span class="tab-number">02</span>
              <span class="tab-label">Weekly Live Timetable</span>
            </button>
            <button
              type="button"
              class="material-tab"
              data-material="curriculum"
              role="tab"
              aria-selected="false"
              id="tabCurriculum"
            >
              <span class="tab-number">03</span>
              <span class="tab-label">Four-Page Curriculum</span>
            </button>
          </div>
        </div>

        <!-- Curriculum Week Sub-Navigation (visible when Curriculum is active) -->
        <div class="curriculum-week-nav" id="curriculumWeekNav" style="display: none;">
          <div class="week-nav-label">Curriculum Week:</div>
          <div class="week-nav-group" role="tablist" aria-label="Curriculum Weeks">
            <button type="button" class="week-pill is-active" data-week="1" role="tab" aria-selected="true">
              Week 1: Build the Base (Oct 5–9)
            </button>
            <button type="button" class="week-pill" data-week="2" role="tab" aria-selected="false">
              Week 2: Build the Base (Oct 12–16)
            </button>
            <button type="button" class="week-pill" data-week="3" role="tab" aria-selected="false">
              Week 3: Strengthen & Apply (Oct 19–23)
            </button>
            <button type="button" class="week-pill" data-week="4" role="tab" aria-selected="false">
              Week 4: Strengthen, Correct & Measure (Oct 26–30)
            </button>
          </div>
        </div>

        <!-- Central Showcase Display: Artwork rendered in full natural aspect ratio -->
        <div class="showcase-card reveal" id="materialShowcase">
          <div class="showcase-header">
            <div class="showcase-meta">
              <span class="showcase-kicker" id="showcaseKicker">30-DAY PROGRESSION MAP</span>
              <h3 class="showcase-title" id="showcaseTitle">October Master Calendar</h3>
            </div>
            <div class="showcase-actions">
              <button
                type="button"
                class="showcase-action-btn js-inspect-current"
                id="showcaseInspectBtn"
                aria-label="Inspect graphic in full resolution"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <span>Inspect Full Resolution</span>
              </button>
              <a
                id="showcaseExternalBtn"
                href="/images/foundation-protocol/master-calendar.png"
                target="_blank"
                rel="noopener"
                class="showcase-action-btn secondary"
                aria-label="Open original image in new tab"
              >
                <span>Open Original</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>

          <!-- Finished Artwork Canvas: Rendered exactly as supplied, completely uncropped -->
          <div class="showcase-stage">
            <button
              type="button"
              class="showcase-image-btn js-inspect-current"
              title="Click to inspect in full resolution"
              aria-label="Click to inspect graphic in full resolution"
            >
              <img
                id="showcaseImg"
                src="/images/foundation-protocol/master-calendar.png?v=2"
                alt="October Master Calendar - Complete 30-Day Day-by-Day Progression Map"
                class="showcase-artwork"
                loading="lazy"
                width="1000"
                height="1780"
              />
            </button>
          </div>

          <div class="showcase-footer">
            <p class="showcase-desc" id="showcaseDesc">
              Your sequential roadmap across all 30 days of October — beginning with orientation and top scorer deconstruction, progressing through the 20-day foundation phase, and concluding with the comprehensive diagnostic CBT on October 31.
            </p>
          </div>
        </div>

        <!-- Quick Switcher Cards: Direct selection of the 3 materials -->
        <div class="materials-quick-grid reveal">
          <button
            type="button"
            class="material-quick-card is-active"
            data-target-material="calendar"
            aria-label="Switch to October Master Calendar"
          >
            <div class="quick-card-thumb">
              <img
                src="/images/foundation-protocol/master-calendar.png?v=2"
                alt="October Master Calendar preview"
                loading="lazy"
              />
            </div>
            <div class="quick-card-info">
              <span class="quick-card-tag">30-Day Roadmap</span>
              <h4 class="quick-card-title">October Master Calendar</h4>
              <p class="quick-card-desc">Orientation, 300+ System, 20 Foundation Days & Final CBT</p>
            </div>
          </button>

          <button
            type="button"
            class="material-quick-card"
            data-target-material="timetable"
            aria-label="Switch to Weekly Live Timetable"
          >
            <div class="quick-card-thumb">
              <img
                src="/images/foundation-protocol/weekly-timetable.png?v=2"
                alt="Weekly Live Timetable preview"
                loading="lazy"
              />
            </div>
            <div class="quick-card-info">
              <span class="quick-card-tag">Live Evening Schedule</span>
              <h4 class="quick-card-title">Weekly Live Timetable</h4>
              <p class="quick-card-desc">Mon–Fri double sessions at 7:00 PM & 9:00 PM for school students</p>
            </div>
          </button>

          <button
            type="button"
            class="material-quick-card"
            data-target-material="curriculum"
            aria-label="Switch to Four-Page Curriculum"
          >
            <div class="quick-card-thumb">
              <img
                src="/images/foundation-protocol/curriculum-week-1.png?v=2"
                alt="Four-Page Curriculum preview"
                loading="lazy"
              />
            </div>
            <div class="quick-card-info">
              <span class="quick-card-tag">4-Week Syllabus</span>
              <h4 class="quick-card-title">Four-Page Curriculum</h4>
              <p class="quick-card-desc">20 days, 40 sessions, and weekly memory engine challenges</p>
            </div>
          </button>
        </div>
      </div>
    </section>

    <!-- SECTION 7: PROOF -->
    <section class="fp-section proof-section">
      <div class="fp-container">
        <div class="section-badge">STUDENT PROOF</div>
        <h2 class="section-title">Built From Experience.</h2>
        <p class="section-subtitle">
          Validated by real results in Nigeria’s most competitive examinations.
        </p>

        <div class="proof-card reveal">
          <div class="proof-visual">
            <img
              src="/images/daniella-portrait.jpg"
              alt="Owoeye Daniella Jesudunsin, 372 in UTME 2026, highest score in Nigeria"
              class="proof-img"
              width="700"
              height="1454"
              loading="lazy"
            />
            <div class="score-pill">
              <span class="score-num">372</span>
              <span class="score-denom">/ 400</span>
            </div>
          </div>

          <div class="proof-details">
            <div class="proof-headline-tag">NIGERIA’S HIGHEST UTME 2026 SCORE</div>
            <blockquote class="proof-quote">
              &ldquo;Your tests and podcasts have been helpful&hellip; I’ve seen my result and I’m really proud to have you tutor me. You’re one of the people I look up to.&rdquo;
            </blockquote>
            <p class="proof-author">
              <strong>Owoeye Daniella Jesudunsin</strong>
              <span>Top Scorer, UTME 2026</span>
            </p>

            <div class="subject-breakdown">
              <div class="subj-box">
                <span class="subj-name">English</span>
                <span class="subj-score">98</span>
              </div>
              <div class="subj-box">
                <span class="subj-name">Chemistry</span>
                <span class="subj-score">98</span>
              </div>
              <div class="subj-box">
                <span class="subj-name">Physics</span>
                <span class="subj-score">94</span>
              </div>
              <div class="subj-box">
                <span class="subj-name">Biology</span>
                <span class="subj-score">82</span>
              </div>
