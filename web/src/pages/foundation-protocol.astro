<script is:inline>
  // Analytics & Interaction Handlers
  (function () {
    // Track clicks on primary and final CTAs if gtag is initialized
    function trackEvent(name, params) {
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', name, params || {});
        }
      } catch (e) {}
    }

    document.querySelectorAll('[data-analytics]').forEach(function (el) {
      el.addEventListener('click', function () {
        var action = el.getAttribute('data-analytics');
        trackEvent(action, { page: 'foundation-protocol' });
      });
    });

    // Sticky CTA visibility control: show when scrolled past hero, hide near final CTA
    var stickyBar = document.getElementById('stickyMobileCta');
    var hero = document.querySelector('.fp-hero');
    var finalSection = document.querySelector('.final-cta-section');

    if (stickyBar && hero && window.innerWidth <= 860) {
      var checkScroll = function () {
        var heroRect = hero.getBoundingClientRect();
        var finalRect = finalSection ? finalSection.getBoundingClientRect() : null;

        var pastHero = heroRect.bottom < 100;
        var inFinal = finalRect && finalRect.top < window.innerHeight;

        if (pastHero && !inFinal) {
          stickyBar.classList.add('is-visible');
          stickyBar.removeAttribute('aria-hidden');
        } else {
          stickyBar.classList.remove('is-visible');
          stickyBar.setAttribute('aria-hidden', 'true');
        }
      };

      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();
    }

    // Accessible smooth scrolling for quick-jump anchor
    var journeyAnchor = document.getElementById('heroJourneyAnchor');
    if (journeyAnchor) {
      journeyAnchor.addEventListener('click', function (e) {
        var target = document.getElementById('journey');
        if (target) {
          e.preventDefault();
          var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({
            behavior: prefersReduced ? 'auto' : 'smooth',
            block: 'start'
          });
          if (history.pushState) {
            history.pushState(null, '', '#journey');
          }
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        }
      });
    }

    // Programme Materials Showcase & Full-Resolution Viewer
    var modal = document.getElementById('programmeGraphicModal');
    var modalBackdrop = document.getElementById('modalBackdrop');
    var modalCloseBtn = document.getElementById('modalCloseBtn');
    var modalTitle = document.getElementById('modalTitle');
    var modalImg = document.getElementById('modalImg');
    var modalExternalLink = document.getElementById('modalExternalLink');
    var modalCurriculumTabs = document.getElementById('modalCurriculumTabs');
    var lastFocusedElement = null;

    var showcaseImg = document.getElementById('showcaseImg');
    var showcaseTitle = document.getElementById('showcaseTitle');
    var showcaseKicker = document.getElementById('showcaseKicker');
    var showcaseDesc = document.getElementById('showcaseDesc');
    var showcaseExternalBtn = document.getElementById('showcaseExternalBtn');
    var curriculumWeekNav = document.getElementById('curriculumWeekNav');

    var currentMaterial = 'calendar';
    var currentCurriculumWeek = 1;

    var materials = {
      calendar: {
        kicker: '30-DAY PROGRESSION MAP',
        title: 'October Master Calendar',
        desc: 'Your sequential roadmap across all 30 days of October — beginning with orientation and top scorer deconstruction, progressing through the 20-day foundation phase, and concluding with the comprehensive diagnostic CBT on October 31.',
        src: '/images/foundation-protocol/master-calendar.png?v=2',
        alt: 'October Master Calendar - Complete 30-Day Day-by-Day Progression Map',
        isCurriculum: false
      },
      timetable: {
        kicker: 'LIVE EVENING SCHEDULE • 7PM & 9PM',
        title: 'Weekly Live Timetable',
        desc: 'Double live evening sessions scheduled Monday through Friday at 7:00 PM and 9:00 PM, engineered specifically so students attending regular day school can participate consistently without conflict.',
        src: '/images/foundation-protocol/weekly-timetable.png?v=2',
        alt: 'Weekly Live Timetable - Session A and Session B across 5 UTME Science Subjects',
        isCurriculum: false
      },
      curriculum: {
        kicker: '20 DAYS • 40 SESSIONS • 5 SUBJECTS',
        title: 'Four-Page Comprehensive Curriculum',
        desc: 'Day-by-day subject breakdowns and weekly memory engine challenges across Chemistry, Biology, Physics, English, and Mathematics.',
        isCurriculum: true
      }
    };

    var curriculumWeeks = {
      1: {
        kicker: 'WEEK 1 • OCT 5–9 • BUILD THE BASE',
        title: 'Week 1 Curriculum: Build the Base',
        desc: 'Focus on core foundational pillars, diagnosing baseline misconceptions across all 5 subjects, culminating in the Friday Memory Engine challenge.',
        src: '/images/foundation-protocol/curriculum-week-1.png?v=2',
        alt: 'Four-Page Curriculum - Week 1: Build the Base'
      },
      2: {
        kicker: 'WEEK 2 • OCT 12–16 • BUILD THE BASE',
        title: 'Week 2 Curriculum: Build the Base',
        desc: 'Deepening core conceptual models, chemical stoichiometry, mechanics, and cellular genetics with nightly targeted drills.',
        src: '/images/foundation-protocol/curriculum-week-2.png?v=2',
        alt: 'Four-Page Curriculum - Week 2: Build the Base'
      },
      3: {
        kicker: 'WEEK 3 • OCT 19–23 • STRENGTHEN & APPLY',
        title: 'Week 3 Curriculum: Strengthen & Apply',
        desc: 'High-yield synthesis, exam mechanics, and speed drills across recurring UTME trap patterns in Chemistry, Physics, Biology, English, and Mathematics.',
        src: '/images/foundation-protocol/curriculum-week-3.png?v=2',
        alt: 'Four-Page Curriculum - Week 3: Strengthen & Apply'
      },
      4: {
        kicker: 'WEEK 4 • OCT 26–30 • STRENGTHEN, CORRECT & MEASURE',
        title: 'Week 4 Curriculum: Strengthen, Correct & Measure',
        desc: 'Comprehensive multi-topic integration, timing calibration, and final diagnostic preparation leading into the full benchmark CBT on October 31.',
        src: '/images/foundation-protocol/curriculum-week-4.png?v=2',
        alt: 'Four-Page Curriculum - Week 4: Strengthen, Correct & Measure'
      }
    };

    function setMaterial(materialKey) {
      currentMaterial = materialKey;

      // Update material tabs
      document.querySelectorAll('.material-tab').forEach(function (tab) {
        var isTarget = tab.getAttribute('data-material') === materialKey;
        tab.classList.toggle('is-active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      // Update quick cards
      document.querySelectorAll('.material-quick-card').forEach(function (card) {
        var isTarget = card.getAttribute('data-target-material') === materialKey;
        card.classList.toggle('is-active', isTarget);
      });

      // Show or hide curriculum sub-tabs
      if (curriculumWeekNav) {
        curriculumWeekNav.style.display = materialKey === 'curriculum' ? 'flex' : 'none';
      }

      if (materialKey === 'curriculum') {
        renderCurriculumWeek(currentCurriculumWeek);
      } else {
        var data = materials[materialKey];
        if (showcaseImg) {
          showcaseImg.src = data.src;
          showcaseImg.alt = data.alt;
        }
        if (showcaseTitle) showcaseTitle.textContent = data.title;
        if (showcaseKicker) showcaseKicker.textContent = data.kicker;
        if (showcaseDesc) showcaseDesc.textContent = data.desc;
        if (showcaseExternalBtn) showcaseExternalBtn.href = data.src;
      }
    }

    function renderCurriculumWeek(week) {
      currentCurriculumWeek = week;
      var weekData = curriculumWeeks[week];

      document.querySelectorAll('.week-pill').forEach(function (pill) {
        var w = parseInt(pill.getAttribute('data-week'), 10);
        var isTarget = w === week;
        pill.classList.toggle('is-active', isTarget);
        pill.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      if (showcaseImg) {
        showcaseImg.src = weekData.src;
        showcaseImg.alt = weekData.alt;
      }
      if (showcaseTitle) showcaseTitle.textContent = weekData.title;
      if (showcaseKicker) showcaseKicker.textContent = weekData.kicker;
      if (showcaseDesc) showcaseDesc.textContent = weekData.desc;
      if (showcaseExternalBtn) showcaseExternalBtn.href = weekData.src;
    }

    // Material tab listeners
    document.querySelectorAll('.material-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var mat = tab.getAttribute('data-material');
        setMaterial(mat);
      });
    });

    // Quick card listeners
    document.querySelectorAll('.material-quick-card').forEach(function (card) {
      card.addEventListener('click', function () {
        var mat = card.getAttribute('data-target-material');
        setMaterial(mat);
        var showcaseEl = document.getElementById('materialShowcase');
        if (showcaseEl) {
          showcaseEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    // Curriculum week pill listeners
    document.querySelectorAll('.week-pill').forEach(function (pill) {
      pill.addEventListener('click', function () {
        var w = parseInt(pill.getAttribute('data-week'), 10);
        renderCurriculumWeek(w);
      });
    });

    // Modal logic
    function openModal(title, imgSrc, isCurriculum, initialWeek) {
      if (!modal || !modalImg) return;
      lastFocusedElement = document.activeElement;

      if (modalTitle) modalTitle.textContent = title;
      modalImg.src = imgSrc;
      modalImg.alt = title;
      if (modalExternalLink) modalExternalLink.href = imgSrc;

      if (isCurriculum) {
        if (modalCurriculumTabs) modalCurriculumTabs.style.display = 'flex';
        updateModalWeekTabs(initialWeek || currentCurriculumWeek);
      } else {
        if (modalCurriculumTabs) modalCurriculumTabs.style.display = 'none';
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      if (modalCloseBtn) modalCloseBtn.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      }
    }

    function updateModalWeekTabs(week) {
      currentCurriculumWeek = week;
      var weekData = curriculumWeeks[week];
      if (modalImg) modalImg.src = weekData.src;
      if (modalExternalLink) modalExternalLink.href = weekData.src;
      if (modalTitle) modalTitle.textContent = 'Curriculum: ' + weekData.title;

      document.querySelectorAll('.modal-tab-btn').forEach(function (btn) {
        var w = parseInt(btn.getAttribute('data-week'), 10);
        btn.classList.toggle('is-active', w === week);
      });

      renderCurriculumWeek(week);
    }

    // Modal week tab clicks
    document.querySelectorAll('.modal-tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var w = parseInt(btn.getAttribute('data-week'), 10);
        updateModalWeekTabs(w);
      });
    });

    // Inspect buttons: Open currently displayed graphic in full resolution
    document.querySelectorAll('.js-inspect-current').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (currentMaterial === 'curriculum') {
          var weekData = curriculumWeeks[currentCurriculumWeek];
          openModal('Curriculum: ' + weekData.title, weekData.src, true, currentCurriculumWeek);
        } else {
          var matData = materials[currentMaterial];
          openModal(matData.title, matData.src, false);
        }
      });
    });

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
        closeModal();
      }
    });
  })();
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  #journey {
    scroll-margin-top: 88px;
  }

  /* ROOT LAYOUT */
  .fp-page {
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
    position: relative;
    padding-bottom: 30px;
  }

  .fp-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .title-break {
    display: inline;
  }

  @media (max-width: 640px) {
    .title-break {
      display: none;
    }
  }

  /* SECTION BASE */
  .fp-section {
    padding: var(--space-20) 0;
    position: relative;
  }

  .section-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--surface-raised);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-size: clamp(1.85rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-light);
    max-width: 60ch;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }

  /* BUTTONS & CTAS */
  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    padding: 16px 36px;
    min-height: 48px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 220ms ease;
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.4);
  }

  .cta-primary .arrow-icon {
    transition: transform 180ms ease;
  }

  .cta-primary:hover .arrow-icon {
    transform: translateX(4px);
  }

  .cta-large {
    padding: 18px 44px;
    font-size: 1.05rem;
  }

  /* SECTION 1: HERO */
  .fp-hero {
    position: relative;
    padding: var(--space-16) 0 var(--space-20);
    text-align: center;
    overflow: hidden;
  }

  .fp-hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.4;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black 20%, transparent 80%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 820px;
  }

  .hero-eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--surface-raised);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    margin-bottom: var(--space-6);
  }

  .hero-brand-dot {
    color: var(--text-muted);
  }

  .hero-sub-tag {
    color: var(--text);
  }

  .hero-headline {
    font-size: clamp(2.2rem, 6.5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .hero-headline .highlight {
    color: var(--accent);
  }

  :root[data-theme='light'] .hero-headline .highlight {
    color: var(--accent-text);
  }

  .hero-lead {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .protocol-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    margin: 0 auto var(--space-10);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.15);
  }

  .protocol-flag {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    letter-spacing: 0.05em;
    color: var(--text);
    margin-bottom: var(--space-2);
  }

  .protocol-target {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: var(--space-4);
    line-height: 1.5;
  }

  .protocol-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .date-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
    font-weight: 700;
  }

  .hero-cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-anchor-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-light);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    transition: color 180ms ease, background-color 180ms ease;
    margin-top: 2px;
  }

  .hero-anchor-link:hover {
    color: var(--accent-text);
    background-color: var(--surface-raised);
  }

  .hero-anchor-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cta-microcopy {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* SECTION 2: PROBLEM */
  .problem-section {
    background: var(--surface-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .problem-lead {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .problem-sub {
    font-size: 1.02rem;
    color: var(--text-light);
    margin-bottom: var(--space-6);
  }

  .hard-questions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .question-pill {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius);
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .question-pill:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .question-pill .q-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .question-pill p {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }

  .highlight-pill {
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-raised) 100%);
  }

  .highlight-pill .q-num {
    color: var(--accent-text);
  }

  .october-answer {
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .answer-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .answer-heading {
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: var(--space-3);
  }

  .answer-desc {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.65;
    margin: 0;
  }

  /* SECTION 3: OCTOBER EXPERIENCE */
  .journey-schedule-reassurance {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    max-width: 760px;
    margin: 0 auto var(--space-10);
    padding: var(--space-3) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    font-size: 0.92rem;
    color: var(--text);
    line-height: 1.5;
    text-align: left;
  }

  .journey-schedule-reassurance .reassurance-icon {
    flex-shrink: 0;
    color: var(--accent-text);
  }

  .journey-schedule-reassurance p {
    margin: 0;
    font-weight: 500;
  }

  .journey-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: relative;
    max-width: 860px;
    margin: 0 auto var(--space-12);
  }

  .timeline-node {
    display: grid;
    grid-template-columns: 140px 48px 1fr;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .node-time-col {
    text-align: right;
    padding-top: var(--space-2);
  }

  .node-date {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--text);
  }

  .node-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 2px;
  }

  .node-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    position: relative;
  }

  .node-marker {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 2px solid var(--accent);
    color: var(--accent-text);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .node-line {
    width: 2px;
    flex-grow: 1;
    background: var(--border);
    margin-top: 4px;
    min-height: 48px;
  }

  .node-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .node-card:hover {
    transform: translateX(4px);
    border-color: var(--accent);
  }

  .card-tag {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .node-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }

  .node-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.6;
    margin: 0;
  }

  .is-highlight .node-card {
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-raised) 100%);
  }

  .is-highlight .node-marker {
    background: var(--accent);
    color: #1a0a00;
  }

  .is-milestone .node-marker {
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
  }

  .journey-summary-bar {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
    max-width: 760px;
    margin: 0 auto;
  }

  .summary-metric {
    text-align: center;
  }

  .metric-val {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.85rem;
    color: var(--accent-text);
    line-height: 1.1;
  }

  .metric-lbl {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-top: 4px;
    display: block;
  }

  .metric-divider {
    width: 1px;
    height: 36px;
    background: var(--border);
  }

  /* SECTION 4: DIFFERENTIATION */
  .diff-section {
    background: var(--surface-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .diff-comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .diff-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .typical-card {
    border: 1px dashed var(--border);
  }

  .techmed-card {
    border: 1px solid var(--accent);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.15);
  }

  .diff-card-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .typical-dot {
    background: var(--text-muted);
  }

  .techmed-dot {
    background: var(--accent);
    box-shadow: 0 0 10px rgba(201, 162, 39, 0.6);
  }

  .diff-card-head h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
  }

  .flow-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .linear-flow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .flow-step {
    background: var(--surface-raised);
    color: var(--text-muted);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .flow-arrow {
    color: var(--text-muted);
  }

  .loop-flow {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .flow-chip {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .highlight-chip {
    border-color: var(--accent);
    color: var(--accent-text);
    background: var(--surface);
  }

  .chip-arrow {
    font-size: 0.75rem;
    color: var(--accent-text);
  }

  .diff-core-question {
    margin-top: auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .question-prefix {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .contrast-quote {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-light);
    font-style: italic;
    line-height: 1.5;
    margin: 0;
  }

  .techmed-quote {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
    border-left: 3px solid var(--accent);
    padding-left: var(--space-4);
  }

  /* SECTION 5: OUTCOME */
  .outcome-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .outcome-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .outcome-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .outcome-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .outcome-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }

  .outcome-card p {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.6;
    margin: 0;
  }

  .transformation-banner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-8);
    text-align: center;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  }

  .contrast-statement {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-8);
    align-items: center;
    max-width: 800px;
    margin: 0 auto var(--space-6);
  }

  .statement-divider {
    width: 1px;
    height: 60px;
    background: var(--border);
  }

  .statement-col .state-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-2);
  }

  .bad .state-label {
    color: var(--text-muted);
  }

  .bad .state-quote {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text-muted);
    text-decoration: line-through;
    margin: 0;
  }

  .good .state-label {
    color: var(--accent-text);
  }

  .good .state-quote {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.35;
    margin: 0;
  }

  .honesty-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* SECTION 6: PROGRAMME VISUALS */
  .visuals-section {
    background: var(--surface-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  /* SECTION 6: PROGRAMME MATERIALS SHOWCASE */
  .visuals-section {
    background: var(--surface-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  /* Material Selector Tabs */
  .material-tabs-wrap {
    margin-bottom: var(--space-6);
  }

  .material-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    background: var(--surface);
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .material-tab {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-family: var(--font-display);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 180ms ease;
    text-align: center;
  }

  .material-tab .tab-number {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent-text);
    opacity: 0.8;
  }

  .material-tab .tab-label {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .material-tab:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .material-tab.is-active {
    background: #0284C7;
    color: #FFFFFF;
    border-color: #38BDF8;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
  }

  .material-tab.is-active .tab-number {
    color: #FFFFFF;
    opacity: 1;
  }

  /* Curriculum Week Sub-Navigation */
  .curriculum-week-nav {
    margin-bottom: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .week-nav-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-text);
    text-transform: uppercase;
  }

  .week-nav-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    flex-grow: 1;
  }

  .week-pill {
    background: var(--surface-dark);
    border: 1px solid var(--border);
    color: var(--text-light);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 160ms ease;
  }

  .week-pill:hover {
    background: var(--surface-raised);
    color: var(--text);
    border-color: var(--border-light);
  }

  .week-pill.is-active {
    background: var(--accent);
    color: #011425;
    border-color: var(--accent-light);
    font-weight: 800;
    box-shadow: 0 2px 10px rgba(201, 162, 39, 0.35);
  }

  /* Central Showcase Card */
  .showcase-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-6);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
  }

  .showcase-header {
    padding: var(--space-5) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .showcase-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .showcase-kicker {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }

  .showcase-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .showcase-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .showcase-action-btn {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 8px 16px;
    border-radius: var(--radius);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 160ms ease;
    text-decoration: none;
  }

  .showcase-action-btn:hover {
    background: #0284C7;
    border-color: #38BDF8;
    color: #FFFFFF;
  }

  .showcase-action-btn.secondary {
    background: transparent;
    color: var(--text-light);
  }

  .showcase-action-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
    border-color: var(--border-light);
  }

  /* Artwork Stage: Finished artwork displayed with preserved proportions */
  .showcase-stage {
    background: #011425;
    padding: var(--space-8) var(--space-4);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: auto;
  }

  .showcase-image-btn {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: zoom-in;
    display: block;
    max-width: 860px;
    width: 100%;
    text-align: center;
    outline: none;
    transition: transform 200ms ease;
  }

  .showcase-image-btn:hover {
    transform: scale(1.008);
  }

  .showcase-image-btn:focus-visible {
    outline: 2px solid var(--accent);
    border-radius: var(--radius);
  }

  .showcase-artwork {
