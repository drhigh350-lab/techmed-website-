---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBuilderSettings, formatDateRange } from '../lib/builders';

const builderSettings = await getBuilderSettings();
const {
  channelUrl,
  joinUrl,
  foundationOngoing = true,
  foundationStatusNotice,
  tutorialStartDate = '2026-10-16',
  tutorialEndDate = '2026-11-14',
} = builderSettings;

// The actual joining destination: active cohort if set, otherwise permanent channel
const activeJoinDestination = joinUrl || channelUrl;

const dateRangeFormatted = formatDateRange(tutorialStartDate, tutorialEndDate) || '16 October — 14 November 2026';

// SEO Schema for the Foundation Protocol course/programme
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'TECHMED UTME 2027 Foundation Protocol',
  description:
    'Free 30-day structured UTME foundation preparation for science students targeting Medicine, Engineering, Pharmacy, Nursing, and competitive programmes.',
  provider: {
    '@type': 'Organization',
    name: 'TECHMED',
    sameAs: 'https://techmedng.com',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'NGN',
    availability: 'https://schema.org/InStock',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    startDate: tutorialStartDate,
    endDate: tutorialEndDate,
  },
};

const PROGRAMME_BENEFITS = [
  {
    icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>',
    title: 'Structured Live Classes',
    desc: '40 live teaching sessions across 5 core subjects: English, Biology, Chemistry, Physics, and Mathematics.',
  },
  {
    icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>',
    title: 'Clear Schedule & Curriculum',
    desc: 'A day-by-day 30-day roadmap and 4-week syllabus so you always know what to study next.',
  },
  {
    icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>',
    title: "Weekly Builder's Challenges",
    desc: 'Timed retrieval practice and drills under real conditions to discover and close learning gaps early.',
  },
  {
    icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>',
    title: 'Strategy & Guidance',
    desc: 'Dedicated 300+ strategy sessions on habit building, exam pacing, time management, and error analysis.',
  },
  {
    icon: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
    title: 'Final Foundation CBT Assessment',
    desc: '180-question full UTME-format diagnostic evaluation on November 14 to measure true readiness.',
  },
];

const FAQS = [
  {
    q: 'Is the programme really free?',
    a: 'Yes. The Foundation Protocol is completely free of charge. No tuition, no hidden fees, and no credit card required. You gain access to all 40 live classes, the curriculum, challenges, and the final assessment at zero cost.',
  },
  {
    q: 'Can I join while attending school or another tutorial?',
    a: 'Yes, absolutely. The programme is specifically scheduled for students who attend regular school or daytime lessons. Double live sessions take place in the evening (7:00 PM and 9:00 PM, Monday to Friday), and all class notes and practice materials are pinned in the community.',
  },
  {
    q: 'Can I still join while the programme is ongoing?',
    a: 'Yes! The Foundation Protocol is currently in session. New Builders can join right away, access the master timetable and curriculum, participate in all upcoming live classes and weekly Builder Challenges, and review previous materials.',
  },
  {
    q: 'What should I do after joining?',
    a: 'Once you tap "Join the Free Foundation Protocol", you will enter the official WhatsApp community. Review the pinned master calendar, review the 5-move Starter Pack, and be ready to attend the next scheduled live session.',
  },
];
---

<BaseLayout
  title="Free UTME 2027 Foundation Protocol | TECHMED"
  description="Build your UTME 2027 foundation in 30 focused days with TECHMED's free Foundation Protocol. 5 subjects, 40 live classes, weekly challenges, and diagnostic assessment."
  canonicalUrl="https://techmedng.com/foundation-protocol"
  ogImage="/images/proof/daniella-372.jpg"
  jsonLd={[courseSchema]}
  smoothScroll
>
  <div class="fp-page" id="top">
    <!-- 1. LIVE PROGRAMME ANNOUNCEMENT -->
    {foundationOngoing && (
      <aside class="live-strip" aria-label="Programme Status">
        <div class="live-strip-inner">
          <span class="live-indicator">
            <span class="pulse-dot" aria-hidden="true"></span>
            LIVE &bull; ONGOING
          </span>
          <p class="live-text">
            {foundationStatusNotice || `Free 30-Day UTME 2027 Foundation Protocol is in session (${dateRangeFormatted}).`}
          </p>
          <a href={activeJoinDestination} target="_blank" rel="noopener" class="live-action">
            Join Now <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>
    )}

    <!-- 2. HERO SECTION -->
    <header class="fp-hero reveal">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-content">
        <div class="eyebrow-pill">
          <span class="pill-dot"></span>
          FREE 30-DAY PROGRAMME &bull; UTME 2027
        </div>

        <h1 class="hero-title">
          Build your UTME foundation <br class="title-break" />
          before the pressure builds.
        </h1>

        <p class="hero-lede">
          The TECHMED Foundation Protocol is a free, structured 30-day preparation experience for UTME 2027 students. Build understanding, practise deliberately and identify what needs more work across five subjects.
        </p>

        <!-- 4 Concise Facts -->
        <div class="facts-grid">
          <div class="fact-card">
            <span class="fact-value">30</span>
            <span class="fact-label">Days Programme</span>
          </div>
          <div class="fact-card">
            <span class="fact-value">5</span>
            <span class="fact-label">UTME Subjects</span>
          </div>
          <div class="fact-card">
            <span class="fact-value">40</span>
            <span class="fact-label">Live Classes</span>
          </div>
          <div class="fact-card">
            <span class="fact-value free">FREE</span>
            <span class="fact-label">Participation</span>
          </div>
        </div>

        <div class="hero-actions">
          <a
            href={activeJoinDestination}
            class="cta-btn cta-gold"
            target="_blank"
            rel="noopener"
            id="heroJoinCta"
            data-analytics="fp_hero_join_cta"
          >
            Join the Free Foundation Protocol
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="#schedule" class="cta-anchor">
            Inspect Programme Schedule &amp; Curriculum &darr;
          </a>
        </div>

        <p class="hero-reassurance">
          Free on WhatsApp &bull; Evening classes for school students &bull; No registration fee
        </p>
      </div>
    </header>

    <!-- 3. PROGRAMME BENEFITS -->
    <section class="section benefits-section" id="benefits">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-eyebrow">WHAT YOU RECEIVE</p>
          <h2>A Complete 30-Day Preparation System</h2>
          <p class="section-subtitle">
            Nigeria has no shortage of textbooks or past questions. What serious candidates lack is a structured daily system that turns effort into diagnostic clarity.
          </p>
        </div>

        <div class="benefits-grid">
          {PROGRAMME_BENEFITS.map((item, idx) => (
            <div class:list={['benefit-card', 'reveal', { featured: idx === 0 }]}>
              <div class="benefit-icon" set:html={item.icon} />
              <div class="benefit-content">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. STUDENT PROOF -->
    <section class="section proof-section" id="proof">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-eyebrow">STUDENT PROOF</p>
          <h2>Built From Experience. Proven By Results.</h2>
        </div>

        <div class="proof-card reveal">
          <div class="proof-photo-wrap">
            <img
              src="/images/daniella-portrait.jpg"
              alt="Owoeye Daniella Jesudunsin, 372 in UTME 2026"
              class="proof-photo"
              width="700"
              height="1454"
              loading="lazy"
            />
          </div>

          <div class="proof-details">
            <div class="score-pills">
              <span class="score-pill aggregate">Score: 372 / 400</span>
              <span class="score-pill">ENG 98</span>
              <span class="score-pill">CHE 98</span>
              <span class="score-pill">PHY 94</span>
              <span class="score-pill">BIO 82</span>
            </div>

            <blockquote class="proof-quote">
              &ldquo;Your tests and podcasts have been helpful&hellip; I’ve seen my result and I’m really proud to have you tutor me. You’re one of the people I look up to.&rdquo;
            </blockquote>

            <div class="proof-meta">
              <strong>Owoeye Daniella Jesudunsin</strong>
              <span>372 in UTME 2026</span>
            </div>

            <p class="proof-context">
              Prepared within the TECHMED ecosystem. The systems in the Foundation Protocol are built from the exact methods that produce high-performance results.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. PROGRAMME SCHEDULE & CURRICULUM -->
    <section class="section schedule-section" id="schedule">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-eyebrow">PROGRAMME SCHEDULE &amp; CURRICULUM</p>
          <h2>Inspect Before You Enter</h2>
          <p class="section-subtitle">
            Explore the master calendar, weekly evening timetable, and 4-week syllabus. Everything is transparent and structured before you join.
          </p>
        </div>

        <!-- Schedule Navigation Tabs -->
        <div class="schedule-tabs reveal" role="tablist" aria-label="Programme Materials">
          <button
            type="button"
            class="tab-btn is-active"
            data-tab="calendar"
            role="tab"
            aria-selected="true"
            id="tabCalendarBtn"
          >
            <span>01</span> Master Calendar
          </button>
          <button
            type="button"
            class="tab-btn"
            data-tab="timetable"
            role="tab"
            aria-selected="false"
            id="tabTimetableBtn"
          >
            <span>02</span> Weekly Timetable
          </button>
          <button
            type="button"
            class="tab-btn"
            data-tab="curriculum"
            role="tab"
            aria-selected="false"
            id="tabCurriculumBtn"
          >
            <span>03</span> 4-Week Curriculum
          </button>
        </div>

        <!-- Curriculum Week Sub-Pills (shown when curriculum tab active) -->
        <div class="week-pills-bar" id="curriculumWeekBar" style="display: none;">
          <span class="week-label">Curriculum Week:</span>
          <div class="week-pills-group" role="tablist">
            <button type="button" class="week-btn is-active" data-week="1">Week 1 (Oct 19–23)</button>
            <button type="button" class="week-btn" data-week="2">Week 2 (Oct 26–30)</button>
            <button type="button" class="week-btn" data-week="3">Week 3 (Nov 2–6)</button>
            <button type="button" class="week-btn" data-week="4">Week 4 (Nov 9–13)</button>
          </div>
        </div>

        <!-- Material Display Stage -->
        <div class="material-stage reveal" id="materialStage">
          <div class="stage-bar">
            <div class="stage-info">
              <span class="stage-tag" id="stageTag">30-DAY PROGRESSION MAP</span>
              <h3 class="stage-title" id="stageTitle">Master Calendar</h3>
            </div>
            <div class="stage-actions">
              <button type="button" class="inspect-btn" id="inspectBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <span>Full Resolution</span>
              </button>
              <a
                id="openOriginalLink"
                href="/images/foundation-protocol/master-calendar.png"
                target="_blank"
                rel="noopener"
                class="open-link"
              >
                <span>Open File</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>

          <div class="stage-canvas">
            <button type="button" class="canvas-btn" id="canvasInspectTrigger" title="Click to view full screen">
              <img
                id="stageArtwork"
                src="/images/foundation-protocol/master-calendar.png"
                alt="Foundation Protocol Programme Master Calendar"
                class="stage-img"
                loading="lazy"
                width="1000"
                height="1780"
              />
            </button>
          </div>

          <div class="stage-caption">
            <p id="stageDesc">
              Sequential roadmap across all 30 days — beginning with orientation and strategy, progressing through live academic classes (Oct 19–Nov 13), and concluding with the final CBT assessment on November 14.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. WHO SHOULD JOIN -->
    <section class="section target-section" id="who-should-join">
      <div class="container">
        <div class="target-box reveal">
          <div class="target-header">
            <p class="section-eyebrow">WHO SHOULD JOIN</p>
            <h2>Built for Serious UTME 2027 Science Candidates</h2>
          </div>

          <p class="target-lead">
            The Foundation Protocol is engineered for UTME 2027 Science students — especially those targeting high-demand, competitive degree paths such as <strong>Medicine &amp; Surgery, Engineering, Pharmacy, Nursing, Medical Laboratory Science, Dentistry</strong>, and other demanding science faculties.
          </p>

          <div class="target-features">
            <div class="target-feature-item">
              <span class="feature-check">&check;</span>
              <span>First-time candidates who want to master concepts before exam pressure starts.</span>
            </div>
            <div class="target-feature-item">
              <span class="feature-check">&check;</span>
              <span>Re-takers determined to replace past confusion with a reliable, diagnostic system.</span>
            </div>
            <div class="target-feature-item">
              <span class="feature-check">&check;</span>
              <span>Secondary school students looking for high-yield evening structure that complements school.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. FREQUENTLY ASKED QUESTIONS -->
    <section class="section faq-section" id="faq">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-eyebrow">QUESTIONS &amp; CLARITY</p>
          <h2>Frequently Asked Questions</h2>
        </div>

        <div class="faq-list">
          {FAQS.map((item) => (
            <details class="faq-card reveal">
              <summary class="faq-question">
                <span>{item.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. FINAL CTA -->
    <section class="section final-cta-section" id="join">
      <div class="container final-inner reveal">
        <span class="final-pill">FREE ACCESS &bull; ONGOING COHORT</span>
        <h2>Build your UTME foundation before the pressure builds.</h2>
        <p class="final-desc">
          Join thousands of Builders currently preparing strategically for UTME 2027. No fees, no complicated registration — enter and start building.
        </p>

        <div class="final-actions">
          <a
            href={activeJoinDestination}
            class="cta-btn cta-gold cta-large"
            target="_blank"
            rel="noopener"
            id="finalJoinCta"
            data-analytics="fp_final_join_cta"
          >
            Join the Free Foundation Protocol
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="paid-preview-link">
          <span>Preparing for the comprehensive paid programme?</span>
          <a href="/pricing" class="secondary-text-link">
            Explore UTME 2027 Core, Mastery &amp; Ultimate Plans &rarr;
          </a>
        </div>

        <p class="final-footnote">
          TECHMED &bull; Think Smart. Perform Elite. &bull; Questions? WhatsApp 07044255045
        </p>
      </div>
    </section>

    <!-- STICKY MOBILE BOTTOM BAR -->
    <div class="sticky-bar" id="stickyBar" aria-hidden="true">
      <div class="sticky-bar-inner">
        <div class="sticky-info">
          <span class="sticky-title">Foundation Protocol</span>
          <span class="sticky-sub">Free 30-Day UTME 2027</span>
        </div>
        <a
          href={activeJoinDestination}
          target="_blank"
          rel="noopener"
          class="sticky-cta-btn"
          id="stickyJoinCta"
          data-analytics="fp_sticky_join_cta"
        >
          Join Free &rarr;
        </a>
      </div>
    </div>

    <!-- FULL RESOLUTION IMAGE MODAL -->
    <div id="imageModal" class="fp-modal" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="modal-backdrop" id="modalBackdrop"></div>
      <div class="modal-content">
        <div class="modal-top">
          <h3 id="modalTitle">Master Calendar</h3>
          <button type="button" class="modal-close" id="modalCloseBtn" aria-label="Close image preview">
            &times;
          </button>
        </div>
        <div class="modal-image-wrap">
          <img id="modalImg" src="/images/foundation-protocol/master-calendar.png" alt="Full resolution programme graphic" />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // Analytics tracking
    function trackEvent(name) {
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', name, { page: 'foundation-protocol' });
        }
      } catch (e) {}
    }

    document.querySelectorAll('[data-analytics]').forEach(function (el) {
      el.addEventListener('click', function () {
        var action = el.getAttribute('data-analytics');
        if (action) trackEvent(action);
      });
    });

    // Material Assets data
    var materials = {
      calendar: {
        tag: '30-DAY PROGRESSION MAP',
        title: 'Master Calendar',
        src: '/images/foundation-protocol/master-calendar.png',
        desc: 'Sequential roadmap across all 30 days — beginning with orientation and strategy, progressing through live academic classes (Oct 19–Nov 13), and concluding with the final CBT assessment on November 14.',
      },
      timetable: {
        tag: 'LIVE EVENING SCHEDULE',
        title: 'Weekly Live Timetable',
        src: '/images/foundation-protocol/weekly-timetable.png',
        desc: 'Monday through Friday evening double-sessions at 7:00 PM and 9:00 PM, structured specifically for students attending regular secondary school or daytime lessons.',
      },
      curriculum1: {
        tag: 'WEEK 1 &bull; OCT 19–23',
        title: 'Curriculum Week 1: Build the Base',
        src: '/images/foundation-protocol/curriculum-week-1.png',
        desc: 'Week 1 focus: Laying conceptual foundations across English, Biology, Chemistry, Physics and Mathematics with daily worked examples.',
      },
      curriculum2: {
        tag: 'WEEK 2 &bull; OCT 26–30',
        title: 'Curriculum Week 2: Build the Base',
        src: '/images/foundation-protocol/curriculum-week-2.png',
        desc: 'Week 2 focus: Expanding high-yield topics and diagnostic problem-solving across all 5 subjects.',
      },
      curriculum3: {
        tag: 'WEEK 3 &bull; NOV 2–6',
        title: 'Curriculum Week 3: Strengthen & Apply',
        src: '/images/foundation-protocol/curriculum-week-3.png',
        desc: 'Week 3 focus: Moving from comprehension to timed question application, past questions, and gap closing.',
      },
      curriculum4: {
        tag: 'WEEK 4 &bull; NOV 9–13',
        title: 'Curriculum Week 4: Strengthen, Correct & Measure',
        src: '/images/foundation-protocol/curriculum-week-4.png',
        desc: 'Week 4 focus: Final cumulative review, error logging, and preparation for the 180-question closing CBT exam on November 14.',
      },
    };

    var currentTab = 'calendar';
    var currentWeek = '1';

    var stageTag = document.getElementById('stageTag');
    var stageTitle = document.getElementById('stageTitle');
    var stageImg = document.getElementById('stageArtwork');
    var stageDesc = document.getElementById('stageDesc');
    var openOriginal = document.getElementById('openOriginalLink');
    var weekBar = document.getElementById('curriculumWeekBar');

    function updateStage() {
      var key = currentTab === 'curriculum' ? 'curriculum' + currentWeek : currentTab;
      var data = materials[key] || materials.calendar;
      if (stageTag) stageTag.innerHTML = data.tag;
      if (stageTitle) stageTitle.textContent = data.title;
      if (stageImg) stageImg.src = data.src;
      if (stageDesc) stageDesc.textContent = data.desc;
      if (openOriginal) openOriginal.href = data.src;

      if (weekBar) {
        weekBar.style.display = currentTab === 'curriculum' ? 'flex' : 'none';
      }
    }

    // Tab buttons
    document.querySelectorAll('.tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.tab-btn').forEach(function (b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        currentTab = btn.getAttribute('data-tab') || 'calendar';
        updateStage();
      });
    });

    // Week buttons
    document.querySelectorAll('.week-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.week-btn').forEach(function (b) {
          b.classList.remove('is-active');
        });
        btn.classList.add('is-active');
        currentWeek = btn.getAttribute('data-week') || '1';
        updateStage();
      });
    });

    // Modal view
    var modal = document.getElementById('imageModal');
    var modalBackdrop = document.getElementById('modalBackdrop');
    var modalCloseBtn = document.getElementById('modalCloseBtn');
    var modalImg = document.getElementById('modalImg');
    var modalTitle = document.getElementById('modalTitle');

    function openModal() {
      if (!modal || !modalImg) return;
      modalImg.src = stageImg ? stageImg.src : '';
      if (modalTitle && stageTitle) modalTitle.textContent = stageTitle.textContent;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    var inspectBtn = document.getElementById('inspectBtn');
    var canvasBtn = document.getElementById('canvasInspectTrigger');
    if (inspectBtn) inspectBtn.addEventListener('click', openModal);
    if (canvasBtn) canvasBtn.addEventListener('click', openModal);
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });

    // Sticky mobile CTA
    var sticky = document.getElementById('stickyBar');
    var hero = document.querySelector('.fp-hero');
    var finalSection = document.getElementById('join');

    if (sticky && hero) {
      function checkSticky() {
        if (window.innerWidth > 800) {
          sticky.classList.remove('is-active');
          return;
        }
        var heroRect = hero.getBoundingClientRect();
        var finalRect = finalSection ? finalSection.getBoundingClientRect() : null;
        var pastHero = heroRect.bottom < 60;
        var inFinal = finalRect && finalRect.top < window.innerHeight;

        if (pastHero && !inFinal) {
          sticky.classList.add('is-active');
          sticky.removeAttribute('aria-hidden');
        } else {
          sticky.classList.remove('is-active');
          sticky.setAttribute('aria-hidden', 'true');
        }
      }
      window.addEventListener('scroll', checkSticky, { passive: true });
      window.addEventListener('resize', checkSticky, { passive: true });
      checkSticky();
    }
  })();
</script>

