---
// The "5 Minutes Forward" page — a short doorway to the real 5 Minutes
// Forward site, not a rebuild of it. Replaces the previous ComingSoon
// stub. Intro copy, the preview image and the external URL are all
// Sanity-editable (see src/lib/fiveMinutesForward.ts); every value has a
// real, already-established fallback so the page is correct unseeded.
// Deliberately minimal — no episode archive, no listing/filtering.
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderPreview from '../components/PlaceholderPreview.astro';
import { getFiveMinutesForwardSettings } from '../lib/fiveMinutesForward';

const settings = await getFiveMinutesForwardSettings();

const pageUrl = new URL('/podcast', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: settings.heroTitle,
    url: pageUrl,
    description: settings.intro,
    about: { '@type': 'Thing', name: '5 Minutes Forward', url: settings.externalUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: settings.heroTitle, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${settings.heroTitle} — TECHMED`}
  description={settings.intro}
  jsonLd={jsonLd}
>
  <section class="doorway">
    <div class="inner">
      <p class="eyebrow">Beyond Academics</p>
      <h1 class="reveal">{settings.heroTitle}</h1>
      <p class="intro reveal">{settings.intro}</p>

      <div class="preview reveal">
        {settings.previewImageUrl ? (
          <img src={settings.previewImageUrl} alt={`${settings.heroTitle} preview`} loading="lazy" decoding="async" />
        ) : (
          <PlaceholderPreview label={`${settings.heroTitle} — Preview`} aspect="16 / 9" />
        )}
      </div>

      <a class="cta" href={settings.externalUrl} target="_blank" rel="noopener">
        {settings.ctaLabel}
        <span aria-hidden="true">&rarr;</span>
      </a>
      <p class="note">Opens the full 5 Minutes Forward experience on its own site.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .doorway {
    padding: var(--space-24) var(--space-6);
  }

  .inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }

  .intro {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .preview {
    margin-bottom: var(--space-8);
  }

  .preview img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    padding: 15px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.3);
  }

  .cta span {
    transition: transform 200ms ease;
  }

  .cta:hover span {
    transform: translateX(3px);
  }

  .note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-4);
  }
</style>
