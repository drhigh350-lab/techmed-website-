---
// The UTME 2027 landing page — the acquisition/conversion page for
// UTME 2027 candidates. Not the general homepage and not a catalogue of
// everything TECHMED has built: this page argues one thing (random
// preparation → the TECHMED system → proof it works → BECOME A BUILDER)
// and every section exists to carry that argument forward. See the
// handoff this was built from for the locked copy and section order —
// none of the section copy below is paraphrased from it.
//
// Previously this page was the "UTME 2027 Hub," a link-out directory to
// the Blueprints/Resources/Tools/Blog ecosystem. That hub role has been
// intentionally dropped here in favor of a focused narrative; the other
// systems are still reachable from Navbar/Footer and from the Kairo and
// "What You Get" sections' own links.
import BaseLayout from '../layouts/BaseLayout.astro';

const BUILDERS_URL = '/utme-2027/builders';

const SYSTEM_STEPS = [
  { name: 'Understand', copy: 'Know what JAMB 2027 actually expects, subject by subject.' },
  { name: 'Plan', copy: 'Turn the syllabus into a study order you can actually follow.' },
  { name: 'Learn', copy: 'Work through each topic with real material, not guesswork.' },
  { name: 'Practice', copy: "Apply what you've learned under real conditions." },
  { name: 'Diagnose', copy: "Find out exactly where you're strong and where you're not." },
  { name: 'Revise', copy: 'Close the gaps the diagnosis reveals.' },
  { name: 'Prepare', copy: 'Walk into the exam ready, not hopeful.' },
];

const WITHOUT_SYSTEM = ['Random topics', 'Random resources', 'Random practice', 'Confusion'];
const WITH_SYSTEM = SYSTEM_STEPS.map((s) => s.name);

// Verbatim excerpts from real TECHMED student messages (screenshots on
// file) — trimmed with "…" where a message continued, never paraphrased
// or invented. No video testimonials exist in the repo yet, so this
// mosaic uses authentic text testimonials in their place rather than a
// fabricated video placeholder.
const TESTIMONIALS = [
  {
    quote:
      "Starting from the mole concept cure to the very last day before UTME, you've been there. There were many times I wanted to give up but you kept sending voice notes… I'm grateful to have met you.",
    name: 'Blessing',
    context: 'TECHMED Student, UTME 2026',
  },
  {
    quote:
      "The mocks were exactly like JAMB CBT. By the time I got to the real UTME, my heart wasn't racing because I'd already ‘written JAMB’ like 5 times with TechMed… My confidence went from 50% to 90%.",
    name: 'Praise',
    context: 'FUTA, Ekiti',
  },
  {
    quote:
      "Before, I was struggling and didn't even fully understand the basics, but your teachings gave me confidence and direction. Walking into that exam, I felt prepared in a way I never have before.",
    name: 'Favour',
    context: 'TECHMED Student, UTME 2026',
  },
  {
    quote:
      "All the sacrifices to make cheat sheets, the organization of Operation 100, the encouragements and everything. You held my hands all the way.",
    name: 'Naomi',
    context: 'TECHMED Student, UTME 2026',
  },
];

const KAIRO_FLOW = [
  {
    src: '/images/kairo/kairo-home.jpg',
    alt: "Kairo home screen with a personalized “Start Practising” recommendation and a 7-day streak.",
    caption: 'You practise.',
  },
  {
    src: '/images/kairo/kairo-practice-complete.jpg',
    alt: 'Kairo practice results showing 53% accuracy and a topic needing attention.',
    caption: 'Kairo reads the performance.',
  },
  {
    src: '/images/kairo/kairo-profile-insight.jpg',
    alt: "Kairo insight reading “88% Theory | 62% Math” with an explanation of the gap.",
    caption: 'Kairo finds the pattern.',
  },
  {
    src: '/images/kairo/kairo-weak-topics.jpg',
    alt: 'Kairo weak topics list with Launch Drill buttons for each one.',
    caption: 'Kairo tells you what to fix next.',
  },
];

const WHAT_YOU_GET = [
  {
    stage: '01',
    label: 'Understand',
    title: 'JAMB Blueprints',
    copy: "Know what matters before you spend hours studying everything equally.",
  },
  {
    stage: '02',
    label: 'Plan',
    title: 'Structured Study Roadmaps',
    copy: 'Turn the syllabus into an order you can actually follow.',
  },
  {
    stage: '03',
    label: 'Learn',
    title: 'Builder Sessions & Learning Resources',
    copy: 'Build genuine understanding instead of relying on blind memorisation.',
  },
  {
    stage: '04',
    label: 'Practice',
    title: 'CBT Practice & Challenges',
    copy: 'Turn knowledge into speed, accuracy and exam readiness.',
  },
  {
    stage: '05',
    label: 'Diagnose',
    title: 'Performance Analysis + Kairo',
    copy: "Understand where you're strong, where you're weak, and what deserves attention.",
  },
  {
    stage: '06',
    label: 'Revise',
    title: 'Targeted Reinforcement',
    copy: 'Close the gaps your practice reveals.',
  },
  {
    stage: '07',
    label: 'Prepare',
    title: 'Builder Community & Support',
    copy: 'Stay consistent in an environment built around serious preparation.',
  },
];

const OBJECTIONS = [
  {
    q: "“I'm just starting. Isn't this too early?”",
    a: "That's exactly why we're starting now. The goal isn't to create pressure early. It's to build a strong foundation before pressure arrives.",
  },
  {
    q: '“I already have textbooks and past questions.”',
    a: "Good. TECHMED isn't trying to replace every resource you own. We're helping you use your resources more strategically.",
  },
  {
    q: '“I’m already in another tutorial.”',
    a: "You don't have to abandon what works. TECHMED is designed to complement serious preparation with structure, diagnosis, practice and accountability.",
  },
  {
    q: '“I’m not naturally brilliant.”',
    a: "You don't need to be. You need a willingness to learn, practise, correct your mistakes and keep building.",
  },
  {
    q: '“Will Kairo do everything for me?”',
    a: 'No. Kairo is a guide, not a substitute for effort. It helps you make better decisions about your effort.',
  },
];

const pageUrl = new URL('/utme-2027', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'UTME 2027 Preparation System | TECHMED',
    url: pageUrl,
    description:
      "Prepare for UTME 2027 with TECHMED's structured student-success system—from understanding the JAMB syllabus to practice, diagnosis, revision and exam readiness.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'UTME 2027', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="UTME 2027 Preparation System | TECHMED"
  description="Prepare for UTME 2027 with TECHMED's structured student-success system—from understanding the JAMB syllabus to practice, diagnosis, revision and exam readiness."
  jsonLd={jsonLd}
  smoothScroll
  ogImage="/images/proof/daniella-372.jpg"
>
  <!-- 01. HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">UTME 2027 &bull; BUILT TO LAST</p>
      <h1>Don't guess your way through UTME 2027.</h1>
      <p class="lede">
        TECHMED gives you a structured system for knowing what to study, how to practise, what to
        fix and what to do next&mdash;so you can prepare strategically instead of studying randomly.
      </p>
      <a class="cta-primary" href={BUILDERS_URL}>BECOME A BUILDER <span aria-hidden="true">&rarr;</span></a>
      <p class="microcopy">Start building your preparation before the pressure starts.</p>

      <ol class="hero-path" aria-label="The TECHMED preparation system">
        {SYSTEM_STEPS.map((step, i) => (
          <>
            <li>{step.name}</li>
            {i < SYSTEM_STEPS.length - 1 && <span aria-hidden="true">&rarr;</span>}
          </>
        ))}
      </ol>
    </div>
  </section>

  <!-- 02. THE PROBLEM -->
  <section class="problem">
    <h2>The problem isn't a lack of materials.</h2>
    <p class="body-copy">
      You already have textbooks, past questions, videos, tutorials and study apps.
    </p>
    <p class="body-copy">
      The hard part is knowing what matters, what to do with it, and what to do next.
    </p>

    <div class="compare reveal">
      <div class="compare-col without">
        <p class="compare-label">Without a system</p>
        <ol class="chain">
          {WITHOUT_SYSTEM.map((item, i) => (
            <li>
              <span class="chain-item">{item}</span>
              {i < WITHOUT_SYSTEM.length - 1 && <span class="chain-arrow" aria-hidden="true">&darr;</span>}
            </li>
          ))}
        </ol>
      </div>
      <div class="compare-col with">
        <p class="compare-label">With a system</p>
        <ol class="chain">
          {WITH_SYSTEM.map((item, i) => (
            <li>
              <span class="chain-item">{item}</span>
              {i < WITH_SYSTEM.length - 1 && <span class="chain-arrow" aria-hidden="true">&darr;</span>}
            </li>
          ))}
        </ol>
      </div>
    </div>

    <p class="closing">
      Having more resources doesn't automatically create better preparation.<br />
      A system does.
    </p>
  </section>

  <!-- 03. THE TECHMED SYSTEM -->
  <section class="system">
    <p class="eyebrow center">The TECHMED System</p>
    <h2 class="center">Your preparation has a system.</h2>
    <p class="intro">TECHMED is built around a simple seven-stage preparation process.</p>

    <ol class="system-flow">
      {SYSTEM_STEPS.map((step, i) => (
        <li class:list={['system-step', 'reveal', { destination: i === SYSTEM_STEPS.length - 1 }]}>
          <span class="node"><span class="number">{String(i + 1).padStart(2, '0')}</span></span>
          <div class="step-text">
            <h3>{step.name}</h3>
            <p>{step.copy}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="section-cta">
      <a class="cta-primary" href={BUILDERS_URL}>BECOME A BUILDER <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- 04. 372 PROOF -->
  <section class="proof">
    <div class="proof-grid">
      <div class="proof-image reveal">
        <img
          src="/images/proof/daniella-372.jpg"
          alt="Congratulations graphic for Owoeye Daniella, TECHMED student — 2026 UTME result: English 98, Chemistry 98, Physics 94, Biology 82, aggregate score 372."
          width="900"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="proof-content reveal">
        <p class="eyebrow">Real Student. Real Result.</p>
        <p class="proof-number">372</p>
        <p class="proof-label">UTME 2026</p>
        <h2>She prepared within the TECHMED ecosystem.</h2>
        <blockquote>
          &ldquo;I've seen my result and I'm really proud to have you tutor me&hellip; Your tests and
          podcasts have been helpful and I'm so grateful to God for channeling me to you.&rdquo;
        </blockquote>
        <p class="attribution">&mdash; Owoeye Daniella, 2026 UTME Highest Scorer</p>
        <p class="supporting">
          One result doesn't tell the whole TECHMED story. But it tells you what is possible when
          serious preparation meets the right environment.
        </p>
      </div>
    </div>
  </section>

  <!-- 05. TESTIMONIAL MOSAIC -->
  <section class="mosaic">
    <h2 class="center">But TECHMED is more than a score.</h2>
    <p class="intro center">Ask the students who have experienced it.</p>
    <div class="mosaic-grid">
      {TESTIMONIALS.map((t) => (
        <figure class="quote-card reveal">
          <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
          <figcaption>
            <span class="name">{t.name}</span>
            <span class="context">{t.context}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 06. KAIRO -->
  <section class="kairo">
    <div class="kairo-inner">
      <p class="eyebrow">The Intelligence Layer</p>
      <h2>When you don't know what to do next, Kairo helps.</h2>
      <p class="body-copy">
        Kairo uses your performance to help identify what you should study, practise, fix and
        revisit next.
      </p>
      <p class="supporting-line">
        Instead of giving you more things to study, Kairo helps you make better decisions about
        what to do next.
      </p>

      <div class="kairo-flow">
        {KAIRO_FLOW.map((shot, i) => (
          <div class="kairo-shot reveal">
            <div class="kairo-frame">
              <img
                src={shot.src}
                alt={shot.alt}
                width="720"
                height="1386"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="kairo-caption">
              <span aria-hidden="true">{i + 1}.</span> {shot.caption}
            </p>
          </div>
        ))}
      </div>

      <div class="section-cta">
        <a class="cta-primary" href="/tools">EXPLORE KAIRO <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- 07. WHAT YOU GET -->
  <section class="what-you-get">
    <h2 class="center">One system. Everything works together.</h2>
    <p class="intro center">
      TECHMED brings the tools, resources, teaching, practice and community together around one
      preparation journey.
    </p>
    <div class="wyg-grid">
      {WHAT_YOU_GET.map((item) => (
        <div class="wyg-card reveal">
          <div class="wyg-head">
            <span class="wyg-stage">{item.stage}</span>
            <span class="wyg-label">{item.label}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 08. BUILDER IDENTITY -->
  <section class="builder-identity">
    <p class="eyebrow center">The Builder</p>
    <h2 class="center">You don't have to have it all figured out.</h2>
    <p class="body-copy center">A Builder is a student who has decided to prepare deliberately.</p>
    <p class="body-copy center">You don't need to be the smartest person in the room.</p>
    <p class="body-copy center">
      You need to be willing to understand, practise, correct your mistakes, and keep building.
    </p>
    <p class="identity-close">Brick by brick. Day by day.</p>
  </section>

  <!-- 09. OBJECTIONS -->
  <section class="objections">
    <h2 class="center">You might be wondering&hellip;</h2>
    <div class="accordion">
      {OBJECTIONS.map((item) => (
        <details class="reveal">
          <summary>
            <span>{item.q}</span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 10. FINAL CTA -->
  <section class="final-cta reveal">
    <p class="eyebrow">UTME 2027 Starts Now</p>
    <h2>Don't wait until the pressure starts.</h2>
    <p class="body-copy">Start building your preparation now.</p>
    <a class="cta-primary" href={BUILDERS_URL}>BECOME A BUILDER <span aria-hidden="true">&rarr;</span></a>
    <p class="supporting-line">Brick by brick. Day by day.</p>
    <p class="brand-line">Because things built well last.</p>
  </section>

  <!-- Mobile sticky CTA — hidden while the Hero or Final CTA (which both
       already show the same button) or the Footer are in view, so it
       never doubles up on-screen or sits over the page's last content. -->
  <div class="sticky-cta" id="stickyCta">
    <a class="cta-primary" href={BUILDERS_URL}>BECOME A BUILDER <span aria-hidden="true">&rarr;</span></a>
  </div>
</BaseLayout>

<script>
  const stickyCta = document.getElementById('stickyCta');
  const hideTargets = document.querySelectorAll('.hero, .final-cta, .footer');

  if (stickyCta && hideTargets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const anyVisible = entries.some((entry) => entry.isIntersecting);
        stickyCta.classList.toggle('is-hidden', anyVisible);
      },
      { threshold: 0.1 },
    );
    hideTargets.forEach((el) => observer.observe(el));
  }
</script>

<style>
  section {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
  }

  .center {
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: clamp(1.6rem, 4.2vw, 2.3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .body-copy {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-light);
    max-width: 62ch;
    margin-bottom: var(--space-3);
  }

  .body-copy.center {
    margin-left: auto;
    margin-right: auto;
  }

  .intro {
    font-size: 1.05rem;
    color: var(--text-light);
    max-width: 56ch;
    margin-bottom: var(--space-10);
  }

  .intro.center {
    margin-left: auto;
    margin-right: auto;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    padding: 15px 30px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .cta-primary span {
    transition: transform 200ms ease;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.35);
  }

  .cta-primary:hover span {
    transform: translateX(3px);
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-10);
  }

  /* 01. Hero — kept short: eyebrow, headline, subhead and CTA all land in
     the first viewport on mobile; the path visual sits below the fold
     trigger, reinforcing "there is a system" right as the visitor keeps
     scrolling, without delaying the CTA. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
    padding: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.3;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 15%, black 30%, transparent 75%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-10);
    text-align: center;
  }

  .hero-content .eyebrow {
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 6.5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .lede {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--text-light);
    max-width: 56ch;
    margin: 0 auto var(--space-7);
  }

  .microcopy {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-4);
  }

  .hero-path {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-1) 6px;
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-path li {
    white-space: nowrap;
  }

  .hero-path span {
    color: var(--accent-text);
  }

  /* 02. Problem */
  .problem {
    max-width: 800px;
  }

  .problem h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .closing {
    font-size: 1.15rem;
    font-weight: 700;
    font-family: var(--font-display);
    line-height: 1.6;
    margin-top: var(--space-8);
  }

  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin: var(--space-10) 0;
  }

  .compare-col {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
  }

  .compare-col.without {
    border: 1px dashed var(--border);
  }

  .compare-col.with {
    border: 1px solid var(--accent);
    box-shadow: inset 0 2px 0 0 var(--accent);
  }

  .compare-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .without .compare-label {
    color: var(--text-muted);
  }

  .with .compare-label {
    color: var(--accent-text);
  }

  .chain {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .chain-item {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    padding: 8px 14px;
    border-radius: var(--radius-full);
  }

  .without .chain-item {
    color: var(--text-muted);
    background: var(--surface-raised);
    opacity: 0.85;
  }

  .with .chain-item {
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
  }

  .chain-arrow {
    display: block;
    text-align: center;
    line-height: 1.6;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .with .chain-arrow {
    color: var(--accent-text);
    opacity: 1;
  }

  /* 03. The TECHMED System */
  .system {
    max-width: 1150px;
  }

  .system-flow {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    max-width: 620px;
    margin: 0 auto;
  }

  .system-step {
    display: flex;
    gap: var(--space-5);
    padding-bottom: var(--space-8);
    position: relative;
  }

  .system-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    width: 2px;
    height: calc(100% - 40px);
    background: var(--border);
  }

  .node {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-raised);
    border: 2px solid var(--accent);
    z-index: 1;
  }

  .number {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--accent-text);
  }

  .step-text h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 4px;
    padding-top: 10px;
  }

  .step-text p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-light);
  }

  .system-step.destination .node {
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    border-color: var(--accent);
  }

