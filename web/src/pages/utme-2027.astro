---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBuilderSettings, formatDateRange } from '../lib/builders';

const builderSettings = await getBuilderSettings();
const {
  channelUrl,
  joinUrl,
  foundationOngoing = true,
  foundationStatusNotice,
  tutorialStartDate = '2026-10-16',
  tutorialEndDate = '2026-11-14',
} = builderSettings;

const activeJoinDestination = joinUrl || channelUrl;
const dateRangeFormatted = formatDateRange(tutorialStartDate, tutorialEndDate) || '16 October — 14 November 2026';

const SYSTEM_STEPS = [
  {
    stage: '01',
    name: 'Understand',
    summary: 'Decode the Syllabus',
    copy: 'Know exactly what JAMB tests across every topic before spending hours on low-yield material.',
  },
  {
    stage: '02',
    name: 'Plan',
    summary: 'Structured Roadmap',
    copy: 'Convert the vast 5-subject syllabus into an achievable weekly timetable you can actually stick to.',
  },
  {
    stage: '03',
    name: 'Learn',
    summary: 'Concept Mastery',
    copy: 'Build genuine scientific comprehension through first-principles explanations, not blind memorisation.',
  },
  {
    stage: '04',
    name: 'Practise',
    summary: 'Deliberate Drills',
    copy: 'Apply your understanding under real CBT constraints to build speed, accuracy, and calm execution.',
  },
  {
    stage: '05',
    name: 'Diagnose',
    summary: 'Pinpoint Blind Spots',
    copy: 'Analyze performance data to identify specific subtopic weaknesses and recurring question errors.',
  },
  {
    stage: '06',
    name: 'Revise',
    summary: 'Targeted Reinforcement',
    copy: 'Close identified knowledge gaps systematically using high-yield summary boosters and formula sheets.',
  },
  {
    stage: '07',
    name: 'Prepare',
    summary: 'Exam Conditioning',
    copy: 'Simulate full mock conditions with peer ranking so you enter the exam hall confident and ready.',
  },
];

const ECOSYSTEM_CARDS = [
  {
    tag: 'Syllabus Intelligence',
    title: 'JAMB 2027 Blueprints',
    description: 'Deconstructed syllabi for Biology, Chemistry, Physics, Mathematics, and English detailing question weight and critical focus areas.',
    href: '/jamb-syllabus-2027',
    cta: 'View 2027 Blueprints',
    external: false,
    highlight: false,
  },
  {
    tag: 'Diagnostic CBT Tool',
    title: 'Kairo Practice System',
    description: 'Practice real UTME past questions and timed drills. Kairo tracks your accuracy, identifies weak topics, and recommends your next drill.',
    href: 'https://kairo.techmedng.com/',
    cta: 'Launch Kairo Practice',
    external: true,
    highlight: false,
  },
  {
    tag: 'Revision & Strategy',
    title: 'Learning Resources',
    description: 'Topic summaries, high-yield formula sheets, study schedules, and the “5 Minutes Forward” daily discipline podcast.',
    href: '/resources',
    cta: 'Explore Resources',
    external: false,
    highlight: false,
  },
  {
    tag: 'Free 30-Day Cohort · Ongoing',
    title: 'Foundation Protocol',
    description: 'Structured 30-day preparation experience with 40 live classes across 5 subjects, weekly Builder challenges, and CBT diagnosis.',
    href: '/foundation-protocol',
    cta: 'Inspect Foundation Protocol',
    external: false,
    highlight: true,
  },
  {
    tag: 'Comprehensive Programme',
    title: 'UTME 2027 Masterclass',
    description: 'Full 3-month syllabus coverage starting November 30, 2026. Live interactive lectures, mentor check-ins, mock exams, and community.',
    href: '/pricing',
    cta: 'Compare Plans & Pricing',
    external: false,
    highlight: false,
  },
];

const pageUrl = new URL('/utme-2027', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'UTME 2027 Preparation Ecosystem | TECHMED',
    url: pageUrl,
    description:
      'The comprehensive TECHMED UTME 2027 gateway: verified syllabus blueprints, Kairo CBT practice, free 30-day Foundation Protocol, and structured masterclass packages.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'UTME 2027', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="UTME 2027 Preparation Ecosystem | TECHMED"
  description="Prepare for UTME 2027 with TECHMED's structured preparation ecosystem: JAMB Blueprints, Kairo CBT, free Foundation Protocol, and comprehensive 2027 masterclasses."
  jsonLd={jsonLd}
  smoothScroll
  ogImage="/images/proof/daniella-372.jpg"
>
  <!-- 01. HERO SECTION -->
  <section class="hero-section">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-container">
      {foundationOngoing && (
        <aside class="hero-status-pill" aria-label="Ongoing Programme Notice">
          <span class="status-indicator" aria-hidden="true"></span>
          <span class="status-text">
            <strong>Active Now:</strong> Free 30-Day Foundation Protocol Ongoing ({dateRangeFormatted})
          </span>
          <a href="/foundation-protocol" class="status-link">
            Details <span aria-hidden="true">&rarr;</span>
          </a>
        </aside>
      )}

      <p class="hero-eyebrow">TECHMED UTME 2027 PREPARATION ECOSYSTEM</p>
      <h1 class="hero-title">Build your UTME foundation before the pressure builds.</h1>
      <p class="hero-lede">
        TECHMED provides a structured system across syllabus blueprints, diagnostic CBT practice,
        curated revision resources, and community accountability—so you can stop guessing and prepare
        with calm certainty.
      </p>

      <div class="hero-cta-group">
        <a class="btn-primary" href="/foundation-protocol">
          Join Free Foundation Protocol <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn-outline" href="#ecosystem">
          Explore the Ecosystem
        </a>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="hero-metrics-strip">
        <div class="metric-item">
          <span class="metric-val">5</span>
          <span class="metric-label">UTME Subjects</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric-item">
          <span class="metric-val">7-Stage</span>
          <span class="metric-label">Preparation System</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric-item">
          <span class="metric-val">372/400</span>
          <span class="metric-label">Proven Top Score</span>
        </div>
        <div class="metric-divider" aria-hidden="true"></div>
        <div class="metric-item">
          <span class="metric-val">100% Free</span>
          <span class="metric-label">Protocol Access</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 02. STUDENT PROOF SECTION -->
  <section class="proof-section" id="proof">
    <div class="container">
      <div class="proof-card">
        <div class="proof-visual">
          <img
            src="/images/proof/daniella-372.jpg"
            alt="Official result graphic for Owoeye Daniella, TECHMED student — UTME 2026 score: English 98, Chemistry 98, Physics 94, Biology 82, aggregate 372/400."
            width="640"
            height="850"
            loading="lazy"
            decoding="async"
            class="proof-img"
          />
        </div>

        <div class="proof-content">
          <p class="section-eyebrow">VERIFIED STUDENT EVIDENCE</p>
          <div class="proof-score-badge">
            <span class="score-number">372</span>
            <span class="score-scale">/ 400</span>
          </div>
          <p class="score-breakdown">
            English 98 &bull; Chemistry 98 &bull; Physics 94 &bull; Biology 82
          </p>
          <h2 class="proof-title">She prepared within the TECHMED ecosystem.</h2>

          <blockquote class="proof-quote">
            &ldquo;I've seen my result and I'm really proud to have you tutor me&hellip; Your tests and
            podcasts have been helpful and I'm so grateful to God for channeling me to you.&rdquo;
          </blockquote>

          <div class="proof-author">
            <p class="author-name">Owoeye Daniella Jesudunsin</p>
            <p class="author-meta">TECHMED Student &bull; UTME 2026 Score: 372/400</p>
          </div>

          <p class="proof-subtext">
            One student's exceptional score does not promise an effortless outcome—it demonstrates what
            is realistically achievable when serious daily discipline meets the right preparation environment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. THE TECHMED SYSTEM (DISPLAYED ONCE) -->
  <section class="system-section" id="system">
    <div class="container">
      <div class="section-header text-center">
        <p class="section-eyebrow">THE METHODOLOGY</p>
        <h2 class="section-title">Your preparation has a system.</h2>
        <p class="section-lede">
          Random topics, scattered past questions, and chaotic study routines produce panic.
          TECHMED structures your entire 2027 preparation into one repeatable, seven-stage framework.
        </p>
      </div>

      <div class="system-grid">
        {SYSTEM_STEPS.map((step) => (
          <div class="system-card">
            <div class="system-card-top">
              <span class="step-badge">{step.stage}</span>
              <span class="step-summary">{step.summary}</span>
            </div>
            <h3 class="step-name">{step.name}</h3>
            <p class="step-copy">{step.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04. EXPLORE THE ECOSYSTEM -->
  <section class="ecosystem-section" id="ecosystem">
    <div class="container">
      <div class="section-header text-center">
        <p class="section-eyebrow">TECHMED 2027 PLATFORM</p>
        <h2 class="section-title">Explore the UTME 2027 Ecosystem</h2>
        <p class="section-lede">
          Five focused components designed to take you from foundational understanding to full exam readiness.
        </p>
      </div>

      <div class="ecosystem-grid">
        {ECOSYSTEM_CARDS.map((item) => (
          <article class:list={['ecosystem-card', { featured: item.highlight }]}>
            <div class="card-head">
              <span class="card-tag">{item.tag}</span>
              {item.highlight && <span class="active-badge">Active</span>}
            </div>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.description}</p>
            <div class="card-footer">
              <a
                href={item.href}
                class:list={['card-btn', item.highlight ? 'card-btn-primary' : 'card-btn-outline']}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.cta} <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05. CURRENT OPPORTUNITIES -->
  <section class="opportunities-section" id="opportunities">
    <div class="container">
      <div class="section-header text-center">
        <p class="section-eyebrow">HOW TO GET INVOLVED RIGHT NOW</p>
        <h2 class="section-title">Current Opportunities for UTME 2027</h2>
        <p class="section-lede">
          Clear, honest transparency: join what is live today, or inspect upcoming programmes for the months ahead.
        </p>
      </div>

      <div class="opportunities-grid">
        <!-- Opportunity 1: Foundation Protocol (Ongoing) -->
        <div class="opp-card opp-highlight">
          <div class="opp-badge-row">
            <span class="opp-tag">Primary Active Opportunity</span>
            <span class="opp-status live">Ongoing</span>
          </div>
          <h3 class="opp-title">Free 30-Day Foundation Protocol</h3>
          <p class="opp-date">Dates: {dateRangeFormatted}</p>
          <p class="opp-desc">
            40 live classes across English, Biology, Chemistry, Physics, and Mathematics. Daily structure,
            interactive problem solving, weekly Builder's Challenges, and diagnostic CBT assessments.
          </p>
          <ul class="opp-list">
            <li>Zero registration fees or hidden costs</li>
            <li>Direct access to live sessions & syllabus guides</li>
            <li>Weekly retrieval drills and CBT diagnosis</li>
          </ul>
          <div class="opp-cta-wrap">
            <a class="btn-primary" href="/foundation-protocol">
              Join Free Foundation Protocol <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Opportunity 2: Builders Channel (Active Community) -->
        <div class="opp-card">
          <div class="opp-badge-row">
            <span class="opp-tag">Daily Culture & Strategy</span>
            <span class="opp-status community">Active Community</span>
          </div>
          <h3 class="opp-title">UTME 2027 Builders Channel</h3>
          <p class="opp-date">Permanent WhatsApp Channel</p>
          <p class="opp-desc">
            The central communication channel for serious UTME 2027 candidates. Receive daily strategy insights,
            study schedules, class links, and announcements directly on WhatsApp.
          </p>
          <ul class="opp-list">
            <li>Daily strategy notes & formula reminders</li>
            <li>Broadcast updates for all TECHMED events</li>
            <li>Strictly focused on academic preparation</li>
          </ul>
          <div class="opp-cta-wrap">
            <a class="btn-outline" href={channelUrl} target="_blank" rel="noopener noreferrer">
              Join Builders Channel <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Opportunity 3: Paid Masterclasses (Coming Nov 30) -->
        <div class="opp-card">
          <div class="opp-badge-row">
            <span class="opp-tag">Comprehensive 3-Month Course</span>
            <span class="opp-status upcoming">Starts Nov 30, 2026</span>
          </div>
          <h3 class="opp-title">Paid UTME 2027 Masterclass</h3>
          <p class="opp-date">Launch Date: November 30, 2026</p>
          <p class="opp-desc">
            Our comprehensive 3-month syllabus mastery programme. Complete topic-by-topic teaching,
            weekly CBT mocks, assigned tutors, personalized weak-area diagnosis, and intensive revision.
          </p>
          <ul class="opp-list">
            <li>Complete JAMB syllabus coverage until exam day</li>
            <li>Unlimited Kairo CBT practice & full-length mocks</li>
            <li>Three transparent tier packages (Core, Mastery, Ultimate)</li>
          </ul>
          <div class="opp-cta-wrap">
            <a class="btn-outline" href="/pricing">
              Compare Plans & Pricing <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. BUILDER IDENTITY (SHORT SUMMARY) -->
  <section class="identity-section" id="builder-identity">
    <div class="container text-center">
      <div class="identity-box">
        <p class="section-eyebrow">THE BUILDER IDENTITY</p>
        <h2 class="identity-title">You don't have to be a genius. You have to be a Builder.</h2>
        <p class="identity-body">
          A Builder is a student who has decided to prepare deliberately. You don't need to know every
          formula on Day 1. You only need a willingness to learn concepts deeply, practise under real conditions,
          confront your mistakes honestly, and keep building every single day.
        </p>
        <p class="identity-motto">Brick by brick. Day by day. Because things built well last.</p>
        <div class="identity-actions">
          <a class="btn-outline" href="/utme-2027/builders">
            Read the Builder Culture & Manifesto <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 07. FINAL CTA -->
  <section class="final-cta-section" id="final-cta">
    <div class="container text-center">
      <div class="final-card">
        <p class="section-eyebrow">UTME 2027 STARTS NOW</p>
        <h2 class="final-title">Don't wait until the pressure starts.</h2>
        <p class="final-lede">
          Join prospective UTME 2027 candidates who have chosen structure over guesswork.
          Start with the free Foundation Protocol today.
        </p>

        <div class="final-actions">
          <a class="btn-primary" href="/foundation-protocol">
            Join the Free Foundation Protocol <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-secondary" href={channelUrl} target="_blank" rel="noopener noreferrer">
            Join the Builders Channel
          </a>
        </div>

        <p class="final-sublink">
          Targeting the complete 3-month programme?
          <a href="/pricing" class="link-gold">Explore the UTME 2027 Masterclass packages &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Mobile CTA -->
  <aside class="sticky-mobile-cta" id="stickyCta" aria-label="Mobile Registration Action">
    <div class="sticky-inner">
      <div class="sticky-info">
        <span class="sticky-badge">Free Protocol</span>
        <span class="sticky-text">30-day UTME 2027 foundation</span>
      </div>
      <a class="sticky-btn" href="/foundation-protocol">
        Join Free <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </aside>
</BaseLayout>

<script>
  const stickyCta = document.getElementById('stickyCta');
  const hideTargets = document.querySelectorAll('.hero-section, .final-cta-section, footer');

  if (stickyCta && hideTargets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const anyVisible = entries.some((entry) => entry.isIntersecting);
        stickyCta.classList.toggle('is-hidden', anyVisible);
      },
      { threshold: 0.1 },
    );
    hideTargets.forEach((el) => observer.observe(el));
  }
</script>

<style>
  /* Base Containers & Typography */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .section-eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .section-lede {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text-light);
  }

  /* Buttons */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.94rem;
    letter-spacing: 0.02em;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    padding: 14px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.25);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.38);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.94rem;
    letter-spacing: 0.02em;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 13px 26px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .btn-outline:hover {
    background: var(--surface-raised);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.94rem;
    letter-spacing: 0.02em;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    padding: 13px 26px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .btn-secondary:hover {
    background: var(--surface-raised);
    border-color: var(--accent);
  }

  /* 01. HERO */
  .hero-section {
    position: relative;
    padding: var(--space-12) 0 var(--space-16);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.25;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black 20%, transparent 80%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 860px;
    text-align: center;
  }

  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(201, 162, 39, 0.12);
    border: 1px solid rgba(201, 162, 39, 0.35);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-size: 0.82rem;
    color: var(--text);
    margin-bottom: var(--space-6);
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.25);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .status-link {
    font-weight: 700;
    color: var(--accent-text);
    text-decoration: underline;
    margin-left: 4px;
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-size: clamp(2.1rem, 5.8vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.12;
    margin-bottom: var(--space-5);
  }

  .hero-lede {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--text-light);
    max-width: 68ch;
    margin: 0 auto var(--space-8);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .hero-metrics-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .metric-val {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.25rem;
    color: var(--accent-text);
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
  }

  /* 02. STUDENT PROOF */
  .proof-section {
    padding: var(--space-14) 0;
    background: var(--surface-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .proof-card {
    display: grid;
    grid-template-columns: minmax(0, 360px) 1fr;
    gap: var(--space-10);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
