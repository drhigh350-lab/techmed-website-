---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceDetail from '../../components/ResourceDetail.astro';
import { RESOURCES } from '../../lib/resources';

export function getStaticPaths() {
  return RESOURCES.map((resource) => ({
    params: { slug: resource.slug },
  }));
}

// Safe: getStaticPaths (above) generates exactly one page per RESOURCES
// entry, so every built [slug] page has a matching resource by
// construction — any slug not in RESOURCES never gets a page generated
// for it in the first place, and resolves to a clean 404 instead.
const resource = RESOURCES.find((r) => r.slug === Astro.params.slug)!;
const related = RESOURCES.filter(
  (r) => r.category === resource.category && r.slug !== resource.slug,
).slice(0, 3);

const pageUrl = new URL(`/resources/${resource.slug}`, Astro.site).toString();
const currencyCode = resource.currency ?? 'NGN';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: resource.title, item: pageUrl },
    ],
  },
  resource.status === 'paid'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: resource.title,
        description: resource.description,
        offers: {
          '@type': 'Offer',
          priceCurrency: currencyCode,
          ...(resource.price ? { price: resource.price } : {}),
          availability: 'https://schema.org/InStock',
          url: pageUrl,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: resource.title,
        description: resource.description,
        url: pageUrl,
      },
];
---

<BaseLayout
  title={`${resource.title} | TECHMED Resources`}
  description={resource.description}
  jsonLd={jsonLd}
>
  <ResourceDetail resource={resource} related={related} />
</BaseLayout>
