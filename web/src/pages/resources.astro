---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResourceCard from '../components/ResourceCard.astro';
import FeaturedResource from '../components/FeaturedResource.astro';
import ResourceFilters from '../components/ResourceFilters.astro';
import QuizCard from '../components/QuizCard.astro';
import { RESOURCES, RESOURCE_CATEGORIES, getFeaturedResource, getQuizResources } from '../lib/resources';

const featured = getFeaturedResource();
const categories = ['All', ...RESOURCE_CATEGORIES];
const quizResources = getQuizResources();
const kairo = RESOURCES.find((resource) => resource.id === 'kairo');

const pageUrl = new URL('/resources', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'TECHMED Resources',
    url: pageUrl,
    description:
      'Academic resources, admission guides, quizzes and digital tools built to help Nigerian students prepare with greater clarity and consistency.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="TECHMED Resources — Tools, Guides & Learning Systems"
  description="Explore TECHMED academic resources, admission guides, quizzes and digital tools designed to help students prepare with greater clarity and consistency."
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="eyebrow">TECHMED RESOURCES</p>
    <h1>Tools for the journey.</h1>
    <p class="subtitle">
      Explore academic resources, study systems, admission guides, quizzes and digital tools built
      to help you prepare with greater clarity and consistency.
    </p>
    <a href="#catalog" class="btn-primary">Explore Resources</a>
  </section>

  <FeaturedResource resource={featured} />

  <section class="catalog" id="catalog">
    <SectionHeading title="Browse All Resources" align="center" />
    <ResourceFilters categories={categories} gridSelector="#resource-grid" />

    <div class="resource-grid" id="resource-grid">
      {RESOURCES.map((resource) => (
        <div data-category={resource.category}>
          <ResourceCard resource={resource} />
        </div>
      ))}
    </div>

    <p class="empty-state" data-empty-state>
      No resources here yet. More resources are being built — check back soon.
    </p>
  </section>

  <section class="quizzes">
    <SectionHeading
      eyebrow="Practice"
      title="Test what you know."
      subtitle="Practice is where understanding becomes performance."
      align="center"
    />
    {quizResources.length > 0 ? (
      <div class="quiz-grid">
        {quizResources.map((quiz) => (
          <QuizCard
            title={quiz.title}
            description={quiz.description}
            startUrl={quiz.externalUrl ?? quiz.accessUrl ?? `/resources/${quiz.slug}`}
            external={Boolean(quiz.externalUrl)}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">New practice quizzes are coming.</p>
    )}
  </section>

  {kairo && (
    <section class="digital-tools">
      <SectionHeading eyebrow="Digital Tools" title="Kairo" align="center" />
      <div class="kairo-card reveal">
        {kairo.thumbnail && <div class="icon" set:html={kairo.thumbnail} />}
        <p class="positioning">
          Kairo is a student intelligence and learning platform designed to understand the
          learner's journey and help them make meaningful progress.
        </p>
        <a class="btn-primary" href={kairo.accessUrl}>Open Kairo</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-12);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  .subtitle {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .btn-primary {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    padding: 14px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.3);
  }

  .catalog,
  .quizzes,
  .digital-tools {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .empty-state {
    display: none;
    text-align: center;
    font-size: 0.95rem;
    color: var(--text-muted);
    padding: var(--space-12) var(--space-6);
  }

  .quiz-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    max-width: 800px;
    margin: 0 auto;
  }

  .quizzes .empty-state {
    display: block;
  }

  .digital-tools {
    max-width: 720px;
  }

  .kairo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-8);
  }

  .kairo-card .icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--surface-raised);
    color: var(--accent);
    margin-bottom: var(--space-6);
  }

  .kairo-card .icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .positioning {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-light);
    max-width: 52ch;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 800px) {
    .resource-grid,
    .quiz-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
