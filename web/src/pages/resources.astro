---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResourceCard from '../components/ResourceCard.astro';
import FeaturedResource from '../components/FeaturedResource.astro';
import ResourceFilters from '../components/ResourceFilters.astro';
import QuizCard from '../components/QuizCard.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import { getResources, getFeaturedResource, getQuizResources, resourceIcon } from '../lib/resources';

const resources = await getResources();
const featured = getFeaturedResource(resources);
const quizResources = getQuizResources(resources);
const kairo = resources.find((resource) => resource.slug === 'kairo');

const pageUrl = new URL('/resources', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'TECHMED Resource Library',
    url: pageUrl,
    description:
      'High-yield booster systems, formula workbooks, revision manuals, and digital learning tools for Nigerian UTME & Post-UTME candidates.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="Resource Library — Booster Systems, Revision Manuals & Tools | TECHMED"
  description="High-yield Chemistry, Biology, and Physics booster systems, formula banks, Post-UTME guides, and free learning tools for UTME 2027 candidates."
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="eyebrow">TECHMED RESOURCE LIBRARY</p>
    <h1>Tools built for high performance.</h1>
    <p class="subtitle">
      Formula banks, examiner trap playbooks, and high-yield booster systems built for candidates
      aiming for 300+ in UTME. Available standalone for any student, or included with TECHMED cohort plans.
    </p>

    <div class="hero-actions">
      <a href="#catalog" class="btn-primary">Browse Catalogue</a>
      <a href="/library" class="btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>Open Student Library</span>
      </a>
    </div>

    <!-- Quick explanation card of inclusions -->
    <div class="tier-inclusions-strip">
      <div class="strip-item">
        <span class="strip-label">Standalone:</span>
        <span class="strip-val">Open to all candidates nationwide</span>
      </div>
      <div class="strip-divider" aria-hidden="true">·</div>
      <div class="strip-item">
        <span class="strip-label">Core Plan:</span>
        <span class="strip-val">20% discount on e-books</span>
      </div>
      <div class="strip-divider" aria-hidden="true">·</div>
      <div class="strip-item">
        <span class="strip-label">Mastery &amp; Ultimate:</span>
        <span class="strip-val">Formula workbooks &amp; boosters included</span>
      </div>
    </div>
  </section>

  {featured && <FeaturedResource resource={featured} />}

  <section class="catalog" id="catalog">
    <div class="catalog-header">
      <SectionHeading
        title="Learning Catalogue"
        subtitle="Filter by subject or access tier. Live search by keyword, formula, or exam trap."
        align="center"
      />
    </div>

    <ResourceFilters gridSelector="#resource-grid" />

    <div class="resource-grid" id="resource-grid">
      {resources.map((resource) => (
        <div class="grid-item">
          <ResourceCard resource={resource} />
        </div>
      ))}
    </div>

    <div class="empty-state" data-empty-state style="display: none;">
      <div class="empty-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h3>No resources match your search</h3>
      <p>Try clearing your search query or switching subject filters to view other materials.</p>
    </div>
  </section>

  <!-- Student Library Notice -->
  <section class="student-library-banner">
    <div class="banner-inner">
      <div class="banner-text">
        <span class="banner-eyebrow">STUDENT ACCESS</span>
        <h2>Access your personal library anytime.</h2>
        <p>
          Already enrolled in TECHMED Mastery or purchased a booster? Sign in to your Student Library
          to read your materials, review formula cheat-sheets, and track your active preparation assets.
        </p>
      </div>
      <div class="banner-action">
        <a href="/library" class="btn-primary">Go to Student Library &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Practice & Tools -->
  <section class="quizzes">
    <SectionHeading
      eyebrow="Practice Drills"
      title="Test what you know."
      subtitle="Practice is where understanding transforms into speed and exam precision."
      align="center"
    />
    {quizResources.length > 0 ? (
      <div class="quiz-grid">
        {quizResources.map((quiz) => (
          <QuizCard
            title={quiz.title}
            description={quiz.description}
            startUrl={quiz.externalUrl ?? quiz.accessUrl ?? `/resources/${quiz.slug}`}
            external={Boolean(quiz.externalUrl)}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">New practice quizzes are coming.</p>
    )}
  </section>

  {kairo && (
    <section class="digital-tools">
      <SectionHeading eyebrow="Digital Learning Platform" title="Kairo Intelligence" align="center" />
      <div class="kairo-card reveal">
        {kairo.primaryImage ? (
          <img class="kairo-image" src={kairo.primaryImage} alt="Kairo" loading="lazy" decoding="async" />
        ) : (
          <div class="icon" set:html={resourceIcon(kairo)} />
        )}
        <p class="positioning">
          Kairo is a student intelligence and learning platform designed to understand the
          learner's journey and help them make meaningful progress.
        </p>
        <a class="btn-primary" href={kairo.accessUrl}>Launch Kairo CBT</a>
      </div>
    </section>
  )}

  <section class="syllabus-link reveal">
    <p>
      Looking for the complete UTME 2027 preparation plan? View our <a href="/pricing">Preparation Packages &amp; Pricing</a>,
      explore the <a href="/jamb-syllabus-2027">JAMB Syllabus 2027 Breakdown</a>, or visit the <a href="/utme-2027">UTME 2027 Gateway</a>.
    </p>
  </section>

  <CheckoutModal />
</BaseLayout>

<style>
  .hero {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-10);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-text);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-5);
  }

  .subtitle {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-light);
    max-width: 66ch;
    margin: 0 auto var(--space-8);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 13px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }

  .btn-primary {
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.3);
  }

  .btn-secondary {
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .tier-inclusions-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    margin: 0 auto;
    font-size: 0.8rem;
    color: var(--text-light);
  }

  .strip-item {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .strip-label {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--accent-text);
    letter-spacing: 0.05em;
  }

  .strip-val {
    color: var(--text);
  }

  .strip-divider {
    color: var(--border);
  }

  .catalog,
  .quizzes,
  .digital-tools {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }

  .catalog-header {
    margin-bottom: var(--space-8);
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: stretch;
  }

  .grid-item {
    display: contents;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    margin-top: var(--space-6);
  }

  .empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--surface-raised);
    color: var(--text-muted);
  }

  .empty-state h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .empty-state p {
    font-size: 0.92rem;
    color: var(--text-light);
    max-width: 48ch;
    margin: 0 auto;
  }

  .student-library-banner {
    max-width: 1200px;
    margin: var(--space-8) auto;
    padding: 0 var(--space-6);
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-10);
  }

  .banner-eyebrow {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    display: block;
    margin-bottom: var(--space-2);
  }

  .banner-text h2 {
    font-size: 1.4rem;
    margin-bottom: var(--space-3);
  }

  .banner-text p {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.7;
    max-width: 60ch;
  }

  .banner-action {
    flex-shrink: 0;
  }

  .quiz-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5);
    max-width: 800px;
    margin: 0 auto;
  }

  .quiz-grid > :global(*) {
    flex: 0 1 360px;
  }

  .digital-tools {
    max-width: 760px;
  }

  .kairo-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-8);
  }

  .kairo-card .icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--surface-raised);
    color: var(--accent-text);
    margin-bottom: var(--space-6);
  }

  .kairo-card .icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .kairo-image {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
  }

  .positioning {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-light);
    max-width: 52ch;
    margin-bottom: var(--space-6);
  }

  .syllabus-link {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-20);
    text-align: center;
  }

  .syllabus-link p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-light);
  }

  .syllabus-link a {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: none;
  }

  .syllabus-link a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .resource-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .banner-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
    .tier-inclusions-strip {
      flex-direction: column;
      gap: var(--space-2);
      align-items: flex-start;
    }
    .strip-divider {
      display: none;
    }
    .quiz-grid > :global(*) {
      flex-basis: 100%;
    }
  }
</style>
