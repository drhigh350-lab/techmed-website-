---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResourceCard from '../components/ResourceCard.astro';
import FeaturedResource from '../components/FeaturedResource.astro';
import ResourceFilters from '../components/ResourceFilters.astro';
import QuizCard from '../components/QuizCard.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import { getResources, getFeaturedResource, getQuizResources, resourceIcon } from '../lib/resources';

const resources = await getResources();
const featured = getFeaturedResource(resources);
const quizResources = getQuizResources(resources);
const kairo = resources.find((resource) => resource.slug === 'kairo');

const pageUrl = new URL('/resources', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'TECHMED Resources & Learning Bookshelf',
    url: pageUrl,
    description:
      'High-yield booster systems, formula workbooks, revision manuals, and digital learning tools for Nigerian UTME & Post-UTME candidates.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title="Resources & Bookshelf — Booster Systems, Revision Manuals & Tools | TECHMED"
  description="High-yield Chemistry, Biology, and Physics booster systems, formula banks, Post-UTME guides, and free learning tools for UTME 2027 candidates."
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="eyebrow">TECHMED RESOURCE LIBRARY</p>
    <h1>Tools built for high performance.</h1>
    <p class="subtitle">
      Formula banks, examiner trap playbooks, and high-yield booster systems built for candidates
      aiming for 300+ in UTME. Available standalone for any student, or included with TECHMED cohort plans.
    </p>

    <div class="hero-actions">
      <a href="#catalog" class="btn-primary">Browse Catalogue &amp; Bookshelf</a>
    </div>

    <!-- Quick explanation card of inclusions -->
    <div class="tier-inclusions-strip">
      <div class="strip-item">
        <span class="strip-label">Standalone:</span>
        <span class="strip-val">Open to all candidates nationwide</span>
      </div>
      <div class="strip-divider" aria-hidden="true">·</div>
      <div class="strip-item">
        <span class="strip-label">Core Plan:</span>
        <span class="strip-val">20% discount on e-books</span>
      </div>
      <div class="strip-divider" aria-hidden="true">·</div>
      <div class="strip-item">
        <span class="strip-label">Mastery &amp; Ultimate:</span>
        <span class="strip-val">Formula workbooks &amp; boosters included</span>
      </div>
    </div>
  </section>

  {featured && <FeaturedResource resource={featured} />}

  <section class="catalog" id="catalog">
    <div class="catalog-header">
      <SectionHeading
        title="Learning Catalogue &amp; Bookshelf"
        subtitle="Discover study materials, formula banks, and your personal student bookshelf."
        align="center"
      />
    </div>

    <ResourceFilters gridSelector="#resource-grid" />

    <div class="resource-grid" id="resource-grid">
      {resources.map((resource) => (
        <div
          class="grid-item"
          data-resource-id={resource.id}
          data-slug={resource.slug}
          data-subject={resource.subject || resource.category || 'General'}
          data-status={resource.status}
        >
          <ResourceCard resource={resource} />
        </div>
      ))}
    </div>

    <!-- Search Empty State -->
    <div class="empty-state" data-empty-state style="display: none;">
      <div class="empty-icon" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h3>No resources match your search</h3>
      <p>Try clearing your search query or switching subject filters to view other materials.</p>
    </div>

    <!-- Unauthenticated Bookshelf Login Prompt -->
    <div id="bookshelfAuthPrompt" class="bookshelf-auth-prompt" style="display: none;">
      <div class="prompt-icon" aria-hidden="true">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
      </div>
      <p class="prompt-eyebrow">STUDENT BOOKSHELF</p>
      <h3>Sign in to access your bookshelf</h3>
      <p class="prompt-desc">
        Log in to view your purchased booster systems, cohort plan inclusions, and free official study materials.
      </p>
      <div class="prompt-actions">
        <a href="/login?redirect=/resources?view=bookshelf" class="btn-primary prompt-btn">
          Log In to Your Bookshelf &rarr;
        </a>
        <a href="/register?redirect=/resources?view=bookshelf" class="btn-secondary prompt-btn">
          Create Free Account
        </a>
      </div>
    </div>

    <!-- Empty Bookshelf State (authenticated student with no matching items) -->
    <div id="emptyBookshelfState" class="empty-bookshelf-state" style="display: none;">
      <div class="empty-icon" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
      </div>
      <h3>Your personal bookshelf</h3>
      <p class="empty-desc">You haven't unlocked any paid booster systems yet. Explore the catalogue below to add materials to your bookshelf.</p>
      <button type="button" id="browseAllFromBookshelfBtn" class="btn-primary prompt-btn">
        Browse All Resources &rarr;
      </button>
    </div>
  </section>

  <!-- Practice Drills & Quizzes Section -->
  <section class="quizzes">
    <SectionHeading
      eyebrow="Practice Drills"
      title="Test what you know."
      subtitle="Practice is where understanding transforms into speed and exam precision."
      align="center"
    />
    {quizResources.length > 0 ? (
      <div class="quiz-grid">
        {quizResources.map((quiz) => (
          <QuizCard
            title={quiz.title}
            description={quiz.description}
            startUrl={quiz.externalUrl ?? quiz.accessUrl ?? `/resources/${quiz.slug}`}
            external={Boolean(quiz.externalUrl)}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">New practice quizzes are coming.</p>
    )}
  </section>

  <!-- Kairo Digital Platform Section -->
  {kairo && (
    <section class="digital-tools">
      <SectionHeading eyebrow="Digital Learning Platform" title="Kairo Intelligence" align="center" />
      <div class="kairo-card reveal">
        {kairo.primaryImage ? (
          <img class="kairo-image" src={kairo.primaryImage} alt="Kairo" loading="lazy" decoding="async" />
        ) : (
          <div class="icon" set:html={resourceIcon(kairo)} />
        )}
        <p class="positioning">
          Kairo is a student intelligence and learning platform designed to understand the
          learner's journey and help them make meaningful progress.
        </p>
        <a class="btn-primary" href={kairo.accessUrl}>Launch Kairo CBT</a>
      </div>
    </section>
  )}

  <section class="syllabus-link reveal">
    <p>
      Looking for the complete UTME 2027 preparation plan? View our <a href="/pricing">Preparation Packages &amp; Pricing</a>,
      explore the <a href="/jamb-syllabus-2027">JAMB Syllabus 2027 Breakdown</a>, or visit the <a href="/utme-2027">UTME 2027 Gateway</a>.
    </p>
  </section>

  <CheckoutModal />
</BaseLayout>

<style>
  .hero {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-10);
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-text);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: var(--space-5);
  }

  .subtitle {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-light);
    max-width: 66ch;
    margin: 0 auto var(--space-8);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  /* Prominent Deep Navy button styling */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 13px 26px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: #ffffff !important;
    background: #012748 !important;
    border: 1px solid #012748 !important;
    box-shadow: 0 4px 14px rgba(1, 39, 72, 0.22);
    transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: #09476E !important;
    border-color: #09476E !important;
    box-shadow: 0 6px 18px rgba(9, 71, 110, 0.3);
  }

  .tier-inclusions-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 8px 18px;
    font-size: 0.8rem;
    max-width: fit-content;
    margin: 0 auto;
  }

  .strip-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .strip-label {
    font-weight: 700;
    color: var(--text);
  }

  .strip-val {
    color: var(--text-muted);
  }

  .strip-divider {
    color: var(--border);
    font-weight: 800;
  }

  .catalog {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }

  .catalog-header {
    margin-bottom: var(--space-8);
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .grid-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--surface-raised);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    margin-top: var(--space-6);
  }

  .empty-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(9, 71, 110, 0.08);
    color: #09476E;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  :root:not([data-theme='light']) .empty-icon {
    background: rgba(152, 176, 196, 0.15);
    color: #98B0C4;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: var(--space-2);
  }

  .empty-state p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 44ch;
    margin: 0 auto;
  }

  /* Unauthenticated Bookshelf Login Prompt */
  .bookshelf-auth-prompt,
  .empty-bookshelf-state {
    max-width: 540px;
    margin: var(--space-8) auto;
    padding: var(--space-10) var(--space-6);
    background: var(--surface-raised);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 16px 36px rgba(1, 39, 72, 0.08);
    animation: fadeIn 200ms ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .prompt-icon {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(9, 71, 110, 0.1);
    color: #09476E;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  :root:not([data-theme='light']) .prompt-icon {
    background: rgba(152, 176, 196, 0.15);
    color: #98B0C4;
  }

  .prompt-eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #09476E;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  :root:not([data-theme='light']) .prompt-eyebrow {
    color: #98B0C4;
  }

  .bookshelf-auth-prompt h3,
  .empty-bookshelf-state h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 var(--space-3);
  }

  .prompt-desc,
  .empty-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 auto var(--space-6);
    max-width: 42ch;
  }

  .prompt-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .prompt-btn {
    padding: 12px 22px !important;
    font-size: 0.92rem !important;
    border-radius: 8px !important;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .btn-secondary.prompt-btn {
    background: #ffffff !important;
    color: #012748 !important;
    border: 1.5px solid #98B0C4 !important;
    transition: all 150ms ease;
  }

  .btn-secondary.prompt-btn:hover {
    background: #F8F9FA !important;
    border-color: #09476E !important;
    color: #09476E !important;
  }

  /* Quizzes & Practice */
  .quizzes {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }

  .quiz-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  /* Digital Tools / Kairo */
  .digital-tools {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }

  .kairo-card {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    text-align: center;
    margin-top: var(--space-6);
  }

  .kairo-image {
    max-width: 120px;
    margin: 0 auto var(--space-4);
  }

  .positioning {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-light);
    max-width: 58ch;
    margin: 0 auto var(--space-6);
  }

  .syllabus-link {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
    text-align: center;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .syllabus-link a {
    color: #09476E;
    font-weight: 700;
    text-decoration: underline;
  }

  :root:not([data-theme='light']) .syllabus-link a {
    color: #98B0C4;
  }

  @media (max-width: 640px) {
    .tier-inclusions-strip {
      border-radius: var(--radius-sm);
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .strip-divider {
      display: none;
    }

    .prompt-actions {
      flex-direction: column;
      width: 100%;
    }

    .prompt-btn {
      width: 100%;
    }
  }
</style>
