---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FALLBACK_RESOURCES } from '../../lib/resources';

const pageUrl = new URL('/payment/callback', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Payment Verification — TECHMED',
    url: pageUrl,
    description: 'Instant verification of your TECHMED resource purchase or cohort enrolment.',
  },
];

const catalogMapJson = JSON.stringify(FALLBACK_RESOURCES.map(r => ({
  id: r.id,
  slug: r.slug,
  title: r.title,
  price: r.price,
})));
---

<BaseLayout
  title="Payment Verification | TECHMED"
  description="Confirming your payment and unlocking your study materials."
  jsonLd={jsonLd}
>
  <div class="callback-container">
    <div class="callback-card" id="callbackCard">
      <!-- State 1: Verifying Spinner -->
      <div id="loadingState" class="state-block">
        <div class="spinner-wrap">
          <div class="spinner"></div>
        </div>
        <p class="state-eyebrow">PAYSTACK SECURE VERIFICATION</p>
        <h1 class="state-title">Confirming your payment...</h1>
        <p class="state-desc">
          We are verifying your transaction reference with Paystack and activating your enrolment. This usually takes just a few seconds.
        </p>
        <div class="ref-pill-box">
          <span class="ref-label">Reference:</span>
          <span id="displayRef" class="ref-code">Detecting...</span>
        </div>
      </div>

      <!-- State 2: Success Confirmation -->
      <div id="successState" class="state-block" style="display: none;">
        <div class="status-icon success-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <p class="state-eyebrow success">TRANSACTION CONFIRMED</p>
        <h1 class="state-title" id="successHeading">Payment Confirmed!</h1>
        <p class="state-desc" id="successDesc">
          Your payment has been verified and your purchase is active. Welcome to TECHMED!
        </p>

        <div class="receipt-box">
          <div class="receipt-row">
            <span class="receipt-label">Enrolment / Item:</span>
            <span id="confirmedProductName" class="receipt-val highlight">—</span>
          </div>
          <div class="receipt-row">
            <span class="receipt-label">Billing Duration:</span>
            <span id="confirmedDuration" class="receipt-val">—</span>
          </div>
          <div class="receipt-row">
            <span class="receipt-label">Amount Paid:</span>
            <span id="confirmedAmount" class="receipt-val highlight">—</span>
          </div>
          <div class="receipt-row">
            <span class="receipt-label">Transaction Reference:</span>
            <span id="confirmedRef" class="receipt-val mono">—</span>
          </div>
          <div class="receipt-row">
            <span class="receipt-label">Verified At:</span>
            <span id="confirmedTime" class="receipt-val">—</span>
          </div>
        </div>

        <!-- Post-Payment Account Setup (for unauthenticated students) -->
        <div id="postPaymentAccountBox" class="account-setup-box" style="display: none;">
          <div class="setup-badge">STUDENT ACCOUNT SETUP</div>
          <h2 class="setup-title">Secure your student account</h2>
          <p class="setup-desc">
            Your purchase is secure. Create a password to access your dashboard, track classes, and manage your enrolment.
          </p>
          <form id="postPaymentAuthForm" class="setup-form">
            <div class="form-field">
              <label for="postPaymentEmail">Email Address</label>
              <input type="email" id="postPaymentEmail" readonly required class="setup-input" />
            </div>
            <div class="form-field">
              <label for="postPaymentPassword">Create Password</label>
              <input type="password" id="postPaymentPassword" placeholder="Minimum 6 characters" minlength="6" required class="setup-input" />
            </div>
            <button type="submit" id="postPaymentSubmitBtn" class="btn-primary action-btn">
              Create Account &amp; Access Dashboard
            </button>
            <p id="postPaymentStatus" class="setup-status" style="display: none;"></p>
          </form>
        </div>

        <!-- Direct Access Links -->
        <div class="action-buttons-group">
          <a id="openReaderBtn" href="/library" class="btn-primary action-btn">
            Open Student Library &amp; Bookshelf &rarr;
          </a>
          <a id="successWhatsAppBtn" href="#" target="_blank" rel="noopener" class="btn-secondary action-btn">
            Join Student WhatsApp Community
          </a>
        </div>
      </div>

      <!-- State 3: Pending / Delayed Bank Processing -->
      <div id="pendingState" class="state-block" style="display: none;">
        <div class="status-icon pending-icon" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <p class="state-eyebrow warning">TRANSACTION PROCESSING</p>
        <h1 class="state-title">Payment Settlement in Progress</h1>
        <p class="state-desc">
          Your bank or Paystack is still processing the transfer. If you were debited, your reference is recorded and your enrolment will activate automatically as soon as settlement completes.
        </p>

        <div class="pending-actions">
          <button type="button" id="recheckBtn" class="btn-primary action-btn">
            Check Payment Status Again
          </button>
          <a id="pendingWhatsAppBtn" href="#" target="_blank" rel="noopener" class="btn-secondary action-btn">
            Notify Admissions Desk on WhatsApp
          </a>
          <a href="/pricing" class="text-link">Return to Pricing</a>
        </div>
      </div>

      <!-- State 4: Error / Payment Not Completed -->
      <div id="errorState" class="state-block" style="display: none;">
        <div class="status-icon error-icon" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <p class="state-eyebrow danger">PAYMENT NOT COMPLETED</p>
        <h1 class="state-title">We couldn't confirm this payment</h1>
        <p class="state-desc" id="errorMessage">
          The transaction could not be verified or was cancelled. If your bank account was debited, please contact our admissions desk with your reference and we will verify it manually.
        </p>

        <div class="error-actions">
          <a href="/pricing" id="retryPricingBtn" class="btn-primary action-btn">
            Try Again on Pricing Page
          </a>
          <a id="errorWhatsAppBtn" href="#" target="_blank" rel="noopener" class="btn-secondary action-btn">
            Message Support on WhatsApp
          </a>
          <a href="/library" class="text-link">Open Student Library</a>
        </div>
      </div>
    </div>
  </div>

  <script id="catalogData" type="application/json" set:html={catalogMapJson} />
</BaseLayout>

<script>
  import { getSupabase, getCurrentUser, verifyAndClaimOrderReference, saveLocalEntitlement } from '/src/lib/supabase.ts';
  import { trackEvent } from '/src/lib/analytics.ts';

  const catalogEl = document.getElementById('catalogData');
  let CATALOG: any[] = [];
  try {
    CATALOG = JSON.parse(catalogEl?.textContent || '[]');
  } catch {}

  const loadingState = document.getElementById('loadingState');
  const successState = document.getElementById('successState');
  const pendingState = document.getElementById('pendingState');
  const errorState = document.getElementById('errorState');

  const displayRef = document.getElementById('displayRef');
  const confirmedProductName = document.getElementById('confirmedProductName');
  const confirmedDuration = document.getElementById('confirmedDuration');
  const confirmedAmount = document.getElementById('confirmedAmount');
  const confirmedRef = document.getElementById('confirmedRef');
  const confirmedTime = document.getElementById('confirmedTime');
  const successDesc = document.getElementById('successDesc');
  const openReaderBtn = document.getElementById('openReaderBtn') as HTMLAnchorElement | null;
  const successWhatsAppBtn = document.getElementById('successWhatsAppBtn') as HTMLAnchorElement | null;

  const recheckBtn = document.getElementById('recheckBtn');
  const pendingWhatsAppBtn = document.getElementById('pendingWhatsAppBtn') as HTMLAnchorElement | null;
  const errorWhatsAppBtn = document.getElementById('errorWhatsAppBtn') as HTMLAnchorElement | null;
  const errorMessage = document.getElementById('errorMessage');

  const postPaymentAccountBox = document.getElementById('postPaymentAccountBox');
  const postPaymentAuthForm = document.getElementById('postPaymentAuthForm');
  const postPaymentEmail = document.getElementById('postPaymentEmail') as HTMLInputElement | null;
  const postPaymentPassword = document.getElementById('postPaymentPassword') as HTMLInputElement | null;
  const postPaymentSubmitBtn = document.getElementById('postPaymentSubmitBtn') as HTMLButtonElement | null;
  const postPaymentStatus = document.getElementById('postPaymentStatus');

  let pollAttempts = 0;
  const MAX_POLL_ATTEMPTS = 5;
  let currentOrderEmail = '';
  let activeReference = '';

  function setView(state: 'loading' | 'success' | 'pending' | 'error') {
    if (loadingState) loadingState.style.display = state === 'loading' ? 'block' : 'none';
    if (successState) successState.style.display = state === 'success' ? 'block' : 'none';
    if (pendingState) pendingState.style.display = state === 'pending' ? 'block' : 'none';
    if (errorState) errorState.style.display = state === 'error' ? 'block' : 'none';
  }

  function getReference(): string | null {
    const params = new URLSearchParams(window.location.search);
    return params.get('reference') || params.get('trxref') || params.get('ref');
  }

  function getPlanDurationLabel(productId?: string): string {
    if (!productId) return 'Lifetime Access';
    if (productId.includes('monthly')) return '1-Month Subscription (Renews Monthly)';
    if (productId.includes('earlybird')) return '3 Months Upfront (Early-Bird Offer)';
    if (productId.includes('standard')) return '3 Months Upfront (Standard)';
    if (productId.includes('ultimate')) return 'Full UTME 2027 Access (All Phases)';
    if (productId.includes('core')) return '3 Months Upfront (Early-Bird Offer)';
    if (productId.includes('mastery')) return '3 Months Upfront (Early-Bird Offer)';
    return 'Permanent Lifetime Bookshelf License';
  }

  function formatNaira(amount?: number | string): string {
    if (!amount) return '—';
    const num = Number(amount);
    return '₦' + num.toLocaleString('en-NG');
  }

  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVuYmdib3JiaHh6c290YWllaXVuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0MDMyNDcsImV4cCI6MjA5Nzk3OTI0N30.3uM4SaYII60V988NA5PvqphQs6HkTVTnGKpZFqzZY-c';

  async function checkServerEdgeVerify(reference: string) {
    try {
      const res = await fetch('https://unbgborbhxzsotaieiun.supabase.co/functions/v1/pay-verify', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify({ reference }),
      });
      if (res.ok) {
        return await res.json();
      }
    } catch (e) {
      console.warn('pay-verify edge function call failed, falling back to client RPC:', e);
    }
    return null;
  }

  async function verifyTransaction() {
    const reference = getReference();

    if (!reference) {
      setView('error');
      if (errorMessage) {
        errorMessage.textContent = 'No payment reference was detected in the URL. If you just finished payment, please check your email receipt or contact TECHMED on WhatsApp.';
      }
      return;
    }

    activeReference = reference;
    if (displayRef) displayRef.textContent = reference;

    const waMsg = encodeURIComponent(`Hi TECHMED, I just paid via Paystack. My reference is ${reference}. Please verify my access.`);
    const waUrl = `https://wa.me/2347044255045?text=${waMsg}`;
    if (pendingWhatsAppBtn) pendingWhatsAppBtn.href = waUrl;
    if (errorWhatsAppBtn) errorWhatsAppBtn.href = waUrl;
    if (successWhatsAppBtn) successWhatsAppBtn.href = waUrl;

    const user = await getCurrentUser();

    // 1. Try server-side Edge verification
    const edgeResult = await checkServerEdgeVerify(reference);

    if (edgeResult?.success && edgeResult.status === 'paid' && edgeResult.order) {
      handleSuccessOrder(edgeResult.order, reference, user);
      return;
    }

    // 2. Try client RPC verification
    const res = await verifyAndClaimOrderReference(reference, user);

    if (res.success && res.order) {
      handleSuccessOrder(res.order, reference, user);
      return;
    }

    if (res.order?.status === 'pending') {
      pollAttempts++;
      if (pollAttempts < MAX_POLL_ATTEMPTS) {
        setTimeout(verifyTransaction, 3000);
      } else {
        setView('pending');
      }
      return;
    }

    // Failed or not found
    setView('error');
    if (errorMessage && res.message) {
      errorMessage.textContent = res.message;
    }
  }

  function handleSuccessOrder(order: any, reference: string, user: any) {
    setView('success');
    const matchedCatalog = CATALOG.find(c => c.id === order.product_id || c.slug === order.product_id);
    const title = order.product_name || matchedCatalog?.title || 'TECHMED Programme Access';

    if (confirmedProductName) confirmedProductName.textContent = title;
    if (confirmedDuration) confirmedDuration.textContent = getPlanDurationLabel(order.product_id);
    if (confirmedAmount) confirmedAmount.textContent = formatNaira(order.amount || matchedCatalog?.price);
    if (confirmedRef) confirmedRef.textContent = reference;
    if (confirmedTime) {
      confirmedTime.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ', ' + new Date().toLocaleDateString('en-GB');
    }

    currentOrderEmail = order.email || user?.email || '';

    // Track analytics conversion
    trackEvent('payment_success', {
      product_id: order.product_id,
      amount: order.amount,
      reference,
    });

    const isCohort = order.product_id && (order.product_id.startsWith('cohort-') || ['core', 'mastery', 'ultimate'].includes(order.product_id));

    if (openReaderBtn) {
      if (isCohort) {
        openReaderBtn.href = '/library';
        openReaderBtn.textContent = 'Enter Student Dashboard & Library →';
      } else {
        const readerId = matchedCatalog?.id || order.product_id;
        openReaderBtn.href = `/library/read/${readerId}`;
        openReaderBtn.textContent = 'Open in Study Reader Now →';
      }
    }

    // Local entitlement caching
    saveLocalEntitlement({
      resourceId: order.product_id,
      customerEmail: currentOrderEmail,
      grantSource: 'purchase',
      resourceTitle: title,
    });

    // Check if account setup is required (user not signed in)
    if (!user) {
      if (postPaymentAccountBox) postPaymentAccountBox.style.display = 'block';
      if (postPaymentEmail && currentOrderEmail) postPaymentEmail.value = currentOrderEmail;
    }
  }

  // Handle post-payment password creation
  postPaymentAuthForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = postPaymentEmail?.value.trim() || currentOrderEmail;
    const password = postPaymentPassword?.value || '';

    if (!email || !password || password.length < 6) {
      if (postPaymentStatus) {
        postPaymentStatus.style.display = 'block';
        postPaymentStatus.style.color = '#ef4444';
        postPaymentStatus.textContent = 'Password must be at least 6 characters.';
      }
      return;
    }

    if (postPaymentSubmitBtn) {
      postPaymentSubmitBtn.disabled = true;
      postPaymentSubmitBtn.textContent = 'Setting up account...';
    }

    try {
      const supabase = getSupabase();
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
      });

      if (error) {
        if (error.message.includes('already registered')) {
          if (postPaymentStatus) {
            postPaymentStatus.style.display = 'block';
            postPaymentStatus.style.color = '#eab308';
            postPaymentStatus.textContent = 'An account with this email already exists. You can sign in using your existing password on the Student Library.';
          }
        } else {
          if (postPaymentStatus) {
            postPaymentStatus.style.display = 'block';
            postPaymentStatus.style.color = '#ef4444';
            postPaymentStatus.textContent = error.message;
          }
        }
        if (postPaymentSubmitBtn) {
          postPaymentSubmitBtn.disabled = false;
          postPaymentSubmitBtn.textContent = 'Create Account & Access Dashboard';
        }
        return;
      }

      // Link order to new user account
      if (activeReference) {
        try {
          await supabase.rpc('claim_order_reference', {
            p_reference: activeReference,
            p_claimant_email: email.toLowerCase(),
          });
        } catch (rpcErr) {
          console.warn('Auto-claim order failed:', rpcErr);
        }
      }

      if (postPaymentStatus) {
        postPaymentStatus.style.display = 'block';
        postPaymentStatus.style.color = '#22c55e';
        postPaymentStatus.textContent = 'Account created successfully! Please check your email to verify your address, or continue to your dashboard.';
      }

      if (postPaymentSubmitBtn) {
        postPaymentSubmitBtn.style.display = 'none';
      }
    } catch (err: any) {
      if (postPaymentStatus) {
        postPaymentStatus.style.display = 'block';
        postPaymentStatus.style.color = '#ef4444';
        postPaymentStatus.textContent = err.message || 'Error creating account. Please try again.';
      }
      if (postPaymentSubmitBtn) {
        postPaymentSubmitBtn.disabled = false;
        postPaymentSubmitBtn.textContent = 'Create Account & Access Dashboard';
      }
    }
  });

  recheckBtn?.addEventListener('click', () => {
    pollAttempts = 0;
    setView('loading');
    verifyTransaction();
  });

  // Run on mount
  verifyTransaction();
</script>

<style>
  .callback-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-4);
  }

  .callback-card {
    max-width: 540px;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-8);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    text-align: center;
  }

  .state-block {
    animation: fadeIn 200ms ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .spinner-wrap {
    margin-bottom: var(--space-6);
  }

  .spinner {
    width: 44px;
    height: 44px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--accent);
    border-radius: 50%;
    margin: 0 auto;
    animation: spin 800ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .state-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }

  .state-eyebrow.success {
    color: #22c55e;
  }

  .state-eyebrow.warning {
    color: #eab308;
  }

  .state-eyebrow.danger {
    color: #ef4444;
  }

  .state-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 var(--space-3);
    line-height: 1.25;
  }

  .state-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }

  .ref-pill-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .ref-code {
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent);
    font-weight: 600;
    word-break: break-all;
  }

  .status-icon {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
  }

  .success-icon {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .pending-icon {
    background: rgba(234, 179, 8, 0.12);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }

  .error-icon {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .receipt-box {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
    text-align: left;
  }

  .receipt-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 0;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .receipt-row:last-child {
    border-bottom: none;
  }

  .receipt-label {
    color: var(--text-muted);
  }

  .receipt-val {
    font-weight: 500;
    color: var(--text);
  }

  .receipt-val.highlight {
    font-weight: 700;
    color: var(--accent);
  }

  .receipt-val.mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
  }

  /* Account setup box */
  .account-setup-box {
    background: rgba(3, 105, 161, 0.08);
    border: 1px solid rgba(14, 165, 233, 0.25);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
    text-align: left;
  }

  .setup-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .setup-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--text);
  }

  .setup-desc {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0 0 14px;
  }

  .setup-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-field label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .setup-input {
    width: 100%;
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9rem;
  }

  .setup-status {
    font-size: 0.8rem;
    line-height: 1.4;
    margin-top: 6px;
  }

  .action-buttons-group,
  .pending-actions,
  .error-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .action-btn {
    width: 100%;
    padding: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-align: center;
    text-decoration: none;
    display: inline-block;
  }

  .text-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: underline;
    margin-top: var(--space-2);
  }
</style>
