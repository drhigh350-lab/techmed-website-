---
// Ecosystem section, per the "Built to Last" refinement brief: grouped
// around the student journey (KNOW -> LEARN -> PRACTISE -> DIAGNOSE ->
// IMPROVE -> REPEAT) instead of a flat catalogue. Route mapping: KAIRO and
// CBT Practice live under /tools (the "product tools" hub, still a
// placeholder); Study Blueprints under its own real hub,
// /jamb-syllabus-2027; Builder Sessions and Builder Cohort both point to
// /utme-2027/builders, the one page that actually explains the Builder
// Cohort (/cohort is still a placeholder). Revisit this mapping once any
// remaining placeholder gets a dedicated route.
import SectionHeading from './SectionHeading.astro';
import FeatureCard from './FeatureCard.astro';

const icons = {
  kairo:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg>',
  blueprint:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h18"/></svg>',
  podcast:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>',
  session:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
  cbt:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
  community:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
};

// Grouped around the student journey (KNOW -> LEARN -> PRACTISE ->
// DIAGNOSE -> IMPROVE -> REPEAT) rather than presented as a flat
// catalogue — each product answers one stage of that journey, and the
// stage label is what a first-time visitor reads first on the card.
const items = [
  { stage: 'Know What Matters', title: 'Study Blueprints', description: "TECHMED's optimized presentation of the official JAMB syllabus, so you always know what to study next.", href: '/jamb-syllabus-2027', icon: icons.blueprint },
  { stage: 'Know What To Do Next', title: 'KAIRO', description: 'Learns from your performance and helps identify what to study, practise, fix and revisit next.', href: '/tools', icon: icons.kairo },
  { stage: 'Build Understanding', title: 'Builder Sessions', description: 'Weekly concept breakdowns and past-question analysis that build real understanding, not memorization.', href: '/utme-2027/builders', icon: icons.session },
  { stage: 'Practise With Purpose', title: 'Challenges & CBT Practice', description: 'Timed, exam-format practice and quizzes that sharpen speed, accuracy and confidence.', href: '/tools', icon: icons.cbt },
  { stage: 'Stay Consistent', title: 'Builder Cohort', description: "Your academic home inside TECHMED — an assigned classroom, not a public group. You don't prepare alone.", href: '/utme-2027/builders', icon: icons.community },
  { stage: 'Build Beyond The Score', title: '5 Minutes Forward', description: 'A daily podcast habit for the discipline and character behind the score.', href: '/podcast', icon: icons.podcast },
];
---

<section class="section ecosystem">
  <SectionHeading
    eyebrow="The Ecosystem"
    title="Everything Works Together."
    subtitle="TECHMED isn't another place to collect study materials. It's a system designed to help students Know, Learn, Practise, Diagnose, Improve and Repeat."
  />
  <div class="grid">
    {items.map((item) => (
      <FeatureCard eyebrow={item.stage} title={item.title} description={item.description} href={item.href} icon={item.icon} />
    ))}
  </div>
</section>

<style>
  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
