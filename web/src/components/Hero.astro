---
// Homepage hero — refined per brand guidelines and UX audit.
// Tagline: "THINK SMART. PERFORM ELITE."
// Value proposition: "Stop Guessing. Start Building."
// Dual high-conversion CTAs: View 2027 Plans (/pricing) + Join Builder Channel.
// Real verified social proof stats bar grounded in TECHMED records.
import { getBuilderSettings } from '../lib/builders';
const { channelUrl } = await getBuilderSettings();
---

<section class="hero" id="join-builder-cohort">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="badge">
      <span class="badge-dot"></span>
      TECHMED &middot; THINK SMART. PERFORM ELITE.
    </p>

    <h1>Stop Guessing.<br />Start Building.</h1>

    <p class="lede">
      Your UTME 2027 preparation needs more than more questions, more notes,
      and more hours. TECHMED gives serious Nigerian candidates a structured
      system for knowing what to study, how to practise, what to fix, and what
      to do next — so you prepare strategically instead of guessing your way to exam day.
    </p>

    <div class="cta-group">
      <a class="cta cta-primary" href="/pricing">
        Explore 2027 Plans &amp; Pricing <span aria-hidden="true">&rarr;</span>
      </a>
      <a class="cta cta-secondary" href={channelUrl} target="_blank" rel="noopener">
        Become a Builder <span class="tag-free">Free</span>
      </a>
    </div>

    <p class="cta-note">
      Home of Nigeria's highest UTME scorer in 2026 &middot; Cohort starts 30 Nov 2026
    </p>

    <!-- Verified Stats Proof Strip -->
    <div class="stats-strip reveal">
      <div class="stat-card">
        <span class="stat-number">372<span class="stat-unit">/400</span></span>
        <span class="stat-label">Highest UTME Score 2026</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">5,000<span class="stat-plus">+</span></span>
        <span class="stat-label">Students in Ecosystem</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">100<span class="stat-plus">+</span></span>
        <span class="stat-label">Scored 300+ in UTME</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">2027</span>
        <span class="stat-label">Full Syllabus Blueprint Aligned</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-6) var(--space-16);
    text-align: center;
  }

  /* Subtle blueprint grid */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black 30%, transparent 75%);
  }

  :root[data-theme='light'] .hero-bg {
    opacity: 0.18;
  }

  /* Soft radial lighting */
  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    width: 900px;
    height: 600px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse at 50% 30%, var(--color-professional-blue) 0%, transparent 55%),
      radial-gradient(ellipse at 65% 15%, var(--accent) 0%, transparent 40%);
    opacity: 0.18;
    filter: blur(40px);
    animation: hero-float 12s ease-in-out infinite;
  }

  :root[data-theme='light'] .hero-glow {
    background:
      radial-gradient(ellipse at 50% 30%, rgba(9, 71, 110, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse at 65% 15%, rgba(201, 162, 39, 0.1) 0%, transparent 50%);
    opacity: 0.85;
    filter: blur(50px);
  }

  @keyframes hero-float {
    0%, 100% { transform: translateX(-50%) translateY(0) scale(1); }
    50% { transform: translateX(-50%) translateY(12px) scale(1.03); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    margin-bottom: var(--space-5);
    box-shadow: var(--card-shadow);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(2.35rem, 5.8vw, 3.85rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text);
    margin-bottom: var(--space-6);
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--text-light);
    max-width: 680px;
    margin: 0 auto var(--space-8);
  }

  .cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 15px 30px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 300ms ease;
  }

  .cta-primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    box-shadow: 0 4px 18px rgba(201, 162, 39, 0.25);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.4);
  }

  .cta-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: var(--card-shadow);
  }

  .cta-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--card-shadow-hover);
  }

  .tag-free {
    font-size: 0.65rem;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: rgba(201, 162, 39, 0.15);
    color: var(--accent-text);
    text-transform: uppercase;
    font-weight: 800;
  }

  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-5);
    margin-bottom: var(--space-12);
  }

  /* Stats Strip */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--card-shadow);
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--accent-text);
    line-height: 1.1;
  }

  .stat-unit {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .stat-plus {
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
    line-height: 1.35;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .stats-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .cta-group {
      flex-direction: column;
      width: 100%;
    }
    .cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
