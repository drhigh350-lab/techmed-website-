---
// Homepage hero — v2 per the "Built to Last" refinement brief. The primary
// value proposition ("Stop Guessing. Start Building.") now leads; BUILT TO
// LAST moves to a small brand badge so it stays present as the campaign
// identity without competing with the actual message. Only one CTA
// ("Become a Builder") — no competing high-emphasis action.
import { getBuilderSettings } from '../lib/builders';
const { channelUrl } = await getBuilderSettings();
---

<section class="hero" id="join-builder-cohort">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="badge">TECHMED &middot; Built to Last</p>
    <h1>Stop Guessing. Start Building.</h1>
    <p class="lede">
      Your UTME 2027 preparation needs more than more questions, more notes,
      and more hours. TECHMED gives serious students a structured system for
      knowing what to study, how to practise, what to fix, and what to do
      next — so you can prepare strategically instead of guessing your way
      to exam day.
    </p>
    <a class="cta" href={channelUrl} target="_blank" rel="noopener">Become a Builder <span aria-hidden="true">&rarr;</span></a>
    <p class="cta-note">Free to start. Built for the journey.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
    text-align: center;
  }

  /* Subtle blueprint grid, faded toward the edges so it reads as texture
     rather than a pattern. */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black 30%, transparent 75%);
  }

  /* Soft radial lighting + a faint gold accent glow, both barely-there.
     The float is applied here, not to the text, so it never reads as
     distracting motion. */
  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    width: 900px;
    height: 600px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse at 50% 30%, var(--color-professional-blue) 0%, transparent 55%),
      radial-gradient(ellipse at 65% 15%, var(--accent) 0%, transparent 40%);
    opacity: 0.18;
    filter: blur(40px);
    animation: hero-float 12s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateX(-50%) translateY(0) scale(1); }
    50% { transform: translateX(-50%) translateY(12px) scale(1.03); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
    }
  }

  .badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-text);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    margin-bottom: var(--space-5);
  }

  h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    padding: 15px 32px;
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: 0 0 0 rgba(201, 162, 39, 0);
    transition: transform 200ms ease, box-shadow 300ms ease;
  }

  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.35);
  }

  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-4);
  }
</style>
