---
// Landing page hero — copy pulled directly from the UTME 2027 Campaign
// Operating Manual (Chapter 39, Landing Page Structure) and the Branding
// Standard's primary tagline. Copy is unchanged from v1.0; this pass only
// adds background/motion polish (blueprint grid, radial glow, subtle
// float) — restrained, Apple/Linear/Stripe-style, not flashy.
import { getWhatsappChannelUrl } from '../lib/sanity';
const WHATSAPP_CHANNEL = await getWhatsappChannelUrl();
---

<section class="hero" id="join-builder-cohort">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="eyebrow">TECHMED</p>
    <h1>BUILT TO LAST</h1>
    <p class="tagline">Think Smart. Perform Elite.</p>
    <p class="lede">
      Most students do not fail because they lack intelligence. They fail
      because they prepare without a clear system. TECHMED replaces confusion
      with clarity, guesswork with strategy, and inconsistency with systems
      that keep working — even on the hardest days.
    </p>
    <a class="cta" href={WHATSAPP_CHANNEL} target="_blank" rel="noopener">Join Builder Cohort</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
    text-align: center;
  }

  /* Subtle blueprint grid, faded toward the edges so it reads as texture
     rather than a pattern. */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, black 30%, transparent 75%);
  }

  /* Soft radial lighting + a faint gold accent glow, both barely-there.
     The float is applied here, not to the text, so it never reads as
     distracting motion. */
  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    width: 900px;
    height: 600px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse at 50% 30%, var(--color-professional-blue) 0%, transparent 55%),
      radial-gradient(ellipse at 65% 15%, var(--accent) 0%, transparent 40%);
    opacity: 0.18;
    filter: blur(40px);
    animation: hero-float 12s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateX(-50%) translateY(0) scale(1); }
    50% { transform: translateX(-50%) translateY(12px) scale(1.03); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
    }
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--space-6);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .cta {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    padding: 15px 32px;
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: 0 0 0 rgba(201, 162, 39, 0);
    transition: transform 200ms ease, box-shadow 300ms ease;
  }

  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.35);
  }
</style>
