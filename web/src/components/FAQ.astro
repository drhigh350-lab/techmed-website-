---
// Grounded in the Brand Overview and Campaign Manual only — no invented
// pricing, dates or claims not documented in those sources. Content lives
// in Sanity (faqItem documents, ordered by "order") once seeded; the
// fallback below keeps this section correct either way.
import { fetchSanity } from '../lib/sanity';

const FALLBACK_FAQS = [
  {
    q: 'What is TECHMED, exactly?',
    a: "A student-success ecosystem for Nigerian students preparing for UTME and Post-UTME — combining structured preparation, a Builder community, and personal growth content, built around one belief: most students don't fail from lack of intelligence, but from lack of a clear system.",
  },
  {
    q: 'What preparation plans are available for UTME 2027?',
    a: "We offer three structured tracks: TECHMED Core (₦18,000 for three months or ₦7,000/month) for live teaching and CBT drills; TECHMED Mastery (₦25,000) adding all four subject study manuals and monthly mocks; and TECHMED Ultimate (₦40,000 once through UTME 2027) which includes ₦36,000 in standalone bonus bootcamps, four subject revision packages, final revision classes, and founder mentorship eligibility.",
  },
  {
    q: 'What is a Builder Cohort?',
    a: "Your academic home inside TECHMED — an assigned group (not a giant public chat) where you attend Builder Sessions, ask questions, and prepare alongside the same set of fellow Builders throughout the journey.",
  },
  {
    q: 'Is TECHMED free to start?',
    a: 'Yes. The Builder community, the WhatsApp Channel, and a number of foundational resources are free. Our intensive structured classes, study manuals, bootcamps, and examination preparation packages are paid. You will always know what is included before enrolling.',
  },
  {
    q: "I've already written UTME before. Is this still for me?",
    a: 'Yes. Builders include first-time candidates and students rewriting UTME. TECHMED focuses on building the systems and deep subject understanding that carry you forward, whichever attempt this is.',
  },
  {
    q: 'How do I actually join?',
    a: 'Tap "Become a Builder" to follow the official UTME 2027 Builders Channel on WhatsApp. To enrol in a structured preparation track (Core, Mastery, or Ultimate), visit our Pricing page or message our official admissions desk directly on WhatsApp at 07044255045.',
  },
];

const faqs = await fetchSanity<{ q: string; a: string }[]>(
  `*[_type == "faqItem"] | order(order asc){"q": question, "a": answer}`,
  FALLBACK_FAQS,
);
---

<section class="section">
  <div class="header">
    <p class="eyebrow">COMMON QUESTIONS</p>
    <h2>Frequently Asked Questions</h2>
  </div>
  <div class="list">
    {faqs.map((item) => (
      <details class="reveal">
        <summary>
          <span>{item.q}</span>
          <span class="indicator" aria-hidden="true">+</span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .section {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-6);
  }

  .header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    padding: var(--space-6);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  details:hover {
    border-color: var(--accent);
    box-shadow: var(--card-shadow-hover);
  }

  details[open] {
    border-color: var(--accent);
  }

  summary {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    content: '';
    display: none;
  }

  .indicator {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent-text);
    transition: transform 200ms ease;
  }

  details[open] .indicator {
    transform: rotate(45deg);
  }

  details[open] summary {
    margin-bottom: var(--space-4);
  }

  details p {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-light);
  }
</style>
