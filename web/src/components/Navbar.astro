---
import { NAV_ROUTES } from '../lib/routes';
import { getBuilderSettings } from '../lib/builders';

// The sitewide "Become a Builder" CTA goes straight to the UTME 2027
// Builders Channel everywhere except /utme-2027/builders itself, which is
// the one page that also offers the actual current-cohort join link — see
// that page for why the two are kept separate.
const { channelUrl } = await getBuilderSettings();
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath === `${path}/`;
---

<header class="navbar">
  <nav class="navbar-inner">
    <a href="/" class="logo">
      <img src="/images/logo.png" alt="TECHMED" class="logo-mark" width="36" height="36" />
      <span class="logo-word">TECHMED</span>
    </a>

    <ul class="nav-links">
      {NAV_ROUTES.map((route) => (
        <li>
          <a href={route.path} class:list={['nav-link', { active: isActive(route.path) }]}>
            {route.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <button class="theme-toggle desktop-theme-toggle" id="themeToggle" aria-label="Switch to dark theme" type="button">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <!-- Student Account Access (Desktop) -->
      <div class="nav-account-container" id="navAccountContainer">
        <!-- Logged Out View (SSR default, instant) -->
        <a href="/login" class="nav-auth-link" id="navLoginLink">
          <span>Log In</span>
        </a>

        <!-- Logged In View (shown dynamically when auth session detected) -->
        <div class="nav-user-menu" id="navUserMenu" style="display: none;">
          <button
            class="nav-avatar-btn"
            id="navAvatarBtn"
            type="button"
            aria-label="Student Account Menu"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span class="avatar-initials" id="navAvatarInitials">--</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <div class="nav-dropdown" id="navUserDropdown" role="menu">
            <div class="nav-dropdown-header">
              <div class="dropdown-student-name" id="dropdownStudentName">Student</div>
              <div class="dropdown-student-email" id="dropdownStudentEmail">student@email.com</div>
              <div class="dropdown-verified-badge" id="dropdownVerifiedBadge" style="display: none;">
                Verified Student
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <a href="/dashboard" class="dropdown-link" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span>Student Dashboard</span>
            </a>
            <a href="/account/onboarding" class="dropdown-link" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span>Profile & Onboarding</span>
            </a>
            <a href="/account/settings" class="dropdown-link" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              <span>Account Settings</span>
            </a>
            <a href="/library" class="dropdown-link" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span>Bookshelf & Resources</span>
            </a>
            <div class="dropdown-divider"></div>
            <button type="button" class="dropdown-signout" id="navSignOutBtn" role="menuitem">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>Sign Out</span>
            </button>
          </div>
        </div>
      </div>

      <a class="cta" href={channelUrl} target="_blank" rel="noopener">Become a Builder</a>

      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu">
    <!-- Mobile Account Section -->
    <div class="mobile-account-section">
      <!-- Logged Out View -->
      <div id="mobileAuthLoggedOut" class="mobile-auth-loggedout">
        <a href="/login" class="mobile-auth-btn mobile-login-btn">Log In</a>
        <a href="/register" class="mobile-auth-btn mobile-signup-btn">Create Account</a>
      </div>
      <!-- Logged In View -->
      <div id="mobileAuthLoggedIn" class="mobile-auth-loggedin" style="display: none;">
        <div class="mobile-user-row">
          <div class="avatar-initials small" id="mobileAvatarInitials">--</div>
          <div class="mobile-user-info">
            <span class="mobile-user-name" id="mobileUserName">Student</span>
            <span class="mobile-user-email" id="mobileUserEmail">student@email.com</span>
          </div>
        </div>
        <div class="mobile-user-links">
          <a href="/dashboard" class="mobile-account-link">Student Dashboard</a>
          <a href="/account/onboarding" class="mobile-account-link">Profile & Onboarding</a>
          <a href="/account/settings" class="mobile-account-link">Account Settings</a>
          <a href="/library" class="mobile-account-link">Bookshelf & Resources</a>
          <button type="button" class="mobile-signout-btn" id="mobileSignOutBtn">Sign Out</button>
        </div>
      </div>
    </div>

    <ul>
      {NAV_ROUTES.map((route) => (
        <li>
          <a href={route.path} class:list={['mobile-link', { active: isActive(route.path) }]}>
            {route.label}
          </a>
        </li>
      ))}
    </ul>
    <button class="theme-toggle mobile-theme-toggle" id="themeToggleMobile" type="button">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span class="mobile-theme-label">Dark theme</span>
    </button>
    <a class="mobile-cta" href={channelUrl} target="_blank" rel="noopener">Become a Builder</a>
  </div>
</header>

<script>
  import { getSupabase, checkIsVerifiedStudent } from '../lib/supabase';

  // Theme toggle persistence
  const THEME_KEY = 'techmed-theme';
  const desktopToggle = document.getElementById('themeToggle');
  const mobileToggle = document.getElementById('themeToggleMobile');
  const mobileLabel = mobileToggle?.querySelector('.mobile-theme-label');

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch (e) {}
    try {
      document.cookie = `${THEME_KEY}=${theme}; max-age=315360000; path=/; SameSite=Lax`;
    } catch (e) {}
    const isDark = theme === 'dark';
    desktopToggle?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    if (mobileLabel) mobileLabel.textContent = isDark ? 'Light theme' : 'Dark theme';
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  }

  applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  desktopToggle?.addEventListener('click', toggleTheme);
  mobileToggle?.addEventListener('click', toggleTheme);

  // Mobile menu toggle
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    toggle.classList.toggle('open', isOpen);
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  // Authentication & Dynamic Profile Menu in Navigation
  const supabase = getSupabase();
  const navLoginLink = document.getElementById('navLoginLink');
  const navUserMenu = document.getElementById('navUserMenu');
  const navAvatarBtn = document.getElementById('navAvatarBtn');
  const navAvatarInitials = document.getElementById('navAvatarInitials');
  const navUserDropdown = document.getElementById('navUserDropdown');
  const dropdownStudentName = document.getElementById('dropdownStudentName');
  const dropdownStudentEmail = document.getElementById('dropdownStudentEmail');
  const dropdownVerifiedBadge = document.getElementById('dropdownVerifiedBadge');
  const navSignOutBtn = document.getElementById('navSignOutBtn');

  const mobileAuthLoggedOut = document.getElementById('mobileAuthLoggedOut');
  const mobileAuthLoggedIn = document.getElementById('mobileAuthLoggedIn');
  const mobileAvatarInitials = document.getElementById('mobileAvatarInitials');
  const mobileUserName = document.getElementById('mobileUserName');
  const mobileUserEmail = document.getElementById('mobileUserEmail');
  const mobileSignOutBtn = document.getElementById('mobileSignOutBtn');

  function computeInitials(nameOrEmail?: string): string {
    if (!nameOrEmail) return 'TM';
    const clean = nameOrEmail.trim();
    if (clean.includes('@')) {
      return clean.slice(0, 2).toUpperCase();
    }
    const parts = clean.split(/\s+/).filter(Boolean);
    if (parts.length >= 2) {
      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }
    return clean.slice(0, 2).toUpperCase();
  }

  async function updateNavbarAuth(user: any) {
    if (user) {
      const name = user.user_metadata?.full_name || user.user_metadata?.name || 'TECHMED Student';
      const email = user.email || '';
      const initials = computeInitials(name !== 'TECHMED Student' ? name : email);

      // Desktop
      if (navLoginLink) navLoginLink.style.display = 'none';
      if (navUserMenu) navUserMenu.style.display = 'block';
      if (navAvatarInitials) navAvatarInitials.textContent = initials;
      if (dropdownStudentName) dropdownStudentName.textContent = name;
      if (dropdownStudentEmail) dropdownStudentEmail.textContent = email;

      // Mobile
      if (mobileAuthLoggedOut) mobileAuthLoggedOut.style.display = 'none';
      if (mobileAuthLoggedIn) mobileAuthLoggedIn.style.display = 'block';
      if (mobileAvatarInitials) mobileAvatarInitials.textContent = initials;
      if (mobileUserName) mobileUserName.textContent = name;
      if (mobileUserEmail) mobileUserEmail.textContent = email;

      // Check verified student status
      try {
        const { isVerified } = await checkIsVerifiedStudent(user.id, user.email);
        if (dropdownVerifiedBadge) {
          dropdownVerifiedBadge.style.display = isVerified ? 'inline-block' : 'none';
        }
      } catch {
        // Fallback silently if offline/network error
      }
    } else {
      // Desktop
      if (navLoginLink) navLoginLink.style.display = 'inline-flex';
      if (navUserMenu) navUserMenu.style.display = 'none';
      if (navUserDropdown) navUserDropdown.classList.remove('open');

      // Mobile
      if (mobileAuthLoggedOut) mobileAuthLoggedOut.style.display = 'grid';
      if (mobileAuthLoggedIn) mobileAuthLoggedIn.style.display = 'none';
    }
  }

  // Handle dropdown open / close
  navAvatarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = navUserDropdown?.classList.toggle('open');
    navAvatarBtn.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.addEventListener('click', (e) => {
    if (navUserDropdown?.classList.contains('open') && !navUserMenu?.contains(e.target as Node)) {
      navUserDropdown.classList.remove('open');
      navAvatarBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navUserDropdown?.classList.contains('open')) {
      navUserDropdown.classList.remove('open');
      navAvatarBtn?.setAttribute('aria-expanded', 'false');
      navAvatarBtn?.focus();
    }
  });

  // Sign out handlers
  async function handleSignOut() {
    try {
      await supabase.auth.signOut();
    } finally {
      window.location.href = '/';
    }
  }

  navSignOutBtn?.addEventListener('click', handleSignOut);
  mobileSignOutBtn?.addEventListener('click', handleSignOut);

  // Initialize session state
  supabase.auth.getSession().then(({ data }) => {
    updateNavbarAuth(data.session?.user ?? null);
  });

  supabase.auth.onAuthStateChange((_event, session) => {
    updateNavbarAuth(session?.user ?? null);
  });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(1, 39, 72, 0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-on-dark-surface);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 1240px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    color: var(--text-on-dark-surface);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-light-on-dark-surface);
    text-decoration: none;
    padding: var(--space-2) 0;
    position: relative;
    transition: color 150ms ease;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transition: width 200ms ease;
  }

  .nav-link:hover {
    color: var(--text-on-dark-surface);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link.active {
    color: var(--text-on-dark-surface);
  }

  .nav-link.active::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--border-on-dark-surface);
    border-radius: 50%;
    color: var(--text-light-on-dark-surface);
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .theme-toggle:hover {
    color: var(--text-on-dark-surface);
    border-color: var(--accent);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }

  /* Account Container & Link */
  .nav-account-container {
    display: flex;
    align-items: center;
    position: relative;
  }

  .nav-auth-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-on-dark-surface);
    text-decoration: none;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-full);
    transition: all 150ms ease;
    white-space: nowrap;
  }

  .nav-auth-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 162, 39, 0.08);
  }

  /* User Menu & Avatar */
  .nav-user-menu {
    position: relative;
  }

  .nav-avatar-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: 3px 10px 3px 4px;
    cursor: pointer;
    transition: all 150ms ease;
    color: var(--text-on-dark-surface);
  }

  .nav-avatar-btn:hover {
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.14);
  }

  .avatar-initials {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .avatar-initials.small {
    width: 36px;
    height: 36px;
    font-size: 0.9rem;
  }

  .chevron-icon {
    transition: transform 150ms ease;
  }

  .nav-avatar-btn[aria-expanded="true"] .chevron-icon {
    transform: rotate(180deg);
  }

  /* User Dropdown */
  .nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 250px;
    background: var(--surface-dark, #021f38);
    border: 1px solid var(--border-on-dark-surface);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    padding: var(--space-3) 0;
    z-index: 200;
    backdrop-filter: blur(20px);
  }

  .nav-dropdown.open {
    display: block;
    animation: fadeInDropdown 150ms ease-out;
  }

  @keyframes fadeInDropdown {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nav-dropdown-header {
    padding: var(--space-2) var(--space-4) var(--space-3);
  }

  .dropdown-student-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-on-dark-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-student-email {
    font-size: 0.78rem;
    color: var(--text-light-on-dark-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
  }

  .dropdown-verified-badge {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgba(201, 162, 39, 0.18);
    color: var(--accent);
    border: 1px solid rgba(201, 162, 39, 0.38);
  }

  .dropdown-divider {
    height: 1px;
    background: var(--border-on-dark-surface);
    margin: var(--space-2) 0;
  }

  .dropdown-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 9px var(--space-4);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-light-on-dark-surface);
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease;
  }

  .dropdown-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-on-dark-surface);
  }

  .dropdown-signout {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: 9px var(--space-4);
    font-size: 0.85rem;
    font-weight: 500;
    background: none;
    border: none;
    color: #f87171;
    cursor: pointer;
    text-align: left;
    transition: background 120ms ease;
  }

