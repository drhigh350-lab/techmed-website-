---
import { getWhatsappChannelUrl } from '../lib/sanity';
import { getContactChannels } from '../lib/contact';

const WHATSAPP_CHANNEL = await getWhatsappChannelUrl();
// Sourced from the same siteSettings.facebookUrl field the Contact page
// uses (official handle: @heytechmed) — previously hard-coded here to a
// different, stale Facebook page.
const { facebookUrl: FACEBOOK_URL } = await getContactChannels();
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Quick Links',
    links: [
      { label: 'Home', href: '/' },
      { label: 'UTME 2027', href: '/utme-2027' },
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Resources', href: '/resources' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Tools',
    links: [
      { label: 'Tools', href: '/tools' },
      { label: 'Podcast', href: '/podcast' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Builder Cohort', href: '/utme-2027/builders' },
      { label: 'Join on WhatsApp', href: WHATSAPP_CHANNEL, external: true },
    ],
  },
  {
    title: 'Legal',
    links: [{ label: 'Legal', href: '/legal' }],
  },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="brand-col">
      <a href="/" class="logo">TECHMED</a>
      <p class="tagline">Think Smart. Perform Elite.</p>
      <p class="mission">
        A student-success ecosystem helping Nigerian students move from
        confusion to clarity, from effort to strategy, and from potential
        to performance.
      </p>
      <div class="social">
        <a href={FACEBOOK_URL} target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href={WHATSAPP_CHANNEL} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0012.05 0"/></svg>
        </a>
      </div>
    </div>

    {columns.map((col) => (
      <div class="link-col">
        <h4>{col.title}</h4>
        <ul>
          {col.links.map((link) => (
            <li>
              {link.external ? (
                <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
              ) : (
                <a href={link.href}>{link.label}</a>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} TECHMED. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-dark);
    border-top: 1px solid var(--border);
    padding: var(--space-16) var(--space-6) var(--space-8);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr repeat(5, 1fr);
    gap: var(--space-8);
  }

  .brand-col .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.15em;
    text-decoration: none;
    color: var(--text-on-dark-surface);
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-top: var(--space-3);
  }

  .mission {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-light-on-dark-surface);
    margin-top: var(--space-3);
    max-width: 32ch;
  }

  .social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .social a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 150ms ease;
  }

  .social a:hover {
    background: var(--color-professional-blue);
    color: var(--text-on-dark-surface);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .link-col h4 {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light-on-dark-surface);
    margin-bottom: var(--space-4);
  }

  .link-col ul {
    list-style: none;
  }

  .link-col li {
    margin-bottom: var(--space-2);
  }

  .link-col a {
    font-size: 0.875rem;
    color: var(--text-light-on-dark-surface);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .link-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: var(--space-12) auto 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: var(--text-light-on-dark-surface);
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
