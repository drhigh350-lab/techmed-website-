---
// Two usage modes, kept backward compatible with the original card:
// 1. Legacy: title/description/tag/comingSoon (still used by tools.astro).
// 2. Full: pass a `resource` from src/lib/resources.ts — renders category,
//    type, free/paid status, price, and the correct action(s) for that
//    resource's status (never "Buy" language on a free resource).
import type { Resource } from '../lib/resources';

interface Props {
  title?: string;
  description?: string;
  tag?: string;
  comingSoon?: boolean;
  resource?: Resource;
}

const { title, description, tag, comingSoon = false, resource } = Astro.props;

const currencySymbol = resource?.currency === 'NGN' ? '₦' : (resource?.currency ?? '');
const priceLabel = resource
  ? resource.status === 'free'
    ? 'FREE'
    : resource.price
      ? `${currencySymbol}${resource.price.toLocaleString()}`
      : 'Price coming soon'
  : '';

const primaryHref = resource?.accessUrl ?? resource?.externalUrl;
const primaryIsExternal = Boolean(resource?.externalUrl) || Boolean(resource?.accessUrl?.startsWith('http'));
---

{resource ? (
  <div class:list={['resource-card', 'reveal', { featured: resource.featured }]}>
    <a href={`/resources/${resource.slug}`} class="card-top">
      <div class="top-row">
        {resource.thumbnail && <div class="icon" set:html={resource.thumbnail} />}
        {resource.featured && <span class="featured-badge">Featured</span>}
      </div>
      <p class="meta">{resource.category} · {resource.type}</p>
      <h3>{resource.title}</h3>
      <p class="description">{resource.description}</p>
    </a>
    <div class="card-footer">
      <span class:list={['price', resource.status]}>{priceLabel}</span>
      <div class="actions">
        {resource.status === 'free' && primaryHref && (
          <a
            class="btn-primary"
            href={primaryHref}
            target={primaryIsExternal ? '_blank' : undefined}
            rel={primaryIsExternal ? 'noopener' : undefined}
          >
            {resource.actionLabel}
          </a>
        )}
        {resource.status === 'free' && !primaryHref && (
          <a class="btn-primary" href={`/resources/${resource.slug}`}>{resource.actionLabel}</a>
        )}
        {resource.status === 'paid' && resource.paystackUrl && (
          <a class="btn-primary" href={resource.paystackUrl}>Buy with Paystack</a>
        )}
        {resource.status === 'paid' && resource.whatsappUrl && (
          <a class="btn-secondary" href={resource.whatsappUrl} target="_blank" rel="noopener">
            {resource.paystackUrl ? 'Get via WhatsApp' : resource.actionLabel}
          </a>
        )}
      </div>
    </div>
  </div>
) : (
  <div class="resource-card reveal">
    <div class="top">
      {tag && <span class="tag">{tag}</span>}
      {comingSoon && <span class="badge">Coming Soon</span>}
    </div>
    <h3>{title}</h3>
    <p class="description">{description}</p>
  </div>
)}

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .resource-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .resource-card.featured {
    border-color: var(--accent);
  }

  .card-top {
    display: block;
    color: inherit;
    text-decoration: none;
    flex: 1;
  }

  .top,
  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--surface-raised);
    color: var(--accent);
  }

  .icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .tag {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .badge,
  .featured-badge {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: rgba(201, 162, 39, 0.12);
    border: 1px solid rgba(201, 162, 39, 0.3);
    border-radius: var(--radius-full);
    padding: 3px 10px;
  }

  .meta {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  h3 {
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }

  .description {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-light);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .price {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .price.free {
    color: var(--accent);
  }

  .price.paid {
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-left: auto;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 9px 16px;
    border-radius: var(--radius);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }

  .btn-primary {
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(201, 162, 39, 0.3);
  }

  .btn-secondary {
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
  }
</style>
