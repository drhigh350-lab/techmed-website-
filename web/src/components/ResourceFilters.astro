---
// Enhanced client-side filtering and live search for the resource catalogue.
// High-speed vanilla JS without heavy framework hydration overhead.
interface Props {
  categories?: string[];
  gridSelector?: string;
}

const { gridSelector = '#resource-grid' } = Astro.props;

const SUBJECT_OPTIONS = ['All', 'Chemistry', 'Biology', 'Physics', 'Admission', 'General'];
const ACCESS_OPTIONS = [
  { id: 'all', label: 'All Resources' },
  { id: 'paid', label: 'Standalone Boosters' },
  { id: 'free', label: 'Free Guides & Tools' },
  { id: 'mastery', label: 'Mastery / Ultimate Inclusions' },
];
---

<div class="catalogue-controls" data-grid={gridSelector}>
  <!-- Search input bar -->
  <div class="search-bar">
    <div class="search-input-wrap">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="resourceSearchInput"
        class="search-input"
        placeholder="Search resources, topics, or formulas (e.g. Mole Concept, Traps, Post-UTME)..."
        aria-label="Search resources"
        autocomplete="off"
      />
      <button type="button" id="clearSearchBtn" class="clear-btn" aria-label="Clear search" style="display: none;">
        &times;
      </button>
    </div>
  </div>

  <!-- Filter rows -->
  <div class="filter-sections">
    <div class="filter-group">
      <span class="group-label">Subject:</span>
      <div class="segment-group" role="tablist" aria-label="Filter by subject" id="subjectFilterGroup">
        {SUBJECT_OPTIONS.map((subj, i) => (
          <button
            type="button"
            class:list={['segment-btn', { active: i === 0 }]}
            data-subject={subj}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {subj}
          </button>
        ))}
      </div>
    </div>

    <div class="filter-group">
      <span class="group-label">Access:</span>
      <div class="segment-group" role="tablist" aria-label="Filter by access tier" id="accessFilterGroup">
        {ACCESS_OPTIONS.map((opt, i) => (
          <button
            type="button"
            class:list={['segment-btn', { active: i === 0 }]}
            data-access={opt.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {opt.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Status / Results Summary -->
  <div class="filter-summary">
    <span id="resultsCounter" class="counter-text">Showing all resources</span>
    <button type="button" id="resetFiltersBtn" class="reset-btn" style="display: none;">
      Reset filters
    </button>
  </div>
</div>

<script>
  (function initCatalogueFilters() {
    const root = document.querySelector('.catalogue-controls');
    if (!root) return;

    const gridSelector = root.getAttribute('data-grid') || '#resource-grid';
    const grid = document.querySelector(gridSelector);
    if (!grid) return;

    const searchInput = root.querySelector('#resourceSearchInput') as HTMLInputElement | null;
    const clearBtn = root.querySelector('#clearSearchBtn') as HTMLButtonElement | null;
    const subjectBtns = root.querySelectorAll('#subjectFilterGroup .segment-btn');
    const accessBtns = root.querySelectorAll('#accessFilterGroup .segment-btn');
    const counterEl = root.querySelector('#resultsCounter');
    const resetBtn = root.querySelector('#resetFiltersBtn') as HTMLButtonElement | null;
    const emptyState = document.querySelector('[data-empty-state]') as HTMLElement | null;

    const cards = Array.from(grid.querySelectorAll('.resource-card')) as HTMLElement[];
    const totalCount = cards.length;

    let currentSearch = '';
    let currentSubject = 'All';
    let currentAccess = 'all';

    function applyFilters() {
      const searchTerms = currentSearch.toLowerCase().trim();
      let matchCount = 0;

      cards.forEach((card) => {
        const text = (card.textContent || '').toLowerCase();
        const subjectAttr = (card.getAttribute('data-subject') || '').toLowerCase();
        const statusAttr = (card.getAttribute('data-status') || '').toLowerCase();
        const incNote = card.querySelector('.inclusion-note');
        const hasMasteryInclusion = Boolean(incNote && incNote.textContent?.toLowerCase().includes('mastery'));

        // 1. Search filter
        const matchesSearch = !searchTerms || text.includes(searchTerms);

        // 2. Subject filter
        const matchesSubject =
          currentSubject === 'All' ||
          subjectAttr.includes(currentSubject.toLowerCase()) ||
          text.includes(currentSubject.toLowerCase());

        // 3. Access filter
        let matchesAccess = true;
        if (currentAccess === 'paid') {
          matchesAccess = statusAttr === 'paid';
        } else if (currentAccess === 'free') {
          matchesAccess = statusAttr === 'free';
        } else if (currentAccess === 'mastery') {
          matchesAccess = hasMasteryInclusion;
        }

        const isVisible = matchesSearch && matchesSubject && matchesAccess;

        // The card's parent container might be a grid-item wrapper
        const wrapper = card.parentElement && card.parentElement.classList.contains('grid-item')
          ? card.parentElement
          : card;

        wrapper.style.display = isVisible ? '' : 'none';
        if (isVisible) matchCount++;
      });

      // Update counter
      if (counterEl) {
        if (currentSearch || currentSubject !== 'All' || currentAccess !== 'all') {
          counterEl.textContent = `Showing ${matchCount} of ${totalCount} resources`;
        } else {
          counterEl.textContent = `Showing all ${totalCount} resources`;
        }
      }

      // Update clear/reset button affordances
      const isFiltered = Boolean(currentSearch || currentSubject !== 'All' || currentAccess !== 'all');
      if (resetBtn) resetBtn.style.display = isFiltered ? 'inline-block' : 'none';
      if (clearBtn) clearBtn.style.display = currentSearch ? 'inline-block' : 'none';

      // Empty state
      if (emptyState) {
        emptyState.style.display = matchCount === 0 ? 'block' : 'none';
      }
    }

    // Search events
    searchInput?.addEventListener('input', () => {
      currentSearch = searchInput.value;
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      applyFilters();
      searchInput?.focus();
    });

    // Subject buttons
    subjectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        subjectBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentSubject = btn.getAttribute('data-subject') || 'All';
        applyFilters();
      });
    });

    // Access buttons
    accessBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        accessBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentAccess = btn.getAttribute('data-access') || 'all';
        applyFilters();
      });
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';

      subjectBtns.forEach((b, i) => {
        b.classList.toggle('active', i === 0);
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      currentSubject = 'All';

      accessBtns.forEach((b, i) => {
        b.classList.toggle('active', i === 0);
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      currentAccess = 'all';

      applyFilters();
    });

    // Initial check
    applyFilters();
  })();
</script>

<style>
  .catalogue-controls {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .search-bar {
    width: 100%;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .search-input-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 13px 40px 13px 42px;
    background: transparent;
    border: none;
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    font-size: 1.25rem;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1;
    padding: 4px;
  }

  .clear-btn:hover {
    color: var(--text);
  }

  .filter-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .group-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    min-width: 70px;
  }

  .segment-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .segment-btn {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--text-light);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 7px 14px;
    cursor: pointer;
    transition: all 150ms ease;
    white-space: nowrap;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .segment-btn:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .segment-btn.active {
    color: #1a0a00;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    border-color: transparent;
    font-weight: 700;
  }

  .filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
  }

  .counter-text {
    color: var(--text-muted);
  }

  .reset-btn {
    background: none;
    border: none;
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    padding: 4px 8px;
    text-decoration: underline;
  }

  .reset-btn:hover {
    color: var(--text);
  }

  @media (max-width: 680px) {
    .filter-group {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .group-label {
      min-width: auto;
    }

    .segment-group {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }

    .segment-btn {
      flex-shrink: 0;
    }
  }
</style>
