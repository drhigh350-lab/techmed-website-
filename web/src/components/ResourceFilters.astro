---
// Simplified client-side filtering: "All Resources" and "My Bookshelf" with Subject filter and live search.
// Unifies resource discovery and personal bookshelf at /resources/.
interface Props {
  gridSelector?: string;
}

const { gridSelector = '#resource-grid' } = Astro.props;

const SUBJECT_OPTIONS = ['All', 'Chemistry', 'Biology', 'Physics', 'Admission', 'General'];
---

<div class="catalogue-controls" data-grid={gridSelector}>
  <!-- Primary View Tabs: All Resources vs My Library -->
  <div class="primary-view-wrap">
    <div class="view-tabs" role="tablist" aria-label="Resource View" id="viewFilterGroup">
      <button
        type="button"
        class="view-tab-btn active"
        id="tabAllResources"
        data-view="all"
        role="tab"
        aria-selected="true"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>All Resources</span>
      </button>

      <button
        type="button"
        class="view-tab-btn"
        id="tabMyBookshelf"
        data-view="bookshelf"
        role="tab"
        aria-selected="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>My Library</span>
        <span class="bookshelf-badge" id="bookshelfCountBadge" style="display: none;">0</span>
      </button>
    </div>
  </div>

  <!-- Search input bar -->
  <div class="search-bar">
    <div class="search-input-wrap">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="resourceSearchInput"
        class="search-input"
        placeholder="Search resources, topics, or formulas (e.g. Mole Concept, Traps, Post-UTME)..."
        aria-label="Search resources"
        autocomplete="off"
      />
      <button type="button" id="clearSearchBtn" class="clear-btn" aria-label="Clear search" style="display: none;">
        &times;
      </button>
    </div>
  </div>

  <!-- Subject Filter Row -->
  <div class="filter-sections">
    <div class="filter-group">
      <span class="group-label">Subject:</span>
      <div class="segment-group" role="tablist" aria-label="Filter by subject" id="subjectFilterGroup">
        {SUBJECT_OPTIONS.map((subj, i) => (
          <button
            type="button"
            class:list={['segment-btn', { active: i === 0 }]}
            data-subject={subj}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {subj}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Status / Results Summary -->
  <div class="filter-summary">
    <span id="resultsCounter" class="counter-text">Showing all resources</span>
    <button type="button" id="resetFiltersBtn" class="reset-btn" style="display: none;">
      Reset filters
    </button>
  </div>
</div>

<script>
  import { getSupabase, getUserResourceEntitlements, getMyLibraryIds, getStudentPlan } from '/src/lib/supabase.ts';
  import { listBooks, rememberReader, lastReader } from '/src/lib/offlineBooks.ts';
  import { renderOwnedActions, ownedStatus } from '/src/lib/libraryActions.ts';

  (function initUnifiedResourceFilters() {
    const root = document.querySelector('.catalogue-controls');
    if (!root) return;

    const gridSelector = root.getAttribute('data-grid') || '#resource-grid';
    const grid = document.querySelector(gridSelector) as HTMLElement | null;
    if (!grid) return;

    const searchInput = root.querySelector('#resourceSearchInput') as HTMLInputElement | null;
    const clearBtn = root.querySelector('#clearSearchBtn') as HTMLButtonElement | null;
    const viewBtns = root.querySelectorAll('#viewFilterGroup .view-tab-btn');
    const subjectBtns = root.querySelectorAll('#subjectFilterGroup .segment-btn');
    const counterEl = root.querySelector('#resultsCounter');
    const resetBtn = root.querySelector('#resetFiltersBtn') as HTMLButtonElement | null;
    const bookshelfBadge = root.querySelector('#bookshelfCountBadge') as HTMLElement | null;

    const emptyState = document.querySelector('[data-empty-state]') as HTMLElement | null;
    const authPrompt = document.getElementById('bookshelfAuthPrompt') as HTMLElement | null;
    const emptyBookshelf = document.getElementById('emptyBookshelfState') as HTMLElement | null;
    const browseAllFromBookshelfBtn = document.getElementById('browseAllFromBookshelfBtn');

    // Each item wrapper is in grid
    const itemWrappers = Array.from(grid.querySelectorAll('.grid-item')) as HTMLElement[];
    const totalCount = itemWrappers.length;

    let currentView: 'all' | 'bookshelf' = 'all';
    let currentSubject = 'All';
    let currentSearch = '';

    let currentUser: any = null;
    let authChecked = false;
    let ownedResourceIds: Set<string> | null = null;

    // Database ids that differ from the website's resource ids.
    const DB_TO_SITE: Record<string, string> = {
      'post-utme-pq': 'post-utme-brainstorming-hub',
      'research-file': 'university-research-file',
    };

    function setPriceLine(wrapper: HTMLElement, html: string, owned = false) {
      const priceVal = wrapper.querySelector('.price-val') as HTMLElement | null;
      const note = wrapper.querySelector('.standalone-note') as HTMLElement | null;
      if (priceVal) {
        priceVal.innerHTML = html;
        priceVal.classList.toggle('is-owned', owned);
      }
      if (note && owned) note.style.display = 'none';
    }

    // Who is this, what do they own (asked of the database), and what plan
    // discount applies. Owned books get the same "Read · Save offline"
    // buttons everywhere; nobody is shown "Unlock" for a book they have.
    async function loadAuthAndEntitlements() {
      try {
        const { data } = await getSupabase().auth.getSession();
        const sessionUser = data.session?.user ?? null;
        let userId: string | null = sessionUser?.id ?? null;
        if (sessionUser) rememberReader({ id: sessionUser.id, email: sessionUser.email });
        if (!userId && !navigator.onLine) userId = lastReader()?.id ?? null;
        currentUser = userId ? { id: userId, email: sessionUser?.email } : null;
        authChecked = true;

        if (userId) {
          const ids = new Set<string>();
          const serverIds = navigator.onLine && sessionUser ? await getMyLibraryIds() : null;
          (serverIds ?? []).forEach((id) => ids.add(DB_TO_SITE[id] ?? id));
          if (serverIds === null && navigator.onLine && sessionUser) {
            // Fallback if the database call is unavailable.
            const res = await getUserResourceEntitlements(sessionUser.id, sessionUser.email);
            res.items.forEach((item) => {
              if (item.isOwned) {
                ids.add(item.id);
                if (item.slug) ids.add(item.slug);
              }
            });
          }
          // Books saved on this phone are owned too (works offline).
          (await listBooks(userId)).forEach((m) => ids.add(m.resourceId));
          ownedResourceIds = ids;

          let hasPlan = false;
          if (sessionUser && navigator.onLine) {
            try {
              const plan = await getStudentPlan(sessionUser.id, sessionUser.email);
              hasPlan = Boolean(plan?.isCore || plan?.isMastery || plan?.isUltimate);
            } catch {}
          }

          for (const wrapper of itemWrappers) {
            const resId = wrapper.getAttribute('data-resource-id') || '';
            const slug = wrapper.getAttribute('data-slug') || '';
            const status = wrapper.getAttribute('data-status') || '';
            const title = wrapper.getAttribute('data-title') || '';
            const inReader = wrapper.getAttribute('data-reader') === '1';
            const price = Number(wrapper.getAttribute('data-price')) || 0;
            const isOwned = Boolean((resId && ids.has(resId)) || (slug && ids.has(slug)));
            if (status !== 'paid') continue;

            const actionStack = wrapper.querySelector('.paid-action-stack') as HTMLElement | null;
            if (isOwned && actionStack) {
              if (inReader) {
                const book = { id: resId, title };
                const refresh = async () => {
                  const st = await ownedStatus(book, userId as string);
                  setPriceLine(wrapper, `<span class="owned-tick">✓</span> ${st.text}`, true);
                };
                await renderOwnedActions(actionStack, book, userId, refresh);
                await refresh();
              } else {
                actionStack.style.width = '100%';
                actionStack.style.alignItems = 'stretch';
                actionStack.innerHTML = `<div class="lib-actions"><a class="lib-btn lib-read" href="/resources/${slug}/">Open</a></div>`;
                setPriceLine(wrapper, '<span class="owned-tick">✓</span> In your library', true);
              }
            } else if (hasPlan && price > 0 && wrapper.querySelector('.buy-trigger-btn')) {
              // TECHMED plan students: 20% off standalone e-books (server applies the same rule).
              const discounted = price - Math.round(price * 0.2);
              setPriceLine(
                wrapper,
                `<s class="price-was">₦${price.toLocaleString()}</s>₦${discounted.toLocaleString()}`,
              );
              const buyBtn = wrapper.querySelector('.buy-trigger-btn') as HTMLElement;
              buyBtn.textContent = `Unlock · ₦${discounted.toLocaleString()}`;
            }
          }

          if (bookshelfBadge) {
            let owned = 0;
            itemWrappers.forEach((w) => {
              const id = w.getAttribute('data-resource-id') || '';
              const sl = w.getAttribute('data-slug') || '';
              if (w.getAttribute('data-status') === 'free' || ids.has(id) || ids.has(sl)) owned++;
            });
            bookshelfBadge.textContent = String(owned);
            bookshelfBadge.style.display = 'inline-block';
          }
        }
      } catch (err) {
        console.warn('Library load notice:', err);
        authChecked = true;
      }

      applyFilters();
    }

    function applyFilters() {
      const searchTerms = currentSearch.toLowerCase().trim();

      // If My Bookshelf is selected and user is not signed in
      if (currentView === 'bookshelf') {
        if (!authChecked) {
          // Still loading auth, wait
          return;
        }

        if (!currentUser) {
          // Prompt unauthenticated visitor to log in
          grid.style.display = 'none';
          if (emptyState) emptyState.style.display = 'none';
          if (emptyBookshelf) emptyBookshelf.style.display = 'none';
          if (authPrompt) authPrompt.style.display = 'block';
          if (counterEl) counterEl.textContent = 'Sign in to see your library';
          if (resetBtn) resetBtn.style.display = 'none';
          return;
        }
      }

      // Hide auth prompt if logged in or on All Resources
      if (authPrompt) authPrompt.style.display = 'none';

      let matchCount = 0;
      let bookshelfTotal = 0;

      itemWrappers.forEach((wrapper) => {
        const text = (wrapper.textContent || '').toLowerCase();
        const subjectAttr = (wrapper.getAttribute('data-subject') || '').toLowerCase();
        const statusAttr = (wrapper.getAttribute('data-status') || '').toLowerCase();
        const resId = wrapper.getAttribute('data-resource-id') || '';
        const slug = wrapper.getAttribute('data-slug') || '';

        // Check if item belongs in student bookshelf
        const isFree = statusAttr === 'free';
        const isOwned = Boolean(ownedResourceIds && (ownedResourceIds.has(resId) || ownedResourceIds.has(slug)));
        const inBookshelf = isFree || isOwned;

        if (inBookshelf) bookshelfTotal++;

        // 1. View check
        const matchesView = currentView === 'all' || inBookshelf;

        // 2. Search check
        const matchesSearch = !searchTerms || text.includes(searchTerms);

        // 3. Subject check
        const matchesSubject =
          currentSubject === 'All' ||
          subjectAttr.includes(currentSubject.toLowerCase()) ||
          text.includes(currentSubject.toLowerCase());

        const isVisible = matchesView && matchesSearch && matchesSubject;
        wrapper.style.display = isVisible ? '' : 'none';

        if (isVisible) matchCount++;
      });

      // Update grid visibility
      if (matchCount > 0) {
        grid.style.display = '';
        if (emptyState) emptyState.style.display = 'none';
        if (emptyBookshelf) emptyBookshelf.style.display = 'none';
      } else {
        grid.style.display = 'none';
        if (currentView === 'bookshelf' && bookshelfTotal === 0 && !currentSearch && currentSubject === 'All') {
          if (emptyBookshelf) emptyBookshelf.style.display = 'block';
          if (emptyState) emptyState.style.display = 'none';
        } else {
          if (emptyState) emptyState.style.display = 'block';
          if (emptyBookshelf) emptyBookshelf.style.display = 'none';
        }
      }

      // Update summary counter
      if (counterEl) {
        if (currentView === 'bookshelf') {
          if (currentSearch || currentSubject !== 'All') {
            counterEl.textContent = `Showing ${matchCount} of ${bookshelfTotal} resources in your library`;
          } else {
            counterEl.textContent = `Showing all ${bookshelfTotal} resources in your library`;
          }
        } else {
          if (currentSearch || currentSubject !== 'All') {
            counterEl.textContent = `Showing ${matchCount} of ${totalCount} resources`;
          } else {
            counterEl.textContent = `Showing all ${totalCount} resources`;
          }
        }
      }

      const isFiltered = Boolean(currentSearch || currentSubject !== 'All');
      if (resetBtn) resetBtn.style.display = isFiltered ? 'inline-block' : 'none';
      if (clearBtn) clearBtn.style.display = currentSearch ? 'inline-block' : 'none';
    }

    // View tab switching
    function setView(view: 'all' | 'bookshelf') {
      currentView = view;
      viewBtns.forEach((btn) => {
        const isTarget = btn.getAttribute('data-view') === view;
        btn.classList.toggle('active', isTarget);
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      // Update URL hash/query without reload
      try {
        const url = new URL(window.location.href);
        if (view === 'bookshelf') {
          url.searchParams.set('view', 'library');
          url.hash = '';
        } else {
          url.searchParams.delete('view');
        }
        window.history.replaceState({}, '', url.toString());
      } catch {}

      applyFilters();
    }

    viewBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetView = (btn.getAttribute('data-view') || 'all') as 'all' | 'bookshelf';
        setView(targetView);
      });
    });

    browseAllFromBookshelfBtn?.addEventListener('click', () => {
      setView('all');
    });

    // Subject buttons
    subjectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        subjectBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentSubject = btn.getAttribute('data-subject') || 'All';
        applyFilters();
      });
    });

    // Search events
    searchInput?.addEventListener('input', () => {
      currentSearch = searchInput.value;
      applyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      applyFilters();
      searchInput?.focus();
    });

    // Reset filters
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';

      subjectBtns.forEach((b, i) => {
        b.classList.toggle('active', i === 0);
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      currentSubject = 'All';

      applyFilters();
    });

    // Handle initial URL param e.g. /resources?view=bookshelf or #bookshelf
    const initialParams = new URLSearchParams(window.location.search);
    const wantsLibrary =
      initialParams.get('view') === 'bookshelf' ||
      initialParams.get('view') === 'library' ||
      ['#bookshelf', '#my-library', '#library'].includes(window.location.hash);
    if (wantsLibrary) {
      setView('bookshelf');
      requestAnimationFrame(() => root.scrollIntoView({ block: 'start' }));
    }

    // Run auth check & initial hydration
    loadAuthAndEntitlements();
  })();
</script>

<style>
  .catalogue-controls {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Primary View Tabs (All Resources vs My Bookshelf) */
  .primary-view-wrap {
    display: flex;
    justify-content: flex-start;
  }

  .view-tabs {
    display: inline-flex;
    background: var(--surface-raised);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 5px;
    gap: 6px;
    box-shadow: 0 2px 8px rgba(1, 39, 72, 0.06);
  }

  .view-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 10px 22px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 180ms ease;
    white-space: nowrap;
  }

  .view-tab-btn:hover {
    color: var(--text);
  }

  /* Deep Navy active state */
  .view-tab-btn.active {
    background: #012748 !important;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(1, 39, 72, 0.22);
  }

  :root:not([data-theme='light']) .view-tab-btn.active {
    background: #09476E !important;
    color: #ffffff !important;
  }

  .bookshelf-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
  }

  .view-tab-btn:not(.active) .bookshelf-badge {
    background: rgba(152, 176, 196, 0.2);
    color: var(--text-muted);
  }

  /* Search input */
  .search-bar {
    width: 100%;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .search-input-wrap:focus-within {
    border-color: #09476E;
    box-shadow: 0 0 0 3px rgba(9, 71, 110, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 13px 40px 13px 42px;
    background: transparent;
    border: none;
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .clear-btn {
    position: absolute;
    right: 12px;
    background: transparent;
    border: none;
    font-size: 1.25rem;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1;
    padding: 4px;
  }

  .clear-btn:hover {
    color: var(--text);
  }

  /* Filter rows */
  .filter-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .group-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    min-width: 65px;
  }

  .segment-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .segment-btn {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--text-light);
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 7px 15px;
    cursor: pointer;
    transition: all 150ms ease;
    white-space: nowrap;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .segment-btn:hover {
    color: #012748;
    border-color: #09476E;
  }

  :root:not([data-theme='light']) .segment-btn:hover {
    color: #F8F9FA;
    border-color: #98B0C4;
  }

  /* Deep Navy active state for subject filters */
  .segment-btn.active {
    color: #ffffff !important;
    background: #012748 !important;
    border-color: #012748 !important;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(1, 39, 72, 0.2);
  }

  :root:not([data-theme='light']) .segment-btn.active {
    background: #09476E !important;
    border-color: #09476E !important;
    color: #ffffff !important;
  }

  .filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .counter-text {
    color: var(--text-muted);
    font-weight: 500;
  }

  .reset-btn {
    background: none;
    border: none;
    color: #09476E;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    padding: 4px 8px;
    text-decoration: underline;
  }

  :root:not([data-theme='light']) .reset-btn {
    color: #98B0C4;
  }

  .reset-btn:hover {
    color: #012748;
  }

  @media (max-width: 680px) {
    .primary-view-wrap {
      width: 100%;
    }

    .view-tabs {
      width: 100%;
    }

    .view-tab-btn {
      flex: 1;
      justify-content: center;
      padding: 10px 14px;
      font-size: 0.82rem;
    }

    .filter-group {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .group-label {
      min-width: auto;
    }

    .segment-group {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }

    .segment-btn {
      flex-shrink: 0;
    }
  }
</style>
