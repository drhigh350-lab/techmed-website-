---
// Founder facts sourced from about.html (already live on techmedng.com) —
// kept consistent with the established public bio rather than restated
// from scratch. Content lives in Sanity (singleton doc _id: "founder")
// once seeded; falls back to the local static photo and this copy either
// way, so a missing/unreachable Sanity doc never breaks the section.
import { fetchSanity } from '../lib/sanity';

const FALLBACK = {
  name: 'Wisdom Johnson',
  role: 'CEO, TECHMED',
  label: 'A Note From the Founder',
  photoUrl: '/images/201319.jpg',
  bio: [
    'Wisdom Johnson is a medical student at the University of Uyo and the founder of TECHMED. Before gaining admission, he lived the exact pain many Nigerian students face today — after secondary school in 2021, he wrote UTME in 2022 hoping to study Medicine & Surgery, and was not admitted. He spent nearly three years at home facing that disappointment.',
    'Instead of giving up, he studied the admission process deeply. On his second attempt, he scored 331 in UTME and 91% in Chemistry, and secured admission to study Medicine & Surgery in 2024.',
  ],
  quote:
    "Most students don't fail because they lack intelligence. They fail because they lack strategy, systems and proper guidance.",
};

const founder = await fetchSanity<typeof FALLBACK>(
  `*[_id == "founder"][0]{name, role, label, "photoUrl": photo.asset->url, bio, quote}`,
  FALLBACK,
);
const { name, role, label, bio, quote } = founder;
// photo.asset->url resolves to null if a founder doc exists in Sanity but
// has no photo uploaded yet — fall back to the static asset rather than
// rendering a broken <img>.
const photoUrl = founder.photoUrl || FALLBACK.photoUrl;
---

<section class="section">
  <div class="grid">
    <div class="photo-wrap reveal">
      <img src={photoUrl} alt={`${name}, founder of TECHMED`} loading="lazy" decoding="async" />
    </div>
    <div class="content reveal">
      <p class="label">{label}</p>
      <h2>{name} — {role}</h2>
      {bio.map((paragraph) => (
        <p set:text={paragraph} />
      ))}
      <p class="quote">"{quote}"</p>

      <ol class="timeline">
        <li><span class="year">2021</span><span class="event">Finished secondary school</span></li>
        <li><span class="year">2022</span><span class="event">First UTME attempt — not admitted</span></li>
        <li><span class="year">2024</span><span class="event">Admitted to study Medicine &amp; Surgery</span></li>
      </ol>
    </div>
  </div>
</section>

<style>
  .section {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-24) var(--space-6);
  }

  .grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .photo-wrap img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--surface-raised);
    transition: border-color 250ms ease, transform 250ms ease;
  }

  .photo-wrap:hover img {
    border-color: var(--accent);
    transform: scale(1.02);
  }

  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    margin-bottom: var(--space-5);
  }

  .content p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-light);
    margin-bottom: var(--space-4);
  }

  .quote {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    color: var(--text);
    border-left: 3px solid var(--accent);
    padding-left: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .timeline {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .timeline li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .timeline .year {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--accent-text);
  }

  .timeline .event {
    font-size: 0.75rem;
    color: var(--text-muted);
    max-width: 14ch;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .photo-wrap img {
      width: 160px;
      margin: 0 auto;
    }
    .quote {
      text-align: left;
    }
    .timeline {
      justify-content: center;
      flex-wrap: wrap;
      text-align: left;
    }
  }
</style>
