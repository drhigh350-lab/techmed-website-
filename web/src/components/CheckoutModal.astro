---
// TECHMED Unified Guided Resource Checkout Modal
// Mobile-first, minimal, premium 3-step checkout experience for study resources:
// Step 1: Review Order (resource title, delivery format, Core 20% discount option, price breakdown)
// Step 2: Confirm Details (email for license, student name, WhatsApp phone, target university if needed)
// Step 3: Payment (Paystack secure portal, card & instant bank transfer, duplicate submission prevention)
// Step 4: Managed via /payment/callback after verified Paystack return
---

<div id="checkoutModalBackdrop" class="checkout-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="checkoutTitle">
  <div class="checkout-card" id="checkoutCard">
    <!-- Top Header & Close Button -->
    <div class="checkout-header">
      <div class="header-titles">
        <span class="header-eyebrow">TECHMED RESOURCE CHECKOUT</span>
        <h2 id="checkoutTitle" class="checkout-modal-title">Unlock Study Resource</h2>
      </div>
      <button type="button" id="closeCheckoutBtn" class="close-btn" aria-label="Close checkout modal">&times;</button>
    </div>

    <!-- Guided Checkout Step Indicator -->
    <div class="checkout-stepper" role="navigation" aria-label="Checkout Progress">
      <button type="button" class="step-indicator active" id="resourceStepNav1" data-step="1">
        <span class="step-num">1</span>
        <span class="step-label">Order</span>
      </button>
      <div class="step-connector" id="resourceConnector1"></div>
      <button type="button" class="step-indicator" id="resourceStepNav2" data-step="2">
        <span class="step-num">2</span>
        <span class="step-label">Details</span>
      </button>
      <div class="step-connector" id="resourceConnector2"></div>
      <button type="button" class="step-indicator" id="resourceStepNav3" data-step="3">
        <span class="step-num">3</span>
        <span class="step-label">Payment</span>
      </button>
    </div>

    <form id="checkoutForm" class="checkout-form" novalidate>
      <div class="checkout-panes-wrap">
        <!-- =============================================================== -->
        <!-- STEP 1: REVIEW ORDER PANE                                        -->
        <!-- =============================================================== -->
        <div id="resourcePaneStep1" class="checkout-pane active">
          <!-- Resource Summary Box -->
          <div class="item-summary-box">
            <div class="summary-top">
              <span id="checkoutSubject" class="summary-subject">Academic</span>
              <span class="sep">·</span>
              <span id="checkoutFormat" class="summary-format">PDF eBook &amp; Reader</span>
            </div>
            <h3 id="checkoutItemTitle" class="summary-title">Resource Title</h3>
            <p id="checkoutItemDesc" class="summary-desc">Resource description</p>

            <div class="resource-perks-list">
              <div class="perk-item">
                <span class="perk-icon" aria-hidden="true">✓</span>
                <span>Instant bookshelf activation &amp; interactive PDF reader</span>
              </div>
              <div class="perk-item">
                <span class="perk-icon" aria-hidden="true">✓</span>
                <span>Permanent personal student copy with custom watermark</span>
              </div>
            </div>
          </div>

          <!-- Plan Billing Option Selector (for Core plan fallback) -->
          <div class="form-group" id="planBillingOptionsGroup" style="display: none;">
            <label class="billing-select-label">Choose billing option:</label>
            <div class="modal-billing-selector">
              <label class="modal-billing-card active" id="modalCardEarlybird">
                <input type="radio" name="modalBillingChoice" value="earlybird" checked />
                <div class="card-inner">
                  <div class="card-row-top">
                    <span class="card-title">3 Months Upfront</span>
                    <span class="card-badge" id="modalEarlybirdBadge">Early-bird</span>
                  </div>
                  <div class="card-price-row">
                    <span class="card-strike" id="modalCardStrike">₦18,000</span>
                    <span class="card-final" id="modalCardFinal">₦15,000</span>
                  </div>
                  <span class="card-note" id="modalCardNote">Valid through 15 November 2026</span>
                </div>
              </label>

              <label class="modal-billing-card" id="modalCardMonthly">
                <input type="radio" name="modalBillingChoice" value="monthly" />
                <div class="card-inner">
                  <div class="card-row-top">
                    <span class="card-title">Monthly Subscription</span>
                  </div>
                  <div class="card-price-row">
                    <span class="card-final">₦7,000</span>
                    <span class="card-period">/ month</span>
                  </div>
                  <span class="card-note">Pay per month to maintain active access</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Core Student 20% Discount Accordion -->
          <div class="discount-section">
            <label class="discount-checkbox-label">
              <input type="checkbox" id="coreDiscountCheckbox" />
              <span>I am enrolled in the <strong>TECHMED Core</strong> plan (20% discount)</span>
            </label>
            <div id="discountDetails" class="discount-details" style="display: none;">
              <p class="discount-note">
                ✓ 20% discount applied for active Core student. Enrolment will be verified upon activation.
              </p>
            </div>
          </div>

          <!-- Itemized Order Breakdown -->
          <div class="order-breakdown-card">
            <h4 class="breakdown-title">Order Summary</h4>
            <div class="breakdown-line">
              <span class="breakdown-label">Standard Price:</span>
              <span class="breakdown-figure" id="resourceBaseFigure">₦0</span>
            </div>
            <div class="breakdown-line discount-line" id="resourceDiscountRow" style="display: none;">
              <span class="breakdown-label">Core Student Discount (20%):</span>
              <span class="breakdown-figure discount-val" id="resourceDiscountFigure">-₦0</span>
            </div>
            <div class="breakdown-divider"></div>
            <div class="breakdown-line total-line">
              <span class="total-label">Total Payable:</span>
              <div class="total-figures">
                <span id="checkoutOriginalPrice" class="original-price" style="display: none;">₦0</span>
                <span id="checkoutFinalPrice" class="final-price">₦0</span>
              </div>
            </div>
          </div>

          <!-- Step 1 Primary Action -->
          <div class="step-action-bar">
            <button type="button" id="btnResourceToStep2" class="btn-primary step-next-btn">
              <span>Continue to Student Details &rarr;</span>
            </button>
            <span class="step-action-hint">Next: Enter contact details for your access license</span>
          </div>
        </div>

        <!-- =============================================================== -->
        <!-- STEP 2: CONFIRM DETAILS PANE                                    -->
        <!-- =============================================================== -->
        <div id="resourcePaneStep2" class="checkout-pane" style="display: none;">
          <div class="pane-intro">
            <h3 class="pane-title">Student Information</h3>
            <p class="pane-subtitle">Your study materials will be immediately unlocked and associated with this email address.</p>
          </div>

          <div class="form-fields-stack">
            <div class="form-group">
              <label for="checkoutEmail">
                Email Address for Bookshelf Access <span class="required-mark">*</span>
              </label>
              <input
                type="email"
                id="checkoutEmail"
                required
                placeholder="e.g. candidate@gmail.com"
                autocomplete="email"
                class="checkout-input"
              />
              <span class="hint-text">Your reading license and payment receipt will be linked to this email.</span>
            </div>

            <div class="form-group" id="studentNameGroup" style="display: none;">
              <label for="checkoutName">Student Full Name</label>
              <input
                type="text"
                id="checkoutName"
                placeholder="e.g. Samuel Adebayo"
                autocomplete="name"
                class="checkout-input"
              />
              <span class="hint-text">Used on your custom watermarked resource copy.</span>
            </div>

            <div class="form-group" id="studentPhoneGroup" style="display: none;">
              <label for="checkoutPhone">WhatsApp Phone Number</label>
              <input
                type="tel"
                id="checkoutPhone"
                placeholder="e.g. 08012345678"
                autocomplete="tel"
                class="checkout-input"
              />
              <span class="hint-text">Used for study updates and reading progress sync.</span>
            </div>

            <div class="form-group" id="universityGroup" style="display: none;">
              <label for="checkoutUniversity">Target University <span class="required-mark">*</span></label>
              <select id="checkoutUniversity" class="checkout-select">
                <option value="">Select your target institution...</option>
                <option value="UNILAG">University of Lagos (UNILAG)</option>
                <option value="UI">University of Ibadan (UI)</option>
                <option value="OAU">Obafemi Awolowo University (OAU)</option>
                <option value="UNN">University of Nigeria, Nsukka (UNN)</option>
                <option value="UNIBEN">University of Benin (UNIBEN)</option>
                <option value="ABU">Ahmadu Bello University (ABU)</option>
                <option value="FUTA">Federal University of Technology, Akure (FUTA)</option>
                <option value="UNILORIN">University of Ilorin (UNILORIN)</option>
                <option value="OOU">Olabisi Onabanjo University (OOU)</option>
                <option value="LASU">Lagos State University (LASU)</option>
                <option value="RSU">Rivers State University (RSU)</option>
                <option value="OTHER">Other Nigerian University</option>
              </select>
              <span class="hint-text">This study resource is customized for your specific university requirements.</span>
            </div>
          </div>

          <!-- Step 2 Navigation Actions -->
          <div class="step-action-bar dual-actions">
            <button type="button" id="btnResourceBackToStep1" class="btn-secondary step-back-btn">
              &larr; Back to Order
            </button>
            <button type="button" id="btnResourceToStep3" class="btn-primary step-next-btn">
              <span>Continue to Payment &rarr;</span>
            </button>
          </div>
        </div>

        <!-- =============================================================== -->
        <!-- STEP 3: PAYMENT PANE                                            -->
        <!-- =============================================================== -->
        <div id="resourcePaneStep3" class="checkout-pane" style="display: none;">
          <div class="pane-intro">
            <h3 class="pane-title">Complete Payment</h3>
            <p class="pane-subtitle">Review your order and proceed to Paystack secure checkout.</p>
          </div>

          <!-- Compact Order Recap Card -->
          <div class="payment-recap-box">
            <div class="recap-header">
              <span class="recap-badge">ORDER RECAP</span>
              <button type="button" id="btnEditResourceFromRecap" class="recap-edit-btn">Change</button>
            </div>
            <div class="recap-details">
              <div class="recap-title" id="recapResourceTitle">Resource Title</div>
              <div class="recap-email" id="recapResourceEmail">candidate@gmail.com</div>
            </div>
            <div class="recap-price-row">
              <span class="recap-price-label">Amount Payable:</span>
              <span class="recap-price-amount" id="recapResourceFinalPrice">₦0</span>
            </div>
          </div>

          <!-- Paystack Gateway Presentation Card -->
          <div class="gateway-card">
            <div class="gateway-header">
              <div class="gateway-brand">
                <span class="paystack-pill">Paystack Verified</span>
                <span class="gateway-ssl">256-Bit SSL Secured</span>
              </div>
            </div>
            <p class="gateway-desc">
              Complete your payment via Paystack's official portal using:
            </p>
            <div class="payment-methods-grid">
              <div class="method-tag">💳 Debit Card (Mastercard / Visa / Verve)</div>
              <div class="method-tag">🏦 Bank Transfer (Instant Automated Match)</div>
              <div class="method-tag">📱 USSD &amp; Mobile Money</div>
            </div>
            <div class="gateway-steps-list">
              <div class="gateway-step-item">
                <span class="step-dot">1</span>
                <span>Select <strong>Card</strong> or <strong>Bank Transfer</strong> on Paystack.</span>
              </div>
              <div class="gateway-step-item">
                <span class="step-dot">2</span>
                <span>Complete the transaction securely.</span>
              </div>
              <div class="gateway-step-item">
                <span class="step-dot">3</span>
                <span>Access unlocks in your TECHMED Bookshelf immediately.</span>
              </div>
            </div>
          </div>

          <div id="checkoutAlert" class="checkout-alert" style="display: none;" role="alert"></div>

          <!-- Step 3 Actions -->
          <div class="step-action-bar dual-actions">
            <button type="button" id="btnResourceBackToStep2" class="btn-secondary step-back-btn">
              &larr; Back to Details
            </button>
            <button type="submit" class="btn-primary pay-btn" id="paystackSubmitBtn">
              <span>Pay <span id="paystackAmountLabel">₦0</span> with Paystack &rarr;</span>
            </button>
          </div>

          <p class="security-note">
            🔒 Secured by Paystack 256-bit encryption. Card, Bank Transfer, USSD &amp; Mobile Money supported.
          </p>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  import { getCurrentUser, SUPABASE_ANON_KEY } from '/src/lib/supabase.ts';
  import { trackEvent } from '/src/lib/analytics.ts';

  const modalBackdrop = document.getElementById('checkoutModalBackdrop');
  const closeCheckoutBtn = document.getElementById('closeCheckoutBtn');
  const checkoutTitle = document.getElementById('checkoutTitle');
  const checkoutSubject = document.getElementById('checkoutSubject');
  const checkoutFormat = document.getElementById('checkoutFormat');
  const checkoutItemTitle = document.getElementById('checkoutItemTitle');
  const checkoutItemDesc = document.getElementById('checkoutItemDesc');
  const checkoutOriginalPrice = document.getElementById('checkoutOriginalPrice');
  const checkoutFinalPrice = document.getElementById('checkoutFinalPrice');
  const coreDiscountCheckbox = document.getElementById('coreDiscountCheckbox') as HTMLInputElement | null;
  const discountDetails = document.getElementById('discountDetails');
  const checkoutEmail = document.getElementById('checkoutEmail') as HTMLInputElement | null;
  const checkoutName = document.getElementById('checkoutName') as HTMLInputElement | null;
  const checkoutPhone = document.getElementById('checkoutPhone') as HTMLInputElement | null;
  const studentNameGroup = document.getElementById('studentNameGroup');
  const studentPhoneGroup = document.getElementById('studentPhoneGroup');
  const universityGroup = document.getElementById('universityGroup');
  const checkoutUniversity = document.getElementById('checkoutUniversity') as HTMLSelectElement | null;
  const checkoutAlert = document.getElementById('checkoutAlert');
  const checkoutForm = document.getElementById('checkoutForm');
  const paystackSubmitBtn = document.getElementById('paystackSubmitBtn') as HTMLButtonElement | null;
  const paystackAmountLabel = document.getElementById('paystackAmountLabel');

  const resourceBaseFigure = document.getElementById('resourceBaseFigure');
  const resourceDiscountRow = document.getElementById('resourceDiscountRow');
  const resourceDiscountFigure = document.getElementById('resourceDiscountFigure');

  // Stepper & Panes
  let currentStep: 1 | 2 | 3 = 1;
  const paneStep1 = document.getElementById('resourcePaneStep1');
  const paneStep2 = document.getElementById('resourcePaneStep2');
  const paneStep3 = document.getElementById('resourcePaneStep3');
  const stepNav1 = document.getElementById('resourceStepNav1');
  const stepNav2 = document.getElementById('resourceStepNav2');
  const stepNav3 = document.getElementById('resourceStepNav3');
  const connector1 = document.getElementById('resourceConnector1');
  const connector2 = document.getElementById('resourceConnector2');

  const btnToStep2 = document.getElementById('btnResourceToStep2');
  const btnBackToStep1 = document.getElementById('btnResourceBackToStep1');
  const btnToStep3 = document.getElementById('btnResourceToStep3');
  const btnBackToStep2 = document.getElementById('btnResourceBackToStep2');
  const btnEditFromRecap = document.getElementById('btnEditResourceFromRecap');

  const recapResourceTitle = document.getElementById('recapResourceTitle');
  const recapResourceEmail = document.getElementById('recapResourceEmail');
  const recapResourceFinalPrice = document.getElementById('recapResourceFinalPrice');

  // Plan billing selector elements (for fallback)
  const planBillingOptionsGroup = document.getElementById('planBillingOptionsGroup');
  const modalCardEarlybird = document.getElementById('modalCardEarlybird');
  const modalCardMonthly = document.getElementById('modalCardMonthly');
  const modalCardStrike = document.getElementById('modalCardStrike');
  const modalCardFinal = document.getElementById('modalCardFinal');
  const modalEarlybirdBadge = document.getElementById('modalEarlybirdBadge');
  const modalCardNote = document.getElementById('modalCardNote');

  const EARLY_BIRD_DEADLINE = new Date('2026-11-15T23:59:59Z').getTime();

  let currentResource: any = null;
  let basePrice = 0;
  let activeDuration = 'earlybird'; // 'earlybird' | 'monthly'

  function isEarlyBirdValid() {
    return Date.now() <= EARLY_BIRD_DEADLINE;
  }

  function goToStep(targetStep: 1 | 2 | 3) {
    if (targetStep === 3) {
      const email = checkoutEmail?.value.trim() || '';
      if (!email || !email.includes('@')) {
        if (checkoutEmail) {
          checkoutEmail.focus();
          checkoutEmail.classList.add('input-error');
        }
        showInlineAlert('Please enter a valid email address to proceed.');
        return;
      } else {
        if (checkoutEmail) checkoutEmail.classList.remove('input-error');
      }

      const needsUni = universityGroup && universityGroup.style.display !== 'none';
      const uni = checkoutUniversity?.value;
      if (needsUni && !uni) {
        if (checkoutUniversity) {
          checkoutUniversity.focus();
          checkoutUniversity.classList.add('input-error');
        }
        showInlineAlert('Please select your target university.');
        return;
      } else {
        if (checkoutUniversity) checkoutUniversity.classList.remove('input-error');
      }

      hideInlineAlert();
      updateStep3Recap();
    }

    currentStep = targetStep;

    if (paneStep1) paneStep1.style.display = targetStep === 1 ? 'block' : 'none';
    if (paneStep2) paneStep2.style.display = targetStep === 2 ? 'block' : 'none';
    if (paneStep3) paneStep3.style.display = targetStep === 3 ? 'block' : 'none';

    stepNav1?.classList.toggle('active', targetStep === 1);
    stepNav1?.classList.toggle('completed', targetStep > 1);
    stepNav2?.classList.toggle('active', targetStep === 2);
    stepNav2?.classList.toggle('completed', targetStep > 2);
    stepNav3?.classList.toggle('active', targetStep === 3);

    connector1?.classList.toggle('active', targetStep >= 2);
    connector2?.classList.toggle('active', targetStep >= 3);

    const cardEl = document.getElementById('checkoutCard');
    if (cardEl) cardEl.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateStep3Recap() {
    if (recapResourceTitle) recapResourceTitle.textContent = currentResource?.title || 'Resource';
    if (recapResourceEmail) recapResourceEmail.textContent = checkoutEmail?.value.trim() || 'candidate@gmail.com';
    const isCohort = !!(currentResource?.isCohort || currentResource?.id?.startsWith('cohort-') || ['core', 'mastery', 'ultimate'].includes(currentResource?.id));
    const isCore = coreDiscountCheckbox?.checked && !isCohort;
    const finalPrice = isCore ? Math.round(basePrice * 0.8) : basePrice;
    if (recapResourceFinalPrice) recapResourceFinalPrice.textContent = `₦${finalPrice.toLocaleString()}`;
  }

  function showInlineAlert(message: string) {
    if (checkoutAlert) {
      checkoutAlert.style.display = 'block';
      checkoutAlert.innerHTML = `<strong>Attention:</strong> ${message}`;
    }
  }

  function hideInlineAlert() {
    if (checkoutAlert) {
      checkoutAlert.style.display = 'none';
      checkoutAlert.innerHTML = '';
    }
  }

  btnToStep2?.addEventListener('click', () => goToStep(2));
  btnBackToStep1?.addEventListener('click', () => goToStep(1));
  btnToStep3?.addEventListener('click', () => goToStep(3));
  btnBackToStep2?.addEventListener('click', () => goToStep(2));
  btnEditFromRecap?.addEventListener('click', () => goToStep(1));

  stepNav1?.addEventListener('click', () => goToStep(1));
  stepNav2?.addEventListener('click', () => {
    if (currentStep > 1) goToStep(2);
  });
  stepNav3?.addEventListener('click', () => {
    if (currentStep > 2) goToStep(3);
  });

  function updatePriceDisplay() {
    if (!currentResource) return;
    const isCohort = !!(currentResource.isCohort || currentResource.id?.startsWith('cohort-') || ['core', 'mastery', 'ultimate'].includes(currentResource.id));
    const isCore = coreDiscountCheckbox?.checked && !isCohort;
    const finalPrice = isCore ? Math.round(basePrice * 0.8) : basePrice;
    const discountAmount = isCore ? (basePrice - finalPrice) : 0;

    if (resourceBaseFigure) {
      resourceBaseFigure.textContent = `₦${basePrice.toLocaleString()}`;
    }

    if (resourceDiscountRow && resourceDiscountFigure) {
      if (isCore && discountAmount > 0) {
        resourceDiscountRow.style.display = 'flex';
        resourceDiscountFigure.textContent = `-₦${discountAmount.toLocaleString()}`;
      } else {
        resourceDiscountRow.style.display = 'none';
      }
    }

    if (currentResource.originalPrice && currentResource.originalPrice > finalPrice) {
      if (checkoutOriginalPrice) {
        checkoutOriginalPrice.style.display = 'inline';
        checkoutOriginalPrice.textContent = `₦${currentResource.originalPrice.toLocaleString()}`;
      }
    } else if (isCore && basePrice > 0) {
      if (checkoutOriginalPrice) {
        checkoutOriginalPrice.style.display = 'inline';
        checkoutOriginalPrice.textContent = `₦${basePrice.toLocaleString()}`;
      }
    } else {
      if (checkoutOriginalPrice) {
        checkoutOriginalPrice.style.display = 'none';
      }
    }

    if (checkoutFinalPrice) checkoutFinalPrice.textContent = `₦${finalPrice.toLocaleString()}`;
    if (paystackAmountLabel) paystackAmountLabel.textContent = `₦${finalPrice.toLocaleString()}`;
    updateStep3Recap();
  }

  // Handle billing radio changes inside modal
  function setupBillingRadioListeners() {
    const radios = document.querySelectorAll('input[name="modalBillingChoice"]');
    radios.forEach((r) => {
      r.addEventListener('change', () => {
        const input = r as HTMLInputElement;
        if (!input.checked) return;
        activeDuration = input.value;
        const earlyValid = isEarlyBirdValid();

        if (activeDuration === 'monthly') {
          modalCardMonthly?.classList.add('active');
          modalCardEarlybird?.classList.remove('active');
          currentResource.id = 'cohort-core-monthly';
          currentResource.title = 'TECHMED Core (Monthly Subscription)';
          currentResource.price = 7000;
          currentResource.originalPrice = null;
          basePrice = 7000;
        } else {
          modalCardEarlybird?.classList.add('active');
          modalCardMonthly?.classList.remove('active');
          currentResource.id = earlyValid ? 'cohort-core-earlybird' : 'cohort-core-standard';
          currentResource.title = earlyValid ? 'TECHMED Core (3-Month Early-Bird)' : 'TECHMED Core (3-Month Standard)';
          currentResource.price = earlyValid ? 15000 : 18000;
          currentResource.originalPrice = earlyValid ? 18000 : null;
          basePrice = currentResource.price;
        }

        if (checkoutItemTitle) checkoutItemTitle.textContent = currentResource.title;
        updatePriceDisplay();
        trackEvent('billing_option_selected', {
          planId: 'core',
          billingOption: activeDuration,
          amount: basePrice,
        });
      });
    });
  }
  setupBillingRadioListeners();

  coreDiscountCheckbox?.addEventListener('change', () => {
    if (discountDetails) {
      discountDetails.style.display = coreDiscountCheckbox.checked ? 'block' : 'none';
    }
    updatePriceDisplay();
  });

  checkoutEmail?.addEventListener('input', () => {
    if (checkoutEmail.classList.contains('input-error')) checkoutEmail.classList.remove('input-error');
    updatePriceDisplay();
  });
  checkoutName?.addEventListener('input', updatePriceDisplay);
  checkoutUniversity?.addEventListener('change', () => {
    if (checkoutUniversity.classList.contains('input-error')) checkoutUniversity.classList.remove('input-error');
    updatePriceDisplay();
  });

  export function openCheckout(resource: any) {
    currentResource = { ...resource };
    const earlyValid = isEarlyBirdValid();
    const isCohort = !!(resource.isCohort || resource.id?.startsWith('cohort-') || ['core', 'mastery', 'ultimate'].includes(resource.id));

    // Normalise Core plan selection with duration options
    if (resource.id === 'core' || resource.id === 'cohort-core' || resource.id === 'cohort-core-earlybird' || resource.id === 'cohort-core-monthly') {
      if (planBillingOptionsGroup) planBillingOptionsGroup.style.display = 'block';
      activeDuration = resource.initialDuration === 'monthly' || resource.id === 'cohort-core-monthly' ? 'monthly' : 'earlybird';

      if (modalEarlybirdBadge) modalEarlybirdBadge.style.display = earlyValid ? 'inline' : 'none';
      if (modalCardStrike) modalCardStrike.style.display = earlyValid ? 'inline' : 'none';
      if (modalCardFinal) modalCardFinal.textContent = earlyValid ? '₦15,000' : '₦18,000';
      if (modalCardNote) modalCardNote.textContent = earlyValid ? 'Valid through 15 November 2026' : '3 months upfront preparation';

      const radioEarly = document.querySelector('input[name="modalBillingChoice"][value="earlybird"]') as HTMLInputElement | null;
      const radioMonth = document.querySelector('input[name="modalBillingChoice"][value="monthly"]') as HTMLInputElement | null;

      if (activeDuration === 'monthly') {
        if (radioMonth) radioMonth.checked = true;
        modalCardMonthly?.classList.add('active');
        modalCardEarlybird?.classList.remove('active');
        currentResource.id = 'cohort-core-monthly';
        currentResource.title = 'TECHMED Core (Monthly Subscription)';
        currentResource.price = 7000;
        currentResource.originalPrice = null;
      } else {
        if (radioEarly) radioEarly.checked = true;
        modalCardEarlybird?.classList.add('active');
        modalCardMonthly?.classList.remove('active');
        currentResource.id = earlyValid ? 'cohort-core-earlybird' : 'cohort-core-standard';
        currentResource.title = earlyValid ? 'TECHMED Core (3-Month Early-Bird)' : 'TECHMED Core (3-Month Standard)';
        currentResource.price = earlyValid ? 15000 : 18000;
        currentResource.originalPrice = earlyValid ? 18000 : null;
      }
    } else {
      if (planBillingOptionsGroup) planBillingOptionsGroup.style.display = 'none';

      if (resource.id === 'mastery' || resource.id === 'cohort-mastery') {
        currentResource.id = earlyValid ? 'cohort-mastery-earlybird' : 'cohort-mastery-standard';
        currentResource.title = earlyValid ? 'TECHMED Mastery (3-Month Early-Bird)' : 'TECHMED Mastery (3-Month Standard)';
        currentResource.price = earlyValid ? 20000 : 25000;
        currentResource.originalPrice = earlyValid ? 25000 : null;
      } else if (resource.id === 'ultimate' || resource.id === 'cohort-ultimate') {
        currentResource.id = 'cohort-ultimate';
        currentResource.title = 'TECHMED Ultimate (Full Programme)';
        currentResource.price = 40000;
        currentResource.originalPrice = null;
      }
    }

    basePrice = currentResource.price || 0;
    if (checkoutItemTitle) checkoutItemTitle.textContent = currentResource.title;
    if (checkoutItemDesc) checkoutItemDesc.textContent = currentResource.description || '';
    if (checkoutSubject) checkoutSubject.textContent = currentResource.subject || (isCohort ? 'UTME 2027 Track' : 'Academic');
    if (checkoutFormat) checkoutFormat.textContent = currentResource.deliveryFormat || (isCohort ? 'Live Telegram + CBT Drills' : 'PDF eBook & Reader');

    if (studentNameGroup) studentNameGroup.style.display = isCohort ? 'block' : 'none';
    if (studentPhoneGroup) studentPhoneGroup.style.display = isCohort ? 'block' : 'none';

    const discountSection = document.querySelector('.discount-section') as HTMLElement | null;
    if (discountSection) {
      discountSection.style.display = isCohort ? 'none' : 'block';
    }

    const needsUni = resource.id === 'research-file' || resource.id === 'university-research-file' || resource.id === 'post-utme-pq' || resource.id === 'post-utme-brainstorming-hub';
    if (universityGroup) universityGroup.style.display = needsUni ? 'block' : 'none';
    if (checkoutUniversity) checkoutUniversity.required = needsUni;

    if (coreDiscountCheckbox) coreDiscountCheckbox.checked = false;
    if (discountDetails) discountDetails.style.display = 'none';

    goToStep(1);

    // Prefill user email if signed in
    getCurrentUser().then(user => {
      if (user?.email && checkoutEmail && !checkoutEmail.value) {
        checkoutEmail.value = user.email;
      }
      if (user?.user_metadata?.full_name && checkoutName && !checkoutName.value) {
        checkoutName.value = user.user_metadata.full_name;
      }
      updatePriceDisplay();
    });

    updatePriceDisplay();
    hideInlineAlert();
    if (modalBackdrop) modalBackdrop.style.display = 'flex';

    trackEvent('plan_selected', {
      planId: currentResource.id,
      planName: currentResource.title,
      amount: basePrice,
    });
  }

  export function closeCheckout() {
    if (modalBackdrop) modalBackdrop.style.display = 'none';
    trackEvent('checkout_abandoned', {
      planId: currentResource?.id,
      amount: basePrice,
    });
  }

  closeCheckoutBtn?.addEventListener('click', closeCheckout);
  modalBackdrop?.addEventListener('click', (e) => {
    if (e.target === modalBackdrop) closeCheckout();
  });

  // Handle Form Submission (Paystack Initiation)
  checkoutForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = checkoutEmail?.value.trim() || '';
    if (!email || !email.includes('@')) {
      goToStep(2);
      showInlineAlert('Please enter a valid email address.');
      return;
    }

    const name = checkoutName?.value?.trim() || '';
    const phone = checkoutPhone?.value?.trim() || '';
    const isCohort = currentResource?.isCohort || currentResource?.id?.startsWith('cohort-') || ['core', 'mastery', 'ultimate'].includes(currentResource?.id);

    const needsUni = universityGroup && universityGroup.style.display !== 'none';
    const uni = checkoutUniversity?.value;
    if (needsUni && !uni) {
      goToStep(2);
      showInlineAlert('Please select your target university.');
      return;
    }

    hideInlineAlert();
    if (paystackSubmitBtn) {
      paystackSubmitBtn.disabled = true;
      paystackSubmitBtn.innerHTML = '<span>Connecting to Paystack...</span>';
    }

    try {
      const SUPABASE_FN_BASE = 'https://unbgborbhxzsotaieiun.supabase.co/functions/v1';
      const isCore = coreDiscountCheckbox?.checked && !isCohort;
      const chargeAmount = isCore ? Math.round(basePrice * 0.8) : basePrice;

      // Normalise product id for cohort or legacy aliases
      let productId = currentResource.id;
      if (productId === 'core') productId = isEarlyBirdValid() ? 'cohort-core-earlybird' : 'cohort-core-standard';
      if (productId === 'mastery') productId = isEarlyBirdValid() ? 'cohort-mastery-earlybird' : 'cohort-mastery-standard';
      if (productId === 'ultimate') productId = 'cohort-ultimate';

      trackEvent('checkout_initiated', {
        planId: productId,
        planName: currentResource.title,
        amount: chargeAmount,
      });

      const res = await fetch(`${SUPABASE_FN_BASE}/pay-initiate`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify({
          product_id: productId,
          product_name: currentResource.title,
          amount: chargeAmount,
          email,
          name: name || undefined,
          phone: phone || undefined,
          university: uni || null,
          callback_url: `${window.location.origin}/payment/callback`,
        }),
      });

      const data = await res.json();
      if (res.ok && data.success && data.data?.authorization_url) {
        trackEvent('paystack_redirect', {
          reference: data.data.reference,
          amount: chargeAmount,
        });
        window.location.href = data.data.authorization_url;
      } else {
        throw new Error(data.message || 'Payment initiation failed.');
      }
    } catch (err: any) {
      console.warn('Paystack initiate error:', err);
      showInlineAlert(err.message || 'Unable to connect to Paystack. Please try again.');
      if (paystackSubmitBtn) {
        paystackSubmitBtn.disabled = false;
        paystackSubmitBtn.innerHTML = `<span>Pay ₦${basePrice.toLocaleString()} with Paystack &rarr;</span>`;
      }
    }
  });

  // Global listener for open-checkout events
  window.addEventListener('open-checkout', (e: any) => {
    if (e.detail?.resource) {
      openCheckout(e.detail.resource);
    }
  });
</script>

