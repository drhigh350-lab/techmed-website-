---
// Used on the JAMB Syllabus hub and (as a lightweight "explore other
// subjects" strip) on each subject page — kept as a shared component
// since both places need the exact same card shape.
import type { Subject } from '../lib/syllabus';

interface Props {
  subject: Subject;
}

const { subject } = Astro.props;
const stageCount = subject.stages.length;
---

<a href={`/jamb-syllabus/${subject.slug}`} class="subject-card reveal">
  <h3>{subject.name}</h3>
  <p class="description">{subject.description}</p>
  <div class="meta">
    {subject.topicCount && <span>{subject.topicCount} topics</span>}
    <span>{stageCount} stages</span>
  </div>
  <span class="link">View Syllabus <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .subject-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .subject-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-3);
  }

  .description {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-light);
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
  }

  .link span {
    transition: transform 200ms ease;
  }

  .subject-card:hover .link span {
    transform: translateX(3px);
  }
</style>
