---
interface Props {
  title: string;
  description: string;
  href: string;
  /** Inline SVG markup (kept tiny + monochrome, matching the brief's "avoid unnecessary icons" guidance). */
  icon: string;
  /** Optional small stage label above the title (e.g. "Know What Matters"), used by EcosystemGrid to group products around the student journey rather than presenting them as a flat catalogue. */
  eyebrow?: string;
}

const { title, description, href, icon, eyebrow } = Astro.props;
---

<a href={href} class="feature-card reveal">
  <div class="icon" set:html={icon} />
  {eyebrow && <p class="stage-eyebrow">{eyebrow}</p>}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="learn-more">Learn More <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    background: var(--surface-raised);
    color: var(--accent-text);
    margin-bottom: var(--space-4);
  }

  .icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .stage-eyebrow {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--space-2);
  }

  h3 {
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }

  p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-light);
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .learn-more {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-text);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1, 4px);
  }

  .learn-more span {
    transition: transform 200ms ease;
  }

  .feature-card:hover .learn-more span {
    transform: translateX(3px);
  }
</style>
