---
import { getWhatsappChannelUrl } from '../lib/sanity';
const WHATSAPP_CHANNEL = await getWhatsappChannelUrl();
---

<section class="cta-section reveal">
  <h2>Brick by brick. Day by day.</h2>
  <p>You don't have to prepare alone.</p>
  <a class="cta" href={WHATSAPP_CHANNEL} target="_blank" rel="noopener">Join Builder Cohort</a>
</section>

<style>
  .cta-section {
    text-align: center;
    padding: var(--space-24) var(--space-6);
    background: linear-gradient(135deg, var(--surface-raised) 0%, var(--surface) 100%);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  p {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .cta {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    padding: 16px 36px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 300ms ease;
  }

  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.35);
  }
</style>
