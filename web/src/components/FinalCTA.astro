---
import { getBuilderSettings } from '../lib/builders';
const { channelUrl } = await getBuilderSettings();
---

<section class="cta-section reveal">
  <h2>You Don't Have To Prepare Alone.</h2>
  <p>Brick by brick. Day by day.</p>
  <a class="cta" href={channelUrl} target="_blank" rel="noopener">Become a Builder <span aria-hidden="true">&rarr;</span></a>
  <p class="cta-note">Because things built well last.</p>
</section>

<style>
  .cta-section {
    text-align: center;
    padding: var(--space-24) var(--space-6);
    background: linear-gradient(135deg, var(--surface-raised) 0%, var(--surface) 100%);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  p {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: var(--space-8);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #1a0a00;
    padding: 16px 36px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 300ms ease;
  }

  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 162, 39, 0.35);
  }

  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-5);
    margin-bottom: 0;
  }
</style>
