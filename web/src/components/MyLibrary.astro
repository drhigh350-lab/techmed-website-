---
// "My Library" — the student's own bookshelf at the top of /resources.
// Every book they own (purchase, plan, bundle or admin grant) appears here
// automatically, with one tap to read and one tap to save for offline.
// Works offline too: saved books are listed from the phone's storage.
import type { Resource } from '../lib/resources';

interface Props {
  resources: Resource[];
}

const { resources } = Astro.props;

// Only what the shelf needs, keyed by every id/slug a book might be known by.
const catalogue = resources
  .filter((r) => r.status === 'paid' && r.deliveryFormat === 'PDF eBook')
  .map((r) => ({ id: r.id, slug: r.slug, title: r.title, cover: r.primaryImage ?? null }));
---

<section id="my-library" class="my-library" hidden data-catalogue={JSON.stringify(catalogue)}>
  <div class="ml-head">
    <div>
      <p class="ml-eyebrow">My Library</p>
      <h2 class="ml-title">Your books</h2>
    </div>
    <span id="mlNet" class="ml-net" hidden></span>
  </div>
  <p id="mlHint" class="ml-hint">Tap <strong>Save offline</strong> once per book. After that it opens with your data off.</p>
  <div id="mlShelf" class="ml-shelf" role="list"></div>
  <p id="mlEmpty" class="ml-empty" hidden>
    Books you buy, or get with your TECHMED plan, appear here automatically.
  </p>
</section>

<script>
  import { getSupabase, getMyLibraryIds, getLocalReadingProgress } from '../lib/supabase';
  import {
    listBooks,
    saveBook,
    removeBook,
    rememberReader,
    lastReader,
    isOfflineStorageSupported,
    formatSize,
    keepPagesOffline,
    type OfflineBookMeta,
  } from '../lib/offlineBooks';
  import { downloadBook, ReaderError } from '../lib/readerApi';

  type Book = { id: string; slug: string; title: string; cover: string | null };

  const root = document.getElementById('my-library') as HTMLElement;
  const shelf = document.getElementById('mlShelf') as HTMLElement;
  const empty = document.getElementById('mlEmpty') as HTMLElement;
  const net = document.getElementById('mlNet') as HTMLElement;
  const catalogue: Book[] = JSON.parse(root.dataset.catalogue || '[]');

  // Database ids that differ from the website's resource ids.
  const DB_TO_SITE: Record<string, string> = { 'post-utme-pq': 'post-utme-brainstorming-hub', 'research-file': 'university-research-file' };
  const findBook = (id: string) => catalogue.find((b) => b.id === (DB_TO_SITE[id] ?? id) || b.slug === id);

  function progressFor(userId: string, id: string): string {
    const rec = getLocalReadingProgress(userId, id, '');
    return rec && rec.currentPage > 1 ? `Page ${rec.currentPage} of ${rec.totalPages}` : '';
  }

  function card(book: Book, userId: string, saved: OfflineBookMeta | undefined, canDownload: boolean): HTMLElement {
    const el = document.createElement('article');
    el.className = 'ml-card';
    el.setAttribute('role', 'listitem');
    const href = `/library/read/${book.id}`;
    const where = progressFor(userId, book.id);
    el.innerHTML = `
      <a class="ml-cover" href="${href}" aria-label="Read ${book.title}">
        ${book.cover ? `<img src="${book.cover}" alt="${book.title} cover" loading="lazy" />` : `<span class="ml-cover-fallback">${book.title}</span>`}
        ${saved ? '<span class="ml-badge">✓ Offline</span>' : ''}
      </a>
      <div class="ml-body">
        <h3 class="ml-book">${book.title}</h3>
        <p class="ml-meta">${where || (saved ? `Saved on this phone · ${formatSize(saved.size)}` : 'Not saved on this phone yet')}</p>
        <div class="ml-actions">
          <a class="ml-read" href="${href}">${where ? 'Continue' : 'Read'}</a>
          ${
            saved
              ? '<button type="button" class="ml-save saved" data-act="remove" aria-label="Remove from this phone">Saved ✓</button>'
              : canDownload && isOfflineStorageSupported()
                ? '<button type="button" class="ml-save" data-act="save">Save offline</button>'
                : ''
          }
        </div>
        <div class="ml-progress" hidden><div></div></div>
      </div>`;

    const btn = el.querySelector<HTMLButtonElement>('.ml-save');
    btn?.addEventListener('click', async () => {
      if (btn.dataset.act === 'remove') {
        if (!confirm(`Remove "${book.title}" from this phone? You can save it again any time (uses data).`)) return;
        await removeBook(userId, book.id);
        render();
        return;
      }
      const bar = el.querySelector<HTMLElement>('.ml-progress')!;
      const fill = bar.firstElementChild as HTMLElement;
      bar.hidden = false;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        const file = await downloadBook(book.id, (f) => {
          fill.style.width = f == null ? '40%' : `${Math.round(f * 100)}%`;
        });
        await saveBook({ userId, resourceId: book.id, title: book.title, fileType: file.fileType, version: file.version }, file.bytes);
        void keepPagesOffline([`/library/read/${book.id}/`, '/resources/']);
        render();
      } catch (err) {
        bar.hidden = true;
        btn.disabled = false;
        const code = err instanceof ReaderError ? err.code : 'failed';
        btn.textContent =
          code === 'file_not_uploaded' ? 'Coming soon' : code === 'offline' ? 'No connection' : 'Try again';
        if (code === 'file_not_uploaded') btn.disabled = true;
      }
    });
    return el;
  }

  async function render() {
    let userId: string | null = null;
    try {
      const { data } = await getSupabase().auth.getSession();
      if (data.session?.user) {
        userId = data.session.user.id;
        rememberReader({ id: userId, email: data.session.user.email });
      }
    } catch {}
    if (!userId && !navigator.onLine) userId = lastReader()?.id ?? null;
    if (!userId) {
      root.hidden = true;
      return;
    }

    const saved = await listBooks(userId);
    const savedById = new Map(saved.map((m) => [m.resourceId, m]));
    const ownedIds = navigator.onLine ? await getMyLibraryIds() : null;

    // Online: show everything the database says they own. Offline: show what's saved.
    const ids = new Set<string>([...(ownedIds ?? []), ...saved.map((m) => m.resourceId)]);
    const books = [...ids].map(findBook).filter((b): b is Book => !!b);
    const unique = [...new Map(books.map((b) => [b.id, b])).values()];

    shelf.innerHTML = '';
    for (const b of unique) shelf.appendChild(card(b, userId, savedById.get(b.id), navigator.onLine));
    empty.hidden = unique.length > 0;
    root.hidden = false;

    net.hidden = navigator.onLine;
    net.textContent = navigator.onLine ? '' : 'Offline · showing saved books';

    if (navigator.onLine && saved.length) {
      void keepPagesOffline(['/resources/', ...saved.map((m) => `/library/read/${m.resourceId}/`)]);
    }

    if (location.hash === '#my-library') root.scrollIntoView({ block: 'start' });
  }

  window.addEventListener('online', render);
  window.addEventListener('offline', render);
  render();
</script>

<style>
  .my-library {
    max-width: 1100px;
    margin: 0 auto var(--space-12, 48px);
    padding: var(--space-6, 24px) var(--space-4, 16px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg, 16px);
    scroll-margin-top: 90px;
  }
  .ml-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .ml-eyebrow {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text, var(--accent));
  }
  .ml-title {
    margin: 2px 0 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.4rem;
  }
  .ml-net {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(201, 162, 39, 0.18);
  }
  .ml-hint {
    margin: 8px 0 16px;
    color: var(--text-light);
    font-size: 0.92rem;
  }
  .ml-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .ml-card {
    display: flex;
    gap: 12px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
  }
  .ml-cover {
    position: relative;
    flex: 0 0 84px;
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: linear-gradient(135deg, #012748, #09476e);
  }
  .ml-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ml-cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 6px;
    color: #f8f9fa;
    font-size: 0.7rem;
    font-weight: 700;
    text-align: center;
  }
  .ml-badge {
    position: absolute;
    left: 4px;
    bottom: 4px;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 999px;
    background: #c9a227;
    color: #1a1400;
  }
  .ml-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .ml-book {
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.98rem;
    line-height: 1.25;
  }
  .ml-meta {
    margin: 4px 0 auto;
    font-size: 0.82rem;
    color: var(--text-light);
  }
  .ml-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .ml-read,
  .ml-save {
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }
  .ml-read {
    background: var(--accent);
    color: #1a1400;
    border: 0;
  }
  .ml-save {
    background: transparent;
    color: inherit;
    border: 1px solid var(--border);
  }
  .ml-save.saved {
    border-color: var(--accent);
  }
  .ml-save:disabled {
    opacity: 0.6;
  }
  .ml-progress {
    height: 6px;
    margin-top: 8px;
    border-radius: 999px;
    background: rgba(152, 176, 196, 0.25);
    overflow: hidden;
  }
  .ml-progress div {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.2s;
  }
  .ml-empty {
    color: var(--text-light);
    margin: 0;
  }
</style>
